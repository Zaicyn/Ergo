#version 450

/*
 * Atlas generation compute shader — per-cell tiles.
 * Uses Collignon quincuncial equal-area projection (Appendix B of Petroff 2021).
 * Every texel covers equal solid angle — no area distortion.
 */

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer BufX { float px[]; };
layout(set = 0, binding = 1) readonly buffer BufY { float py[]; };
layout(set = 0, binding = 2) readonly buffer BufZ { float pz[]; };
layout(set = 0, binding = 3) readonly buffer BufC { float cv[]; };
layout(set = 0, binding = 4) buffer AtlasBuf { uint atlas_pixels[]; };

layout(push_constant) uniform PC {
    int   n_points;
    int   grid_size;
    float cell_size;
    float val_min;
    float val_max;
    float pad1, pad2, pad3;
};

#define PI 3.14159265359
#define SQRT2 1.41421356237

/* Collignon quincuncial equal-area projection.
 * Input: direction vector (will be normalized).
 * Output: (x,y) in [-1, 1] mapped to [0, 1] UV. */
vec2 equal_area_octa_uv(vec3 dir) {
    dir = normalize(dir);

    /* Convert to spherical: latitude phi, longitude lambda */
    float phi = asin(clamp(dir.y, -1.0, 1.0));          /* [-pi/2, pi/2] */
    float lambda = atan(dir.x, dir.z);                   /* [-pi, pi] */

    /* Collignon quincuncial (Petroff 2021 Appendix B, eq 75-81) */
    int q = int(floor(2.0 * lambda / PI));               /* octant 0-3 */
    if (lambda < 0.0) q -= 1;                            /* handle negative */
    q = clamp(q, -2, 1);

    float lambda_0 = lambda - (PI / 2.0) * float(q) - PI / 4.0;

    float cos_phi = cos(abs(phi) / 2.0 + PI / 4.0);

    float x = -(2.0 * SQRT2 / PI) * lambda_0 * cos_phi;
    float y;
    if (phi < 0.0)
        y = 1.0 - cos_phi / SQRT2;
    else
        y = cos_phi / SQRT2;

    /* Rotate by octant */
    float xt, yt;
    if (q == 0)       { xt = x + y;  yt = x - y; }
    else if (q == 1)  { xt = -x - y; yt = x - y; }
    else if (q == -1) { xt = x + y;  yt = -x + y; }
    else              { xt = -x - y; yt = -x + y; } /* q == -2 */

    /* Map from [-1,1] to [0,1] */
    return clamp(vec2(xt, yt) * 0.5 + 0.5, vec2(0.0), vec2(1.0));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= n_points) return;

    vec3 pos = vec3(px[idx], py[idx], pz[idx]);

    int gs = grid_size;
    float half_extent = float(gs) * 0.5 * cell_size;

    int ci = clamp(int(floor((pos.x + half_extent) / cell_size)), 0, gs - 1);
    int cj = clamp(int(floor((pos.y + half_extent) / cell_size)), 0, gs - 1);
    int ck = clamp(int(floor((pos.z + half_extent) / cell_size)), 0, gs - 1);

    int cell_idx = ck * gs * gs + cj * gs + ci;

    vec3 cell_center = vec3(
        (float(ci) - float(gs) * 0.5 + 0.5) * cell_size,
        (float(cj) - float(gs) * 0.5 + 0.5) * cell_size,
        (float(ck) - float(gs) * 0.5 + 0.5) * cell_size
    );

    vec3 dir = pos - cell_center;
    if (length(dir) < 1e-8) return;

    vec2 uv = equal_area_octa_uv(dir);
    ivec2 local_px = clamp(ivec2(uv * 64.0), ivec2(0), ivec2(63));

    int tile_x = cell_idx % 128;
    int tile_y = cell_idx / 128;
    ivec2 tile_origin = ivec2(tile_x * 64, tile_y * 64);

    float t = clamp((cv[idx] - val_min) / (val_max - val_min + 1e-10), 0.0, 1.0);
    float r = clamp(t * 4.0 - 2.0, 0.0, 1.0);
    float g_val = clamp(1.0 - abs(t * 4.0 - 2.0), 0.0, 1.0) +
                  clamp(t * 4.0 - 2.0, 0.0, 1.0) * step(0.5, t);
    float b = clamp(1.0 - t * 4.0, 0.0, 1.0);

    uint packed = (uint(r * 255.0) & 0xFFu) |
                  ((uint(clamp(g_val, 0.0, 1.0) * 255.0) & 0xFFu) << 8u) |
                  ((uint(b * 255.0) & 0xFFu) << 16u) |
                  (0xFFu << 24u);

    ivec2 atlas_px = tile_origin + local_px;
    uint pixel_idx = uint(atlas_px.y) * 8192u + uint(atlas_px.x);
    atlas_pixels[pixel_idx] = packed;
}
