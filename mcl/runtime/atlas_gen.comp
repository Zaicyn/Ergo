#version 450

/*
 * Atlas generation compute shader — per-cell octahedral tiles.
 *
 * One thread per particle. Writes heat palette color into a flat
 * SSBO atlas buffer (2048 x 4096 = 8M pixels, packed as uint RGBA8).
 *
 * Atlas layout: 128 x 256 tiles of 16x16 pixels
 * Cell index i maps to tile (i % 128, i / 128)
 */

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer BufX { float px[]; };
layout(set = 0, binding = 1) readonly buffer BufY { float py[]; };
layout(set = 0, binding = 2) readonly buffer BufZ { float pz[]; };
layout(set = 0, binding = 3) readonly buffer BufC { float cv[]; };

/* Atlas as flat SSBO — 2048*4096 uint32 pixels (RGBA8 packed) */
layout(set = 0, binding = 4) buffer AtlasBuf { uint atlas_pixels[]; };

layout(push_constant) uniform PC {
    int   n_points;
    int   grid_size;
    float cell_size;
    float val_min;
    float val_max;
    float pad1;
    float pad2;
    float pad3;
};

vec2 dir_to_octa_uv(vec3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    if (n.z < 0.0) {
        vec2 wrapped = (1.0 - abs(n.yx)) * vec2(
            n.x >= 0.0 ? 1.0 : -1.0,
            n.y >= 0.0 ? 1.0 : -1.0
        );
        n.x = wrapped.x;
        n.y = wrapped.y;
    }
    return n.xy * 0.5 + 0.5;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= n_points) return;

    vec3 pos = vec3(px[idx], py[idx], pz[idx]);

    /* Determine grid cell */
    int gs = grid_size;
    float half_extent = float(gs) * 0.5 * cell_size;

    int ci = clamp(int(floor((pos.x + half_extent) / cell_size)), 0, gs - 1);
    int cj = clamp(int(floor((pos.y + half_extent) / cell_size)), 0, gs - 1);
    int ck = clamp(int(floor((pos.z + half_extent) / cell_size)), 0, gs - 1);

    int cell_idx = ck * gs * gs + cj * gs + ci;

    /* Cell center */
    vec3 center = vec3(
        (float(ci) - float(gs) * 0.5 + 0.5) * cell_size,
        (float(cj) - float(gs) * 0.5 + 0.5) * cell_size,
        (float(ck) - float(gs) * 0.5 + 0.5) * cell_size
    );

    /* Direction from cell center to particle */
    vec3 dir = pos - center;
    float dist = length(dir);
    if (dist < 1e-8) return;
    dir /= dist;

    /* Octa UV within 16x16 tile */
    vec2 uv = dir_to_octa_uv(dir);
    ivec2 local_px = clamp(ivec2(uv * 16.0), ivec2(0), ivec2(15));

    /* Atlas pixel position */
    int tile_x = cell_idx % 128;
    int tile_y = cell_idx / 128;
    ivec2 atlas_px = ivec2(tile_x * 16, tile_y * 16) + local_px;

    /* Heat palette */
    float t = clamp((cv[idx] - val_min) / (val_max - val_min + 1e-10), 0.0, 1.0);
    float r = clamp(t * 4.0 - 2.0, 0.0, 1.0);
    float g_val = clamp(1.0 - abs(t * 4.0 - 2.0), 0.0, 1.0) +
                  clamp(t * 4.0 - 2.0, 0.0, 1.0) * step(0.5, t);
    float b = clamp(1.0 - t * 4.0, 0.0, 1.0);

    /* Pack RGBA8 as uint32 */
    uint packed = (uint(r * 255.0) & 0xFFu) |
                  ((uint(g_val * 255.0) & 0xFFu) << 8u) |
                  ((uint(b * 255.0) & 0xFFu) << 16u) |
                  (0xFFu << 24u);

    /* Write to atlas (last-write-wins for overlapping particles) */
    uint pixel_idx = uint(atlas_px.y) * 2048u + uint(atlas_px.x);
    atlas_pixels[pixel_idx] = packed;
}
