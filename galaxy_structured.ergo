   1.000000, -0.000000,  0.000000, &
   0.138370,  0.331496, -0.933255, &
  -0.120303,  0.344944, -0.930882, &
  -0.408600,  0.332813, -0.849871, &
  -0.857493,  0.171499, -0.485071, &
  -0.941049, -0.250189,  0.227669, &
  -0.666393, -0.564428,  0.487177, &
  -0.386358, -0.836993,  0.387517, &
  -0.000000, -1.000000,  0.000000, &
   0.386358, -0.836993, -0.387517, &
   0.666393, -0.564428, -0.487177, &
