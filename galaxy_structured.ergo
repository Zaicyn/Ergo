  -0.340459, -0.163085,  0.216041,  0.319410, &
   0.259259,  0.319410,  0.216041, -0.163086, &
  -0.340459, -0.227317, -0.231222, -0.263371 /

! ── Curve control points (3 × 32) — coherence nodes ──────
! Envelope = 1/sqrt(1 + dist² · INV_R_SCALE_SQ)
! Signed XYZ positions on the unit sphere.
STATIC REAL :: CURVE_PT(3, 32)
DATA CURVE_PT / &
