! ============================================================
! ab_recoil_standoff.ergo  --  Stage 5b: the 1/r law
!
! Follow-up to ab_recoil: the recoil (= canonical/kinetic split,
! delta_kx per channel = -A along the path) predicts the kinetic
! momentum imprint scales as the vector potential at closest
! approach: A = FL/(2 pi r)  ->  slope(dkx1/FL) = -1/(2 pi r).
!
! Three standoffs, packets symmetric about the flux row 256:
!   GS1: rows 204/308   r = 52
!   GS2: rows 156/356   r = 100
!   GS3: rows 232/280   r = 24
!
! MIRROR VERDICT (C mirror, 21 runs): the naive 1/r law FAILS.
!   slope dkx1/FL at pi/4:  r=24 -0.00293, r=52 -0.00302,
!                           r=100 -0.00019
!   - saturation r=24 ~ r=52 (ratio 0.97, not 2.17): the
!     path integral of A_x over the full line is r-INDEPENDENT
!     (integral of dy/(x^2+dy^2) dx = pi), so an integral
!     mechanism cannot grow like 1/r -- consistent.
!   - collapse + SIGN FLIP of dcx1 at r=100 (+0.14 at +pi/4,
!     still FL-odd): kills every single-mechanism story. The
!     Stage-5 recoil at r=52 is dominated by the NEAR-FIELD
!     transit region around the shield disk, not the 1/r tail.
!   - null-case cx: r=100 packets reach 358 vs 340 (r=52) --
!     they miss the disk diffraction fan entirely.
! Score the ergo run against these numbers, not the 1/r preds.
!
! FL sweep trimmed to the linear window + pi anchor:
!   0, +-pi/4, +-pi/2, +-pi  (2pi regime = band curvature,
!   characterized in Stage 5; not re-measured here).
! 3 x 7 = 21 runs, NSTEPS=2200, sponge ON.
!
! Same instrument as ab_recoil: per-channel centroid CX and
! kinetic momentum KX from the gauge-covariant derivative.
! Mass/CY/trajectory prints dropped -- Stage 5 verified them
! byte-exact against the mirror; this file is the slope test.
!
! Mirror oracles: filled from /tmp/sweep_mirror (C, same engine)
! -- see summary block at bottom.
!
! NOTE: arrays are stack-allocated by the current codegen;
! run with: ulimit -s unlimited
!
! Rename: ab_recoil_standoff.ergo.txt -> ab_recoil_standoff.ergo
! Run: python -m core min/ab/ab_recoil_standoff.ergo -o /tmp/sweep
!      ulimit -s unlimited && /tmp/sweep
! ============================================================

IMPLICIT NONE
INTEGER, PARAMETER :: NX = 512, NY = 512
INTEGER, PARAMETER :: NPTS = NX*NY
INTEGER, PARAMETER :: NEND = NPTS - NX - 1
INTEGER, PARAMETER :: NSTEPS = 2200
INTEGER, PARAMETER :: NSP = 48
REAL, PARAMETER :: AA = 0.20
REAL, PARAMETER :: SIG = 14.0
REAL, PARAMETER :: K0 = 0.3
INTEGER, PARAMETER :: X0 = 100
INTEGER, PARAMETER :: XC = 256, YC = 256
REAL, PARAMETER :: PI2 = 6.283185307179586
REAL, PARAMETER :: PIH = 3.14159265358979

REAL :: R(NPTS), I(NPTS), ABSORB(NPTS), WALL(NPTS)
REAL :: CXL(NPTS), SXL(NPTS), CYL(NPTS), SYL(NPTS)
REAL :: FT(21), X1T(21), X2T(21), K1T(21), K2T(21)

INTEGER :: J, K, KK, T, CS, GS, IT, IDX, B, C
REAL :: FLV, SV, DX, DY, R2C, TH
REAL :: Y1V, Y2V
REAL :: W1, WX1, WK1, W2, WX2, WK2
REAL :: RH, DRX, DIX, KM
REAL :: CX1, CX2, KX1, KX2
REAL :: S52, S100, S24

IT := 0

DO GS = 1, 3

   IF (GS = 1) THEN
      Y1V := 204.0
      Y2V := 308.0
   ENDIF
   IF (GS = 2) THEN
      Y1V := 156.0
      Y2V := 356.0
   ENDIF
   IF (GS = 3) THEN
      Y1V := 232.0
      Y2V := 280.0
   ENDIF

   DO CS = 1, 7

      FLV := 0.0
      IF (CS = 2) THEN
         FLV := PIH/4.0
      ENDIF
      IF (CS = 3) THEN
         FLV := -PIH/4.0
      ENDIF
      IF (CS = 4) THEN
         FLV := PIH/2.0
      ENDIF
      IF (CS = 5) THEN
         FLV := -PIH/2.0
      ENDIF
      IF (CS = 6) THEN
         FLV := PIH
      ENDIF
      IF (CS = 7) THEN
         FLV := -PIH
      ENDIF

      ! --- clear grid, absorber, wall ---
      DO KK = 1, NX*NY
         R(KK) := 0.0
         I(KK) := 0.0
         ABSORB(KK) := 1.0
         WALL(KK) := 1.0
      ENDDO

      ! --- sponge: symmetric on all four edges ---
      DO J = 1, NSP
         SV := 1.0 - 0.35*(1.0 - J/49.0)*(1.0 - J/49.0)
         DO K = 1, NX
            ABSORB(K + (J-1)*NX) := ABSORB(K + (J-1)*NX) * SV
            ABSORB(K + (NY-J)*NX) := ABSORB(K + (NY-J)*NX) * SV
         ENDDO
         DO K = 1, NY
            ABSORB(J + (K-1)*NX) := ABSORB(J + (K-1)*NX) * SV
            ABSORB(NX+1-J + (K-1)*NX) := ABSORB(NX+1-J + (K-1)*NX) * SV
         ENDDO
      ENDDO

      ! --- flux shield: r=8 disk, WALL=0 ---
      DO J = 248, 264
         DO K = 248, 264
            DX := K - XC
            DY := J - YC
            IF (DX*DX + DY*DY < 64.0) THEN
               WALL(K + (J-1)*NX) := 0.0
            ENDIF
         ENDDO
      ENDDO

      ! --- Peierls links (r>6 cutoff) ---
      DO KK = 1, NX*NY
         CXL(KK) := 1.0
         SXL(KK) := 0.0
         CYL(KK) := 1.0
         SYL(KK) := 0.0
      ENDDO
      IF (FLV /= 0.0) THEN
         TH := FLV / PI2
         DO J = 2, NY-1
            DO K = 2, NX-1
               DX := K - XC + 0.5
               DY := J - YC
               R2C := DX*DX + DY*DY
               IF (R2C > 36.0) THEN
                  SV := -TH*DY/R2C
                  IDX := K + (J-1)*NX
                  CXL(IDX) := COS(SV)
                  SXL(IDX) := SIN(SV)
               ENDIF
               DX := K - XC
               DY := J - YC + 0.5
               R2C := DX*DX + DY*DY
               IF (R2C > 36.0) THEN
                  SV := TH*DX/R2C
                  IDX := K + (J-1)*NX
                  CYL(IDX) := COS(SV)
                  SYL(IDX) := SIN(SV)
               ENDIF
            ENDDO
         ENDDO
      ENDIF

      ! --- two Gaussian packets at this standoff ---
      DO J = 1, NY
         DO K = 1, NX
            IDX := K + (J-1)*NX
            SV := EXP(-(((K-X0)/30.0)*((K-X0)/30.0) + ((J-Y1V)/SIG)*((J-Y1V)/SIG)))
            R(IDX) := SV*COS(K0*(K-X0))
            I(IDX) := SV*SIN(K0*(K-X0))
            SV := EXP(-(((K-X0)/30.0)*((K-X0)/30.0) + ((J-Y2V)/SIG)*((J-Y2V)/SIG)))
            R(IDX) := R(IDX) + SV*COS(K0*(K-X0))
            I(IDX) := I(IDX) + SV*SIN(K0*(K-X0))
         ENDDO
      ENDDO

      ! --- integration; instrument pass at final step only ---
      DO T = 1, NSTEPS

         DO K = NX+2, NEND
            I(K) := (I(K) + AA*(CXL(K)*R(K+1) + CXL(K-1)*R(K-1) &
               + CYL(K)*R(K+NX) + CYL(K-NX)*R(K-NX) - 4.0*R(K) &
               - SXL(K)*I(K+1) + SXL(K-1)*I(K-1) &
               - SYL(K)*I(K+NX) + SYL(K-NX)*I(K-NX))) &
               * ABSORB(K) * WALL(K)
         ENDDO
         DO K = NX+2, NEND
            R(K) := (R(K) - AA*(SXL(K)*R(K+1) - SXL(K-1)*R(K-1) &
               + SYL(K)*R(K+NX) - SYL(K-NX)*R(K-NX) &
               + CXL(K)*I(K+1) + CXL(K-1)*I(K-1) &
               + CYL(K)*I(K+NX) + CYL(K-NX)*I(K-NX) - 4.0*I(K))) &
               * ABSORB(K) * WALL(K)
         ENDDO

         IF (T = NSTEPS) THEN
            W1 := 0.0
            WX1 := 0.0
            WK1 := 0.0
            W2 := 0.0
            WX2 := 0.0
            WK2 := 0.0
            DO J = 2, NY-1
               DO K = 2, NX-1
                  IDX := K + (J-1)*NX
                  RH := R(IDX)*R(IDX) + I(IDX)*I(IDX)
                  DRX := 0.5*((CXL(IDX)*R(IDX+1) - SXL(IDX)*I(IDX+1)) &
                     - (CXL(IDX-1)*R(IDX-1) + SXL(IDX-1)*I(IDX-1)))
                  DIX := 0.5*((CXL(IDX)*I(IDX+1) + SXL(IDX)*R(IDX+1)) &
                     - (CXL(IDX-1)*I(IDX-1) - SXL(IDX-1)*R(IDX-1)))
                  KM := R(IDX)*DIX - I(IDX)*DRX
                  IF (J <= 256) THEN
                     W1 := W1 + RH
                     WX1 := WX1 + RH*K
                     WK1 := WK1 + KM
                  ELSE
                     W2 := W2 + RH
                     WX2 := WX2 + RH*K
                     WK2 := WK2 + KM
                  ENDIF
               ENDDO
            ENDDO
            CX1 := WX1/W1
            KX1 := WK1/W1
            CX2 := WX2/W2
            KX2 := WK2/W2
         ENDIF

      ENDDO

      IT := IT + 1
      FT(IT) := FLV
      X1T(IT) := CX1
      X2T(IT) := CX2
      K1T(IT) := KX1
      K2T(IT) := KX2

      WRITE(*,"('gs %d case %d FL %.4f cx1 %.2f cx2 %.2f kx1 %.5f kx2 %.5f')") GS, CS, FLV, CX1, CX2, KX1, KX2

   ENDDO
ENDDO

! ---------------- summary tables ----------------

DO GS = 1, 3
   B := (GS-1)*7
   WRITE(*,"('-- standoff %d --')") GS
   DO C = 2, 7
      WRITE(*,"('FL %.4f dcx1 %.3f dcx2 %.3f dkx1 %.5f dkx2 %.5f')") FT(B+C), X1T(B+C)-X1T(B+1), X2T(B+C)-X2T(B+1), K1T(B+C)-K1T(B+1), K2T(B+C)-K2T(B+1)
   ENDDO
   WRITE(*,"('slope dkx1/FL pi/4 %.5f pi/2 %.5f pi %.5f')") (K1T(B+2)-K1T(B+1))/(PIH/4.0), (K1T(B+4)-K1T(B+1))/(PIH/2.0), (K1T(B+6)-K1T(B+1))/PIH
ENDDO

WRITE(*,"('-- 1/r check: slope(pi/4) ratios vs r=52 --')")
S52 := (K1T(2)-K1T(1))/(PIH/4.0)
S100 := (K1T(9)-K1T(8))/(PIH/4.0)
S24 := (K1T(16)-K1T(15))/(PIH/4.0)
WRITE(*,"('s52 %.5f s100 %.5f s24 %.5f')") S52, S100, S24
WRITE(*,"('r=24/r=52 %.3f mirror 0.969   r=100/r=52 %.3f mirror 0.061')") S24/S52, S100/S52
WRITE(*,"('-- mirror slopes: s24 -0.00293 s52 -0.00302 s100 -0.00019 --')")
WRITE(*,"('-- 1/r law fails: saturation r24~r52, sign flip at r100 --')")
