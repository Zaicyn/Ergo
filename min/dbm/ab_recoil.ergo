! ============================================================
! ab_recoil.ergo  --  Stage 5: the recoil instrument
!
! Question: the 4b flip showed an FL-odd centroid displacement
! (~2.4 sites per pi, negative-FL packets travel farther). Is it
! a wavefunction-side AB impulse (hidden-momentum transfer), and
! what is its momentum bookkeeping?
!
! Instrument: per channel (below/above the flux line at 256,256,
! r=8 WALL=0 disk), per step:
!   W   = channel mass
!   CX,CY = centroid (longitudinal displacement AND transverse
!           lens kick)
!   KX  = mean KINETIC momentum from the gauge-covariant
!         derivative with the Peierls links:
!           D_x psi = 0.5[ e^{+i th}psi(K+1) - e^{-i th'}psi(K-1) ]
!         canonical momentum is conserved; kinetic = canonical - A.
!         If the displacement is the canonical/kinetic split, then
!         delta_KX per channel = -A_x(path) and CX integrates it.
!   MASS = total mass trajectory (the transit dip flagged in 4d)
!
! Sweep: 9 cases, FL = 0, +-pi/4, +-pi/2, +-pi, +-2pi.
! NSTEPS=2200, sponge ON (symmetric on all four edges; the disk
! and geometry are mirror-symmetric about y=256, so any FL-odd,
! channel-antisymmetric signal cannot come from the boundaries).
!
! Mirror oracles (C mirror, same engine):
!   small FL (pi/4, pi/2):
!     odd-ness:      dcx1(+FL)+dcx1(-FL) = -0.03 sites
!     channel mirror: dcx1+dcx2          = +-0.06 sites
!     linear:        dcx1 = -1.0 (pi/4), -1.6 (pi/2)
!     kinetic split: dkx1 ~ -+0.0023 per pi/4 (opposed below,
!                    aided above)
!   rollover past pi/2 (sin(k-A) nonlinearity):
!     dcx1 = -1.0 (pi), +0.3 (2pi)  -- non-monotonic, matches
!     the 4b flip numbers (340.0/341.3 for +pi/+2pi)
!   2pi odd-check asymmetry (+2.4 sites) reproduces the flip
!   data exactly: engine physics, NOT sponge asymmetry.
!
! Cases 6/7 (FL=+-pi) print the full trajectory every 400 steps
! (centroids, kinetic momenta, mass) so the transit window is
! resolved; the summary prints the displacement table vs the
! null case, the odd check, and the channel-mirror check.
!
! Rename: ab_recoil.ergo.txt -> ab_recoil.ergo
! Run: python -m core min/ab/ab_recoil.ergo -o /tmp/recoil && /tmp/recoil
! ============================================================

IMPLICIT NONE
INTEGER, PARAMETER :: NX = 512, NY = 512
INTEGER, PARAMETER :: NPTS = NX*NY
INTEGER, PARAMETER :: NEND = NPTS - NX - 1
INTEGER, PARAMETER :: NSTEPS = 2200
INTEGER, PARAMETER :: NSP = 48
REAL, PARAMETER :: AA = 0.20
REAL, PARAMETER :: SIG = 14.0
REAL, PARAMETER :: K0 = 0.3
INTEGER, PARAMETER :: X0 = 100
INTEGER, PARAMETER :: Y1 = 204, Y2 = 308
INTEGER, PARAMETER :: XC = 256, YC = 256
REAL, PARAMETER :: PI2 = 6.283185307179586
REAL, PARAMETER :: PIH = 3.14159265358979

REAL :: R(NPTS), I(NPTS), ABSORB(NPTS), WALL(NPTS)
REAL :: CXL(NPTS), SXL(NPTS), CYL(NPTS), SYL(NPTS)
REAL :: FT(9), X1T(9), X2T(9), Y1T(9), Y2T(9), K1T(9), K2T(9)

INTEGER :: J, K, KK, T, CS, IDX
REAL :: FLV, SV, DX, DY, R2C, TH
REAL :: W1, WX1, WY1, WK1, W2, WX2, WY2, WK2, MC, M0
REAL :: RH, DRX, DIX, KM
REAL :: CX1, CY1, CX2, CY2, KX1, KX2
REAL :: ODD

DO CS = 1, 9

   FLV := 0.0
   IF (CS = 2) THEN
      FLV := PIH/4.0
   ENDIF
   IF (CS = 3) THEN
      FLV := -PIH/4.0
   ENDIF
   IF (CS = 4) THEN
      FLV := PIH/2.0
   ENDIF
   IF (CS = 5) THEN
      FLV := -PIH/2.0
   ENDIF
   IF (CS = 6) THEN
      FLV := PIH
   ENDIF
   IF (CS = 7) THEN
      FLV := -PIH
   ENDIF
   IF (CS = 8) THEN
      FLV := PI2
   ENDIF
   IF (CS = 9) THEN
      FLV := -PI2
   ENDIF

   ! --- clear grid, absorber, wall ---
   DO KK = 1, NX*NY
      R(KK) := 0.0
      I(KK) := 0.0
      ABSORB(KK) := 1.0
      WALL(KK) := 1.0
   ENDDO

   ! --- sponge: symmetric on all four edges ---
   DO J = 1, NSP
      SV := 1.0 - 0.35*(1.0 - J/49.0)*(1.0 - J/49.0)
      DO K = 1, NX
         ABSORB(K + (J-1)*NX) := ABSORB(K + (J-1)*NX) * SV
         ABSORB(K + (NY-J)*NX) := ABSORB(K + (NY-J)*NX) * SV
      ENDDO
      DO K = 1, NY
         ABSORB(J + (K-1)*NX) := ABSORB(J + (K-1)*NX) * SV
         ABSORB(NX+1-J + (K-1)*NX) := ABSORB(NX+1-J + (K-1)*NX) * SV
      ENDDO
   ENDDO

   ! --- flux shield: r=8 disk, WALL=0 (Dirichlet pinning) ---
   DO J = 248, 264
      DO K = 248, 264
         DX := K - XC
         DY := J - YC
         IF (DX*DX + DY*DY < 64.0) THEN
            WALL(K + (J-1)*NX) := 0.0
         ENDIF
      ENDDO
   ENDDO

   ! --- Peierls links (stage-2 form, r>6 cutoff) ---
   DO KK = 1, NX*NY
      CXL(KK) := 1.0
      SXL(KK) := 0.0
      CYL(KK) := 1.0
      SYL(KK) := 0.0
   ENDDO
   IF (FLV /= 0.0) THEN
      TH := FLV / PI2
      DO J = 2, NY-1
         DO K = 2, NX-1
            DX := K - XC + 0.5
            DY := J - YC
            R2C := DX*DX + DY*DY
            IF (R2C > 36.0) THEN
               SV := -TH*DY/R2C
               IDX := K + (J-1)*NX
               CXL(IDX) := COS(SV)
               SXL(IDX) := SIN(SV)
            ENDIF
            DX := K - XC
            DY := J - YC + 0.5
            R2C := DX*DX + DY*DY
            IF (R2C > 36.0) THEN
               SV := TH*DX/R2C
               IDX := K + (J-1)*NX
               CYL(IDX) := COS(SV)
               SYL(IDX) := SIN(SV)
            ENDIF
         ENDDO
      ENDDO
   ENDIF

   ! --- two Gaussian packets, rows 204 / 308 ---
   DO J = 1, NY
      DO K = 1, NX
         IDX := K + (J-1)*NX
         SV := EXP(-(((K-X0)/30.0)*((K-X0)/30.0) + ((J-Y1)/SIG)*((J-Y1)/SIG)))
         R(IDX) := SV*COS(K0*(K-X0))
         I(IDX) := SV*SIN(K0*(K-X0))
         SV := EXP(-(((K-X0)/30.0)*((K-X0)/30.0) + ((J-Y2)/SIG)*((J-Y2)/SIG)))
         R(IDX) := R(IDX) + SV*COS(K0*(K-X0))
         I(IDX) := I(IDX) + SV*SIN(K0*(K-X0))
      ENDDO
   ENDDO

   M0 := 0.0
   DO KK = 1, NX*NY
      M0 := M0 + R(KK)*R(KK) + I(KK)*I(KK)
   ENDDO

   ! --- integration + instrument pass ---
   DO T = 1, NSTEPS

      DO K = NX+2, NEND
         I(K) := (I(K) + AA*(CXL(K)*R(K+1) + CXL(K-1)*R(K-1) &
            + CYL(K)*R(K+NX) + CYL(K-NX)*R(K-NX) - 4.0*R(K) &
            - SXL(K)*I(K+1) + SXL(K-1)*I(K-1) &
            - SYL(K)*I(K+NX) + SYL(K-NX)*I(K-NX))) &
            * ABSORB(K) * WALL(K)
      ENDDO
      DO K = NX+2, NEND
         R(K) := (R(K) - AA*(SXL(K)*R(K+1) - SXL(K-1)*R(K-1) &
            + SYL(K)*R(K+NX) - SYL(K-NX)*R(K-NX) &
            + CXL(K)*I(K+1) + CXL(K-1)*I(K-1) &
            + CYL(K)*I(K+NX) + CYL(K-NX)*I(K-NX) - 4.0*I(K))) &
            * ABSORB(K) * WALL(K)
      ENDDO

      ! --- per-channel mass, centroid, kinetic momentum ---
      W1 := 0.0
      WX1 := 0.0
      WY1 := 0.0
      WK1 := 0.0
      W2 := 0.0
      WX2 := 0.0
      WY2 := 0.0
      WK2 := 0.0
      MC := 0.0
      DO J = 2, NY-1
         DO K = 2, NX-1
            IDX := K + (J-1)*NX
            RH := R(IDX)*R(IDX) + I(IDX)*I(IDX)
            MC := MC + RH
            DRX := 0.5*((CXL(IDX)*R(IDX+1) - SXL(IDX)*I(IDX+1)) &
               - (CXL(IDX-1)*R(IDX-1) + SXL(IDX-1)*I(IDX-1)))
            DIX := 0.5*((CXL(IDX)*I(IDX+1) + SXL(IDX)*R(IDX+1)) &
               - (CXL(IDX-1)*I(IDX-1) - SXL(IDX-1)*R(IDX-1)))
            KM := R(IDX)*DIX - I(IDX)*DRX
            IF (J <= 256) THEN
               W1 := W1 + RH
               WX1 := WX1 + RH*K
               WY1 := WY1 + RH*J
               WK1 := WK1 + KM
            ELSE
               W2 := W2 + RH
               WX2 := WX2 + RH*K
               WY2 := WY2 + RH*J
               WK2 := WK2 + KM
            ENDIF
         ENDDO
      ENDDO
      CX1 := WX1/W1
      CY1 := WY1/W1
      KX1 := WK1/W1
      CX2 := WX2/W2
      CY2 := WY2/W2
      KX2 := WK2/W2

      IF (CS = 6) THEN
         IF (MOD(T,400) = 0) THEN
            WRITE(*,"('cs6 t %d cx1 %.2f cx2 %.2f cy1 %.2f cy2 %.2f kx1 %.5f kx2 %.5f mass %.6f')") T, CX1, CX2, CY1, CY2, KX1, KX2, MC/M0
         ENDIF
      ENDIF
      IF (CS = 7) THEN
         IF (MOD(T,400) = 0) THEN
            WRITE(*,"('cs7 t %d cx1 %.2f cx2 %.2f cy1 %.2f cy2 %.2f kx1 %.5f kx2 %.5f mass %.6f')") T, CX1, CX2, CY1, CY2, KX1, KX2, MC/M0
         ENDIF
      ENDIF

   ENDDO

   FT(CS) := FLV
   X1T(CS) := CX1
   X2T(CS) := CX2
   Y1T(CS) := CY1
   Y2T(CS) := CY2
   K1T(CS) := KX1
   K2T(CS) := KX2

   WRITE(*,"('case %d FL %.4f cx1 %.2f cx2 %.2f cy1 %.2f cy2 %.2f kx1 %.5f kx2 %.5f')") CS, FLV, CX1, CX2, CY1, CY2, KX1, KX2

ENDDO

! ---------------- summary tables ----------------

WRITE(*,"('-- displacement table (vs null) --')")
DO CS = 2, 9
   WRITE(*,"('FL %.4f dcx1 %.3f dcx2 %.3f dcy1 %.3f dcy2 %.3f dkx1 %.5f dkx2 %.5f')") FT(CS), X1T(CS)-X1T(1), X2T(CS)-X2T(1), Y1T(CS)-Y1T(1), Y2T(CS)-Y2T(1), K1T(CS)-K1T(1), K2T(CS)-K2T(1)
ENDDO

WRITE(*,"('-- odd check: dcx1(+FL)+dcx1(-FL) --')")
ODD := (X1T(2)-X1T(1)) + (X1T(3)-X1T(1))
WRITE(*,"('pi/4 %.3f')") ODD
ODD := (X1T(4)-X1T(1)) + (X1T(5)-X1T(1))
WRITE(*,"('pi/2 %.3f')") ODD
ODD := (X1T(6)-X1T(1)) + (X1T(7)-X1T(1))
WRITE(*,"('pi %.3f')") ODD
ODD := (X1T(8)-X1T(1)) + (X1T(9)-X1T(1))
WRITE(*,"('2pi %.3f')") ODD

WRITE(*,"('-- channel mirror check: dcx1+dcx2 --')")
DO CS = 2, 9
   WRITE(*,"('FL %.4f sum %.3f')") FT(CS), (X1T(CS)-X1T(1)) + (X2T(CS)-X2T(1))
ENDDO

WRITE(*,"('-- mirror oracles: dcx1 pi/4 -1.0, pi/2 -1.6, pi -1.0, 2pi +0.3 --')")
WRITE(*,"('-- mirror oracles: odd pi/4 -0.03, pi/2 -0.04; mirror sum <0.07 (small FL) --')")
WRITE(*,"('-- mirror oracles: dkx1 pi/4 -0.00237, pi/2 -0.00397 (opposed below) --')")
