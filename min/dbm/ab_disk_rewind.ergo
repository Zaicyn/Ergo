! ════════════════════════════════════════════════════════════════════
! AB_DISK_REWIND — Stage 4d: is the disk a sink? (mirror says NO)
! ════════════════════════════════════════════════════════════════════
! Single packet AIMED at the flux line (row 256, straight over the
! r=8 disk), forward 1600 steps then backward 1600, sponge OFF.
! The two halves of the packet are the two arms, so the ledger still
! books its winding; the mass trajectory is the new readout.
!
! Mirror prediction (C mirror, same sweeps, 2026-08-11) - and it is
! the opposite of what Stage 4c led us to expect:
!
!   The disk is NOT an entropy sink. WALL=0 is not absorption; it is
!   PINNING. Because the zeroing happens at the end of every step at
!   fixed sites, those sites hold exactly 0 at the start of every
!   step - which is a Dirichlet boundary condition, and a Dirichlet
!   boundary is perfectly reversible. The wave scatters around the
!   obstacle; nothing is eaten. The "Tonomura shield" in this rig is
!   a mirror, not a drain.
!
! Oracles (mirror numbers):
!   fwd mass: ~1.0000, dips to ~0.9992 at transit (t~1200), returns
!     to ~0.99997 - the dip is scheme norm drift + scattering
!     redistribution, NOT absorption.
!   rew mass: retraces the forward values EXACTLY in reverse order
!     (0.99977290, 0.99923484, 1.00025218, ...) and returns to
!     1.00000000 at t=1600.
!   deficit: interior ~4e-12 (vs 2.9e-15 for the no-aim case - the
!     scattering event adds rounding, but there is no true loss).
!   ledger (FL=pi): climbs to ~1.91 by t=1600 (single-packet arms
!     wind tighter than the two-packet geometry), rewinds to ~0.04
!     (bookkeeping residual, same class as Stage 4c).
!   centroid: home to 99.0.
!
! If your run confirms: the rig contains NO irreversible dynamics in
! exact arithmetic. The sponge is a gray filter (irreversible only
! through finite-precision contraction, 0.18 dex/step measured in
! Stage 4c); the disk is a mirror (reversible always). The arrow of
! time in this machine lives in the arithmetic, not the physics.
!
!   python -m core min/ab/ab_disk_rewind.ergo -o /tmp/diskrew && /tmp/diskrew
! ════════════════════════════════════════════════════════════════════
IMPLICIT NONE
INTEGER, PARAMETER :: NX = 512, NY = 512
INTEGER, PARAMETER :: NPTS = NX*NY
INTEGER, PARAMETER :: NEND = NPTS - NX - 1
INTEGER, PARAMETER :: NSTEPS = 1600
REAL, PARAMETER :: AA = 0.20
REAL, PARAMETER :: SIG = 14.0
REAL, PARAMETER :: K0 = 0.3
INTEGER, PARAMETER :: X0 = 100
INTEGER, PARAMETER :: YPK = 256
INTEGER, PARAMETER :: XC = 256, YC = 256
REAL, PARAMETER :: PI2 = 6.283185307179586
REAL, PARAMETER :: PIH = 3.14159265358979

STATIC REAL :: R(NPTS), I(NPTS)
STATIC REAL :: R0(NPTS), I0(NPTS)
STATIC REAL :: ABSORB(NPTS), WALL(NPTS), MINV(NPTS)
STATIC REAL :: CXL(NPTS), SXL(NPTS), CYL(NPTS), SYL(NPTS)
REAL :: SV, TH, DX, DY, R2, RH
REAL :: EX1, EY1, EX2, EY2
REAL :: W1, WX1, WY1, W2, WX2, WY2
REAL :: CX1, CY1M, CX2, CY2M
REAL :: PCX1, PCY1, PCX2, PCY2
REAL :: VX1, VY1M, VX2, VY2M
REAL :: PH1, PH2, PHL
REAL :: FLV, MASS0, MASSR, MASSC, DINT, DD
INTEGER :: K, J, T, CS, KK

DO CS = 1, 2
  FLV := 0.0
  IF (CS == 2) THEN
    FLV := PIH
  ENDIF

  DO K = 1, NPTS
    R(K) := 0.0
    I(K) := 0.0
    ABSORB(K) := 1.0
    WALL(K) := 1.0
  ENDDO
  DO J = YC - 8, YC + 8
    DO K = XC - 8, XC + 8
      DX := REAL(K - XC)
      DY := REAL(J - YC)
      IF (DX * DX + DY * DY < 64.0) THEN
        WALL(K + (J - 1) * NX) := 0.0
      ENDIF
    ENDDO
  ENDDO
  DO K = 1, NPTS
    IF (WALL(K) > 0.5) THEN
      MINV(K) := 1.0
    ELSE
      MINV(K) := 0.0
    ENDIF
  ENDDO
  ! link phases
  DO J = 1, NY
    DO K = 1, NX
      CXL(K + (J - 1) * NX) := 1.0
      SXL(K + (J - 1) * NX) := 0.0
      CYL(K + (J - 1) * NX) := 1.0
      SYL(K + (J - 1) * NX) := 0.0
    ENDDO
  ENDDO
  IF (FLV /= 0.0) THEN
    TH := FLV / PI2
    DO J = 2, NY - 1
      DO K = 2, NX - 1
        DX := REAL(K - XC) + 0.5
        DY := REAL(J - YC)
        R2 := DX * DX + DY * DY
        IF (R2 > 36.0) THEN
          SV := (0.0 - TH) * DY / R2
          CXL(K + (J - 1) * NX) := COS(SV)
          SXL(K + (J - 1) * NX) := SIN(SV)
        ENDIF
        DX := REAL(K - XC)
        DY := REAL(J - YC) + 0.5
        R2 := DX * DX + DY * DY
        IF (R2 > 36.0) THEN
          SV := TH * DX / R2
          CYL(K + (J - 1) * NX) := COS(SV)
          SYL(K + (J - 1) * NX) := SIN(SV)
        ENDIF
      ENDDO
    ENDDO
  ENDIF
  ! single aimed packet
  DO J = 1, NY
    DO K = 1, NX
      SV := EXP(0.0 - ((REAL(K - X0) / 30.0) * (REAL(K - X0) / 30.0) &
        + (REAL(J - YPK) / SIG) * (REAL(J - YPK) / SIG)))
      R(K + (J - 1) * NX) := SV * COS(K0 * REAL(K - X0))
      I(K + (J - 1) * NX) := SV * SIN(K0 * REAL(K - X0))
    ENDDO
  ENDDO
  MASS0 := 0.0
  DO K = 1, NPTS
    R0(K) := R(K)
    I0(K) := I(K)
    MASS0 := MASS0 + R(K) * R(K) + I(K) * I(K)
  ENDDO

  PH1 := 0.0
  PH2 := 0.0
  PCX1 := REAL(X0)
  PCY1 := REAL(YPK)
  PCX2 := REAL(X0)
  PCY2 := REAL(YPK)

  ! ─────────────── FORWARD ───────────────
  DO T = 1, NSTEPS
    DO K = NX + 2, NEND
      I(K) := (I(K) + AA * ( &
        CXL(K) * R(K + 1) + CXL(K - 1) * R(K - 1) &
        + CYL(K) * R(K + NX) + CYL(K - NX) * R(K - NX) - 4.0 * R(K) &
        - SXL(K) * I(K + 1) + SXL(K - 1) * I(K - 1) &
        - SYL(K) * I(K + NX) + SYL(K - NX) * I(K - NX))) &
        * WALL(K)
    ENDDO
    DO K = NX + 2, NEND
      R(K) := (R(K) - AA * ( &
        SXL(K) * R(K + 1) - SXL(K - 1) * R(K - 1) &
        + SYL(K) * R(K + NX) - SYL(K - NX) * R(K - NX) &
        + CXL(K) * I(K + 1) + CXL(K - 1) * I(K - 1) &
        + CYL(K) * I(K + NX) + CYL(K - NX) * I(K - NX) - 4.0 * I(K))) &
        * WALL(K)
    ENDDO
    W1 := 0.0
    WX1 := 0.0
    WY1 := 0.0
    EX1 := 0.0
    EY1 := 0.0
    W2 := 0.0
    WX2 := 0.0
    WY2 := 0.0
    EX2 := 0.0
    EY2 := 0.0
    MASSC := 0.0
    DO J = 2, NY - 1
      DO K = 2, NX - 1
        RH := R(K + (J - 1) * NX) * R(K + (J - 1) * NX) &
          + I(K + (J - 1) * NX) * I(K + (J - 1) * NX)
        MASSC := MASSC + RH
        IF (RH > 0.0) THEN
          DX := REAL(XC - K)
          DY := REAL(YC - J)
          R2 := DX * DX + DY * DY
          IF (R2 > 64.0) THEN
            IF (J <= YC) THEN
              W1 := W1 + RH
              WX1 := WX1 + RH * REAL(K)
              WY1 := WY1 + RH * REAL(J)
              EX1 := EX1 + RH * DX / R2
              EY1 := EY1 + RH * DY / R2
            ELSE
              W2 := W2 + RH
              WX2 := WX2 + RH * REAL(K)
              WY2 := WY2 + RH * REAL(J)
              EX2 := EX2 + RH * DX / R2
              EY2 := EY2 + RH * DY / R2
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDDO
    IF (W1 > 1.0E-20) THEN
      CX1 := WX1 / W1
      CY1M := WY1 / W1
      VX1 := CX1 - PCX1
      VY1M := CY1M - PCY1
      PCX1 := CX1
      PCY1 := CY1M
      PH1 := PH1 + FLV * (VX1 * EY1 - VY1M * EX1) / (PI2 * W1)
    ENDIF
    IF (W2 > 1.0E-20) THEN
      CX2 := WX2 / W2
      CY2M := WY2 / W2
      VX2 := CX2 - PCX2
      VY2M := CY2M - PCY2
      PCX2 := CX2
      PCY2 := CY2M
      PH2 := PH2 + FLV * (VX2 * EY2 - VY2M * EX2) / (PI2 * W2)
    ENDIF
    PHL := PH1 - PH2
    SV := REAL(T - 200 * (T / 200))
    IF (SV < 0.5) THEN
      WRITE(*, "fwd cs %d t %d cx1 %.1f ledger %.8f mass %.8f") &
        CS, T, CX1, PHL, MASSC / MASS0
    ENDIF
  ENDDO
  WRITE(*, "fwd cs %d end cx1 %.2f ledger %.8f mass %.8f") &
    CS, CX1, PHL, MASSC / MASS0

  ! ─────────────── REWIND ───────────────
  DO T = 1, NSTEPS
    DO KK = NX + 2, NEND
      K := NX + 2 + NEND - KK
      R(K) := (R(K) * MINV(K) + AA * ( &
        SXL(K) * R(K + 1) - SXL(K - 1) * R(K - 1) &
        + SYL(K) * R(K + NX) - SYL(K - NX) * R(K - NX) &
        + CXL(K) * I(K + 1) + CXL(K - 1) * I(K - 1) &
        + CYL(K) * I(K + NX) + CYL(K - NX) * I(K - NX) - 4.0 * I(K))) &
        * WALL(K)
    ENDDO
    DO KK = NX + 2, NEND
      K := NX + 2 + NEND - KK
      I(K) := (I(K) * MINV(K) - AA * ( &
        CXL(K) * R(K + 1) + CXL(K - 1) * R(K - 1) &
        + CYL(K) * R(K + NX) + CYL(K - NX) * R(K - NX) - 4.0 * R(K) &
        - SXL(K) * I(K + 1) + SXL(K - 1) * I(K - 1) &
        - SYL(K) * I(K + NX) + SYL(K - NX) * I(K - NX))) &
        * WALL(K)
    ENDDO
    W1 := 0.0
    WX1 := 0.0
    WY1 := 0.0
    EX1 := 0.0
    EY1 := 0.0
    W2 := 0.0
    WX2 := 0.0
    WY2 := 0.0
    EX2 := 0.0
    EY2 := 0.0
    MASSC := 0.0
    DO J = 2, NY - 1
      DO K = 2, NX - 1
        RH := R(K + (J - 1) * NX) * R(K + (J - 1) * NX) &
          + I(K + (J - 1) * NX) * I(K + (J - 1) * NX)
        MASSC := MASSC + RH
        IF (RH > 0.0) THEN
          DX := REAL(XC - K)
          DY := REAL(YC - J)
          R2 := DX * DX + DY * DY
          IF (R2 > 64.0) THEN
            IF (J <= YC) THEN
              W1 := W1 + RH
              WX1 := WX1 + RH * REAL(K)
              WY1 := WY1 + RH * REAL(J)
              EX1 := EX1 + RH * DX / R2
              EY1 := EY1 + RH * DY / R2
            ELSE
              W2 := W2 + RH
              WX2 := WX2 + RH * REAL(K)
              WY2 := WY2 + RH * REAL(J)
              EX2 := EX2 + RH * DX / R2
              EY2 := EY2 + RH * DY / R2
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDDO
    IF (W1 > 1.0E-20) THEN
      CX1 := WX1 / W1
      CY1M := WY1 / W1
      VX1 := CX1 - PCX1
      VY1M := CY1M - PCY1
      PCX1 := CX1
      PCY1 := CY1M
      PH1 := PH1 + FLV * (VX1 * EY1 - VY1M * EX1) / (PI2 * W1)
    ENDIF
    IF (W2 > 1.0E-20) THEN
      CX2 := WX2 / W2
      CY2M := WY2 / W2
      VX2 := CX2 - PCX2
      VY2M := CY2M - PCY2
      PCX2 := CX2
      PCY2 := CY2M
      PH2 := PH2 + FLV * (VX2 * EY2 - VY2M * EX2) / (PI2 * W2)
    ENDIF
    PHL := PH1 - PH2
    SV := REAL(T - 200 * (T / 200))
    IF (SV < 0.5) THEN
      WRITE(*, "rew cs %d t %d cx1 %.1f ledger %.8f mass %.8f") &
        CS, T, CX1, PHL, MASSC / MASS0
    ENDIF
  ENDDO

  ! ─────────────── DEFICIT AUDIT ───────────────
  DINT := 0.0
  MASSR := 0.0
  DO K = 1, NPTS
    DD := ABS(R(K) - R0(K)) + ABS(I(K) - I0(K))
    IF (WALL(K) > 0.5) THEN
      IF (DD > DINT) THEN
        DINT := DD
      ENDIF
    ENDIF
    MASSR := MASSR + R(K) * R(K) + I(K) * I(K)
  ENDDO
  WRITE(*, "case %d  FL %.4f  ledger_end %.8f  mass %.8f") &
    CS, FLV, PHL, MASSR / MASS0
  WRITE(*, "  deficit: interior %.3e  (mirror oracle ~4e-12)") DINT
ENDDO

WRITE(*, "-- disk-rewind summary (mirror oracles) --------------")
WRITE(*, "fwd mass dips to ~0.9992 at transit, NOT absorbed; rew")
WRITE(*, "mass retraces forward values exactly, ends 1.00000000.")
WRITE(*, "deficit ~4e-12: scattering rounding, no true loss.")
WRITE(*, "the disk is a Dirichlet boundary (pinned sites) = a")
WRITE(*, "mirror, not a sink. nothing on this grid eats info; the")
WRITE(*, "only entropy in the rig is sponge roundoff (4c: x1.5/step).")
