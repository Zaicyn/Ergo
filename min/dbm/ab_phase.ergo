! ════════════════════════════════════════════════════════════════════
! AB_PI_LEDGER — AB campaign Stage 4: the field-momentum ledger
! ════════════════════════════════════════════════════════════════════
! Stage-2 engine (identical update order, link layout, sponge, disk)
! plus three extra readouts per timestep, testing the Kang/Vaidman/
! Pearle-Rizzi claim that the AB phase can be booked LOCALLY as the
! momentum stored in the overlap of the electron's E-field with the
! confined flux:
!
!   Pi = (1/4 pi c) INT E_q x B_flux dtau     (Kang 1408.0607)
!   L_int = v . Pi                            (local interaction)
!
! In 2+1D with B = FL delta^2 zhat and the 2D Coulomb law E = rhat/r,
! Pi is POINTWISE PROPORTIONAL to A: with the normalization
!   Pi_sim = FL * (EY, -EX) / (2 pi)
! the accumulator SUM v.Pi_sim dt is analytically equal to the Peierls
! rate rho A.v per charge element. So the two ledgers MUST balance
! entry by entry; any residual is the time-stepping/dispersion artifact
! budget. Nobody has computed this ledger numerically before — the
! equivalence has only ever been shown by integrating by parts on
! paper.
!
! Readouts per case:
!   1. LEDGER: PH1/PH2 = per-channel accumulated v.Pi_sim, relative
!      PHL = PH1 - PH2. For a full pass each channel books +-FL/2, so
!      PHL -> FL. Finite x-window (packet 100..360 vs flux 256) books
!      ~85% of FL; the ratio PHL/FL must be THE SAME for all cases.
!   2. PROBE: wrapped-atan2 phase-rate integration of the field at
!      (XPR,Y1) vs (XPR,Y2) — an independent in-sim phase measurement
!      (dynamical phase is common-mode by symmetry and cancels).
!   3. PHASOR: the usual period-40 screen phasor (anchors to the
!      known AB phase: steps of FLV, mod 2pi).
!
! THE 2pi DISCRIMINATOR: the screen only ever sees phase mod 2pi, but
! the ledger is the UNWRAPPED winding. Case 4 (FL=2pi) must show
! phasor ~ 0 and ledger ~ 0.85 * 6.283. If the ledger also returned
! ~0, the local bookkeeping would be suspect; if it returns the full
! winding, the phase was accrued along the path and merely hidden at
! the screen — the "where does the phase go" answer, in numbers.
!
! Cases: CS=1 FL=0 (null), CS=2 FL=pi/2, CS=3 FL=pi (time series
! printed in full), CS=4 FL=2pi (winding discriminator).
!
! Expected:
!   case 1: everything ~0
!   case 2: phasor 1.571, ledger ~1.34, probe ~ ledger
!   case 3: phasor 3.142 (mod), ledger ~2.67, probe ~ ledger
!   case 4: phasor ~0,   ledger ~5.34, probe ~ ledger
!   ledger/FL ratio constant across cases 2..4 (same profile, scaled)
!
! Note: channel split is by row y=256; late-time packet spreading
! (sigma_y ~ 30-40 at transit) contaminates the split a few percent —
! that is the known artifact, visible as probe/ledger drift after
! T~1700. Accumulation during transit (T ~ 600-1400) is the clean
! window.
!
! Runtime ~2.5x ab_fluxline (one extra N^2 pass per step with two
! divisions). Deterministic: no RNG, double-run byte-identical.
!
!   python -m core min/ab/ab_pi_ledger.ergo -o /tmp/piled && /tmp/piled
! ════════════════════════════════════════════════════════════════════
IMPLICIT NONE
INTEGER, PARAMETER :: NX = 512, NY = 512
INTEGER, PARAMETER :: NPTS = NX*NY
INTEGER, PARAMETER :: NEND = NPTS - NX - 1
INTEGER, PARAMETER :: NSTEPS = 2200
INTEGER, PARAMETER :: NSP = 48
REAL, PARAMETER :: AA = 0.20
REAL, PARAMETER :: SIG = 14.0
REAL, PARAMETER :: K0 = 0.3
INTEGER, PARAMETER :: X0 = 100
INTEGER, PARAMETER :: Y1 = 204, Y2 = 308
INTEGER, PARAMETER :: XSCR = 350
INTEGER, PARAMETER :: XC = 256, YC = 256
INTEGER, PARAMETER :: XPR = 300
REAL, PARAMETER :: PI2 = 6.283185307179586
REAL, PARAMETER :: PIH = 3.14159265358979

STATIC REAL :: R(NPTS), I(NPTS)
STATIC REAL :: ABSORB(NPTS), WALL(NPTS)
STATIC REAL :: CXL(NPTS), SXL(NPTS), CYL(NPTS), SYL(NPTS)
STATIC REAL :: SCR(NY)
REAL :: PTAB(4), LTAB(4), RTAB(4)
REAL :: SV, FR, FI, TH, DX, DY, R2, RH
REAL :: EX1, EY1, EX2, EY2, EMAG
REAL :: W1, WX1, WY1, W2, WX2, WY2
REAL :: CX1, CY1M, CX2, CY2M
REAL :: PCX1, PCY1, PCX2, PCY2
REAL :: VX1, VY1M, VX2, VY2M
REAL :: PH1, PH2, PHL
REAL :: PRA, PRB, PRL, NPA, NPB, OPA, OPB, DPH, AMPA, AMPB
REAL :: FLV, PHS
INTEGER :: K, J, T, CS, KA, KB

KA := XPR + (Y1 - 1) * NX
KB := XPR + (Y2 - 1) * NX

DO CS = 1, 4
  FLV := 0.0
  IF (CS == 2) THEN
    FLV := PIH / 2.0
  ENDIF
  IF (CS == 3) THEN
    FLV := PIH
  ENDIF
  IF (CS == 4) THEN
    FLV := PI2
  ENDIF

  DO K = 1, NPTS
    R(K) := 0.0
    I(K) := 0.0
    ABSORB(K) := 1.0
    WALL(K) := 1.0
  ENDDO
  DO J = 1, NY
    SCR(J) := 0.0
  ENDDO
  DO J = 1, NSP
    SV := 1.0 - 0.35 * (1.0 - REAL(J) / REAL(NSP + 1)) * &
      (1.0 - REAL(J) / REAL(NSP + 1))
    DO K = 1, NX
      ABSORB(K + (J - 1) * NX) := ABSORB(K + (J - 1) * NX) * SV
      ABSORB(K + (NY - J) * NX) := ABSORB(K + (NY - J) * NX) * SV
    ENDDO
    DO K = 1, NY
      ABSORB(J + (K - 1) * NX) := ABSORB(J + (K - 1) * NX) * SV
      ABSORB(NX - J + 1 + (K - 1) * NX) := &
        ABSORB(NX - J + 1 + (K - 1) * NX) * SV
    ENDDO
  ENDDO
  ! absorbing disk at the flux line (Tonomura shield)
  DO J = YC - 8, YC + 8
    DO K = XC - 8, XC + 8
      DX := REAL(K - XC)
      DY := REAL(J - YC)
      IF (DX * DX + DY * DY < 64.0) THEN
        WALL(K + (J - 1) * NX) := 0.0
      ENDIF
    ENDDO
  ENDDO
  ! link phases (identity default; flux line A_phi = FLV/(2 pi r))
  DO J = 1, NY
    DO K = 1, NX
      CXL(K + (J - 1) * NX) := 1.0
      SXL(K + (J - 1) * NX) := 0.0
      CYL(K + (J - 1) * NX) := 1.0
      SYL(K + (J - 1) * NX) := 0.0
    ENDDO
  ENDDO
  IF (FLV > 0.0) THEN
    TH := FLV / PI2
    DO J = 2, NY - 1
      DO K = 2, NX - 1
        DX := REAL(K - XC) + 0.5
        DY := REAL(J - YC)
        R2 := DX * DX + DY * DY
        IF (R2 > 36.0) THEN
          SV := (0.0 - TH) * DY / R2
          CXL(K + (J - 1) * NX) := COS(SV)
          SXL(K + (J - 1) * NX) := SIN(SV)
        ENDIF
        DX := REAL(K - XC)
        DY := REAL(J - YC) + 0.5
        R2 := DX * DX + DY * DY
        IF (R2 > 36.0) THEN
          SV := TH * DX / R2
          CYL(K + (J - 1) * NX) := COS(SV)
          SYL(K + (J - 1) * NX) := SIN(SV)
        ENDIF
      ENDDO
    ENDDO
  ENDIF
  ! packets
  DO J = 1, NY
    DO K = 1, NX
      SV := EXP(0.0 - ((REAL(K - X0) / 30.0) * (REAL(K - X0) / 30.0) &
        + (REAL(J - Y1) / SIG) * (REAL(J - Y1) / SIG)))
      R(K + (J - 1) * NX) := SV * COS(K0 * REAL(K - X0))
      I(K + (J - 1) * NX) := SV * SIN(K0 * REAL(K - X0))
      SV := EXP(0.0 - ((REAL(K - X0) / 30.0) * (REAL(K - X0) / 30.0) &
        + (REAL(J - Y2) / SIG) * (REAL(J - Y2) / SIG)))
      R(K + (J - 1) * NX) := R(K + (J - 1) * NX) &
        + SV * COS(K0 * REAL(K - X0))
      I(K + (J - 1) * NX) := I(K + (J - 1) * NX) &
        + SV * SIN(K0 * REAL(K - X0))
    ENDDO
  ENDDO

  PH1 := 0.0
  PH2 := 0.0
  PRA := 0.0
  PRB := 0.0
  OPA := 0.0
  OPB := 0.0
  PCX1 := REAL(X0)
  PCY1 := REAL(Y1)
  PCX2 := REAL(X0)
  PCY2 := REAL(Y2)

  DO T = 1, NSTEPS
    DO K = NX + 2, NEND
      I(K) := (I(K) + AA * ( &
        CXL(K) * R(K + 1) + CXL(K - 1) * R(K - 1) &
        + CYL(K) * R(K + NX) + CYL(K - NX) * R(K - NX) - 4.0 * R(K) &
        - SXL(K) * I(K + 1) + SXL(K - 1) * I(K - 1) &
        - SYL(K) * I(K + NX) + SYL(K - NX) * I(K - NX))) &
        * ABSORB(K) * WALL(K)
    ENDDO
    DO K = NX + 2, NEND
      R(K) := (R(K) - AA * ( &
        SXL(K) * R(K + 1) - SXL(K - 1) * R(K - 1) &
        + SYL(K) * R(K + NX) - SYL(K - NX) * R(K - NX) &
        + CXL(K) * I(K + 1) + CXL(K - 1) * I(K - 1) &
        + CYL(K) * I(K + NX) + CYL(K - NX) * I(K - NX) - 4.0 * I(K))) &
        * ABSORB(K) * WALL(K)
    ENDDO

    ! ── ledger pass: per-channel mass, centroid, and the electron
    !    E-field at the flux core (2D Coulomb, E = rhat/r, q = 1) ──
    W1 := 0.0
    WX1 := 0.0
    WY1 := 0.0
    EX1 := 0.0
    EY1 := 0.0
    W2 := 0.0
    WX2 := 0.0
    WY2 := 0.0
    EX2 := 0.0
    EY2 := 0.0
    DO J = 2, NY - 1
      DO K = 2, NX - 1
        RH := R(K + (J - 1) * NX) * R(K + (J - 1) * NX) &
          + I(K + (J - 1) * NX) * I(K + (J - 1) * NX)
        IF (RH > 0.0) THEN
          DX := REAL(XC - K)
          DY := REAL(YC - J)
          R2 := DX * DX + DY * DY
          IF (R2 > 64.0) THEN
            IF (J <= YC) THEN
              W1 := W1 + RH
              WX1 := WX1 + RH * REAL(K)
              WY1 := WY1 + RH * REAL(J)
              EX1 := EX1 + RH * DX / R2
              EY1 := EY1 + RH * DY / R2
            ELSE
              W2 := W2 + RH
              WX2 := WX2 + RH * REAL(K)
              WY2 := WY2 + RH * REAL(J)
              EX2 := EX2 + RH * DX / R2
              EY2 := EY2 + RH * DY / R2
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDDO
    IF (W1 > 1.0E-20) THEN
      CX1 := WX1 / W1
      CY1M := WY1 / W1
      VX1 := CX1 - PCX1
      VY1M := CY1M - PCY1
      PCX1 := CX1
      PCY1 := CY1M
      PH1 := PH1 + FLV * (VX1 * EY1 - VY1M * EX1) / PI2
    ENDIF
    IF (W2 > 1.0E-20) THEN
      CX2 := WX2 / W2
      CY2M := WY2 / W2
      VX2 := CX2 - PCX2
      VY2M := CY2M - PCY2
      PCX2 := CX2
      PCY2 := CY2M
      PH2 := PH2 + FLV * (VX2 * EY2 - VY2M * EX2) / PI2
    ENDIF
    PHL := PH1 - PH2

    ! ── probe phase integration (wrapped atan2 increments) ──
    AMPA := R(KA) * R(KA) + I(KA) * I(KA)
    AMPB := R(KB) * R(KB) + I(KB) * I(KB)
    NPA := ATAN2(I(KA), R(KA))
    NPB := ATAN2(I(KB), R(KB))
    IF (AMPA > 1.0E-10) THEN
      DPH := NPA - OPA
      IF (DPH > PIH) THEN
        DPH := DPH - PI2
      ENDIF
      IF (DPH < 0.0 - PIH) THEN
        DPH := DPH + PI2
      ENDIF
      PRA := PRA + DPH
      OPA := NPA
    ENDIF
    IF (AMPB > 1.0E-10) THEN
      DPH := NPB - OPB
      IF (DPH > PIH) THEN
        DPH := DPH - PI2
      ENDIF
      IF (DPH < 0.0 - PIH) THEN
        DPH := DPH + PI2
      ENDIF
      PRB := PRB + DPH
      OPB := NPB
    ENDIF
    PRL := PRA - PRB

    IF (T > 1500) THEN
      DO J = 120, 392
        K := XSCR + (J - 1) * NX
        SCR(J) := SCR(J) + R(K) * R(K) + I(K) * I(K)
      ENDDO
    ENDIF

    ! time series: coarse every 100, fine window around closest
    ! approach for the FL=pi case
    SV := REAL(T - 100 * (T / 100))
    IF (SV < 0.5) THEN
      EMAG := SQRT((EX1 + EX2) * (EX1 + EX2) &
        + (EY1 + EY2) * (EY1 + EY2))
      WRITE(*, "cs %d t %d cx1 %.1f ledger %.5f probe %.5f &
        &ecore %.3e") CS, T, CX1, PHL, PRL, EMAG
    ENDIF
    IF (CS == 3) THEN
      IF (T >= 1000) THEN
        IF (T <= 1600) THEN
          SV := REAL(T - 25 * (T / 25))
          IF (SV < 0.5) THEN
            WRITE(*, "  fine t %d cx1 %.2f vx1 %.5f dled %.5f &
              &led %.5f prb %.5f") T, CX1, VX1, &
              FLV * (VX1 * EY1 - VY1M * EX1) / PI2, PHL, PRL
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDDO

  ! screen phasor (period-40 reference)
  FR := 0.0
  FI := 0.0
  DO J = 170, 342
    TH := 6.283185307179586 * REAL(J - 256) / 40.0
    FR := FR + SCR(J) * COS(TH)
    FI := FI + SCR(J) * SIN(TH)
  ENDDO
  PHS := ATAN2(FI, FR)
  PTAB(CS) := PHS
  LTAB(CS) := PHL
  RTAB(CS) := PRL
  WRITE(*, "case %d  FL %.4f  phasor %.5f  ledger %.5f  probe %.5f") &
    CS, FLV, PHS, PHL, PRL
ENDDO

WRITE(*, "── ledger summary ─────────────────────────────")
DO CS = 1, 4
  FLV := 0.0
  IF (CS == 2) THEN
    FLV := PIH / 2.0
  ENDIF
  IF (CS == 3) THEN
    FLV := PIH
  ENDIF
  IF (CS == 4) THEN
    FLV := PI2
  ENDIF
  IF (FLV > 0.01) THEN
    WRITE(*, "FL %.4f  phasor %.5f  ledger %.5f  probe %.5f  &
      &led/FL %.4f  prb/led %.4f") FLV, PTAB(CS), LTAB(CS), &
      RTAB(CS), LTAB(CS) / FLV, RTAB(CS) / LTAB(CS)
  ELSE
    WRITE(*, "FL 0.0000  phasor %.5f  ledger %.5f  probe %.5f &
      &(null: all ~0)") PTAB(CS), LTAB(CS), RTAB(CS)
  ENDIF
ENDDO
WRITE(*, "expect: phasor = FL mod 2pi; ledger ~0.85*FL (finite")
WRITE(*, "window, ratio constant); case 4 ledger ~5.3 vs phasor ~0")
