! ════════════════════════════════════════════════════════════════════
! AB_TIME_REWIND v2 — Stage 4c: engine reversal / arrow-of-time audit
! ════════════════════════════════════════════════════════════════════
! Runs the Stage-2 engine FORWARD 1200 steps, then BACKWARD 1200
! steps from the final state, and audits what comes back. Three cases:
!
!   CS=1  FL=0,  sponge OFF  (reversibility control)
!   CS=2  FL=pi, sponge OFF  (does flux touch reversibility?)
!   CS=3  FL=pi, sponge ON   (death watch: the sponge's entropy rate)
!
! Findings already established by the C mirror (2026-08-11, same
! sweeps, flattened indexing, in-place GS order):
!
!   SPONGE OFF: the rewind is EXACT. Field deficit vs the initial
!   state = 2.3e-15 (machine epsilon accumulated over 2400 sweeps),
!   mass = 1.00000000, centroid returns to 99.0, ledger retraces
!   0.9387 -> -0.00025. The staggered leapfrog is perfectly
!   reversible, and FLUX DOES NOT TOUCH THIS - the deficit is the
!   same class with and without pi of flux. (The ledger's 2.5e-4
!   residual is its own finite-difference velocity bookkeeping, not
!   field error: the FIELD deficit is 1e-15.)
!
!   SPONGE ON: the rewind DIES at t ~ 202, and the autopsy is the
!   point: at t=100 the sponge region carries rmax 2.1e-2 while the
!   interior is clean at 0.54; 100 steps later the sponge dust hits
!   4e29 and floods the interior. Growth ~ x1.5/step = exactly
!   1/0.664, the deepest sponge attenuation inverted. The sponge is a
!   contraction forward (x0.66/step), so its inverse is an amplifier,
!   and amplification of roundoff dust (1e-16) reaches 1e30 in ~200
!   steps. In EXACT arithmetic the sponge is invertible (division);
!   in finite precision it is an entropy source with a measured rate
!   of ~0.18 decades/step at the deepest layer, seeded at the grid
!   EDGES and eating inward. Contraction below the noise floor IS
!   irreversibility - that is the arrow of time in this rig, located
!   in the absorber, not the dynamics.
!
! v1 of this file ran 2200 steps with the sponge on in all cases and
! NaN'd at rew t~400-600; the mirror showed the explosion is sponge
! dust, not an inversion bug (sponge-off rewind is exact to 2.3e-15).
!
! Oracle table:
!   CS=1: ledger -> |PHL| < 1e-3, deficit ~1e-15, mass 1.00000000
!   CS=2: same class (flux changes nothing)
!   CS=3: "rewind died" between t=150 and t=250, sponge rmax leading
!         interior by ~2+ orders of magnitude before death
!
! Dialect: descending sweeps via ascending-index remap (negative-step
! DO is an open IR-path item); MINV precomputed; WALL multiply in the
! backward sweeps keeps the disk zeroed both ways; single-line
! format strings; no negative **.
!
!   python -m core min/ab/ab_time_rewind.ergo -o /tmp/rewind && /tmp/rewind
! ════════════════════════════════════════════════════════════════════
IMPLICIT NONE
INTEGER, PARAMETER :: NX = 512, NY = 512
INTEGER, PARAMETER :: NPTS = NX*NY
INTEGER, PARAMETER :: NEND = NPTS - NX - 1
INTEGER, PARAMETER :: NSTEPS = 1200
INTEGER, PARAMETER :: NSP = 48
REAL, PARAMETER :: AA = 0.20
REAL, PARAMETER :: SIG = 14.0
REAL, PARAMETER :: K0 = 0.3
INTEGER, PARAMETER :: X0 = 100
INTEGER, PARAMETER :: Y1 = 204, Y2 = 308
INTEGER, PARAMETER :: XC = 256, YC = 256
REAL, PARAMETER :: PI2 = 6.283185307179586
REAL, PARAMETER :: PIH = 3.14159265358979

STATIC REAL :: R(NPTS), I(NPTS)
STATIC REAL :: R0(NPTS), I0(NPTS)
STATIC REAL :: ABSORB(NPTS), WALL(NPTS), MINV(NPTS)
STATIC REAL :: CXL(NPTS), SXL(NPTS), CYL(NPTS), SYL(NPTS)
REAL :: SV, TH, DX, DY, R2, RH
REAL :: EX1, EY1, EX2, EY2
REAL :: W1, WX1, WY1, W2, WX2, WY2
REAL :: CX1, CY1M, CX2, CY2M
REAL :: PCX1, PCY1, PCX2, PCY2
REAL :: VX1, VY1M, VX2, VY2M
REAL :: PH1, PH2, PHL
REAL :: FLV, MASS0, MASSR, DINT, DSPN, DD, RMX, RMI, RMS, RA
INTEGER :: K, J, T, CS, KK, SPO, DIED, TPR

DO CS = 1, 3
  FLV := 0.0
  SPO := 0
  IF (CS >= 2) THEN
    FLV := PIH
  ENDIF
  IF (CS == 3) THEN
    SPO := 1
  ENDIF

  DO K = 1, NPTS
    R(K) := 0.0
    I(K) := 0.0
    ABSORB(K) := 1.0
    WALL(K) := 1.0
  ENDDO
  IF (SPO == 1) THEN
    DO J = 1, NSP
      SV := 1.0 - 0.35 * (1.0 - REAL(J) / REAL(NSP + 1)) * &
        (1.0 - REAL(J) / REAL(NSP + 1))
      DO K = 1, NX
        ABSORB(K + (J - 1) * NX) := ABSORB(K + (J - 1) * NX) * SV
        ABSORB(K + (NY - J) * NX) := ABSORB(K + (NY - J) * NX) * SV
      ENDDO
      DO K = 1, NY
        ABSORB(J + (K - 1) * NX) := ABSORB(J + (K - 1) * NX) * SV
        ABSORB(NX - J + 1 + (K - 1) * NX) := &
          ABSORB(NX - J + 1 + (K - 1) * NX) * SV
      ENDDO
    ENDDO
  ENDIF
  DO J = YC - 8, YC + 8
    DO K = XC - 8, XC + 8
      DX := REAL(K - XC)
      DY := REAL(J - YC)
      IF (DX * DX + DY * DY < 64.0) THEN
        WALL(K + (J - 1) * NX) := 0.0
      ENDIF
    ENDDO
  ENDDO
  DO K = 1, NPTS
    IF (WALL(K) > 0.5) THEN
      MINV(K) := 1.0 / ABSORB(K)
    ELSE
      MINV(K) := 0.0
    ENDIF
  ENDDO
  ! link phases
  DO J = 1, NY
    DO K = 1, NX
      CXL(K + (J - 1) * NX) := 1.0
      SXL(K + (J - 1) * NX) := 0.0
      CYL(K + (J - 1) * NX) := 1.0
      SYL(K + (J - 1) * NX) := 0.0
    ENDDO
  ENDDO
  IF (FLV /= 0.0) THEN
    TH := FLV / PI2
    DO J = 2, NY - 1
      DO K = 2, NX - 1
        DX := REAL(K - XC) + 0.5
        DY := REAL(J - YC)
        R2 := DX * DX + DY * DY
        IF (R2 > 36.0) THEN
          SV := (0.0 - TH) * DY / R2
          CXL(K + (J - 1) * NX) := COS(SV)
          SXL(K + (J - 1) * NX) := SIN(SV)
        ENDIF
        DX := REAL(K - XC)
        DY := REAL(J - YC) + 0.5
        R2 := DX * DX + DY * DY
        IF (R2 > 36.0) THEN
          SV := TH * DX / R2
          CYL(K + (J - 1) * NX) := COS(SV)
          SYL(K + (J - 1) * NX) := SIN(SV)
        ENDIF
      ENDDO
    ENDDO
  ENDIF
  ! packets
  DO J = 1, NY
    DO K = 1, NX
      SV := EXP(0.0 - ((REAL(K - X0) / 30.0) * (REAL(K - X0) / 30.0) &
        + (REAL(J - Y1) / SIG) * (REAL(J - Y1) / SIG)))
      R(K + (J - 1) * NX) := SV * COS(K0 * REAL(K - X0))
      I(K + (J - 1) * NX) := SV * SIN(K0 * REAL(K - X0))
      SV := EXP(0.0 - ((REAL(K - X0) / 30.0) * (REAL(K - X0) / 30.0) &
        + (REAL(J - Y2) / SIG) * (REAL(J - Y2) / SIG)))
      R(K + (J - 1) * NX) := R(K + (J - 1) * NX) &
        + SV * COS(K0 * REAL(K - X0))
      I(K + (J - 1) * NX) := I(K + (J - 1) * NX) &
        + SV * SIN(K0 * REAL(K - X0))
    ENDDO
  ENDDO
  MASS0 := 0.0
  DO K = 1, NPTS
    R0(K) := R(K)
    I0(K) := I(K)
    MASS0 := MASS0 + R(K) * R(K) + I(K) * I(K)
  ENDDO

  PH1 := 0.0
  PH2 := 0.0
  PCX1 := REAL(X0)
  PCY1 := REAL(Y1)
  PCX2 := REAL(X0)
  PCY2 := REAL(Y2)

  ! ─────────────── FORWARD ───────────────
  DO T = 1, NSTEPS
    DO K = NX + 2, NEND
      I(K) := (I(K) + AA * ( &
        CXL(K) * R(K + 1) + CXL(K - 1) * R(K - 1) &
        + CYL(K) * R(K + NX) + CYL(K - NX) * R(K - NX) - 4.0 * R(K) &
        - SXL(K) * I(K + 1) + SXL(K - 1) * I(K - 1) &
        - SYL(K) * I(K + NX) + SYL(K - NX) * I(K - NX))) &
        * ABSORB(K) * WALL(K)
    ENDDO
    DO K = NX + 2, NEND
      R(K) := (R(K) - AA * ( &
        SXL(K) * R(K + 1) - SXL(K - 1) * R(K - 1) &
        + SYL(K) * R(K + NX) - SYL(K - NX) * R(K - NX) &
        + CXL(K) * I(K + 1) + CXL(K - 1) * I(K - 1) &
        + CYL(K) * I(K + NX) + CYL(K - NX) * I(K - NX) - 4.0 * I(K))) &
        * ABSORB(K) * WALL(K)
    ENDDO
    W1 := 0.0
    WX1 := 0.0
    WY1 := 0.0
    EX1 := 0.0
    EY1 := 0.0
    W2 := 0.0
    WX2 := 0.0
    WY2 := 0.0
    EX2 := 0.0
    EY2 := 0.0
    DO J = 2, NY - 1
      DO K = 2, NX - 1
        RH := R(K + (J - 1) * NX) * R(K + (J - 1) * NX) &
          + I(K + (J - 1) * NX) * I(K + (J - 1) * NX)
        IF (RH > 0.0) THEN
          DX := REAL(XC - K)
          DY := REAL(YC - J)
          R2 := DX * DX + DY * DY
          IF (R2 > 64.0) THEN
            IF (J <= YC) THEN
              W1 := W1 + RH
              WX1 := WX1 + RH * REAL(K)
              WY1 := WY1 + RH * REAL(J)
              EX1 := EX1 + RH * DX / R2
              EY1 := EY1 + RH * DY / R2
            ELSE
              W2 := W2 + RH
              WX2 := WX2 + RH * REAL(K)
              WY2 := WY2 + RH * REAL(J)
              EX2 := EX2 + RH * DX / R2
              EY2 := EY2 + RH * DY / R2
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDDO
    IF (W1 > 1.0E-20) THEN
      CX1 := WX1 / W1
      CY1M := WY1 / W1
      VX1 := CX1 - PCX1
      VY1M := CY1M - PCY1
      PCX1 := CX1
      PCY1 := CY1M
      PH1 := PH1 + FLV * (VX1 * EY1 - VY1M * EX1) / (PI2 * W1)
    ENDIF
    IF (W2 > 1.0E-20) THEN
      CX2 := WX2 / W2
      CY2M := WY2 / W2
      VX2 := CX2 - PCX2
      VY2M := CY2M - PCY2
      PCX2 := CX2
      PCY2 := CY2M
      PH2 := PH2 + FLV * (VX2 * EY2 - VY2M * EX2) / (PI2 * W2)
    ENDIF
    PHL := PH1 - PH2
    SV := REAL(T - 400 * (T / 400))
    IF (SV < 0.5) THEN
      WRITE(*, "fwd cs %d t %d cx1 %.1f ledger %.8f") CS, T, CX1, PHL
    ENDIF
  ENDDO
  WRITE(*, "fwd cs %d end cx1 %.2f ledger %.8f") CS, CX1, PHL

  ! ─────────────── REWIND ───────────────
  DIED := 0
  DO T = 1, NSTEPS
    DO KK = NX + 2, NEND
      K := NX + 2 + NEND - KK
      R(K) := (R(K) * MINV(K) + AA * ( &
        SXL(K) * R(K + 1) - SXL(K - 1) * R(K - 1) &
        + SYL(K) * R(K + NX) - SYL(K - NX) * R(K - NX) &
        + CXL(K) * I(K + 1) + CXL(K - 1) * I(K - 1) &
        + CYL(K) * I(K + NX) + CYL(K - NX) * I(K - NX) - 4.0 * I(K))) &
        * WALL(K)
    ENDDO
    DO KK = NX + 2, NEND
      K := NX + 2 + NEND - KK
      I(K) := (I(K) * MINV(K) - AA * ( &
        CXL(K) * R(K + 1) + CXL(K - 1) * R(K - 1) &
        + CYL(K) * R(K + NX) + CYL(K - NX) * R(K - NX) - 4.0 * R(K) &
        - SXL(K) * I(K + 1) + SXL(K - 1) * I(K - 1) &
        - SYL(K) * I(K + NX) + SYL(K - NX) * I(K - NX))) &
        * WALL(K)
    ENDDO
    ! ledger pass
    W1 := 0.0
    WX1 := 0.0
    WY1 := 0.0
    EX1 := 0.0
    EY1 := 0.0
    W2 := 0.0
    WX2 := 0.0
    WY2 := 0.0
    EX2 := 0.0
    EY2 := 0.0
    RMX := 0.0
    RMI := 0.0
    RMS := 0.0
    DO J = 2, NY - 1
      DO K = 2, NX - 1
        RH := R(K + (J - 1) * NX) * R(K + (J - 1) * NX) &
          + I(K + (J - 1) * NX) * I(K + (J - 1) * NX)
        RA := ABS(R(K + (J - 1) * NX))
        IF (RA > RMX) THEN
          RMX := RA
        ENDIF
        IF (ABSORB(K + (J - 1) * NX) > 0.999999) THEN
          IF (RA > RMI) THEN
            RMI := RA
          ENDIF
        ELSE
          IF (RA > RMS) THEN
            RMS := RA
          ENDIF
        ENDIF
        IF (RH > 0.0) THEN
          DX := REAL(XC - K)
          DY := REAL(YC - J)
          R2 := DX * DX + DY * DY
          IF (R2 > 64.0) THEN
            IF (J <= YC) THEN
              W1 := W1 + RH
              WX1 := WX1 + RH * REAL(K)
              WY1 := WY1 + RH * REAL(J)
              EX1 := EX1 + RH * DX / R2
              EY1 := EY1 + RH * DY / R2
            ELSE
              W2 := W2 + RH
              WX2 := WX2 + RH * REAL(K)
              WY2 := WY2 + RH * REAL(J)
              EX2 := EX2 + RH * DX / R2
              EY2 := EY2 + RH * DY / R2
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDDO
    IF (W1 > 1.0E-20) THEN
      CX1 := WX1 / W1
      CY1M := WY1 / W1
      VX1 := CX1 - PCX1
      VY1M := CY1M - PCY1
      PCX1 := CX1
      PCY1 := CY1M
      PH1 := PH1 + FLV * (VX1 * EY1 - VY1M * EX1) / (PI2 * W1)
    ENDIF
    IF (W2 > 1.0E-20) THEN
      CX2 := WX2 / W2
      CY2M := WY2 / W2
      VX2 := CX2 - PCX2
      VY2M := CY2M - PCY2
      PCX2 := CX2
      PCY2 := CY2M
      PH2 := PH2 + FLV * (VX2 * EY2 - VY2M * EX2) / (PI2 * W2)
    ENDIF
    PHL := PH1 - PH2
    TPR := 200
    IF (CS == 3) THEN
      TPR := 100
    ENDIF
    SV := REAL(T - TPR * (T / TPR))
    IF (SV < 0.5) THEN
      WRITE(*, "rew cs %d t %d cx1 %.1f ledger %.8f rmax %.2e %.2e") &
        CS, T, CX1, PHL, RMI, RMS
    ENDIF
    IF (RMX > 1.0E30) THEN
      WRITE(*, "rewind cs %d DIED at t %d: int %.2e spn %.2e") &
        CS, T, RMI, RMS
      DIED := 1
      EXIT
    ENDIF
  ENDDO

  ! ─────────────── DEFICIT AUDIT ───────────────
  IF (DIED == 0) THEN
    DINT := 0.0
    DSPN := 0.0
    MASSR := 0.0
    DO K = 1, NPTS
      DD := ABS(R(K) - R0(K)) + ABS(I(K) - I0(K))
      IF (WALL(K) > 0.5) THEN
        IF (ABSORB(K) > 0.999999) THEN
          IF (DD > DINT) THEN
            DINT := DD
          ENDIF
        ELSE
          IF (DD > DSPN) THEN
            DSPN := DD
          ENDIF
        ENDIF
      ENDIF
      MASSR := MASSR + R(K) * R(K) + I(K) * I(K)
    ENDDO
    WRITE(*, "case %d  FL %.4f  ledger_end %.8f  mass %.8f") &
      CS, FLV, PHL, MASSR / MASS0
    WRITE(*, "  deficit: interior %.3e  sponge %.3e") DINT, DSPN
  ELSE
    WRITE(*, "case %d  FL %.4f  rewind destroyed by sponge dust") &
      CS, FLV
  ENDIF
ENDDO

WRITE(*, "-- rewind summary (mirror oracles) -------------------")
WRITE(*, "cs1/cs2 (sponge off): ledger -> ~-0.00025, cx1 -> 99.0,")
WRITE(*, "  mass 1.00000000, interior deficit ~2e-15 (machine).")
WRITE(*, "cs3 (sponge on): rewind DIES at t ~ 202; sponge rmax leads")
WRITE(*, "  interior by 2+ orders; growth x1.5/step = 1/0.664 (the")
WRITE(*, "  deepest attenuation inverted). Arrow of time = absorber,")
WRITE(*, "  not dynamics; flux changes nothing.")
