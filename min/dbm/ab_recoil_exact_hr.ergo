! ============================================================
! ab_recoil_exact_hr.ergo  --  T1: resolution-doubling test
!
! Stage 7 (exact Peierls links) with EVERYTHING scaled x2:
!   grid 512^2 -> 1024^2, SIG 14 -> 28, X0 100 -> 200,
!   rows 204/308 -> 408/616, core (512,512) r=16,
!   link cutoff r>12, sponge 96, NSTEPS 4400 (same vg, 2x path).
! K0 = 0.3 unchanged (same carrier in lattice units).
!
! QUESTION: is the +-2pi winding-direction split (+2.09 sites at
! 512^2, scheme-independent) a lattice/staircase artifact or
! finite-core boundary physics?
!   artifact (staircase/core discretization): split stays ~same
!     in lattice sites or shrinks  (<= ~2 sites at 1024^2)
!   physical (finite-core boundary): split is constant in
!     PHYSICAL units -> DOUBLES in hi-res sites (~+4.2)
! +-pi cases kept as scale reference (512^2: +17.37 both
! channels together; physical -> ~+35 at 1024^2).
!
! Cases: 1=0  2=+pi  3=-pi  4=+2pi  5=-2pi
!
! MIRROR ORACLES (C mirror, gcc -O2, 2026-08-12; cx +1.00 indexing):
!   case 1 (0)     cx1 716.35 cx2 716.31 cy1 404.03 cy2 620.50
!                  kx1 0.28858 kx2 0.28857
!   case 2 (+pi)   cx1 719.98 cx2 717.01 cy1 400.27 cy2 619.22
!                  kx1 0.29311 kx2 0.29053
!   case 3 (-pi)   cx1 717.25 cx2 720.21 cy1 404.64 cy2 623.88
!                  kx1 0.29081 kx2 0.29337
!   case 4 (+2pi)  cx1 717.46 cx2 714.89 cy1 401.12 cy2 617.44
!                  kx1 0.28835 kx2 0.28856
!   case 5 (-2pi)  cx1 715.35 cx2 717.85 cy1 406.73 cy2 623.76
!                  kx1 0.28904 kx2 0.28884
! Displacements vs null: dpi dcx1 +3.63/+0.90, sum +4.33/+4.80;
!   2pi dcx1 +1.11/-1.00 (split 2.11 sites), dcy1 -2.91/+2.70.
!
! Arrays are STATIC (file-scope) -- no ulimit needed.
!
! Rename: ab_recoil_exact_hr.ergo.txt -> ab_recoil_exact_hr.ergo
! Run: python -m core min/ab/ab_recoil_exact_hr.ergo -o /tmp/rehr
!      /tmp/rehr
! ============================================================

IMPLICIT NONE
INTEGER, PARAMETER :: NX = 1024, NY = 1024
INTEGER, PARAMETER :: NPTS = NX*NY
INTEGER, PARAMETER :: NEND = NPTS - NX - 1
INTEGER, PARAMETER :: NSTEPS = 4400
INTEGER, PARAMETER :: NSP = 96
REAL, PARAMETER :: AA = 0.20
REAL, PARAMETER :: SIG = 28.0
REAL, PARAMETER :: K0 = 0.3
INTEGER, PARAMETER :: X0 = 200
INTEGER, PARAMETER :: Y1 = 408, Y2 = 616
INTEGER, PARAMETER :: XC = 512, YC = 512
REAL, PARAMETER :: PI2 = 6.283185307179586
REAL, PARAMETER :: PIH = 3.14159265358979

STATIC REAL :: R(NPTS), I(NPTS), ABSORB(NPTS), WALL(NPTS)
STATIC REAL :: CXL(NPTS), SXL(NPTS), CYL(NPTS), SYL(NPTS)
REAL :: FT(5), X1T(5), X2T(5), Y1T(5), Y2T(5), K1T(5), K2T(5)

INTEGER :: J, K, KK, T, CS, IDX
REAL :: FLV, SV, DX, DY, R2C, TH
REAL :: W1, WX1, WY1, WK1, W2, WX2, WY2, WK2, MC, M0
REAL :: RH, DRX, DIX, KM
REAL :: CX1, CY1, CX2, CY2, KX1, KX2
REAL :: ODD

DO CS = 1, 5

   FLV := 0.0
   IF (CS = 2) THEN
      FLV := PIH
   ENDIF
   IF (CS = 3) THEN
      FLV := -PIH
   ENDIF
   IF (CS = 4) THEN
      FLV := PI2
   ENDIF
   IF (CS = 5) THEN
      FLV := -PI2
   ENDIF

   ! --- clear grid, absorber, wall ---
   DO KK = 1, NX*NY
      R(KK) := 0.0
      I(KK) := 0.0
      ABSORB(KK) := 1.0
      WALL(KK) := 1.0
   ENDDO

   ! --- sponge: symmetric on all four edges (width 96) ---
   DO J = 1, NSP
      SV := 1.0 - 0.35*(1.0 - J/97.0)*(1.0 - J/97.0)
      DO K = 1, NX
         ABSORB(K + (J-1)*NX) := ABSORB(K + (J-1)*NX) * SV
         ABSORB(K + (NY-J)*NX) := ABSORB(K + (NY-J)*NX) * SV
      ENDDO
      DO K = 1, NY
         ABSORB(J + (K-1)*NX) := ABSORB(J + (K-1)*NX) * SV
         ABSORB(NX+1-J + (K-1)*NX) := ABSORB(NX+1-J + (K-1)*NX) * SV
      ENDDO
   ENDDO

   ! --- flux shield: r=16 disk, WALL=0 (Dirichlet pinning) ---
   DO J = 496, 528
      DO K = 496, 528
         DX := K - XC
         DY := J - YC
         IF (DX*DX + DY*DY < 256.0) THEN
            WALL(K + (J-1)*NX) := 0.0
         ENDIF
      ENDDO
   ENDDO

   ! --- EXACT Peierls links, r>12 cutoff ---
   DO KK = 1, NX*NY
      CXL(KK) := 1.0
      SXL(KK) := 0.0
      CYL(KK) := 1.0
      SYL(KK) := 0.0
   ENDDO
   IF (FLV /= 0.0) THEN
      TH := FLV / PI2
      DO J = 2, NY-1
         DO K = 2, NX-1
            DX := K - XC + 0.5
            DY := J - YC
            R2C := DX*DX + DY*DY
            IF (R2C > 144.0) THEN
               SV := TH*(ATAN2(DY, DX + 0.5) - ATAN2(DY, DX - 0.5))
               IDX := K + (J-1)*NX
               CXL(IDX) := COS(SV)
               SXL(IDX) := SIN(SV)
            ENDIF
            DX := K - XC
            DY := J - YC + 0.5
            R2C := DX*DX + DY*DY
            IF (R2C > 144.0) THEN
               SV := TH*(ATAN2(DY + 0.5, DX) - ATAN2(DY - 0.5, DX))
               IDX := K + (J-1)*NX
               CYL(IDX) := COS(SV)
               SYL(IDX) := SIN(SV)
            ENDIF
         ENDDO
      ENDDO
   ENDIF

   ! --- two Gaussian packets, rows 408 / 616 (x-width 60) ---
   DO J = 1, NY
      DO K = 1, NX
         IDX := K + (J-1)*NX
         SV := EXP(-(((K-X0)/60.0)*((K-X0)/60.0) + ((J-Y1)/SIG)*((J-Y1)/SIG)))
         R(IDX) := SV*COS(K0*(K-X0))
         I(IDX) := SV*SIN(K0*(K-X0))
         SV := EXP(-(((K-X0)/60.0)*((K-X0)/60.0) + ((J-Y2)/SIG)*((J-Y2)/SIG)))
         R(IDX) := R(IDX) + SV*COS(K0*(K-X0))
         I(IDX) := I(IDX) + SV*SIN(K0*(K-X0))
      ENDDO
   ENDDO

   M0 := 0.0
   DO KK = 1, NX*NY
      M0 := M0 + R(KK)*R(KK) + I(KK)*I(KK)
   ENDDO

   ! --- integration + instrument pass ---
   DO T = 1, NSTEPS

      DO K = NX+2, NEND
         I(K) := (I(K) + AA*(CXL(K)*R(K+1) + CXL(K-1)*R(K-1) &
            + CYL(K)*R(K+NX) + CYL(K-NX)*R(K-NX) - 4.0*R(K) &
            - SXL(K)*I(K+1) + SXL(K-1)*I(K-1) &
            - SYL(K)*I(K+NX) + SYL(K-NX)*I(K-NX))) &
            * ABSORB(K) * WALL(K)
      ENDDO
      DO K = NX+2, NEND
         R(K) := (R(K) - AA*(SXL(K)*R(K+1) - SXL(K-1)*R(K-1) &
            + SYL(K)*R(K+NX) - SYL(K-NX)*R(K-NX) &
            + CXL(K)*I(K+1) + CXL(K-1)*I(K-1) &
            + CYL(K)*I(K+NX) + CYL(K-NX)*I(K-NX) - 4.0*I(K))) &
            * ABSORB(K) * WALL(K)
      ENDDO

      ! --- per-channel mass, centroid, kinetic momentum ---
      W1 := 0.0
      WX1 := 0.0
      WY1 := 0.0
      WK1 := 0.0
      W2 := 0.0
      WX2 := 0.0
      WY2 := 0.0
      WK2 := 0.0
      MC := 0.0
      DO J = 2, NY-1
         DO K = 2, NX-1
            IDX := K + (J-1)*NX
            RH := R(IDX)*R(IDX) + I(IDX)*I(IDX)
            MC := MC + RH
            DRX := 0.5*((CXL(IDX)*R(IDX+1) - SXL(IDX)*I(IDX+1)) &
               - (CXL(IDX-1)*R(IDX-1) + SXL(IDX-1)*I(IDX-1)))
            DIX := 0.5*((CXL(IDX)*I(IDX+1) + SXL(IDX)*R(IDX+1)) &
               - (CXL(IDX-1)*I(IDX-1) - SXL(IDX-1)*R(IDX-1)))
            KM := R(IDX)*DIX - I(IDX)*DRX
            IF (J <= 512) THEN
               W1 := W1 + RH
               WX1 := WX1 + RH*K
               WY1 := WY1 + RH*J
               WK1 := WK1 + KM
            ELSE
               W2 := W2 + RH
               WX2 := WX2 + RH*K
               WY2 := WY2 + RH*J
               WK2 := WK2 + KM
            ENDIF
         ENDDO
      ENDDO
      CX1 := WX1/W1
      CY1 := WY1/W1
      KX1 := WK1/W1
      CX2 := WX2/W2
      CY2 := WY2/W2
      KX2 := WK2/W2

      IF (CS = 4) THEN
         IF (MOD(T,800) = 0) THEN
            WRITE(*,"('cs4 t %d cx1 %.2f cx2 %.2f cy1 %.2f cy2 %.2f kx1 %.5f kx2 %.5f mass %.6f')") T, CX1, CX2, CY1, CY2, KX1, KX2, MC/M0
         ENDIF
      ENDIF
      IF (CS = 5) THEN
         IF (MOD(T,800) = 0) THEN
            WRITE(*,"('cs5 t %d cx1 %.2f cx2 %.2f cy1 %.2f cy2 %.2f kx1 %.5f kx2 %.5f mass %.6f')") T, CX1, CX2, CY1, CY2, KX1, KX2, MC/M0
         ENDIF
      ENDIF

   ENDDO

   FT(CS) := FLV
   X1T(CS) := CX1
   X2T(CS) := CX2
   Y1T(CS) := CY1
   Y2T(CS) := CY2
   K1T(CS) := KX1
   K2T(CS) := KX2

   WRITE(*,"('case %d FL %.4f cx1 %.2f cx2 %.2f cy1 %.2f cy2 %.2f kx1 %.5f kx2 %.5f')") CS, FLV, CX1, CX2, CY1, CY2, KX1, KX2

ENDDO

! ---------------- summary tables ----------------

WRITE(*,"('-- displacement table (vs null) --')")
DO CS = 2, 5
   WRITE(*,"('FL %.4f dcx1 %.3f dcx2 %.3f dcy1 %.3f dcy2 %.3f dkx1 %.5f dkx2 %.5f')") FT(CS), X1T(CS)-X1T(1), X2T(CS)-X2T(1), Y1T(CS)-Y1T(1), Y2T(CS)-Y2T(1), K1T(CS)-K1T(1), K2T(CS)-K2T(1)
ENDDO

WRITE(*,"('-- odd check: dcx1(+FL)+dcx1(-FL) --')")
ODD := (X1T(2)-X1T(1)) + (X1T(3)-X1T(1))
WRITE(*,"('pi %.3f')") ODD
ODD := (X1T(4)-X1T(1)) + (X1T(5)-X1T(1))
WRITE(*,"('2pi %.3f')") ODD

WRITE(*,"('-- channel mirror check: dcx1+dcx2 --')")
DO CS = 2, 5
   WRITE(*,"('FL %.4f sum %.3f')") FT(CS), (X1T(CS)-X1T(1)) + (X2T(CS)-X2T(1))
ENDDO

WRITE(*,"('-- T1 verdict key: +-2pi split ~2 sites = artifact, ~4+ sites = physics --')")
WRITE(*,"('-- 512^2 reference: dcx1 pi +17.37/+16.60, 2pi +0.34/+1.75 --')")
