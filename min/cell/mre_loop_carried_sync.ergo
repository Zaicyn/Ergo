! MRE2: CPU read at TOP of loop body, GPU kernel at BOTTOM.
! Correct: step sums 0, 1000, 2000 (sum sees last step's bump).
! Stale-host bug: step 2/3 sums stay 0.
IMPLICIT NONE
PARAMETER INTEGER :: N = 1000
STATIC REAL :: A(N)
STATIC REAL :: S
STATIC INTEGER :: I, STEP

DO I = 1, N
  A(I) := 0.0
ENDDO

DO STEP = 1, 3
  S := 0.0
  DO I = 1, N
    IF A(I) > 0.5 THEN
      S := S + A(I)
    ENDIF
  ENDDO
  WRITE(*, "step %d sum %f (want %d)") STEP, S, (STEP - 1) * 1000
  DO I = 1, N
    A(I) := A(I) + 1.0
  ENDDO
ENDDO
STOP
