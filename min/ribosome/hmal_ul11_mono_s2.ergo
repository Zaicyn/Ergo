! WAVEFORM_UL11_MONO - ul11_mono protein variant with native RMSD
! =====================================================================
! 143-residue protein variant
! Design: helix(1-9) - turn/cage(10-20)
! Includes hydrophobic attraction (L2,Y3,I4,W6,L7,P12,P17,P18,P19)
! Computes RMSD to native PDB 1L2Y coordinates at each frame.
!
! CSV: frame,rgyr,e2e,nhb,i3,i4,iL,bang_mean,bang_rms,tors_mean,alpha_frac,
!      e_morse,e_angle,e_torsion,e_hydro,thermal,rmsd_native

IMPLICIT NONE

! ── Chain / run ─────────────────────────────────────────────
PARAMETER INTEGER :: NRES = 145
PARAMETER INTEGER :: MAXHB = 256
PARAMETER INTEGER :: MAXFRAME = 96000

! ── Time stepping / coupling ──────────────────────────────────
PARAMETER REAL :: DT = 0.01
PARAMETER REAL :: FORCE_SCALE = 6.0
PARAMETER REAL :: VELOCITY_DAMP = 0.9
PARAMETER REAL :: BASE_OMEGA = 1.0
PARAMETER REAL :: COUPLING_K = 5.0
PARAMETER REAL :: PHASE_NOISE_SCALE = 10.0
PARAMETER REAL :: SEED = 2.0

! ── Thermal schedule ─────────────────────────────────────────
PARAMETER REAL :: HEAT_START = 0.001
PARAMETER REAL :: HEAT_PEAK = 1.0
! 0 = legacy: two heat/cool cycles hard-coded into frames 0-1200
! 1 = scaled: two heat/cool cycles spanning the first half of MAXFRAME
PARAMETER INTEGER :: SCHEDULE_SCALED = 0

! ── Ultrasonic pulse (mechanical trap rescue; 1SNO/SdrD certified) ──
! Mode-1 standing wave along the backbone; velocity kick per frame,
! axes phase-shifted 2pi/3. AMP = 0 disables (bitwise-identical to no pulse).
! Certified setting: OMEGA = 0.002 (period ~3100 frames), AMP = 0.05.
PARAMETER REAL :: PULSE_AMP = 0.0
PARAMETER REAL :: PULSE_OMEGA = 0.002

! ── Domain rigid-body quaternion MC (post-gate docking moves) ──
! Every MC_EVERY frames post-gate, each domain gets a small rigid-body
! rotation about its COM (quaternion-sampled, hash-deterministic),
! accepted iff inter-domain Go + steric energy does not increase.
! Internal structure is preserved exactly (rigid transform).
! MC_EVERY = 0 disables; with NDOM = 1 there are no inter-domain pairs,
! so the move is a whole-chain rotation about COM and inert by symmetry.
PARAMETER INTEGER :: MC_EVERY = 0
PARAMETER REAL :: MC_ANGLE = 0.08
PARAMETER REAL :: MC_TRANS = 0.3
! ── Oriented-residue (Cosserat ribbon) dynamics ────────────────────
! Each residue carries an orientation quaternion RES_Q* integrated via
! q_dot = 0.5 * omega (x) q, plus angular velocity RES_W*. Neighbor
! alignment torques (FRAME_K) compare q_i^-1 (x) q_i+1 against the native
! relative frame; the orientation->position coupling (FRAME_POS_K) pulls
! p_i+1 toward p_i + R(q_i) . v*_i (native bond in the local frame).
! Both default 0 = off. These act DURING collapse, from frame 0.
PARAMETER REAL :: FRAME_K = 0.2
PARAMETER REAL :: FRAME_POS_K = 0.2

! ── Contact-layer orientation coupling (second coordination shell) ──
! For each native contact pair (i,j), bead j is pulled toward
! p_i + R(q_i).v*_ij (native contact vector carried in i's local frame).
! Generalizes FRAME_POS_K from backbone bonds to spatial contacts.
! Native structure is a zero-force fixed point by construction.
PARAMETER REAL :: FRAME_CL_K = 0.0
PARAMETER INTEGER :: NCL = 0
PARAMETER REAL :: FRAME_DAMP = 0.98

! Metropolis temperature for MC acceptance: uphill moves accepted with
! probability EXP(-dE/MCT). Anneals linearly to 0 over the first 60% of
! the post-gate window (= quench frame when gate=0.5M, quench=0.8M).
! 0 = greedy (downhill-only).
PARAMETER REAL :: MC_TEMP = 0.0
PARAMETER INTEGER :: NDOM = 1

! ── Backbone (permanent) ─────────────────────────────────────
PARAMETER REAL :: BACKBONE_R0 = 1.52
PARAMETER REAL :: BACKBONE_D = 1.4
PARAMETER REAL :: MORSE_A = 1.0

! ── H-bonds (dynamic contacts) ────────────────────────────────
PARAMETER REAL :: HB_R0 = 2.2
PARAMETER REAL :: HB_D = 0.30
PARAMETER REAL :: HB_FORM = 2.5
PARAMETER REAL :: HB_BREAK = 2.8
PARAMETER INTEGER :: HB_CAP = 2
! Breakable cystine restraints (harmonic Cα–Cα to native distance; CYS_ON=0 deletes the bond)
PARAMETER REAL :: CSS_K = 0.0000
PARAMETER INTEGER :: NCYSPAIR = 0
! Non-native disulfide mispairing (e.g. freed CysB7 attacking wrong partners in Akita)
PARAMETER REAL :: MIS_K = 0.0
PARAMETER INTEGER :: NMISPAIR = 0
! Multi-chain support: backbone/angle/torsion/frame terms skipped across the break
! (residue CHAIN_BREAK ends chain 1, CHAIN_BREAK+1 starts chain 2; 0 = single chain)
! CHAIN_BREAK2/3 = optional further breaks for 3- and 4-chain systems (0 = unused)
PARAMETER INTEGER :: CHAIN_BREAK = 0
PARAMETER INTEGER :: CHAIN_BREAK2 = 0
PARAMETER INTEGER :: CHAIN_BREAK3 = 0
! Adaptive substepping (Ergo_Activity_Bounds §5): temporal resolution, not caps.
! Closest-approach scan before the force block; if DMIN < SUBSTEP_D the frame's
! dynamics run NSUB = min(SUBSTEP_MAX, floor(SUBSTEP_D/DMIN)+1) substeps of DT/NSUB.
PARAMETER REAL :: SUBSTEP_D = 0.8
PARAMETER INTEGER :: SUBSTEP_MAX = 64
PARAMETER REAL :: HB_PHASE_FORM = 0.80
PARAMETER REAL :: HB_PHASE_STABLE = 0.95

! ── Steric exclusion ─────────────────────────────────────────
PARAMETER REAL :: STERIC_SIG = 1.60
PARAMETER REAL :: STERIC_EPS = 0.1
PARAMETER REAL :: STERIC_CUT = 2.5

! ── Screened phosphate repulsion (RNA backbone; PHOS_EPS=0 = off) ──
! E = PHOS_EPS * EXP(-D/PHOS_LAM) / D   (screened Coulomb, per pair)
! Only bead pairs with RES_PHOS > 0 on BOTH beads feel it.
PARAMETER REAL :: PHOS_EPS = 0.0000
PARAMETER REAL :: PHOS_LAM = 3.1

! ── Packed pair-slot geometry (GPU pair-force kernels) ─────────────
! All pair forces (steric/PHOS/hydro/Go contacts) run over ONE unified
! padded slot list: atom a owns slots [(a-1)*PSEG+1, a*PSEG]; PAD slots
! carry zero weights. PSEG is a multiple of 256 covering the longest
! per-atom pair run (the segmented-reduction extraction requires
! 256-aligned segments). Both are patched per variant (literal ints).
PARAMETER INTEGER :: PSEG = 256
PARAMETER INTEGER :: NSLOT = 37120

! ── Hydrophobic attraction ───────────────────────────────────
PARAMETER REAL :: HYDRO_STRENGTH = 0.0020
PARAMETER REAL :: HYDRO_R0 = 4.0
PARAMETER REAL :: HYDRO_CUTOFF = 8.0
PARAMETER REAL :: HYDRO_ALPHA = 1.0



! ── Native contact potential (Go-like) ─────────────────────────
PARAMETER REAL :: NATIVE_K = 1.00
PARAMETER REAL :: NATIVE_CUTOFF = 2.600000

! ── Fold-then-dock staging ─────────────────────────────────────
! Inter-domain native contacts (CONTACT_INTER = 1) exert no force and
! contribute no energy until FRAME > DOCK_FROM. Default: off (huge).
PARAMETER INTEGER :: DOCK_FROM = 2000000000



! ── Residue state ─────────────────────────────────────────────
STATIC REAL :: RES_X(145)
STATIC REAL :: RES_Y(145)
STATIC REAL :: RES_Z(145)
STATIC REAL :: RES_VX(145)
STATIC REAL :: RES_VY(145)
STATIC REAL :: RES_VZ(145)
STATIC REAL :: RES_THETA(145)
STATIC REAL :: RES_OMEGA(145)

! ── Per-residue sequence parameters ──────────────────────────
STATIC REAL :: RES_ANGK(145)
STATIC REAL :: RES_ANGT0(145)
STATIC REAL :: RES_TORSK(145)
STATIC REAL :: RES_TORSP0(145)
STATIC REAL :: RES_HYDRO(145)
STATIC REAL :: RES_PHOS(145)



! ── Native coordinates (PDB 1L2Y, model 1, chain A) ─
! These are Cα positions from the NMR structure.
STATIC REAL :: NATIVE_X(145)
STATIC REAL :: NATIVE_Y(145)
STATIC REAL :: NATIVE_Z(145)

! ── Native contact state ─────────────────────────────────────
STATIC INTEGER :: NATIVE_CONTACT(145, 145)
STATIC INTEGER :: CONTACT_INTER(145, 145)
STATIC INTEGER :: DOM_BEG(16)
STATIC INTEGER :: DOM_END(16)
STATIC REAL :: RES_Q0(145)
STATIC REAL :: RES_Q1(145)
STATIC REAL :: RES_Q2(145)
STATIC REAL :: RES_Q3(145)
STATIC REAL :: RES_WX(145)
STATIC REAL :: RES_WY(145)
STATIC REAL :: RES_WZ(145)
STATIC REAL :: NATIVE_Q0(145)
STATIC REAL :: NATIVE_Q1(145)
STATIC REAL :: NATIVE_Q2(145)
STATIC REAL :: NATIVE_Q3(145)
STATIC REAL :: NATIVE_BVX(145)
STATIC REAL :: NATIVE_BVY(145)
STATIC REAL :: NATIVE_BVZ(145)

! ── Contact-layer list (packed pairs + native contact vector, local frame) ──
STATIC INTEGER :: CL_I(1024)
STATIC INTEGER :: CL_J(1024)
STATIC REAL :: CL_VX(1024)
STATIC REAL :: CL_VY(1024)
STATIC REAL :: CL_VZ(1024)
STATIC REAL :: MC_OX(145)
STATIC REAL :: MC_OY(145)
STATIC REAL :: MC_OZ(145)
STATIC REAL :: NATIVE_R0(145, 145)

! ── Unified pair-slot tables (built once at init, two orders) ──────
! i-major: slot (a-1)*PSEG+t holds pair (a, a+2+t) when <= NRES;
! j-major: slot (b-1)*PSEG+t holds pair (t, b) when t <= b-3.
! PAIR_BLK is the segment owner (accumulator table for the segmented
! reduction). Weights bake every static gate: hbond exclusion (WST),
! charge flags (WPH), hydro flag+strength product (WHY), contact
! membership (WCO), inter-domain flag (WCI), native distance (CR0).
STATIC INTEGER :: PAIR_BLK(36608)
STATIC INTEGER :: PAIR_J_I(36608)
STATIC INTEGER :: PAIR_I_J(36608)
STATIC REAL :: WST_I(36608), WPH_I(36608), WHY_I(36608)
STATIC REAL :: WCO_I(36608), WCI_I(36608), CR0_I(36608)
STATIC REAL :: WST_J(36608), WPH_J(36608), WHY_J(36608)
STATIC REAL :: WCO_J(36608), WCI_J(36608), CR0_J(36608)

! ── H-bond state ──────────────────────────────────────────────
STATIC INTEGER :: HBOND_MATRIX(145, 145)
STATIC INTEGER :: CYS_I(192)
STATIC INTEGER :: CYS_J(192)
STATIC REAL :: CYS_R0(192)
STATIC INTEGER :: CYS_ON(192)
STATIC INTEGER :: MIS_I(40)
STATIC INTEGER :: MIS_J(40)
STATIC REAL :: MIS_R0(40)
STATIC REAL :: MIS_KK(40)
STATIC INTEGER :: NHBOND
STATIC INTEGER :: HB_I(256)
STATIC INTEGER :: HB_J(256)

! ── Diagnostics ────────────────────────────────────────────────
STATIC REAL :: RGYR
STATIC REAL :: E2E
STATIC REAL :: BANG_MEAN
STATIC REAL :: BANG_RMS
STATIC REAL :: TORS_MEAN
STATIC REAL :: ALPHA_FRAC
STATIC REAL :: E_MORSE
STATIC REAL :: E_ANGLE
STATIC REAL :: E_TORSION
STATIC REAL :: E_HYDRO
STATIC REAL :: E_NATIVE
STATIC REAL :: THERMAL_CURRENT
STATIC REAL :: RMSD_NATIVE
STATIC REAL :: RMSD_CHAIN(4)
STATIC INTEGER :: NCHAINR
STATIC INTEGER :: SEG_LO(4)
STATIC INTEGER :: SEG_HI(4)
STATIC INTEGER :: I3CNT
STATIC INTEGER :: I4CNT
STATIC INTEGER :: ILCNT
STATIC INTEGER :: HB_FORMS
STATIC INTEGER :: HB_BREAKS

! ── Working scalars ───────────────────────────────────────────
STATIC INTEGER :: I, J, K, FRAME, N, NC, NI3, NI4, NIL, DEG, P
STATIC REAL :: X, Y, Z, VX, VY, VZ, TH, OM, R, D, E, F
STATIC REAL :: DX, DY, DZ, CS, ALIGN, FM, TEMP_X, TEMP_Y, TEMP_Z
STATIC REAL :: SIN_AVG, COS_AVG, THETA_MEAN, PHASE_DEV
STATIC REAL :: SUM_RGYR, SUM_BANG, SUM_BANGSQ, SUM_TORS, CNT_TORS
STATIC REAL :: DIS, ANG, COSA, DEV, BX, CX, BY, CY, BZ, CZ
STATIC REAL :: UX, UY, UZ, WX, WY, WZ, UN, VN, B1X, B1Y, B1Z
STATIC REAL :: B2X, B2Y, B2Z, B3X, B3Y, B3Z, N1X, N1Y, N1Z
STATIC REAL :: N2X, N2Y, N2Z, B2MAG, PHI, DPHI_DR1X, DPHI_DR1Y, DPHI_DR1Z
STATIC REAL :: DPHI_DR4X, DPHI_DR4Y, DPHI_DR4Z, DPHI_DR2X, DPHI_DR2Y, DPHI_DR2Z
STATIC REAL :: DPHI_DR3X, DPHI_DR3Y, DPHI_DR3Z, N1MAG2, N2MAG2, N1MAG, N2MAG
STATIC REAL :: B1DOT, B3DOT, SCALE_B2, SCALE_B1, SCALE_B3, B2DOT
STATIC REAL :: SHIFT_SUM, SCALE_SHIFT, RMSD_SUM
STATIC INTEGER :: IDOM, DA, DB
STATIC REAL :: MCCX, MCCY, MCCZ, MCAX, MCAY, MCAZ, MCAN, MCANG
STATIC REAL :: MCQ0, MCQ1, MCQ2, MCQ3, MCS2
STATIC REAL :: MCR11, MCR12, MCR13, MCR21, MCR22, MCR23, MCR31, MCR32, MCR33
STATIC REAL :: MCEBF, MCEAF, MCRX, MCRY, MCRZ, MCDOM
STATIC REAL :: MCTX, MCTY, MCTZ
STATIC REAL :: MCT, MCFRAC, MCH, MCDE
STATIC REAL :: QW0, QW1, QW2, QW3, QE0, QE1, QE2, QE3, QSGN
STATIC REAL :: TQX, TQY, TQZ, QNORM, HBX, HBY, HBZ
STATIC REAL :: FR11, FR12, FR13, FR21, FR22, FR23, FR31, FR32, FR33
STATIC REAL :: PFX, PFY, PFZ
STATIC REAL :: EQ0, EQ1, EQ2, EQ3
STATIC REAL :: DMIN_S, DTW, DAMP_SUB, FDAMP_SUB
STATIC INTEGER :: NSUB, SUB
! pair-kernel working scalars
STATIC INTEGER :: T, I2, J2, KI, KJ
STATIC REAL :: DD, MD, MS, MH, BST, FMS, FMP, FMH, WCT, FMC, DOCKM



! ── Initialize ─────────────────────────────────────────────
CALL INIT_CHAIN()
CALL INIT_NATIVE()

  ! Single domain: MC move is inert (whole-chain rotation)
  DOM_BEG(1) := 1
  DOM_END(1) := NRES

! Orientation field: identity quaternions, zero angular velocity.
! Alignment torques pull the field toward native relative frames from
! frame 0 (during collapse), so the initial coil needs no frames of its own.
DO I = 1, NRES
  RES_Q0(I) := 1.0
  RES_Q1(I) := 0.0
  RES_Q2(I) := 0.0
  RES_Q3(I) := 0.0
  RES_WX(I) := 0.0
  RES_WY(I) := 0.0
  RES_WZ(I) := 0.0
ENDDO



! CSV header
WRITE(*, "frame,rgyr,e2e,nhb,i3,i4,iL,bang_mean,bang_rms,tors_mean,alpha_frac,e_morse,e_angle,e_torsion,e_hydro,e_native,thermal,rmsd_native,rmsd_c1,rmsd_c2,rmsd_c3,rmsd_c4")

! ── Build the unified pair-slot tables (one O(N^2) pass at init) ───
! Both orders are filled in the same nested sweep: i-major slot
! (a-1)*PSEG+t <-> pair (a, a+2+t); j-major slot (b-1)*PSEG+t <->
! pair (t, b). Steric/PHOS/hydro terms act only on |i-j| >= 4 pairs;
! Go contacts on |i-j| >= 3 native pairs. PAD slots: self-pair, all
! weights zero (they contribute exactly 0.0 to the accumulator).
DO I = 1, NRES
  DO T = 1, PSEG
    K := (I - 1) * PSEG + T
    PAIR_BLK(K) := I
    ! i-major: owner I, partner J = I+2+T
    J := I + 2 + T
    IF J <= NRES THEN
      PAIR_J_I(K) := J
      WST_I(K) := 0.0
      WPH_I(K) := 0.0
      WHY_I(K) := 0.0
      WCO_I(K) := REAL(NATIVE_CONTACT(I, J))
      WCI_I(K) := REAL(CONTACT_INTER(I, J))
      CR0_I(K) := NATIVE_R0(I, J)
      IF J - I >= 4 THEN
        IF HBOND_MATRIX(I, J) = 0 THEN
          WST_I(K) := 1.0
        ENDIF
        WPH_I(K) := RES_PHOS(I) * RES_PHOS(J)
        IF RES_HYDRO(I) > 0.0 .AND. RES_HYDRO(J) > 0.0 THEN
          WHY_I(K) := RES_HYDRO(I) * RES_HYDRO(J)
        ENDIF
      ENDIF
    ELSE
      PAIR_J_I(K) := I
      WST_I(K) := 0.0
      WPH_I(K) := 0.0
      WHY_I(K) := 0.0
      WCO_I(K) := 0.0
      WCI_I(K) := 0.0
      CR0_I(K) := 0.0
    ENDIF
    ! j-major: owner I (as second atom), partner I2 = T
    I2 := T
    J2 := I
    IF I2 <= J2 - 3 THEN
      PAIR_I_J(K) := I2
      WST_J(K) := 0.0
      WPH_J(K) := 0.0
      WHY_J(K) := 0.0
      WCO_J(K) := REAL(NATIVE_CONTACT(I2, J2))
      WCI_J(K) := REAL(CONTACT_INTER(I2, J2))
      CR0_J(K) := NATIVE_R0(I2, J2)
      IF J2 - I2 >= 4 THEN
        IF HBOND_MATRIX(I2, J2) = 0 THEN
          WST_J(K) := 1.0
        ENDIF
        WPH_J(K) := RES_PHOS(I2) * RES_PHOS(J2)
        IF RES_HYDRO(I2) > 0.0 .AND. RES_HYDRO(J2) > 0.0 THEN
          WHY_J(K) := RES_HYDRO(I2) * RES_HYDRO(J2)
        ENDIF
      ENDIF
    ELSE
      PAIR_I_J(K) := J2
      WST_J(K) := 0.0
      WPH_J(K) := 0.0
      WHY_J(K) := 0.0
      WCO_J(K) := 0.0
      WCI_J(K) := 0.0
      CR0_J(K) := 0.0
    ENDIF
  ENDDO
ENDDO

! ════════════════════════════════════════════════════════════
! MAIN LOOP
! ════════════════════════════════════════════════════════════
DO FRAME = 1, MAXFRAME

  ! Phase dynamics: intrinsic advance + Kuramoto coupling + noise
  DO I = 1, NRES
    RES_THETA(I) := RES_THETA(I) + RES_OMEGA(I) * DT
  ENDDO

  SIN_AVG := 0.0
  COS_AVG := 0.0
  DO I = 1, NRES
    SIN_AVG := SIN_AVG + SIN(RES_THETA(I))
    COS_AVG := COS_AVG + COS(RES_THETA(I))
  ENDDO
  THETA_MEAN := ATAN2(SIN_AVG, COS_AVG)
  DO I = 1, NRES
    RES_THETA(I) := RES_THETA(I) + COUPLING_K * SIN(THETA_MEAN - RES_THETA(I)) * DT
  ENDDO

  ! Phase noise
  TEMP_X := THERMAL_CURRENT * PHASE_NOISE_SCALE
  DO I = 1, NRES
    RES_THETA(I) := RES_THETA(I) + TEMP_X * SIN((I+1)*11.3 + REAL(FRAME)*0.23) * DT
  ENDDO

  ! Thermal impulses (velocity kicks)
  DO I = 1, NRES
    RES_VX(I) := RES_VX(I) + THERMAL_CURRENT * SIN((I+1)*7.3 + REAL(FRAME)*0.17)
    RES_VY(I) := RES_VY(I) + THERMAL_CURRENT * COS((I+1)*5.7 + REAL(FRAME)*0.31)
    RES_VZ(I) := RES_VZ(I) + THERMAL_CURRENT * SIN((I+1)*3.1 + REAL(FRAME)*0.09)
  ENDDO

  ! Ultrasonic pulse: mode-1 standing wave along the backbone,
  ! sinusoidal velocity kick, axes phase-shifted by 2pi/3
  IF PULSE_AMP > 0.0 THEN
    DO I = 1, NRES
      RES_VX(I) := RES_VX(I) + PULSE_AMP * SIN(PULSE_OMEGA * REAL(FRAME)) * SIN(3.14159265 * REAL(I) / REAL(NRES + 1))
      RES_VY(I) := RES_VY(I) + PULSE_AMP * SIN(PULSE_OMEGA * REAL(FRAME) + 2.0943951) * SIN(3.14159265 * REAL(I) / REAL(NRES + 1))
      RES_VZ(I) := RES_VZ(I) + PULSE_AMP * SIN(PULSE_OMEGA * REAL(FRAME) + 4.1887902) * SIN(3.14159265 * REAL(I) / REAL(NRES + 1))
    ENDDO
  ENDIF


  ! ── Adaptive substepping: closest-approach pre-scan (a priori bound) ──
  DMIN_S := 9999.0
  DO I = 1, NRES-4
    DO J = I+4, NRES
      DX := RES_X(I) - RES_X(J)
      DY := RES_Y(I) - RES_Y(J)
      DZ := RES_Z(I) - RES_Z(J)
      D := SQRT(DX*DX + DY*DY + DZ*DZ)
      IF D < DMIN_S THEN
        DMIN_S := D
      ENDIF
    ENDDO
  ENDDO
  DO I = 1, NRES-1
    IF I /= CHAIN_BREAK .AND. I /= CHAIN_BREAK2 .AND. I /= CHAIN_BREAK3 THEN
      DX := RES_X(I) - RES_X(I+1)
      DY := RES_Y(I) - RES_Y(I+1)
      DZ := RES_Z(I) - RES_Z(I+1)
      D := SQRT(DX*DX + DY*DY + DZ*DZ)
      IF D < DMIN_S THEN
        DMIN_S := D
      ENDIF
    ENDIF
  ENDDO
  NSUB := 1
  IF DMIN_S < SUBSTEP_D THEN
    IF DMIN_S > 0.0 THEN
      NSUB := INT(SUBSTEP_D / DMIN_S) + 1
    ELSE
      NSUB := SUBSTEP_MAX
    ENDIF
    IF NSUB > SUBSTEP_MAX THEN
      NSUB := SUBSTEP_MAX
    ENDIF
  ENDIF
  DTW := DT / REAL(NSUB)
  IF NSUB = 1 THEN
    DAMP_SUB := VELOCITY_DAMP
    FDAMP_SUB := FRAME_DAMP
  ELSE
    DAMP_SUB := EXP(LOG(VELOCITY_DAMP) / REAL(NSUB))
    FDAMP_SUB := EXP(LOG(FRAME_DAMP) / REAL(NSUB))
  ENDIF

  ! Dock gate mask (exact 0/1 arithmetic, strict): 1 once
  ! FRAME > DOCK_FROM; inter-domain Go contacts (WCI=1) scale with it.
  DOCKM := (1.0 - SIGN(1.0, REAL(DOCK_FROM - FRAME))) * 0.5

  DO SUB = 1, NSUB
  ! ── Unified pair forces (GPU segmented-reduction form) ──────────
  ! Steric + PHOS + hydro + Go contacts in ONE straight-line body over
  ! the padded slot list. All gates are exact 0/1 arithmetic masks (no
  ! IF — required for extraction):
  !   MD = POS(D)             (strict D > 0)
  !   MS = POS(STERIC_CUT-D)  (strict D < CUT)
  !   MH = POS(HYDRO_CUTOFF-D)
  ! with POS(x) = (1 - SIGN(1,-x))/2. The steric base folds the masks
  ! INSIDE the power so padding/out-of-range slots evaluate to exactly
  ! 0 without overflow (DD floors the denominator at 1e-30).
  ! i-side pass: add +F to the owner atom.
  DO K = 1, NSLOT
    KI := PAIR_BLK(K)
    KJ := PAIR_J_I(K)
    DX := RES_X(KI) - RES_X(KJ)
    DY := RES_Y(KI) - RES_Y(KJ)
    DZ := RES_Z(KI) - RES_Z(KJ)
    D := SQRT(DX*DX + DY*DY + DZ*DZ)
    DD := MAX(D, 1.0E-16)
    MD := (1.0 - SIGN(1.0, -D)) * 0.5
    MS := (1.0 - SIGN(1.0, D - STERIC_CUT)) * 0.5
    MH := (1.0 - SIGN(1.0, D - HYDRO_CUTOFF)) * 0.5
    BST := MD * MS * WST_I(K) * STERIC_SIG / DD
    FMS := STERIC_EPS * BST * BST * BST * BST * BST * BST
    FMP := WPH_I(K) * PHOS_EPS * EXP(-DD / PHOS_LAM) * (DD + PHOS_LAM) / (PHOS_LAM * DD * DD)
    FMH := -HYDRO_STRENGTH * WHY_I(K) * MH * EXP(-HYDRO_ALPHA * (DD - HYDRO_R0))
    WCT := WCO_I(K) * (1.0 - WCI_I(K) + WCI_I(K) * DOCKM)
    FMC := -2.0 * NATIVE_K * WCT * (DD - CR0_I(K))
    FM := MD * (FMS + FMP + FMH + FMC)
    RES_VX(PAIR_BLK(K)) := RES_VX(PAIR_BLK(K)) + FM * DX / DD * DTW * FORCE_SCALE
  ENDDO
  DO K = 1, NSLOT
    KI := PAIR_BLK(K)
    KJ := PAIR_J_I(K)
    DX := RES_X(KI) - RES_X(KJ)
    DY := RES_Y(KI) - RES_Y(KJ)
    DZ := RES_Z(KI) - RES_Z(KJ)
    D := SQRT(DX*DX + DY*DY + DZ*DZ)
    DD := MAX(D, 1.0E-16)
    MD := (1.0 - SIGN(1.0, -D)) * 0.5
    MS := (1.0 - SIGN(1.0, D - STERIC_CUT)) * 0.5
    MH := (1.0 - SIGN(1.0, D - HYDRO_CUTOFF)) * 0.5
    BST := MD * MS * WST_I(K) * STERIC_SIG / DD
    FMS := STERIC_EPS * BST * BST * BST * BST * BST * BST
    FMP := WPH_I(K) * PHOS_EPS * EXP(-DD / PHOS_LAM) * (DD + PHOS_LAM) / (PHOS_LAM * DD * DD)
    FMH := -HYDRO_STRENGTH * WHY_I(K) * MH * EXP(-HYDRO_ALPHA * (DD - HYDRO_R0))
    WCT := WCO_I(K) * (1.0 - WCI_I(K) + WCI_I(K) * DOCKM)
    FMC := -2.0 * NATIVE_K * WCT * (DD - CR0_I(K))
    FM := MD * (FMS + FMP + FMH + FMC)
    RES_VY(PAIR_BLK(K)) := RES_VY(PAIR_BLK(K)) + FM * DY / DD * DTW * FORCE_SCALE
  ENDDO
  DO K = 1, NSLOT
    KI := PAIR_BLK(K)
    KJ := PAIR_J_I(K)
    DX := RES_X(KI) - RES_X(KJ)
    DY := RES_Y(KI) - RES_Y(KJ)
    DZ := RES_Z(KI) - RES_Z(KJ)
    D := SQRT(DX*DX + DY*DY + DZ*DZ)
    DD := MAX(D, 1.0E-16)
    MD := (1.0 - SIGN(1.0, -D)) * 0.5
    MS := (1.0 - SIGN(1.0, D - STERIC_CUT)) * 0.5
    MH := (1.0 - SIGN(1.0, D - HYDRO_CUTOFF)) * 0.5
    BST := MD * MS * WST_I(K) * STERIC_SIG / DD
    FMS := STERIC_EPS * BST * BST * BST * BST * BST * BST
    FMP := WPH_I(K) * PHOS_EPS * EXP(-DD / PHOS_LAM) * (DD + PHOS_LAM) / (PHOS_LAM * DD * DD)
    FMH := -HYDRO_STRENGTH * WHY_I(K) * MH * EXP(-HYDRO_ALPHA * (DD - HYDRO_R0))
    WCT := WCO_I(K) * (1.0 - WCI_I(K) + WCI_I(K) * DOCKM)
    FMC := -2.0 * NATIVE_K * WCT * (DD - CR0_I(K))
    FM := MD * (FMS + FMP + FMH + FMC)
    RES_VZ(PAIR_BLK(K)) := RES_VZ(PAIR_BLK(K)) + FM * DZ / DD * DTW * FORCE_SCALE
  ENDDO
  ! j-side pass (j-major slot order — segment geometry must group by
  ! the accumulation atom): subtract the same per-pair force.
  DO K = 1, NSLOT
    KJ := PAIR_BLK(K)
    KI := PAIR_I_J(K)
    DX := RES_X(KI) - RES_X(KJ)
    DY := RES_Y(KI) - RES_Y(KJ)
    DZ := RES_Z(KI) - RES_Z(KJ)
    D := SQRT(DX*DX + DY*DY + DZ*DZ)
    DD := MAX(D, 1.0E-16)
    MD := (1.0 - SIGN(1.0, -D)) * 0.5
    MS := (1.0 - SIGN(1.0, D - STERIC_CUT)) * 0.5
    MH := (1.0 - SIGN(1.0, D - HYDRO_CUTOFF)) * 0.5
    BST := MD * MS * WST_J(K) * STERIC_SIG / DD
    FMS := STERIC_EPS * BST * BST * BST * BST * BST * BST
    FMP := WPH_J(K) * PHOS_EPS * EXP(-DD / PHOS_LAM) * (DD + PHOS_LAM) / (PHOS_LAM * DD * DD)
    FMH := -HYDRO_STRENGTH * WHY_J(K) * MH * EXP(-HYDRO_ALPHA * (DD - HYDRO_R0))
    WCT := WCO_J(K) * (1.0 - WCI_J(K) + WCI_J(K) * DOCKM)
    FMC := -2.0 * NATIVE_K * WCT * (DD - CR0_J(K))
    FM := MD * (FMS + FMP + FMH + FMC)
    RES_VX(PAIR_BLK(K)) := RES_VX(PAIR_BLK(K)) + (0.0 - FM) * DX / DD * DTW * FORCE_SCALE
  ENDDO
  DO K = 1, NSLOT
    KJ := PAIR_BLK(K)
    KI := PAIR_I_J(K)
    DX := RES_X(KI) - RES_X(KJ)
    DY := RES_Y(KI) - RES_Y(KJ)
    DZ := RES_Z(KI) - RES_Z(KJ)
    D := SQRT(DX*DX + DY*DY + DZ*DZ)
    DD := MAX(D, 1.0E-16)
    MD := (1.0 - SIGN(1.0, -D)) * 0.5
    MS := (1.0 - SIGN(1.0, D - STERIC_CUT)) * 0.5
    MH := (1.0 - SIGN(1.0, D - HYDRO_CUTOFF)) * 0.5
    BST := MD * MS * WST_J(K) * STERIC_SIG / DD
    FMS := STERIC_EPS * BST * BST * BST * BST * BST * BST
    FMP := WPH_J(K) * PHOS_EPS * EXP(-DD / PHOS_LAM) * (DD + PHOS_LAM) / (PHOS_LAM * DD * DD)
    FMH := -HYDRO_STRENGTH * WHY_J(K) * MH * EXP(-HYDRO_ALPHA * (DD - HYDRO_R0))
    WCT := WCO_J(K) * (1.0 - WCI_J(K) + WCI_J(K) * DOCKM)
    FMC := -2.0 * NATIVE_K * WCT * (DD - CR0_J(K))
    FM := MD * (FMS + FMP + FMH + FMC)
    RES_VY(PAIR_BLK(K)) := RES_VY(PAIR_BLK(K)) + (0.0 - FM) * DY / DD * DTW * FORCE_SCALE
  ENDDO
  DO K = 1, NSLOT
    KJ := PAIR_BLK(K)
    KI := PAIR_I_J(K)
    DX := RES_X(KI) - RES_X(KJ)
    DY := RES_Y(KI) - RES_Y(KJ)
    DZ := RES_Z(KI) - RES_Z(KJ)
    D := SQRT(DX*DX + DY*DY + DZ*DZ)
    DD := MAX(D, 1.0E-16)
    MD := (1.0 - SIGN(1.0, -D)) * 0.5
    MS := (1.0 - SIGN(1.0, D - STERIC_CUT)) * 0.5
    MH := (1.0 - SIGN(1.0, D - HYDRO_CUTOFF)) * 0.5
    BST := MD * MS * WST_J(K) * STERIC_SIG / DD
    FMS := STERIC_EPS * BST * BST * BST * BST * BST * BST
    FMP := WPH_J(K) * PHOS_EPS * EXP(-DD / PHOS_LAM) * (DD + PHOS_LAM) / (PHOS_LAM * DD * DD)
    FMH := -HYDRO_STRENGTH * WHY_J(K) * MH * EXP(-HYDRO_ALPHA * (DD - HYDRO_R0))
    WCT := WCO_J(K) * (1.0 - WCI_J(K) + WCI_J(K) * DOCKM)
    FMC := -2.0 * NATIVE_K * WCT * (DD - CR0_J(K))
    FM := MD * (FMS + FMP + FMH + FMC)
    RES_VZ(PAIR_BLK(K)) := RES_VZ(PAIR_BLK(K)) + (0.0 - FM) * DZ / DD * DTW * FORCE_SCALE
  ENDDO

  

  ! Breakable cystine restraints: harmonic Cα–Cα toward native distance.
  ! CYS_ON(P)=0 models a deleted disulfide (e.g. Akita CysA7Tyr).
  ! E = CSS_K * (D - R0)^2 ; FM = -dE/dD = -2*CSS_K*(D-R0)
  IF NCYSPAIR > 0 THEN
    DO P = 1, NCYSPAIR
      IF CYS_ON(P) = 1 THEN
        I := CYS_I(P)
        J := CYS_J(P)
        DX := RES_X(I) - RES_X(J)
        DY := RES_Y(I) - RES_Y(J)
        DZ := RES_Z(I) - RES_Z(J)
        D := SQRT(DX*DX + DY*DY + DZ*DZ)
        IF D > 0.0 THEN
          FM := -2.0 * CSS_K * (D - CYS_R0(P))
          RES_VX(I) := RES_VX(I) + FM * DX / D * DTW * FORCE_SCALE
          RES_VY(I) := RES_VY(I) + FM * DY / D * DTW * FORCE_SCALE
          RES_VZ(I) := RES_VZ(I) + FM * DZ / D * DTW * FORCE_SCALE
          RES_VX(J) := RES_VX(J) - FM * DX / D * DTW * FORCE_SCALE
          RES_VY(J) := RES_VY(J) - FM * DY / D * DTW * FORCE_SCALE
          RES_VZ(J) := RES_VZ(J) - FM * DZ / D * DTW * FORCE_SCALE
        ENDIF
      ENDIF
    ENDDO
  ENDIF

  ! Disulfide mispairing: competing non-native restraints (same harmonic form)
  IF NMISPAIR > 0 THEN
    DO P = 1, NMISPAIR
      I := MIS_I(P)
      J := MIS_J(P)
      DX := RES_X(I) - RES_X(J)
      DY := RES_Y(I) - RES_Y(J)
      DZ := RES_Z(I) - RES_Z(J)
      D := SQRT(DX*DX + DY*DY + DZ*DZ)
      IF D > 0.0 THEN
        FM := -2.0 * MIS_KK(P) * (D - MIS_R0(P))
        RES_VX(I) := RES_VX(I) + FM * DX / D * DTW * FORCE_SCALE
        RES_VY(I) := RES_VY(I) + FM * DY / D * DTW * FORCE_SCALE
        RES_VZ(I) := RES_VZ(I) + FM * DZ / D * DTW * FORCE_SCALE
        RES_VX(J) := RES_VX(J) - FM * DX / D * DTW * FORCE_SCALE
        RES_VY(J) := RES_VY(J) - FM * DY / D * DTW * FORCE_SCALE
        RES_VZ(J) := RES_VZ(J) - FM * DZ / D * DTW * FORCE_SCALE
      ENDIF
    ENDDO
  ENDIF

  ! Morse bonds (backbone)
  DO I = 1, NRES-1
    IF I /= CHAIN_BREAK .AND. I /= CHAIN_BREAK2 .AND. I /= CHAIN_BREAK3 THEN
    DX := RES_X(I) - RES_X(I+1)
    DY := RES_Y(I) - RES_Y(I+1)
    DZ := RES_Z(I) - RES_Z(I+1)
    D := SQRT(DX*DX + DY*DY + DZ*DZ)
    IF D > 0.0 THEN
      E := EXP(-MORSE_A * (D - BACKBONE_R0))
      FM := -2.0 * BACKBONE_D * MORSE_A * (1.0 - E) * E * FORCE_SCALE
      RES_VX(I) := RES_VX(I) + FM * DX / D * DTW
      RES_VY(I) := RES_VY(I) + FM * DY / D * DTW
      RES_VZ(I) := RES_VZ(I) + FM * DZ / D * DTW
      RES_VX(I+1) := RES_VX(I+1) - FM * DX / D * DTW
      RES_VY(I+1) := RES_VY(I+1) - FM * DY / D * DTW
      RES_VZ(I+1) := RES_VZ(I+1) - FM * DZ / D * DTW
    ENDIF
    ENDIF
  ENDDO

  ! NOTE: dynamic H-bond force temporarily disabled for Trp-cage sweep

  ! Angle bending (backbone angles)
  DO I = 2, NRES-1
    IF I /= CHAIN_BREAK .AND. I /= CHAIN_BREAK + 1 .AND. I /= CHAIN_BREAK2 .AND. I /= CHAIN_BREAK2 + 1 .AND. I /= CHAIN_BREAK3 .AND. I /= CHAIN_BREAK3 + 1 THEN
    BX := RES_X(I-1) - RES_X(I)
    BY := RES_Y(I-1) - RES_Y(I)
    BZ := RES_Z(I-1) - RES_Z(I)
    CX := RES_X(I+1) - RES_X(I)
    CY := RES_Y(I+1) - RES_Y(I)
    CZ := RES_Z(I+1) - RES_Z(I)
    UN := SQRT(BX*BX + BY*BY + BZ*BZ)
    VN := SQRT(CX*CX + CY*CY + CZ*CZ)
    IF UN > 1.0E-12 .AND. VN > 1.0E-12 THEN
      CS := MAX(-1.0, MIN(1.0, (BX*CX + BY*CY + BZ*CZ) / (UN * VN)))
      E := 2.0 * RES_ANGK(I) * (CS - COS(RES_ANGT0(I)))
      UX := (CX / (UN * VN) - CS * BX / UN / UN)
      UY := (CY / (UN * VN) - CS * BY / UN / UN)
      UZ := (CZ / (UN * VN) - CS * BZ / UN / UN)
      WX := (BX / (UN * VN) - CS * CX / VN / VN)
      WY := (BY / (UN * VN) - CS * CY / VN / VN)
      WZ := (BZ / (UN * VN) - CS * CZ / VN / VN)
      RES_VX(I-1) := RES_VX(I-1) - E * UX * DTW * FORCE_SCALE
      RES_VY(I-1) := RES_VY(I-1) - E * UY * DTW * FORCE_SCALE
      RES_VZ(I-1) := RES_VZ(I-1) - E * UZ * DTW * FORCE_SCALE
      RES_VX(I+1) := RES_VX(I+1) - E * WX * DTW * FORCE_SCALE
      RES_VY(I+1) := RES_VY(I+1) - E * WY * DTW * FORCE_SCALE
      RES_VZ(I+1) := RES_VZ(I+1) - E * WZ * DTW * FORCE_SCALE
      RES_VX(I) := RES_VX(I) + (E * UX + E * WX) * DTW * FORCE_SCALE
      RES_VY(I) := RES_VY(I) + (E * UY + E * WY) * DTW * FORCE_SCALE
      RES_VZ(I) := RES_VZ(I) + (E * UZ + E * WZ) * DTW * FORCE_SCALE
    ENDIF
    ENDIF
  ENDDO

  ! Torsion (dihedral) angles
  DO I = 2, NRES-2
    IF I /= CHAIN_BREAK - 1 .AND. I /= CHAIN_BREAK .AND. I /= CHAIN_BREAK + 1 .AND. I /= CHAIN_BREAK2 - 1 .AND. I /= CHAIN_BREAK2 .AND. I /= CHAIN_BREAK2 + 1 .AND. I /= CHAIN_BREAK3 - 1 .AND. I /= CHAIN_BREAK3 .AND. I /= CHAIN_BREAK3 + 1 THEN
    B1X := RES_X(I) - RES_X(I-1)
    B1Y := RES_Y(I) - RES_Y(I-1)
    B1Z := RES_Z(I) - RES_Z(I-1)
    B2X := RES_X(I+1) - RES_X(I)
    B2Y := RES_Y(I+1) - RES_Y(I)
    B2Z := RES_Z(I+1) - RES_Z(I)
    B3X := RES_X(I+2) - RES_X(I+1)
    B3Y := RES_Y(I+2) - RES_Y(I+1)
    B3Z := RES_Z(I+2) - RES_Z(I+1)

    N1X := B1Y*B2Z - B1Z*B2Y
    N1Y := B1Z*B2X - B1X*B2Z
    N1Z := B1X*B2Y - B1Y*B2X
    N2X := B2Y*B3Z - B2Z*B3Y
    N2Y := B2Z*B3X - B2X*B3Z
    N2Z := B2X*B3Y - B2Y*B3X

    N1MAG2 := N1X*N1X + N1Y*N1Y + N1Z*N1Z
    N2MAG2 := N2X*N2X + N2Y*N2Y + N2Z*N2Z
    B2MAG := SQRT(B2X*B2X + B2Y*B2Y + B2Z*B2Z)

    IF N1MAG2 > 1.0E-12 .AND. N2MAG2 > 1.0E-12 .AND. B2MAG > 1.0E-12 THEN
      N1MAG := SQRT(N1MAG2)
      N2MAG := SQRT(N2MAG2)
      PHI := ATAN2(B2MAG*(B1X*N2X + B1Y*N2Y + B1Z*N2Z), N1X*N2X + N1Y*N2Y + N1Z*N2Z)
      E := 2.0 * RES_TORSK(I) * (1.0 - COS(PHI - RES_TORSP0(I)))

      DPHI_DR1X := -B2MAG / N1MAG2 * N1X
      DPHI_DR1Y := -B2MAG / N1MAG2 * N1Y
      DPHI_DR1Z := -B2MAG / N1MAG2 * N1Z

      DPHI_DR4X := B2MAG / N2MAG2 * N2X
      DPHI_DR4Y := B2MAG / N2MAG2 * N2Y
      DPHI_DR4Z := B2MAG / N2MAG2 * N2Z

      B1DOT := B1X*B2X + B1Y*B2Y + B1Z*B2Z
      B3DOT := B3X*B2X + B3Y*B2Y + B3Z*B2Z
      SCALE_B2 := 1.0 / (B2MAG * B2MAG)
      SCALE_B1 := B1DOT * SCALE_B2
      SCALE_B3 := B3DOT * SCALE_B2

      DPHI_DR2X := -(1.0 + SCALE_B1) * DPHI_DR1X + SCALE_B3 * DPHI_DR4X
      DPHI_DR2Y := -(1.0 + SCALE_B1) * DPHI_DR1Y + SCALE_B3 * DPHI_DR4Y
      DPHI_DR2Z := -(1.0 + SCALE_B1) * DPHI_DR1Z + SCALE_B3 * DPHI_DR4Z

      DPHI_DR3X := -(DPHI_DR1X + DPHI_DR2X + DPHI_DR4X)
      DPHI_DR3Y := -(DPHI_DR1Y + DPHI_DR2Y + DPHI_DR4Y)
      DPHI_DR3Z := -(DPHI_DR1Z + DPHI_DR2Z + DPHI_DR4Z)

      F := -2.0 * RES_TORSK(I) * SIN(PHI - RES_TORSP0(I))

      RES_VX(I-1) := RES_VX(I-1) + F * DPHI_DR1X * DTW * FORCE_SCALE
      RES_VY(I-1) := RES_VY(I-1) + F * DPHI_DR1Y * DTW * FORCE_SCALE
      RES_VZ(I-1) := RES_VZ(I-1) + F * DPHI_DR1Z * DTW * FORCE_SCALE

      RES_VX(I) := RES_VX(I) + F * DPHI_DR2X * DTW * FORCE_SCALE
      RES_VY(I) := RES_VY(I) + F * DPHI_DR2Y * DTW * FORCE_SCALE
      RES_VZ(I) := RES_VZ(I) + F * DPHI_DR2Z * DTW * FORCE_SCALE

      RES_VX(I+1) := RES_VX(I+1) + F * DPHI_DR3X * DTW * FORCE_SCALE
      RES_VY(I+1) := RES_VY(I+1) + F * DPHI_DR3Y * DTW * FORCE_SCALE
      RES_VZ(I+1) := RES_VZ(I+1) + F * DPHI_DR3Z * DTW * FORCE_SCALE

      RES_VX(I+2) := RES_VX(I+2) + F * DPHI_DR4X * DTW * FORCE_SCALE
      RES_VY(I+2) := RES_VY(I+2) + F * DPHI_DR4Y * DTW * FORCE_SCALE
      RES_VZ(I+2) := RES_VZ(I+2) + F * DPHI_DR4Z * DTW * FORCE_SCALE
    ENDIF
    ENDIF
  ENDDO

  

  ! ── Oriented-residue dynamics (Cosserat ribbon) ──────────────────
  IF FRAME_K > 0.0 .OR. FRAME_POS_K > 0.0 .OR. FRAME_CL_K > 0.0 THEN

    ! Neighbor alignment torques: error = (q_i^-1 x q_i+1) (x) (target)^-1
    IF FRAME_K > 0.0 THEN
      DO I = 1, NRES-1
        IF I /= CHAIN_BREAK .AND. I /= CHAIN_BREAK2 .AND. I /= CHAIN_BREAK3 THEN
        ! dq = conj(q_i) (x) q_i+1
        QW0 := RES_Q0(I)*RES_Q0(I+1) + RES_Q1(I)*RES_Q1(I+1) + RES_Q2(I)*RES_Q2(I+1) + RES_Q3(I)*RES_Q3(I+1)
        QW1 := RES_Q0(I)*RES_Q1(I+1) - RES_Q1(I)*RES_Q0(I+1) - RES_Q2(I)*RES_Q3(I+1) + RES_Q3(I)*RES_Q2(I+1)
        QW2 := RES_Q0(I)*RES_Q2(I+1) + RES_Q1(I)*RES_Q3(I+1) - RES_Q2(I)*RES_Q0(I+1) - RES_Q3(I)*RES_Q1(I+1)
        QW3 := RES_Q0(I)*RES_Q3(I+1) - RES_Q1(I)*RES_Q2(I+1) + RES_Q2(I)*RES_Q1(I+1) - RES_Q3(I)*RES_Q0(I+1)
        ! target relative frame dq* = conj(q*_i) (x) q*_i+1
        QE0 := NATIVE_Q0(I)*NATIVE_Q0(I+1) + NATIVE_Q1(I)*NATIVE_Q1(I+1) + NATIVE_Q2(I)*NATIVE_Q2(I+1) + NATIVE_Q3(I)*NATIVE_Q3(I+1)
        QE1 := NATIVE_Q0(I)*NATIVE_Q1(I+1) - NATIVE_Q1(I)*NATIVE_Q0(I+1) - NATIVE_Q2(I)*NATIVE_Q3(I+1) + NATIVE_Q3(I)*NATIVE_Q2(I+1)
        QE2 := NATIVE_Q0(I)*NATIVE_Q2(I+1) + NATIVE_Q1(I)*NATIVE_Q3(I+1) - NATIVE_Q2(I)*NATIVE_Q0(I+1) - NATIVE_Q3(I)*NATIVE_Q1(I+1)
        QE3 := NATIVE_Q0(I)*NATIVE_Q3(I+1) - NATIVE_Q1(I)*NATIVE_Q2(I+1) + NATIVE_Q2(I)*NATIVE_Q1(I+1) - NATIVE_Q3(I)*NATIVE_Q0(I+1)
        ! error e = dq (x) conj(dq*)
        EQ0 := QW0*QE0 + QW1*QE1 + QW2*QE2 + QW3*QE3
        EQ1 := QW1*QE0 - QW0*QE1 + QW2*QE3 - QW3*QE2
        EQ2 := QW2*QE0 - QW0*QE2 + QW3*QE1 - QW1*QE3
        EQ3 := QW3*QE0 - QW0*QE3 + QW1*QE2 - QW2*QE1
        ! shortest-rotation branch
        QSGN := 1.0
        IF EQ0 < 0.0 THEN
          QSGN := -1.0
        ENDIF
        ! torque (world-frame, small-angle): 2*K*Im(e)*sgn
        TQX := 2.0 * FRAME_K * EQ1 * QSGN
        TQY := 2.0 * FRAME_K * EQ2 * QSGN
        TQZ := 2.0 * FRAME_K * EQ3 * QSGN
        RES_WX(I+1) := RES_WX(I+1) - TQX * DTW
        RES_WY(I+1) := RES_WY(I+1) - TQY * DTW
        RES_WZ(I+1) := RES_WZ(I+1) - TQZ * DTW
        RES_WX(I) := RES_WX(I) + TQX * DTW
        RES_WY(I) := RES_WY(I) + TQY * DTW
        RES_WZ(I) := RES_WZ(I) + TQZ * DTW
        ENDIF
      ENDDO
    ENDIF

    ! Damp + integrate angular velocity into orientation: q += 0.5*DTW*(w x q)
    DO I = 1, NRES
      RES_WX(I) := RES_WX(I) * FDAMP_SUB
      RES_WY(I) := RES_WY(I) * FDAMP_SUB
      RES_WZ(I) := RES_WZ(I) * FDAMP_SUB
      QW0 := -RES_WX(I)*RES_Q1(I) - RES_WY(I)*RES_Q2(I) - RES_WZ(I)*RES_Q3(I)
      QW1 :=  RES_WX(I)*RES_Q0(I) + RES_WY(I)*RES_Q3(I) - RES_WZ(I)*RES_Q2(I)
      QW2 :=  RES_WY(I)*RES_Q0(I) - RES_WX(I)*RES_Q3(I) + RES_WZ(I)*RES_Q1(I)
      QW3 :=  RES_WZ(I)*RES_Q0(I) + RES_WX(I)*RES_Q2(I) - RES_WY(I)*RES_Q1(I)
      RES_Q0(I) := RES_Q0(I) + 0.5 * DTW * QW0
      RES_Q1(I) := RES_Q1(I) + 0.5 * DTW * QW1
      RES_Q2(I) := RES_Q2(I) + 0.5 * DTW * QW2
      RES_Q3(I) := RES_Q3(I) + 0.5 * DTW * QW3
      QNORM := SQRT(RES_Q0(I)**2 + RES_Q1(I)**2 + RES_Q2(I)**2 + RES_Q3(I)**2)
      IF QNORM > 0.0 THEN
        RES_Q0(I) := RES_Q0(I) / QNORM
        RES_Q1(I) := RES_Q1(I) / QNORM
        RES_Q2(I) := RES_Q2(I) / QNORM
        RES_Q3(I) := RES_Q3(I) / QNORM
      ENDIF
    ENDDO

    ! Orientation->position coupling: pull p_i+1 toward p_i + R(q_i).v*_i
    IF FRAME_POS_K > 0.0 THEN
      DO I = 1, NRES-1
        IF I /= CHAIN_BREAK .AND. I /= CHAIN_BREAK2 .AND. I /= CHAIN_BREAK3 THEN
        FR11 := RES_Q0(I)**2 + RES_Q1(I)**2 - RES_Q2(I)**2 - RES_Q3(I)**2
        FR12 := 2.0 * (RES_Q1(I)*RES_Q2(I) - RES_Q0(I)*RES_Q3(I))
        FR13 := 2.0 * (RES_Q1(I)*RES_Q3(I) + RES_Q0(I)*RES_Q2(I))
        FR21 := 2.0 * (RES_Q1(I)*RES_Q2(I) + RES_Q0(I)*RES_Q3(I))
        FR22 := RES_Q0(I)**2 - RES_Q1(I)**2 + RES_Q2(I)**2 - RES_Q3(I)**2
        FR23 := 2.0 * (RES_Q2(I)*RES_Q3(I) - RES_Q0(I)*RES_Q1(I))
        FR31 := 2.0 * (RES_Q1(I)*RES_Q3(I) - RES_Q0(I)*RES_Q2(I))
        FR32 := 2.0 * (RES_Q2(I)*RES_Q3(I) + RES_Q0(I)*RES_Q1(I))
        FR33 := RES_Q0(I)**2 - RES_Q1(I)**2 - RES_Q2(I)**2 + RES_Q3(I)**2
        HBX := FR11*NATIVE_BVX(I) + FR12*NATIVE_BVY(I) + FR13*NATIVE_BVZ(I)
        HBY := FR21*NATIVE_BVX(I) + FR22*NATIVE_BVY(I) + FR23*NATIVE_BVZ(I)
        HBZ := FR31*NATIVE_BVX(I) + FR32*NATIVE_BVY(I) + FR33*NATIVE_BVZ(I)
        PFX := FRAME_POS_K * (RES_X(I) + HBX - RES_X(I+1))
        PFY := FRAME_POS_K * (RES_Y(I) + HBY - RES_Y(I+1))
        PFZ := FRAME_POS_K * (RES_Z(I) + HBZ - RES_Z(I+1))
        RES_VX(I+1) := RES_VX(I+1) + PFX * DTW * FORCE_SCALE
        RES_VY(I+1) := RES_VY(I+1) + PFY * DTW * FORCE_SCALE
        RES_VZ(I+1) := RES_VZ(I+1) + PFZ * DTW * FORCE_SCALE
        RES_VX(I) := RES_VX(I) - PFX * DTW * FORCE_SCALE
        RES_VY(I) := RES_VY(I) - PFY * DTW * FORCE_SCALE
        RES_VZ(I) := RES_VZ(I) - PFZ * DTW * FORCE_SCALE
        ENDIF
      ENDDO
    ENDIF

    ! Contact-layer coupling: p_j pulled toward p_i + R(q_i).v*_ij
    ! (same rotation recipe as FRAME_POS_K, packed contact list)
    IF FRAME_CL_K > 0.0 .AND. NCL > 0 THEN
      DO P = 1, NCL
        I := CL_I(P)
        J := CL_J(P)
        IF CONTACT_INTER(I, J) = 0 .OR. FRAME > DOCK_FROM THEN
        FR11 := RES_Q0(I)**2 + RES_Q1(I)**2 - RES_Q2(I)**2 - RES_Q3(I)**2
        FR12 := 2.0 * (RES_Q1(I)*RES_Q2(I) - RES_Q0(I)*RES_Q3(I))
        FR13 := 2.0 * (RES_Q1(I)*RES_Q3(I) + RES_Q0(I)*RES_Q2(I))
        FR21 := 2.0 * (RES_Q1(I)*RES_Q2(I) + RES_Q0(I)*RES_Q3(I))
        FR22 := RES_Q0(I)**2 - RES_Q1(I)**2 + RES_Q2(I)**2 - RES_Q3(I)**2
        FR23 := 2.0 * (RES_Q2(I)*RES_Q3(I) - RES_Q0(I)*RES_Q1(I))
        FR31 := 2.0 * (RES_Q1(I)*RES_Q3(I) - RES_Q0(I)*RES_Q2(I))
        FR32 := 2.0 * (RES_Q2(I)*RES_Q3(I) + RES_Q0(I)*RES_Q1(I))
        FR33 := RES_Q0(I)**2 - RES_Q1(I)**2 - RES_Q2(I)**2 + RES_Q3(I)**2
        HBX := FR11*CL_VX(P) + FR12*CL_VY(P) + FR13*CL_VZ(P)
        HBY := FR21*CL_VX(P) + FR22*CL_VY(P) + FR23*CL_VZ(P)
        HBZ := FR31*CL_VX(P) + FR32*CL_VY(P) + FR33*CL_VZ(P)
        PFX := FRAME_CL_K * (RES_X(I) + HBX - RES_X(J))
        PFY := FRAME_CL_K * (RES_Y(I) + HBY - RES_Y(J))
        PFZ := FRAME_CL_K * (RES_Z(I) + HBZ - RES_Z(J))
        RES_VX(J) := RES_VX(J) + PFX * DTW * FORCE_SCALE
        RES_VY(J) := RES_VY(J) + PFY * DTW * FORCE_SCALE
        RES_VZ(J) := RES_VZ(J) + PFZ * DTW * FORCE_SCALE
        RES_VX(I) := RES_VX(I) - PFX * DTW * FORCE_SCALE
        RES_VY(I) := RES_VY(I) - PFY * DTW * FORCE_SCALE
        RES_VZ(I) := RES_VZ(I) - PFZ * DTW * FORCE_SCALE
        ENDIF
      ENDDO
    ENDIF
  ENDIF

  ! Velocity damping (per-substep: DAMP_SUB = VELOCITY_DAMP^(1/NSUB))
  DO I = 1, NRES
    RES_VX(I) := RES_VX(I) * DAMP_SUB
    RES_VY(I) := RES_VY(I) * DAMP_SUB
    RES_VZ(I) := RES_VZ(I) * DAMP_SUB
  ENDDO



  ! Position update
  DO I = 1, NRES
    RES_X(I) := RES_X(I) + RES_VX(I) * DTW
    RES_Y(I) := RES_Y(I) + RES_VY(I) * DTW
    RES_Z(I) := RES_Z(I) + RES_VZ(I) * DTW
  ENDDO
  ENDDO

  ! ── Domain rigid-body quaternion MC (post-gate) ─────────────────
  ! Nested IFs: MOD(FRAME, MC_EVERY) must never evaluate with MC_EVERY = 0.
  IF MC_EVERY > 0 THEN
    IF NDOM > 1 .AND. FRAME > DOCK_FROM THEN
      IF MOD(FRAME, MC_EVERY) = 0 THEN
        ! Anneal MC_TEMP -> 0 over the first 60% of the post-gate window
        MCFRAC := REAL(FRAME - DOCK_FROM) / REAL(MAXFRAME - DOCK_FROM)
        MCT := MC_TEMP * MAX(0.0, 1.0 - MCFRAC / 0.6)
        DO IDOM = 1, NDOM
          DA := DOM_BEG(IDOM)
          DB := DOM_END(IDOM)

          ! Domain centre of mass
          MCCX := 0.0
          MCCY := 0.0
          MCCZ := 0.0
          DO I = DA, DB
            MCCX := MCCX + RES_X(I)
            MCCY := MCCY + RES_Y(I)
            MCCZ := MCCZ + RES_Z(I)
          ENDDO
          MCDOM := REAL(DB - DA + 1)
          MCCX := MCCX / MCDOM
          MCCY := MCCY / MCDOM
          MCCZ := MCCZ / MCDOM

          ! Hash-deterministic rotation axis + angle in [-MC_ANGLE, MC_ANGLE]
          MCAX := SIN(REAL(FRAME) * 0.371 + REAL(IDOM) * 1.713)
          MCAY := SIN(REAL(FRAME) * 0.517 + REAL(IDOM) * 2.317)
          MCAZ := SIN(REAL(FRAME) * 0.733 + REAL(IDOM) * 1.117)
          MCAN := SQRT(MCAX*MCAX + MCAY*MCAY + MCAZ*MCAZ)
          MCAX := MCAX / MCAN
          MCAY := MCAY / MCAN
          MCAZ := MCAZ / MCAN
          MCANG := MC_ANGLE * SIN(REAL(FRAME) * 0.173 + REAL(IDOM) * 2.913)
          MCQ0 := COS(MCANG * 0.5)
          MCS2 := SIN(MCANG * 0.5)
          MCQ1 := MCAX * MCS2
          MCQ2 := MCAY * MCS2
          MCQ3 := MCAZ * MCS2

          ! Rotation matrix from unit quaternion
          MCR11 := MCQ0*MCQ0 + MCQ1*MCQ1 - MCQ2*MCQ2 - MCQ3*MCQ3
          MCR12 := 2.0 * (MCQ1*MCQ2 - MCQ0*MCQ3)
          MCR13 := 2.0 * (MCQ1*MCQ3 + MCQ0*MCQ2)
          MCR21 := 2.0 * (MCQ1*MCQ2 + MCQ0*MCQ3)
          MCR22 := MCQ0*MCQ0 - MCQ1*MCQ1 + MCQ2*MCQ2 - MCQ3*MCQ3
          MCR23 := 2.0 * (MCQ2*MCQ3 - MCQ0*MCQ1)
          MCR31 := 2.0 * (MCQ1*MCQ3 - MCQ0*MCQ2)
          MCR32 := 2.0 * (MCQ2*MCQ3 + MCQ0*MCQ1)
          MCR33 := MCQ0*MCQ0 - MCQ1*MCQ1 - MCQ2*MCQ2 + MCQ3*MCQ3

          ! E_before: inter-domain Go + steric pairs (i in domain, j outside)
          MCEBF := 0.0
          DO I = DA, DB
            DO J = 1, NRES
              IF J < DA .OR. J > DB THEN
                DX := RES_X(I) - RES_X(J)
                DY := RES_Y(I) - RES_Y(J)
                DZ := RES_Z(I) - RES_Z(J)
                D := SQRT(DX*DX + DY*DY + DZ*DZ)
                IF D > 0.0 THEN
                  IF NATIVE_CONTACT(I, J) = 1 THEN
                    MCEBF := MCEBF + NATIVE_K * (D - NATIVE_R0(I, J))**2
                  ENDIF
                  IF ABS(I - J) >= 4 .AND. D < STERIC_CUT THEN
                    MCEBF := MCEBF + STERIC_EPS * (STERIC_SIG / D) ** 6
                  ENDIF
                  IF ABS(I - J) >= 4 .AND. PHOS_EPS > 0.0 .AND. RES_PHOS(I) > 0.0 .AND. RES_PHOS(J) > 0.0 THEN
                    MCEBF := MCEBF + PHOS_EPS * EXP(-D / PHOS_LAM) / D
                  ENDIF
                ENDIF
              ENDIF
            ENDDO
          ENDDO

          ! Save domain positions, apply rigid rotation about COM
          DO I = DA, DB
            MC_OX(I) := RES_X(I)
            MC_OY(I) := RES_Y(I)
            MC_OZ(I) := RES_Z(I)
          ENDDO
          DO I = DA, DB
            MCRX := RES_X(I) - MCCX
            MCRY := RES_Y(I) - MCCY
            MCRZ := RES_Z(I) - MCCZ
            RES_X(I) := MCCX + MCR11*MCRX + MCR12*MCRY + MCR13*MCRZ
            RES_Y(I) := MCCY + MCR21*MCRX + MCR22*MCRY + MCR23*MCRZ
            RES_Z(I) := MCCZ + MCR31*MCRX + MCR32*MCRY + MCR33*MCRZ
          ENDDO

          ! E_after
          MCEAF := 0.0
          DO I = DA, DB
            DO J = 1, NRES
              IF J < DA .OR. J > DB THEN
                DX := RES_X(I) - RES_X(J)
                DY := RES_Y(I) - RES_Y(J)
                DZ := RES_Z(I) - RES_Z(J)
                D := SQRT(DX*DX + DY*DY + DZ*DZ)
                IF D > 0.0 THEN
                  IF NATIVE_CONTACT(I, J) = 1 THEN
                    MCEAF := MCEAF + NATIVE_K * (D - NATIVE_R0(I, J))**2
                  ENDIF
                  IF ABS(I - J) >= 4 .AND. D < STERIC_CUT THEN
                    MCEAF := MCEAF + STERIC_EPS * (STERIC_SIG / D) ** 6
                  ENDIF
                  IF ABS(I - J) >= 4 .AND. PHOS_EPS > 0.0 .AND. RES_PHOS(I) > 0.0 .AND. RES_PHOS(J) > 0.0 THEN
                    MCEAF := MCEAF + PHOS_EPS * EXP(-D / PHOS_LAM) / D
                  ENDIF
                ENDIF
              ENDIF
            ENDDO
          ENDDO

          ! Metropolis accept (MCT=0 reduces to greedy): rotate velocities
          ! rigidly on accept; else restore positions
          MCDE := MCEAF - MCEBF
          IF MCDE > 0.0 .AND. MCT > 0.0 THEN
            MCH := 0.5 * (1.0 + SIN(REAL(FRAME) * 0.917 + REAL(IDOM) * 3.791))
            IF MCH < EXP(-MCDE / MCT) THEN
              MCDE := 0.0
            ENDIF
          ENDIF
          IF MCDE <= 0.0 THEN
            DO I = DA, DB
              MCRX := RES_VX(I)
              MCRY := RES_VY(I)
              MCRZ := RES_VZ(I)
              RES_VX(I) := MCR11*MCRX + MCR12*MCRY + MCR13*MCRZ
              RES_VY(I) := MCR21*MCRX + MCR22*MCRY + MCR23*MCRZ
              RES_VZ(I) := MCR31*MCRX + MCR32*MCRY + MCR33*MCRZ
            ENDDO
          ELSE
            DO I = DA, DB
              RES_X(I) := MC_OX(I)
              RES_Y(I) := MC_OY(I)
              RES_Z(I) := MC_OZ(I)
            ENDDO
          ENDIF

          ! Rigid translation attempt (same greedy rule; positions only)
          MCTX := MC_TRANS * SIN(REAL(FRAME) * 0.271 + REAL(IDOM) * 1.313)
          MCTY := MC_TRANS * SIN(REAL(FRAME) * 0.419 + REAL(IDOM) * 2.117)
          MCTZ := MC_TRANS * SIN(REAL(FRAME) * 0.631 + REAL(IDOM) * 1.917)

          MCEBF := 0.0
          DO I = DA, DB
            DO J = 1, NRES
              IF J < DA .OR. J > DB THEN
                DX := RES_X(I) - RES_X(J)
                DY := RES_Y(I) - RES_Y(J)
                DZ := RES_Z(I) - RES_Z(J)
                D := SQRT(DX*DX + DY*DY + DZ*DZ)
                IF D > 0.0 THEN
                  IF NATIVE_CONTACT(I, J) = 1 THEN
                    MCEBF := MCEBF + NATIVE_K * (D - NATIVE_R0(I, J))**2
                  ENDIF
                  IF ABS(I - J) >= 4 .AND. D < STERIC_CUT THEN
                    MCEBF := MCEBF + STERIC_EPS * (STERIC_SIG / D) ** 6
                  ENDIF
                  IF ABS(I - J) >= 4 .AND. PHOS_EPS > 0.0 .AND. RES_PHOS(I) > 0.0 .AND. RES_PHOS(J) > 0.0 THEN
                    MCEBF := MCEBF + PHOS_EPS * EXP(-D / PHOS_LAM) / D
                  ENDIF
                ENDIF
              ENDIF
            ENDDO
          ENDDO

          DO I = DA, DB
            MC_OX(I) := RES_X(I)
            MC_OY(I) := RES_Y(I)
            MC_OZ(I) := RES_Z(I)
            RES_X(I) := RES_X(I) + MCTX
            RES_Y(I) := RES_Y(I) + MCTY
            RES_Z(I) := RES_Z(I) + MCTZ
          ENDDO

          MCEAF := 0.0
          DO I = DA, DB
            DO J = 1, NRES
              IF J < DA .OR. J > DB THEN
                DX := RES_X(I) - RES_X(J)
                DY := RES_Y(I) - RES_Y(J)
                DZ := RES_Z(I) - RES_Z(J)
                D := SQRT(DX*DX + DY*DY + DZ*DZ)
                IF D > 0.0 THEN
                  IF NATIVE_CONTACT(I, J) = 1 THEN
                    MCEAF := MCEAF + NATIVE_K * (D - NATIVE_R0(I, J))**2
                  ENDIF
                  IF ABS(I - J) >= 4 .AND. D < STERIC_CUT THEN
                    MCEAF := MCEAF + STERIC_EPS * (STERIC_SIG / D) ** 6
                  ENDIF
                  IF ABS(I - J) >= 4 .AND. PHOS_EPS > 0.0 .AND. RES_PHOS(I) > 0.0 .AND. RES_PHOS(J) > 0.0 THEN
                    MCEAF := MCEAF + PHOS_EPS * EXP(-D / PHOS_LAM) / D
                  ENDIF
                ENDIF
              ENDIF
            ENDDO
          ENDDO

          MCDE := MCEAF - MCEBF
          IF MCDE > 0.0 .AND. MCT > 0.0 THEN
            MCH := 0.5 * (1.0 + SIN(REAL(FRAME) * 0.791 + REAL(IDOM) * 2.573))
            IF MCH < EXP(-MCDE / MCT) THEN
              MCDE := 0.0
            ENDIF
          ENDIF
          IF MCDE > 0.0 THEN
            DO I = DA, DB
              RES_X(I) := MC_OX(I)
              RES_Y(I) := MC_OY(I)
              RES_Z(I) := MC_OZ(I)
            ENDDO
          ENDIF
        ENDDO
      ENDIF
    ENDIF
  ENDIF

  ! H-bond update
  CALL UPDATE_HBONDS()

  ! Thermal schedule
  CALL UPDATE_THERMAL(FRAME)

  ! Output every 10 frames
  IF MOD(FRAME, 10) = 0 .OR. FRAME = MAXFRAME THEN
    CALL COMPUTE_DIAGNOSTICS()
    CALL COMPUTE_RMSD()
    CALL COMPUTE_RMSD_CHAINS()
    WRITE(*, "%d,%.4f,%.4f,%d,%d,%d,%d,%.2f,%.2f,%.2f,%.3f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f") &
      FRAME, RGYR, E2E, NHBOND, I3CNT, I4CNT, ILCNT, BANG_MEAN, BANG_RMS, TORS_MEAN, &
      ALPHA_FRAC, E_MORSE, E_ANGLE, E_TORSION, E_HYDRO, E_NATIVE, THERMAL_CURRENT, RMSD_NATIVE, &
      RMSD_CHAIN(1), RMSD_CHAIN(2), RMSD_CHAIN(3), RMSD_CHAIN(4)
  ENDIF

ENDDO

! Final structure dump for gap analysis
WRITE(*, "FINAL_STRUCTURE")
DO I = 1, NRES
  WRITE(*, "%d,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f") &
    I, RES_X(I), RES_Y(I), RES_Z(I), NATIVE_X(I), NATIVE_Y(I), NATIVE_Z(I)
ENDDO
WRITE(*, "END_FINAL_STRUCTURE")

STOP

! ════════════════════════════════════════════════════════════
! SUBROUTINES
! ════════════════════════════════════════════════════════════

SUBROUTINE INIT_CHAIN()
  INTEGER :: I, ATT, J2, OK
  REAL :: TH0, OM0, R
  REAL :: U1, U2, COSTH, SINTH, PHI2, UX, UY, UZ, CANDX, CANDY, CANDZ, DD

  ! Self-avoiding random walk coil (denatured start)
  RES_X(1) := 10.0
  RES_Y(1) := 10.0
  RES_Z(1) := 10.0
  DO I = 2, NRES
    OK := 0
    ATT := 0
    DO WHILE ATT < 20
      ATT := ATT + 1
      U1 := MOD(ABS(SIN(REAL(I) * 12.9898 + REAL(ATT) * 3.7 + SEED) * 43758.5453), 1.0)
      U2 := MOD(ABS(SIN(REAL(I) * 78.2330 + REAL(ATT) * 1.3 + SEED) * 12543.1230), 1.0)
      COSTH := 2.0 * U1 - 1.0
      SINTH := SQRT(1.0 - COSTH * COSTH)
      PHI2 := 2.0 * 3.14159265 * U2
      UX := SINTH * COS(PHI2)
      UY := SINTH * SIN(PHI2)
      UZ := COSTH
      CANDX := RES_X(I - 1) + UX * BACKBONE_R0
      CANDY := RES_Y(I - 1) + UY * BACKBONE_R0
      CANDZ := RES_Z(I - 1) + UZ * BACKBONE_R0
      OK := 1
      IF I ≥ 5 THEN
        DO J2 = 1, I - 4
          DD := SQRT((CANDX - RES_X(J2))**2 + (CANDY - RES_Y(J2))**2 + (CANDZ - RES_Z(J2))**2)
          IF DD < 1.55 THEN
            OK := 0
          ENDIF
        ENDDO
      ENDIF
      IF OK = 1 THEN
        ATT := 20
      ENDIF
    ENDDO
    RES_X(I) := CANDX
    RES_Y(I) := CANDY
    RES_Z(I) := CANDZ
  ENDDO

  ! Phases from position hash; zero velocities
  DO I = 1, NRES
    RES_THETA(I) := 0.3 * RES_X(I) + 0.5 * RES_Y(I) + 0.7 * RES_Z(I) + SEED
    RES_OMEGA(I) := BASE_OMEGA + 0.5 * SIN(RES_THETA(I))
    RES_VX(I) := 0.0
    RES_VY(I) := 0.0
    RES_VZ(I) := 0.0
  ENDDO

  ! Sequence design: native angle targets and native torsion targets
  DO I = 1, NRES
    RES_ANGK(I) := 0.3000
    RES_TORSK(I) := 0.6000
  ENDDO

  ! Native Cα-Cα-Cα angle targets
  RES_ANGT0(1) := 0.000000
  RES_ANGT0(2) := 2.429003
  RES_ANGT0(3) := 2.045444
  RES_ANGT0(4) := 2.462514
  RES_ANGT0(5) := 2.466060
  RES_ANGT0(6) := 2.229154
  RES_ANGT0(7) := 2.368986
  RES_ANGT0(8) := 1.561107
  RES_ANGT0(9) := 2.314146
  RES_ANGT0(10) := 2.093133
  RES_ANGT0(11) := 1.770111
  RES_ANGT0(12) := 1.680614
  RES_ANGT0(13) := 2.337269
  RES_ANGT0(14) := 1.811112
  RES_ANGT0(15) := 1.575077
  RES_ANGT0(16) := 1.997056
  RES_ANGT0(17) := 1.790095
  RES_ANGT0(18) := 1.684011
  RES_ANGT0(19) := 1.636492
  RES_ANGT0(20) := 1.891700
  RES_ANGT0(21) := 1.965893
  RES_ANGT0(22) := 1.956922
  RES_ANGT0(23) := 1.772989
  RES_ANGT0(24) := 2.075392
  RES_ANGT0(25) := 2.256812
  RES_ANGT0(26) := 1.592117
  RES_ANGT0(27) := 1.533672
  RES_ANGT0(28) := 1.628033
  RES_ANGT0(29) := 1.651031
  RES_ANGT0(30) := 1.746445
  RES_ANGT0(31) := 1.808414
  RES_ANGT0(32) := 1.635436
  RES_ANGT0(33) := 1.600307
  RES_ANGT0(34) := 1.989874
  RES_ANGT0(35) := 1.751728
  RES_ANGT0(36) := 1.961255
  RES_ANGT0(37) := 1.538049
  RES_ANGT0(38) := 2.097983
  RES_ANGT0(39) := 1.928821
  RES_ANGT0(40) := 1.870007
  RES_ANGT0(41) := 2.462852
  RES_ANGT0(42) := 2.191110
  RES_ANGT0(43) := 2.039662
  RES_ANGT0(44) := 2.089166
  RES_ANGT0(45) := 1.966593
  RES_ANGT0(46) := 2.491549
  RES_ANGT0(47) := 2.127242
  RES_ANGT0(48) := 1.604296
  RES_ANGT0(49) := 1.776959
  RES_ANGT0(50) := 2.210662
  RES_ANGT0(51) := 2.465565
