      NATIVE_R0(I, J) := 0.0
    ENDDO
  ENDDO

  ! Go-like contacts (|i-j| >= MIN_SEP, native Cα-Cα < 2.600000 model units)
  NATIVE_CONTACT(62, 84) := 1
  NATIVE_R0(62, 84) := 2.341232
  NATIVE_CONTACT(84, 62) := 1
  NATIVE_R0(84, 62) := 2.341232

  ! Breakable cystine restraints (CYS_ON=0 = deleted disulfide)
  CYS_I(1) := 43
  CYS_J(1) := 47
  CYS_R0(1) := 4.306195
  CYS_ON(1) := 1
  CYS_I(2) := 54
