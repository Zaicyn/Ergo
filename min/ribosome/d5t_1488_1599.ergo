  CYS_R0(4) := 4.288980
  CYS_ON(4) := 1
  CYS_I(5) := 58
  CYS_J(5) := 88
  CYS_R0(5) := 4.257089
  CYS_ON(5) := 1
  CYS_I(6) := 59
  CYS_J(6) := 87
  CYS_R0(6) := 4.178118
  CYS_ON(6) := 1
  CYS_I(7) := 60
  CYS_J(7) := 85
  CYS_R0(7) := 4.337925
  CYS_ON(7) := 1
  CYS_I(8) := 62
  CYS_J(8) := 82
  CYS_R0(8) := 4.206437
  CYS_ON(8) := 1
  CYS_I(9) := 64
  CYS_J(9) := 83
  CYS_R0(9) := 4.043079
  CYS_ON(9) := 1
  CYS_I(10) := 65
  CYS_J(10) := 80
  CYS_R0(10) := 4.260893
  CYS_ON(10) := 1
  CYS_I(11) := 66
  CYS_J(11) := 79
  CYS_R0(11) := 4.177301
  CYS_ON(11) := 1
