  ! Initialize native contact matrix
  DO I = 1, NRES
    DO J = 1, NRES
      NATIVE_CONTACT(I, J) := 0
      CONTACT_INTER(I, J) := 0
      NATIVE_R0(I, J) := 0.0
    ENDDO
