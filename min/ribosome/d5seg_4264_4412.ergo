  NATIVE_BVY(141) := 0.000000
  NATIVE_BVZ(141) := -0.296984
  NATIVE_Q0(142) := -0.183298
  NATIVE_Q1(142) := -0.880527
  NATIVE_Q2(142) := -0.285992
  NATIVE_Q3(142) := 0.330579
