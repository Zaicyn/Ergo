  RES_TORSP0(2) := -2.467023
  RES_TORSP0(3) := 2.954412
  RES_TORSP0(4) := 3.128629
  RES_TORSP0(5) := -2.949773
  RES_TORSP0(6) := 0.000000
  RES_TORSP0(7) := 0.000000
