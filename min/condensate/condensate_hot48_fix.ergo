  ! Chain 1: hash-walk coil (seed offset 0.0)
  RES_X(1) := 22.5
  RES_Y(1) := 22.5
  RES_Z(1) := 25.0
  DO I = 2, NRES
    OK := 0
    ATT := 0
    DO WHILE ATT < 20
      ATT := ATT + 1
      U1 := MOD(ABS(SIN(REAL(I) * 12.9898 + REAL(ATT) * 3.7 + 0.0) * 43758.5453), 1.0)
      U2 := MOD(ABS(SIN(REAL(I) * 78.2330 + REAL(ATT) * 1.3 + 0.0) * 12543.1230), 1.0)
      COSTH := 2.0 * U1 - 1.0
      SINTH := SQRT(1.0 - COSTH * COSTH)
      PHI2 := 2.0 * 3.14159265 * U2
      CANDX := RES_X(0 + I - 1) + SINTH * COS(PHI2) * BACKBONE_R0
      CANDY := RES_Y(0 + I - 1) + SINTH * SIN(PHI2) * BACKBONE_R0
      CANDZ := RES_Z(0 + I - 1) + COSTH * BACKBONE_R0
      OK := 1
      IF I ≥ 5 THEN
        DO J2 = 1, I - 4
          DD := SQRT((CANDX - RES_X(0 + J2))**2 + (CANDY - RES_Y(0 + J2))**2 + (CANDZ - RES_Z(0 + J2))**2)
          IF DD < 1.55 THEN
            OK := 0
          ENDIF
        ENDDO
      ENDIF
      IF OK = 1 THEN
        ATT := 20
      ENDIF
    ENDDO
    RES_X(0 + I) := CANDX
    RES_Y(0 + I) := CANDY
    RES_Z(0 + I) := CANDZ
  ENDDO
  DO I = 1, NRES
    RES_VX(0 + I) := 0.0
    RES_VY(0 + I) := 0.0
    RES_VZ(0 + I) := 0.0
  ENDDO

