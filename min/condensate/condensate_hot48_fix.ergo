  RES_ANGT0(2) := 1.966495
  RES_ANGT0(3) := 2.284735
  RES_ANGT0(4) := 2.064107
  RES_ANGT0(5) := 2.077749
  RES_ANGT0(6) := 1.878620
  RES_ANGT0(7) := 0.000000
  RES_TORSK(1) := 0.2000
  RES_TORSK(2) := 0.2000
  RES_TORSK(3) := 0.2000
  RES_TORSK(4) := 0.2000
  RES_TORSK(5) := 0.2000
  RES_TORSK(6) := 0.2000
  RES_TORSK(7) := 0.2000
