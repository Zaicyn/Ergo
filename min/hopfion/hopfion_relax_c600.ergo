                + SQRT(YTOP - PY(C)))
              C2 := 2.0 * SQRT((PX(C) - PX(KP1)) ** 2 &
                + (PY(C) - PY(KP1)) ** 2) / (SQRT(YTOP - PY(C)) &
                + SQRT(YTOP - PY(KP1)))
              IF (C1 + C2 < CB - 1.0e-12) THEN
                CB := C1 + C2
                CC := C
                MV := 1
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDDO
    ! (b) delete node if its neighbors are adjacent
    OK := 0
    DO J = 1, DEG(KM1)
      IF (ADJ(KM1, J) == KP1) THEN
        OK := 1
      ENDIF
    ENDDO
    IF (OK == 1) THEN
      C1 := 2.0 * SQRT((PX(KM1) - PX(KP1)) ** 2 &
        + (PY(KM1) - PY(KP1)) ** 2) / (SQRT(YTOP - PY(KM1)) &
        + SQRT(YTOP - PY(KP1)))
      IF (C1 < CB - 1.0e-12) THEN
        CB := C1
        MV := 2
      ENDIF
    ENDIF
    IF (MV == 1) THEN
      PTH(I) := CC
      CHANGED := 1
    ENDIF
    IF (MV == 2) THEN
      DO J = I, M - 1
        PTH(J) := PTH(J + 1)
      ENDDO
      M := M - 1
      CHANGED := 1
    ENDIF
  ENDDO
  ! (c) insert a common neighbor on an edge when it lowers cost
  I := 1
  DO WHILE (I < M)
    KM1 := PTH(I)
    KP1 := PTH(I + 1)
    C0 := 2.0 * SQRT((PX(KM1) - PX(KP1)) ** 2 &
      + (PY(KM1) - PY(KP1)) ** 2) / (SQRT(YTOP - PY(KM1)) &
      + SQRT(YTOP - PY(KP1)))
    CB := C0
    CC := 0
    DO J = 1, DEG(KM1)
      C := ADJ(KM1, J)
      IF (C > 0) THEN
        OK := 0
        DO T2 = 1, DEG(KP1)
          IF (ADJ(KP1, T2) == C) THEN
            OK := 1
          ENDIF
        ENDDO
        DO T2 = 1, M
          IF (PTH(T2) == C) THEN
            OK := 0
          ENDIF
        ENDDO
        IF (OK == 1) THEN
          C1 := 2.0 * SQRT((PX(KM1) - PX(C)) ** 2 &
            + (PY(KM1) - PY(C)) ** 2) / (SQRT(YTOP - PY(KM1)) &
            + SQRT(YTOP - PY(C)))
          C2 := 2.0 * SQRT((PX(C) - PX(KP1)) ** 2 &
            + (PY(C) - PY(KP1)) ** 2) / (SQRT(YTOP - PY(C)) &
            + SQRT(YTOP - PY(KP1)))
          IF (C1 + C2 < CB - 1.0e-12) THEN
            CB := C1 + C2
            CC := C
          ENDIF
        ENDIF
      ENDIF
    ENDDO
    IF (CC > 0) THEN
      DO J = M, I + 1, -1
        PTH(J + 1) := PTH(J)
      ENDDO
      PTH(I + 1) := CC
      M := M + 1
      CHANGED := 1
    ENDIF
    I := I + 1
  ENDDO
  IF (CHANGED == 0) THEN
    WRITE(*, "converged at sweep %d") T
    T := NSWEEP
  ENDIF
ENDDO

COST := 0.0
DO I = 1, M - 1
  KM1 := PTH(I)
  KP1 := PTH(I + 1)
  COST := COST + 2.0 * SQRT((PX(KM1) - PX(KP1)) ** 2 &
    + (PY(KM1) - PY(KP1)) ** 2) / (SQRT(YTOP - PY(KM1)) &
    + SQRT(YTOP - PY(KP1)))
ENDDO
