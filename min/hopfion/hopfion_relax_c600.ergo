    ENDDO
  ENDIF
ENDDO
WRITE(*, "init cost %.12e") DIST(NB)
M := 0
C := NB
DO WHILE (C > 0)
  M := M + 1
  TMP(M) := C
  C := PREV(C)
ENDDO
DO I = 1, M
  PTH(I) := TMP(M + 1 - I)
ENDDO

DO T = 1, NSWEEP
  CHANGED := 0
  DO I = 2, M - 1
    KM1 := PTH(I - 1)
    KP1 := PTH(I + 1)
    ! current two-edge cost
    C1 := 2.0 * SQRT((PX(KM1) - PX(PTH(I))) ** 2 &
      + (PY(KM1) - PY(PTH(I))) ** 2) / (SQRT(YTOP - PY(KM1)) &
      + SQRT(YTOP - PY(PTH(I))))
    C2 := 2.0 * SQRT((PX(PTH(I)) - PX(KP1)) ** 2 &
      + (PY(PTH(I)) - PY(KP1)) ** 2) / (SQRT(YTOP - PY(PTH(I))) &
      + SQRT(YTOP - PY(KP1)))
    C0 := C1 + C2
    MV := 0
    CB := C0
    CC := PTH(I)
    ! (a) swap to a node adjacent to both path neighbors
    DO J = 1, DEG(KM1)
      C := ADJ(KM1, J)
      IF (C > 0) THEN
        IF (C /= KM1) THEN
          IF (C /= KP1) THEN
            OK := 0
            DO T2 = 1, DEG(KP1)
              IF (ADJ(KP1, T2) == C) THEN
                OK := 1
              ENDIF
            ENDDO
            DO T2 = 1, M
              IF (PTH(T2) == C) THEN
                OK := 0
              ENDIF
            ENDDO
