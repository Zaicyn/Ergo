REAL :: C0, C1, C2, CB, COST, DB
INTEGER :: I, J, T, M, CHANGED, C, CC, OK, KM1, KP1, MV, T2, U

DO I = 1, NP
  DIST(I) := 1.0e30
  PREV(I) := 0
  VIS(I) := 0
ENDDO
DIST(NA) := 0.0
DO T = 1, NP
  U := 0
  DB := 1.0e29
  DO I = 1, NP
    IF (VIS(I) == 0) THEN
      IF (DIST(I) < DB) THEN
        DB := DIST(I)
        U := I
      ENDIF
    ENDIF
  ENDDO
  IF (U > 0) THEN
    VIS(U) := 1
    DO J = 1, DEG(U)
      C := ADJ(U, J)
      IF (C > 0) THEN
        C1 := 2.0 * SQRT((PX(U) - PX(C)) ** 2 &
          + (PY(U) - PY(C)) ** 2) / (SQRT(YTOP - PY(U)) &
