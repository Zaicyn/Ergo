  BEAD_Y(34) := 5.153040
  BEAD_Z(34) := -2.922938
  BEAD_VX(34) := 0.0
  BEAD_VY(34) := 0.0
  BEAD_VZ(34) := 0.0
  BEAD_X(35) := -1.097828
  BEAD_Y(35) := 6.174439
  BEAD_Z(35) := 0.075964
