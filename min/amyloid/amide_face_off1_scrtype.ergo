  RES_Y(18) := 3.675539
  RES_Z(18) := -1.279836
  RES_X(19) := -1.308241
  RES_Y(19) := 3.864774
  RES_Z(19) := -2.256416
  RES_X(20) := -2.732903
  RES_Y(20) := 3.844370
