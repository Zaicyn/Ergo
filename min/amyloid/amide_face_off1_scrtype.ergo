  ! Chain 4: face-start, sheet2 offset 1.9468
  RES_X(22) := 3.621467
  RES_Y(22) := 6.550110
  RES_Z(22) := -1.860743
  RES_X(23) := 2.609281
  RES_Y(23) := 5.682350
  RES_Z(23) := -1.132609
  RES_X(24) := 1.277435
  RES_Y(24) := 5.628740
  RES_Z(24) := -1.835938
  RES_X(25) := -0.153628
  RES_Y(25) := 5.622339
  RES_Z(25) := -1.279836
  RES_X(26) := -1.308241
  RES_Y(26) := 5.811574
  RES_Z(26) := -2.256416
  RES_X(27) := -2.732903
  RES_Y(27) := 5.791170
  RES_Z(27) := -1.727518
  RES_X(28) := -3.664275
  RES_Y(28) := 5.724758
  RES_Z(28) := -2.920138
  DO I = 1, NRES
    RES_VX(21 + I) := 0.0
    RES_VY(21 + I) := 0.0
    RES_VZ(21 + I) := 0.0
