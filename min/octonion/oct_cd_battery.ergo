! ============================================================
! oct_cd_battery.ergo  --  Stage A: Cayley-Dickson octonion
! algebra + validation battery (pure algebra, no physics)
!
! Octonions built by the Cayley-Dickson recursion from the
! reals up (complex = pair of reals, quaternion = pair of
! complexes, octonion = pair of quaternions), convention:
!   (p,q)(r,s) = (p r - conj(s) q, s p + q conj(r))
!   conj(p,q) = (conj(p), -q)
! The 8x8 multiplication table is GENERATED by the recursion,
! not hard-coded.
!
! Battery (2000 deterministic HASH/RAND draws, seeds fixed):
!   NORM      |XY|^2 = |X|^2 |Y|^2          -> f64 floor
!   ALT       X(XY)=(XX)Y, (XY)Y=X(YY)      -> floor
!   NONASSOC  |(XY)Z - X(YZ)|               -> O(1) witness
!   ARTIN     2-generated subalgebra assoc  -> floor
!   MOUFANG   (XY)(ZX) = X((YZ)X)           -> floor
!   ANTIAUTO  conj(XY) = conj(Y)conj(X)     -> floor
!   INVERSE   X . conj(X)/|X|^2 = 1         -> floor
!
! MIRROR ORACLES (C mirror, gcc -O2, 2026-08-12):
!   NORM maxreldev 6.63739963452946459e-16
!   ALT maxabsdev 2.66453525910037570e-15
!   NONASSOC max 8.44416552778339735e+00 mean 3.06080634094862125e+00
!   ARTIN maxabsdev 1.42108547152020037e-14
!   MOUFANG maxabsdev 4.88498130835068878e-15
!   ANTIAUTO maxabsdev 0.00000000000000000e+00
!   INVERSE maxabsdev 4.44089209850062616e-16
! (byte-parity requires ergo RAND = splitmix64(seed)>>11 * 2^-53;
!  if RAND's seeding differs, the TABLE section still matches --
!  it uses no RNG -- and only the battery values move.)
!
! Arrays are STATIC. Rename: oct_cd_battery.ergo.txt ->
! oct_cd_battery.ergo
! Run: python -m core min/octonion/oct_cd_battery.ergo -o /tmp/ocd
!      /tmp/ocd
! ============================================================

IMPLICIT NONE
INTEGER, PARAMETER :: NDRAWS = 2000

REAL :: X(8), Y(8), Z(8), T1(8), T2(8), T3(8), D(8)
REAL :: WW(8,3), WA(8), WB(8), WC(8)
REAL :: E1(8), E2(8), E3(8)
REAL :: MXNORM, MXALT, MXNON, MXART, MXMOU, MXANTI, MXINV
REAL :: SUMNON, NX2, NY2, NXY, DN, DA, DEV, SS
INTEGER :: T, K, M, I, J, BASE, IA, IB, IC, K2, SG

! ---------------- TABLE: basis products ----------------
DO I = 1, 8
   DO J = 1, 8
      DO K = 1, 8
         E1(K) := 0.0
         E2(K) := 0.0
      ENDDO
      E1(I) := 1.0
      E2(J) := 1.0
      CALL OMUL(E1, E2, E3)
      K2 := 0
      SG := 0
      DO M = 1, 8
         IF (ABS(E3(M)) > 0.5) THEN
            K2 := M
            SG := 1
            IF (E3(M) < 0.0) THEN
               SG := -1
            ENDIF
         ENDIF
      ENDDO
      WRITE(*,"('TABLE %d %d %d %d')") I, J, K2, SG
   ENDDO
ENDDO

! ---------------- battery ----------------
MXNORM := 0.0
MXALT := 0.0
MXNON := 0.0
MXART := 0.0
MXMOU := 0.0
MXANTI := 0.0
MXINV := 0.0
SUMNON := 0.0

DO T = 1, NDRAWS
   BASE := 1000003 + (T-1)*64
   DO K = 1, 8
      X(K) := 2.0*RAND(BASE+K-1) - 1.0
      Y(K) := 2.0*RAND(BASE+K+7) - 1.0
      Z(K) := 2.0*RAND(BASE+K+15) - 1.0
   ENDDO

   NX2 := 0.0
   NY2 := 0.0
   DO K = 1, 8
      NX2 := NX2 + X(K)*X(K)
      NY2 := NY2 + Y(K)*Y(K)
   ENDDO

   ! NORM: |XY|^2 vs |X|^2 |Y|^2
   CALL OMUL(X, Y, T1)
   NXY := 0.0
   DO K = 1, 8
      NXY := NXY + T1(K)*T1(K)
   ENDDO
   DN := ABS(NXY - NX2*NY2) / (NX2*NY2)
   IF (DN > MXNORM) THEN
      MXNORM := DN
   ENDIF

   ! ALT: X(XY) - (XX)Y
   CALL OMUL(X, Y, T1)
   CALL OMUL(X, T1, T2)
   CALL OMUL(X, X, T3)
   CALL OMUL(T3, Y, T1)
   CALL OMAXD(T2, T1, DA)
   IF (DA > MXALT) THEN
      MXALT := DA
   ENDIF
   ! ALT: (XY)Y - X(YY)
   CALL OMUL(X, Y, T1)
   CALL OMUL(T1, Y, T2)
   CALL OMUL(Y, Y, T3)
   CALL OMUL(X, T3, T1)
   CALL OMAXD(T2, T1, DA)
   IF (DA > MXALT) THEN
      MXALT := DA
   ENDIF

   ! NONASSOC witness: (XY)Z - X(YZ)
   CALL OMUL(X, Y, T1)
   CALL OMUL(T1, Z, T2)
   CALL OMUL(Y, Z, T1)
   CALL OMUL(X, T1, T3)
   CALL OMAXD(T2, T3, DA)
   SUMNON := SUMNON + DA
   IF (DA > MXNON) THEN
      MXNON := DA
   ENDIF

   ! ARTIN: associators over {X, Y, XY}
   CALL OMUL(X, Y, T1)
   DO K = 1, 8
      WW(K,1) := X(K)
      WW(K,2) := Y(K)
      WW(K,3) := T1(K)
   ENDDO
   DO IA = 1, 3
      DO IB = 1, 3
         DO IC = 1, 3
            DO K = 1, 8
               WA(K) := WW(K,IA)
               WB(K) := WW(K,IB)
               WC(K) := WW(K,IC)
            ENDDO
            CALL ASSOC8(WA, WB, WC, DEV)
            IF (DEV > MXART) THEN
               MXART := DEV
            ENDIF
         ENDDO
      ENDDO
   ENDDO

   ! MOUFANG: (XY)(ZX) - X((YZ)X)
   CALL OMUL(X, Y, T1)
   CALL OMUL(Z, X, T2)
   CALL OMUL(T1, T2, T3)
   CALL OMUL(Y, Z, T1)
   CALL OMUL(T1, X, T2)
   CALL OMUL(X, T2, T1)
   CALL OMAXD(T3, T1, DA)
   IF (DA > MXMOU) THEN
      MXMOU := DA
   ENDIF

   ! ANTIAUTO: conj(XY) - conj(Y)conj(X)
   CALL OMUL(X, Y, T1)
   CALL OCNJ(T1, T2)
   CALL OCNJ(Y, T1)
   CALL OCNJ(X, T3)
   CALL OMUL(T1, T3, T1)
   CALL OMAXD(T2, T1, DA)
   IF (DA > MXANTI) THEN
      MXANTI := DA
   ENDIF

   ! INVERSE: X . conj(X)/|X|^2 - 1
   CALL OCNJ(X, T1)
   DO K = 1, 8
      T1(K) := T1(K)/NX2
   ENDDO
   CALL OMUL(X, T1, T2)
   T2(1) := T2(1) - 1.0
   DA := 0.0
   DO K = 1, 8
      SS := ABS(T2(K))
      IF (SS > DA) THEN
         DA := SS
      ENDIF
   ENDDO
   IF (DA > MXINV) THEN
      MXINV := DA
   ENDIF

ENDDO

WRITE(*,"('NORM maxreldev %.17e')") MXNORM
WRITE(*,"('ALT maxabsdev %.17e')") MXALT
WRITE(*,"('NONASSOC max %.17e mean %.17e')") MXNON, SUMNON/NDRAWS
WRITE(*,"('ARTIN maxabsdev %.17e')") MXART
WRITE(*,"('MOUFANG maxabsdev %.17e')") MXMOU
WRITE(*,"('ANTIAUTO maxabsdev %.17e')") MXANTI
WRITE(*,"('INVERSE maxabsdev %.17e')") MXINV

! ============================================================
! library: Cayley-Dickson products and helpers
! ============================================================

SUBROUTINE QMU4(A, B, C)
   ! quaternion product on 4-blocks via complex CD pairs
   ! A = (z,w): z = A1+iA2, w = A3+iA4
   IMPLICIT NONE
   REAL :: A(4), B(4), C(4)
   REAL :: ZR0, ZR1, CW0, CW1, WZ0, WZ1, WC0, WC1
   ZR0 := A(1)*B(1) - A(2)*B(2)
   ZR1 := A(1)*B(2) + A(2)*B(1)
   CW0 := B(3)*A(3) + B(4)*A(4)
   CW1 := B(3)*A(4) - B(4)*A(3)
   WZ0 := B(3)*A(1) - B(4)*A(2)
   WZ1 := B(3)*A(2) + B(4)*A(1)
   WC0 := A(3)*B(1) + B(2)*A(4)
   WC1 := -B(2)*A(3) + A(4)*B(1)
   C(1) := ZR0 - CW0
   C(2) := ZR1 - CW1
   C(3) := WZ0 + WC0
   C(4) := WZ1 + WC1
END

SUBROUTINE OMUL(A, B, C)
   ! octonion product: A=(p,q), B=(r,s) ->
   ! C = (p r - conj(s) q, s p + q conj(r))
   IMPLICIT NONE
   REAL :: A(8), B(8), C(8)
   REAL :: P(4), R(4), S(4), CS(4), CR(4)
   REAL :: PR(4), CSQ(4), SP(4), QCR(4)
   INTEGER :: I
   DO I = 1, 4
      P(I) := A(I)
      R(I) := B(I)
      S(I) := B(I+4)
   ENDDO
   CALL QMU4(P, R, PR)
   CS(1) := S(1)
   CS(2) := -S(2)
   CS(3) := -S(3)
   CS(4) := -S(4)
   DO I = 1, 4
      R(I) := A(I+4)
   ENDDO
   CALL QMU4(CS, R, CSQ)
   DO I = 1, 4
      P(I) := B(I+4)
      R(I) := A(I)
   ENDDO
   CALL QMU4(P, R, SP)
   CR(1) := B(1)
   CR(2) := -B(2)
   CR(3) := -B(3)
   CR(4) := -B(4)
   DO I = 1, 4
      P(I) := A(I+4)
   ENDDO
   CALL QMU4(P, CR, QCR)
   DO I = 1, 4
      C(I) := PR(I) - CSQ(I)
      C(I+4) := SP(I) + QCR(I)
   ENDDO
END

SUBROUTINE OCNJ(A, C)
   IMPLICIT NONE
   REAL :: A(8), C(8)
   INTEGER :: I
   C(1) := A(1)
   DO I = 2, 8
      C(I) := -A(I)
   ENDDO
END

SUBROUTINE OMAXD(A, B, DEV)
   ! max |A-B| componentwise
   IMPLICIT NONE
   REAL :: A(8), B(8), DEV
   REAL :: SS
   INTEGER :: I
   DEV := 0.0
   DO I = 1, 8
      SS := ABS(A(I) - B(I))
      IF (SS > DEV) THEN
         DEV := SS
      ENDIF
   ENDDO
END

SUBROUTINE ASSOC8(A, B, C, DEV)
   ! |(AB)C - A(BC)|, max component
   IMPLICIT NONE
   REAL :: A(8), B(8), C(8), DEV
   REAL :: T1(8), T2(8), T3(8)
   CALL OMUL(A, B, T1)
   CALL OMUL(T1, C, T2)
   CALL OMUL(B, C, T1)
   CALL OMUL(A, T1, T3)
   CALL OMAXD(T2, T3, DEV)
END
