! dbm_strip.ergo — Stage 4: DBM electrodeposition in battery geometry
!
! Bottom row = seed electrode (cluster, phi=0), top row = counter
! electrode (phi=1), side walls Neumann (mirrored via precomputed
! LIDX/RIDX index arrays — keeps the stencil branch-free). Growth
! probability p_i ~ phi_i**ETA at empty cluster-adjacent sites; one
! deposit per step, counter-based RAND(SEED + G). Deterministic.
!
! Battery signature: screening instability. eta=0 (Eden) advances a
! compact layer (tip ~ mean height); eta>=1 tips screen the valleys and
! outrun the mean — tracked as tip height, mean height, and per-column
! height roughness.
!
!   python -m core min/dendrite/dbm_strip.ergo -o dbm_strip
!   ./dbm_strip > dbm_strip.out

IMPLICIT NONE
INTEGER, PARAMETER :: DEFAULT_N = 257
INTEGER, PARAMETER :: NX = DEFAULT_N, NY = DEFAULT_N
INTEGER, PARAMETER :: NPTS = NX*NY
INTEGER, PARAMETER :: NSTEPS = 8000
INTEGER, PARAMETER :: SEED = 12345
REAL, PARAMETER :: ETA = 0.0
REAL, PARAMETER :: TOLG = 1.0E-6
INTEGER, PARAMETER :: SWMAX = 1200
STATIC REAL :: PHI(NPTS), MASK(NPTS), CLUS(NPTS), W(NPTS)
STATIC INTEGER :: LIDX(NPTS), RIDX(NPTS), HCOL(NX)
REAL :: DN, MAXD, NSUM, TOTW, U, TARGET, CUM, OMEGA, PI
REAL :: HMEAN, HSTD, HTIP
INTEGER :: I, J, K, G, SW, CONV, KSEL, DONE, SWUSED, NCAND
INTEGER :: ICOL, JROW, JSTOP

PI := ACOS(0.0 - 1.0)
OMEGA := 2.0 / (1.0 + SIN(PI / REAL(NY)))
JSTOP := INT(0.85 * REAL(NY))

! Geometry: rows 1 and NY fixed; interior solves with linear start.
! LIDX/RIDX mirror the side walls (Neumann): I=1 sees I=2 as left
! neighbor, I=NX sees I=NX-1 as right neighbor.
DO J = 1, NY
  DO I = 1, NX
    K := I + (J - 1) * NX
    CLUS(K) := 0.0
    LIDX(K) := K - 1
    RIDX(K) := K + 1
    IF (I == 1) THEN
      LIDX(K) := K + 1
    ENDIF
    IF (I == NX) THEN
      RIDX(K) := K - 1
    ENDIF
    MASK(K) := 1.0
    PHI(K) := REAL(J - 1) / REAL(NY - 1)
    IF (J == 1) THEN
      MASK(K) := 0.0
      PHI(K) := 0.0
      CLUS(K) := 1.0
    ENDIF
    IF (J == NY) THEN
      MASK(K) := 0.0
      PHI(K) := 1.0
    ENDIF
  ENDDO
ENDDO
DO I = 1, NX
  HCOL(I) := 1
ENDDO

WRITE(*, "dbm_strip  grid %d x %d  eta %.2f  seed %d  nsteps %d") &
  NX, NY, ETA, SEED, NSTEPS

DONE := 0
DO G = 1, NSTEPS
  IF (DONE == 0) THEN

    ! 1. Warm-started SOR re-solve (rows 2..NY-1, all columns).
    ! Clamp phi >= 0: SOR overshoot can drive phi negative at the steep
    ! deposit surface; physical field is non-negative (max principle).
    CONV := 0
    SWUSED := SWMAX
    DO SW = 1, SWMAX
      IF (CONV == 0) THEN
        MAXD := 0.0
        DO K = NX + 1, NPTS - NX
          DN := MASK(K) * OMEGA * (0.25 * (PHI(LIDX(K)) + PHI(RIDX(K)) &
            + PHI(K - NX) + PHI(K + NX)) - PHI(K))
          PHI(K) := MAX(PHI(K) + DN, 0.0)
          MAXD := MAX(MAXD, ABS(DN))
        ENDDO
        IF (MAXD < TOLG) THEN
          CONV := 1
          SWUSED := SW
        ENDIF
      ENDIF
    ENDDO

    ! 2. Candidate weights.
    TOTW := 0.0
    NCAND := 0
    DO K = NX + 1, NPTS - NX
      NSUM := CLUS(LIDX(K)) + CLUS(RIDX(K)) + CLUS(K - NX) + CLUS(K + NX)
      W(K) := (1.0 - CLUS(K)) * MASK(K) * MIN(1.0, NSUM) &
        * PHI(K) ** ETA
      TOTW := TOTW + W(K)
      NCAND := NCAND + INT((1.0 - CLUS(K)) * MASK(K) * MIN(1.0, NSUM))
    ENDDO

    ! 3. Roulette pick.
    KSEL := 0
    IF (TOTW > 0.0) THEN
      U := RAND(SEED + G)
      TARGET := U * TOTW
      CUM := 0.0
      DO K = NX + 1, NPTS - NX
        IF (KSEL == 0) THEN
          CUM := CUM + W(K)
          IF (CUM >= TARGET) THEN
            IF (W(K) > 0.0) THEN
              KSEL := K
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDIF

    ! 4. Deposit; column heights; stop when a tip nears the top.
    IF (KSEL > 0) THEN
      CLUS(KSEL) := 1.0
      MASK(KSEL) := 0.0
      PHI(KSEL) := 0.0
      ICOL := MOD(KSEL - 1, NX) + 1
      JROW := (KSEL - 1) / NX + 1
      HCOL(ICOL) := MAX(HCOL(ICOL), JROW)
      IF (JROW >= JSTOP) THEN
        DONE := 1
      ENDIF
    ENDIF

    ! 5. Morphology series: tip height, mean column height, roughness.
    IF (MOD(G, 100) == 0) THEN
      HMEAN := 0.0
      HTIP := 0.0
      DO I = 1, NX
        HMEAN := HMEAN + REAL(HCOL(I))
        HTIP := MAX(HTIP, REAL(HCOL(I)))
      ENDDO
      HMEAN := HMEAN / REAL(NX)
      HSTD := 0.0
      DO I = 1, NX
        HSTD := HSTD + (REAL(HCOL(I)) - HMEAN) ** 2
      ENDDO
      HSTD := SQRT(HSTD / REAL(NX))
      WRITE(*, "step %d  mass %d  tip %.1f  hmean %.2f  rough %.2f  ncand %d  sor %d") &
        G, G + NX, HTIP, HMEAN, HSTD, NCAND, SWUSED
    ENDIF
    IF (DONE == 1) THEN
      WRITE(*, "tip reached row %d at step %d") JSTOP, G
    ENDIF
  ENDIF
ENDDO

WRITE(*, "SNAP %d") NSTEPS
DO K = 1, NPTS
  IF (CLUS(K) > 0.5) THEN
    WRITE(*, "%d %d") MOD(K - 1, NX) + 1, (K - 1) / NX + 1
  ENDIF
ENDDO
WRITE(*, "ENDSNAP")
WRITE(*, "done")
