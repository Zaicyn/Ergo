! dbm_radial.ergo — Stage 2: dielectric breakdown model, radial geometry
!
! Laplacian growth from a central seed: cluster sites fixed phi=0, outer
! circle phi=1, field relaxed by warm-started SOR each growth step.
! Growth probability at empty cluster-adjacent (von Neumann) sites is
! p_i ~ phi_i**ETA; one site deposited per step via counter-based
! roulette draw RAND(SEED + G). Fully deterministic given SEED.
!
! Knobs are PARAMETERs; DEFAULT_N is the grid (override with -N).
!
!   python -m core min/dendrite/dbm_radial.ergo -o dbm_radial
!   ./dbm_radial > dbm_radial.out
!
! Output: header, per-step progress lines (every 100 steps), occupancy
! snapshots ("SNAP <step>" followed by "I J" cluster-site lines) at the
! midpoint and end. Determinism oracle: run twice, diff the .out files.

IMPLICIT NONE
INTEGER, PARAMETER :: DEFAULT_N = 257
INTEGER, PARAMETER :: NX = DEFAULT_N, NY = DEFAULT_N
INTEGER, PARAMETER :: NPTS = NX*NY
INTEGER, PARAMETER :: NEND = NPTS - NX - 1
INTEGER, PARAMETER :: NSTEPS = 4000
INTEGER, PARAMETER :: SEED = 12345
REAL, PARAMETER :: ETA = 0.5
REAL, PARAMETER :: TOLG = 1.0E-6
INTEGER, PARAMETER :: SWMAX = 1200
STATIC REAL :: PHI(NPTS), MASK(NPTS), CLUS(NPTS), W(NPTS)
REAL :: CX, CY, R, R1, DX, DY, PI, OMEGA
REAL :: DN, MAXD, NSUM, TOTW, U, TARGET, CUM, RMAX, RD
INTEGER :: I, J, K, G, SW, CONV, KSEL, DONE, SWUSED, NCAND

PI := ACOS(0.0 - 1.0)
CX := 0.5 * REAL(NX + 1)
CY := 0.5 * REAL(NY + 1)
R1 := 0.5 * REAL(NX) - 2.0
OMEGA := 2.0 / (1.0 + SIN(PI / REAL(NX)))

! Geometry: outer circle fixed phi=1; interior solves; center seed.
DO J = 1, NY
  DO I = 1, NX
    K := I + (J - 1) * NX
    DX := REAL(I) - CX
    DY := REAL(J) - CY
    R := SQRT(DX * DX + DY * DY)
    MASK(K) := 0.0
    PHI(K) := 1.0
    CLUS(K) := 0.0
    IF (R < R1) THEN
      MASK(K) := 1.0
      PHI(K) := LOG(MAX(R, 0.5)) / LOG(R1)
    ENDIF
  ENDDO
ENDDO
K := INT(CX) + (INT(CY) - 1) * NX
CLUS(K) := 1.0
MASK(K) := 0.0
PHI(K) := 0.0

WRITE(*, "dbm_radial  grid %d x %d  R1 %.1f  eta %.2f  seed %d  nsteps %d") &
  NX, NY, R1, ETA, SEED, NSTEPS

RMAX := 0.0
DONE := 0
DO G = 1, NSTEPS
  IF (DONE == 0) THEN

    ! 1. Warm-started SOR re-solve (fixed-count, idempotent past CONV).
    ! Clamp phi >= 0: with OMEGA near 2, SOR undershoots below 0 at the
    ! steep cluster surface; a negative phi fed to phi**ETA is NaN for
    ! non-integer ETA (and a signed weight for ETA=1/2). The physical
    ! field is non-negative (maximum principle), so project it back.
    CONV := 0
    SWUSED := SWMAX
    DO SW = 1, SWMAX
      IF (CONV == 0) THEN
        MAXD := 0.0
        DO K = NX + 2, NEND
          DN := MASK(K) * OMEGA * (0.25 * (PHI(K - 1) + PHI(K + 1) &
            + PHI(K - NX) + PHI(K + NX)) - PHI(K))
          PHI(K) := MAX(PHI(K) + DN, 0.0)
          MAXD := MAX(MAXD, ABS(DN))
        ENDDO
        IF (MAXD < TOLG) THEN
          CONV := 1
          SWUSED := SW
        ENDIF
      ENDIF
    ENDDO

    ! 2. Candidate weights W = phi**ETA at empty sites touching cluster.
    TOTW := 0.0
    NCAND := 0
    DO K = NX + 2, NEND
      NSUM := CLUS(K - 1) + CLUS(K + 1) + CLUS(K - NX) + CLUS(K + NX)
      W(K) := (1.0 - CLUS(K)) * MASK(K) * MIN(1.0, NSUM) &
        * PHI(K) ** ETA
      TOTW := TOTW + W(K)
      NCAND := NCAND + INT((1.0 - CLUS(K)) * MASK(K) * MIN(1.0, NSUM))
    ENDDO

    ! 3. Roulette pick, one counter-based draw per growth step.
    KSEL := 0
    IF (TOTW > 0.0) THEN
      U := RAND(SEED + G)
      TARGET := U * TOTW
      CUM := 0.0
      DO K = NX + 2, NEND
        IF (KSEL == 0) THEN
          CUM := CUM + W(K)
          IF (CUM >= TARGET) THEN
            IF (W(K) > 0.0) THEN
              KSEL := K
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDIF

    ! 4. Deposit; track radius; stop flag when cluster nears boundary.
    IF (KSEL > 0) THEN
      CLUS(KSEL) := 1.0
      MASK(KSEL) := 0.0
      PHI(KSEL) := 0.0
      DX := REAL(MOD(KSEL - 1, NX) + 1) - CX
      DY := REAL((KSEL - 1) / NX + 1) - CY
      RD := SQRT(DX * DX + DY * DY)
      RMAX := MAX(RMAX, RD)
      IF (RMAX > 0.8 * R1) THEN
        DONE := 1
      ENDIF
    ENDIF

    IF (MOD(G, 100) == 0) THEN
      WRITE(*, "step %d  mass %d  rmax %.1f  totw %.4e  ncand %d  sor %d") &
        G, G + 1, RMAX, TOTW, NCAND, SWUSED
    ENDIF
    IF (G == NSTEPS / 2) THEN
      WRITE(*, "SNAP %d") G
      DO K = 1, NPTS
        IF (CLUS(K) > 0.5) THEN
          WRITE(*, "%d %d") MOD(K - 1, NX) + 1, (K - 1) / NX + 1
        ENDIF
      ENDDO
      WRITE(*, "ENDSNAP")
    ENDIF
    IF (DONE == 1) THEN
      WRITE(*, "boundary reached at step %d  rmax %.1f") G, RMAX
    ENDIF
  ENDIF
ENDDO

WRITE(*, "SNAP %d") NSTEPS
DO K = 1, NPTS
  IF (CLUS(K) > 0.5) THEN
    WRITE(*, "%d %d") MOD(K - 1, NX) + 1, (K - 1) / NX + 1
  ENDIF
ENDDO
WRITE(*, "ENDSNAP")
WRITE(*, "done  mass %d  rmax %.1f") NSTEPS + 1, RMAX
