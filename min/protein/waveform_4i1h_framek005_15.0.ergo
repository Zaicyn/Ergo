  REG_K(490) := 0.5000
  REG_P0(490) := -1.152344
  REG_A(491) := 286
  REG_B(491) := 287
  REG_C(491) := 293
  REG_D(491) := 294
  REG_K(491) := 0.5000
  REG_P0(491) := -1.545947
  REG_A(492) := 287
  REG_B(492) := 286
  REG_C(492) := 292
  REG_D(492) := 291
  REG_K(492) := 0.5000
  REG_P0(492) := -0.972210
  REG_A(493) := 287
  REG_B(493) := 285
  REG_C(493) := 293
  REG_D(493) := 291
  REG_K(493) := 0.5000
  REG_P0(493) := -0.700665
  REG_A(494) := 287
  REG_B(494) := 286
  REG_C(494) := 293
  REG_D(494) := 292
  REG_K(494) := 0.5000
  REG_P0(494) := -0.903027
