  RES_ANGT0(12) := 1.540481
  RES_ANGT0(13) := 1.614643
  RES_ANGT0(14) := 1.604252
  RES_ANGT0(15) := 1.532631
  RES_ANGT0(16) := 1.557950
  RES_ANGT0(17) := 1.454703
  RES_ANGT0(18) := 1.870249
