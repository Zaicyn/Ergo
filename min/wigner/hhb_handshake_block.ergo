! Simple compilable HANDSHAKE ... ENDHANDSHAKE example (Phase 3b).
! The block is a counted loop with explicit CONSERVE and ORACLE options.

IMPLICIT NONE

INTEGER, PARAMETER :: N = 8
INTEGER :: I
REAL :: X

X := 0.0

HANDSHAKE simple
    DEPTH=1
    FRAME_BYTES=256
    MAXIT=10
    PAYLOAD=(X)
    ORACLE X VALUE=0.8 LIMIT=1.0E-3
  DO I = 1, N
    X := X + 0.1
  ENDDO
ENDHANDSHAKE

WRITE(*, "('X = %.6e')") X
STOP
