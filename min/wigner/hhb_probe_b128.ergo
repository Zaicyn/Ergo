! HHB_PROBE_B128 — bounded-attempt probe at bound 128 (generated by
! hhb_probe_unroll.py — do not edit by hand).

IMPLICIT NONE

INTEGER, PARAMETER :: N = 2048
INTEGER, PARAMETER :: MAXATT = 128
STATIC REAL :: A(N), B(N)
REAL :: S
INTEGER :: I, ATT

DO I = 1, N
  B(I) := RAND(I) * 2.0 - 1.0
  A(I) := 0.0
ENDDO

HANDSHAKE attempt
    DEPTH=1
    FRAME_BYTES=256
    MAXIT=128
    PAYLOAD=(S)
  DO I = 1, N
    ATT := 0
    DO WHILE ATT < MAXATT
      ATT := ATT + 1
      A(I) := A(I) + B(I) * REAL(ATT)
      IF B(I) > 0.0 THEN
        ATT := 128
      ENDIF
    ENDDO
  ENDDO
  S := 0.0
  DO I = 1, N
    S := S + A(I)
  ENDDO
  WRITE(*, "('S %.10e')") S
ENDHANDSHAKE

WRITE(*, "('FINAL %.10e')") S
STOP
