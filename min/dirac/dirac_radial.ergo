! ════════════════════════════════════════════════════════════════════
! DIRAC_RADIAL — radial Dirac-Coulomb solver (Stage 1 of the Dirac
! campaign). Shooting method with the ANALYTIC small-r series start
! (F ~ r^s, s = sqrt(kappa^2 - (Z alpha)^2); the origin singularity is
! handled by the series, never a grid clamp), matched by a Wronskian
! to an inward integration from large r. Eigenvalue = W = 0 by coarse
! scan + bisection; states identified by radial NODE COUNT
! (n_r = n - |kappa|), never by tuning to the answer.
!
! Equations (a.u., m = 1, c = 137.035999084; eps = E - c^2 < 0 bound):
!   dF/dr = -(kappa/r) F + [2c + (eps - V)/c] G
!   dG/dr = -[(eps - V)/c] F + (kappa/r) G ,   V = -Z/r
! in t = log r:  F' = -kappa F + B G,  G' = -A F + kappa G  with
!   A(r) = (eps r + Z)/c,  B(r) = 2 c r + A(r).
! Small-r series: F = r^s, G = q0 r^s,  q0 = c (s + kappa)/Z.
! Large-r: F ~ exp(-lambda r), G/F -> -lambda c/(2 c^2 + eps),
!   lambda = sqrt(-eps (2 c^2 + eps))/c.
! RK4 in t on a fixed log grid; all iteration counts fixed
! (deterministic; run twice byte-identical).
!
! Oracles (exact Sommerfeld, closed form, all orders in Z*alpha,
! point nucleus): E_nj/mc^2 = [1 + (Z a)^2 / (n - |k| +
! sqrt(k^2 - (Z a)^2))^2]^(-1/2); binding = (1 - E_nj) c^2.
! Compile from repo root: python -m core min/dirac/dirac_radial.ergo
! ════════════════════════════════════════════════════════════════════

IMPLICIT NONE

REAL, PARAMETER :: C = 137.035999084
INTEGER, PARAMETER :: NT = 20000
INTEGER, PARAMETER :: NSC = 3000
INTEGER, PARAMETER :: NBS = 60

! state table: (Z, n, kappa) — 1s(H), 2s, 2p1/2, 2p3/2 (H), 1s (Pb, U)
STATIC REAL :: ZT(8)
STATIC INTEGER :: NQ(8), KP(8)
STATIC REAL :: BINDS(8)
! Z=14 pair anchors the census-ceiling re-measure (Ly-a at the old
! 1% crossing, Si XIV)
DATA ZT / 1.0, 1.0, 1.0, 1.0, 82.0, 92.0, 14.0, 14.0 /
DATA NQ / 1, 2, 2, 2, 1, 1, 1, 2 /
DATA KP / -1, -1, 1, -2, -1, -1, -1, 1 /

! shared run parameters (set per state before calling WRONK)
STATIC REAL :: ZZ, KAP
STATIC REAL :: R0, RMID, RMAX, T0, H, SS, Q0
STATIC INTEGER :: NRT, NRHS

REAL :: PI, EP, E1, E2, EA, EB, EM, W0, W1, WM, LAM, QINF
REAL :: ESOM, BIND, DEV, EFS, ENR, SPL
REAL :: E23, E21
INTEGER :: IS, I, K, NODES, NFOUND
INTEGER :: IB
REAL :: WLO, WHI, ELO, EHI
REAL :: EROOT, ND
INTEGER :: NSEL
REAL :: D1

PI := 3.14159265358979323846

DO IS = 1, 8
  ZZ := ZT(IS)
  KAP := REAL(KP(IS))
  ! series parameters
  SS := SQRT(KAP*KAP - (ZZ/C)*(ZZ/C))
  Q0 := C * (SS + KAP) / ZZ
  R0 := 1.0e-4 / ZZ
  RMID := 2.0 * REAL(NQ(IS)*NQ(IS)) / ZZ
  RMAX := RMID + 60.0 * REAL(NQ(IS)*NQ(IS)) / ZZ
  T0 := LOG(R0)
  H := (LOG(RMAX) - T0) / REAL(NT)
  NRT := INT((LOG(RMID) - T0) / H) + 1
  NRHS := NT - NRT
  ! target radial node count of the LARGE component = n - l - 1,
  ! with l = kappa (kappa > 0) or -kappa - 1 (kappa < 0)
  IF (KP(IS) > 0) THEN
    NODES := NQ(IS) - KP(IS) - 1
  ELSE
    NODES := NQ(IS) + KP(IS)
  ENDIF

  ! Sommerfeld exact binding (Ha)
  D1 := REAL(NQ(IS)) - ABS(KAP) + SS
  ESOM := 1.0 / SQRT(1.0 + (ZZ/C)*(ZZ/C) / (D1*D1))
  ESOM := (1.0 - ESOM) * C * C

  ! scan the bound range for Wronskian sign changes; bisect each;
  ! keep the root with the target node count
  E1 := -1.5 * ZZ * ZZ
  E2 := -1.0e-6 * ZZ * ZZ
  EROOT := 0.0
  NFOUND := 0
  NSEL := -1
  EP := E1
  W0 := WRONK(EP)
  DO I = 2, NSC
    EP := E1 * ((E2 / E1) ** (REAL(I - 1) / REAL(NSC - 1)))
    W1 := WRONK(EP)
    IF (W0 * W1 < 0.0) THEN
      ! bisect [previous EP, EP] in log coordinates
      ELO := E1 * ((E2 / E1) ** (REAL(I - 2) / REAL(NSC - 1)))
      EHI := EP
      WLO := W0
      DO K = 1, NBS
        EM := -SQRT(ELO * EHI)
        WM := WRONK(EM)
        IF (WLO * WM < 0.0) THEN
          EHI := EM
        ELSE
          ELO := EM
          WLO := WM
        ENDIF
      ENDDO
      ! node count at the root
      ND := NNODE(EM)
      IF (INT(ND) == NODES) THEN
        IF (NFOUND == 0) THEN
          EROOT := EM
          NFOUND := 1
          NSEL := INT(ND)
        ENDIF
      ENDIF
    ENDIF
    W0 := W1
  ENDDO

  BIND := -EROOT
  BINDS(IS) := BIND
  DEV := BIND - ESOM
  WRITE(*, "('STATE Z=%.1f n=%d kappa=%d: bind %.10e  sommerfeld %.10e  dev %+.3e  nodes %d')") &
    ZZ, NQ(IS), KP(IS), BIND, ESOM, DEV, NSEL
ENDDO

! ── headline oracles ────────────────────────────────────────────────
! (1) nonrelativistic limit + first-order fine structure (Z=1, 1s):
!   shift = bind - Z^2/2 vs E1 = (Z a)^2 E_n/n (1/(j+1/2) - 3/(4n))
ENR := -0.5
EFS := (1.0/C)*(1.0/C) * ENR * (1.0 - 3.0/4.0)
SPL := BINDS(1) - 0.5
WRITE(*, "('ORACLE nonrel-limit shift: computed %.6e Ha, first-order %.6e Ha')") SPL, -EFS
! (2) 2P3/2 - 2P1/2 Dirac splitting (Lamb excluded): target 4.53e-5 eV
SPL := BINDS(3) - BINDS(4)
WRITE(*, "('ORACLE 2P1/2-2P3/2 split: %.6e Ha = %.6e eV (Dirac 4.53e-5 eV)')") &
  SPL, SPL * 27.211386245988
! (3) 2S1/2 = 2P1/2 degeneracy (kappa = -1 vs +1): exact in Dirac-Coulomb
WRITE(*, "('ORACLE 2S1/2-2P1/2 degeneracy: %.3e Ha (exact 0)')") &
  ABS(BINDS(2) - BINDS(3))
! (4) high-Z K shell already printed above (Pb82, U92)
WRITE(*, "('DONE')")
STOP

! ════════════════════════════════════════════════════════════════════
! WRONK(EP): normalized Wronskian of the outward (analytic-series) and
! inward (decaying) solutions at RMID. Outward: F = r^SS, G = Q0 r^SS.
! Inward: F = 1, G = QINF (decaying asymptotics). RK4 in t = log r.
! ════════════════════════════════════════════════════════════════════
REAL FUNCTION WRONK(EP)
   IMPLICIT NONE
   REAL :: EP
   REAL :: F, G, R, AA, BB, D1, D2, D3, D4
   REAL :: K1F, K1G, K2F, K2G, K3F, K3G, K4F, K4G
   REAL :: LAM, QINF, FO, GO, FI, GI, WN
   INTEGER :: K
   F := R0 ** SS
   G := Q0 * F
   R := R0
   DO K = 1, NRT
      AA := (EP * R + ZZ) / C
      BB := 2.0 * C * R + AA
      K1F := -KAP * F + BB * G
      K1G := -AA * F + KAP * G
      D1 := R * EXP(0.5 * H)
      D2 := (EP * D1 + ZZ) / C
      D3 := 2.0 * C * D1 + D2
      K2F := -KAP * (F + 0.5*H*K1F) + D3 * (G + 0.5*H*K1G)
      K2G := -D2 * (F + 0.5*H*K1F) + KAP * (G + 0.5*H*K1G)
      K3F := -KAP * (F + 0.5*H*K2F) + D3 * (G + 0.5*H*K2G)
      K3G := -D2 * (F + 0.5*H*K2F) + KAP * (G + 0.5*H*K2G)
      D4 := R * EXP(H)
      D2 := (EP * D4 + ZZ) / C
      D3 := 2.0 * C * D4 + D2
      K4F := -KAP * (F + H*K3F) + D3 * (G + H*K3G)
      K4G := -D2 * (F + H*K3F) + KAP * (G + H*K3G)
      F := F + H * (K1F + 2.0*K2F + 2.0*K3F + K4F) / 6.0
      G := G + H * (K1G + 2.0*K2G + 2.0*K3G + K4G) / 6.0
      R := D4
   ENDDO
   FO := F
   GO := G
   LAM := SQRT(-EP * (2.0*C*C + EP)) / C
   QINF := -LAM * C / (2.0*C*C + EP)
   FI := 1.0
   GI := QINF
   R := RMAX
   DO K = 1, NRHS
      AA := (EP * R + ZZ) / C
      BB := 2.0 * C * R + AA
      K1F := -KAP * FI + BB * GI
      K1G := -AA * FI + KAP * GI
      D1 := R * EXP(-0.5 * H)
      D2 := (EP * D1 + ZZ) / C
      D3 := 2.0 * C * D1 + D2
      K2F := -KAP * (FI - 0.5*H*K1F) + D3 * (GI - 0.5*H*K1G)
      K2G := -D2 * (FI - 0.5*H*K1F) + KAP * (GI - 0.5*H*K1G)
      K3F := -KAP * (FI - 0.5*H*K2F) + D3 * (GI - 0.5*H*K2G)
      K3G := -D2 * (FI - 0.5*H*K2F) + KAP * (GI - 0.5*H*K2G)
      D4 := R * EXP(-H)
      D2 := (EP * D4 + ZZ) / C
      D3 := 2.0 * C * D4 + D2
      K4F := -KAP * (FI - H*K3F) + D3 * (GI - H*K3G)
      K4G := -D2 * (FI - H*K3F) + KAP * (GI - H*K3G)
      FI := FI - H * (K1F + 2.0*K2F + 2.0*K3F + K4F) / 6.0
      GI := GI - H * (K1G + 2.0*K2G + 2.0*K3G + K4G) / 6.0
      R := D4
   ENDDO
   WN := (FO * GI - FI * GO) / (ABS(FO * FI) + ABS(GO * GI) + 1.0e-300)
   WRONK := WN
END

! ════════════════════════════════════════════════════════════════════
! NNODE(): radial node count of F at the current state parameters
! (runs the outward integration at EP = the module-static EPS).
! ════════════════════════════════════════════════════════════════════
INTEGER FUNCTION NNODE(EP)
   IMPLICIT NONE
   REAL :: EP
   REAL :: F, G, R, FO, AA, BB, D1, D2, D3, D4
   REAL :: K1F, K1G, K2F, K2G, K3F, K3G, K4F, K4G
   REAL :: LAM, QINF, FI, GI
   INTEGER :: K, NN
   NN := 0
   F := R0 ** SS
   G := Q0 * F
   R := R0
   DO K = 1, NRT
      FO := F
      AA := (EP * R + ZZ) / C
      BB := 2.0 * C * R + AA
      K1F := -KAP * F + BB * G
      K1G := -AA * F + KAP * G
      D1 := R * EXP(0.5 * H)
      D2 := (EP * D1 + ZZ) / C
      D3 := 2.0 * C * D1 + D2
      K2F := -KAP * (F + 0.5*H*K1F) + D3 * (G + 0.5*H*K1G)
      K2G := -D2 * (F + 0.5*H*K1F) + KAP * (G + 0.5*H*K1G)
      K3F := -KAP * (F + 0.5*H*K2F) + D3 * (G + 0.5*H*K2G)
      K3G := -D2 * (F + 0.5*H*K2F) + KAP * (G + 0.5*H*K2G)
      D4 := R * EXP(H)
      D2 := (EP * D4 + ZZ) / C
      D3 := 2.0 * C * D4 + D2
      K4F := -KAP * (F + H*K3F) + D3 * (G + H*K3G)
      K4G := -D2 * (F + H*K3F) + KAP * (G + H*K3G)
      F := F + H * (K1F + 2.0*K2F + 2.0*K3F + K4F) / 6.0
      G := G + H * (K1G + 2.0*K2G + 2.0*K3G + K4G) / 6.0
      R := D4
      IF (FO * F < 0.0) THEN
         NN := NN + 1
      ENDIF
   ENDDO
   ! inward leg: count sign changes from RMAX back to RMID too
   LAM := SQRT(-EP * (2.0*C*C + EP)) / C
   QINF := -LAM * C / (2.0*C*C + EP)
   FI := 1.0
   GI := QINF
   R := RMAX
   DO K = 1, NRHS
      FO := FI
      AA := (EP * R + ZZ) / C
      BB := 2.0 * C * R + AA
      K1F := -KAP * FI + BB * GI
      K1G := -AA * FI + KAP * GI
      D1 := R * EXP(-0.5 * H)
      D2 := (EP * D1 + ZZ) / C
      D3 := 2.0 * C * D1 + D2
      K2F := -KAP * (FI - 0.5*H*K1F) + D3 * (GI - 0.5*H*K1G)
      K2G := -D2 * (FI - 0.5*H*K1F) + KAP * (GI - 0.5*H*K1G)
      K3F := -KAP * (FI - 0.5*H*K2F) + D3 * (GI - 0.5*H*K2G)
      K3G := -D2 * (FI - 0.5*H*K2F) + KAP * (GI - 0.5*H*K2G)
      D4 := R * EXP(-H)
      D2 := (EP * D4 + ZZ) / C
      D3 := 2.0 * C * D4 + D2
      K4F := -KAP * (FI - H*K3F) + D3 * (GI - H*K3G)
      K4G := -D2 * (FI - H*K3F) + KAP * (GI - H*K3G)
      FI := FI - H * (K1F + 2.0*K2F + 2.0*K3F + K4F) / 6.0
      GI := GI - H * (K1G + 2.0*K2G + 2.0*K3G + K4G) / 6.0
      R := D4
      IF (FO * FI < 0.0) THEN
         NN := NN + 1
      ENDIF
   ENDDO
   NNODE := NN
END
