! ════════════════════════════════════════════════════════════
! INIT_COIL: per-block self-avoiding hash-walk coil + phases.
! Replicates the sequential INIT_CHAIN arithmetic exactly, with
! SEEDB in place of the SEED parameter and OFF-shifted state.
! ════════════════════════════════════════════════════════════

SUBROUTINE INIT_COIL(OFFB, SEEDB)
  INTEGER :: OFFB
  REAL :: SEEDB
  INTEGER :: I, ATT, J2, OK
  REAL :: U1, U2, COSTH, SINTH, PHI2, UX, UY, UZ, CANDX, CANDY, CANDZ, DD

  RES_X(OFFB + 1) := 10.0
  RES_Y(OFFB + 1) := 10.0
  RES_Z(OFFB + 1) := 10.0
  DO I = 2, NRES
    OK := 0
    ATT := 0
    DO WHILE ATT < 20
      ATT := ATT + 1
      U1 := MOD(ABS(SIN(REAL(I) * 12.9898 + REAL(ATT) * 3.7 + SEEDB) * 43758.5453), 1.0)
      U2 := MOD(ABS(SIN(REAL(I) * 78.2330 + REAL(ATT) * 1.3 + SEEDB) * 12543.1230), 1.0)
      COSTH := 2.0 * U1 - 1.0
      SINTH := SQRT(1.0 - COSTH * COSTH)
      PHI2 := 2.0 * 3.14159265 * U2
      UX := SINTH * COS(PHI2)
      UY := SINTH * SIN(PHI2)
      UZ := COSTH
      CANDX := RES_X(OFFB + I - 1) + UX * BACKBONE_R0
      CANDY := RES_Y(OFFB + I - 1) + UY * BACKBONE_R0
      CANDZ := RES_Z(OFFB + I - 1) + UZ * BACKBONE_R0
      OK := 1
      IF I ≥ 5 THEN
        DO J2 = 1, I - 4
          DD := SQRT((CANDX - RES_X(OFFB + J2))**2 + (CANDY - RES_Y(OFFB + J2))**2 + (CANDZ - RES_Z(OFFB + J2))**2)
          IF DD < 1.55 THEN
            OK := 0
          ENDIF
        ENDDO
      ENDIF
      IF OK = 1 THEN
        ATT := 20
      ENDIF
    ENDDO
    RES_X(OFFB + I) := CANDX
    RES_Y(OFFB + I) := CANDY
    RES_Z(OFFB + I) := CANDZ
  ENDDO

  DO I = 1, NRES
    RES_THETA(OFFB + I) := 0.3 * RES_X(OFFB + I) + 0.5 * RES_Y(OFFB + I) + 0.7 * RES_Z(OFFB + I) + SEEDB
    RES_OMEGA(OFFB + I) := BASE_OMEGA + 0.5 * SIN(RES_THETA(OFFB + I))
    RES_VX(OFFB + I) := 0.0
    RES_VY(OFFB + I) := 0.0
    RES_VZ(OFFB + I) := 0.0
  ENDDO
END

! ════════════════════════════════════════════════════════════
! INIT_TABLES: build block-aware packed index tables (offsets baked)
! and packed parameter tables from the shared per-residue params
! ════════════════════════════════════════════════════════════

SUBROUTINE INIT_TABLES()
  INTEGER :: B, I, K
  DO B = 1, NBLK
    DO I = 1, NRES - 1
      K := (B - 1) * 22 + I
      BOND_A(K) := (B - 1) * NRES + I
      BOND_B(K) := (B - 1) * NRES + I + 1
    ENDDO
    DO I = 2, NRES - 1
      K := (B - 1) * 21 + (I - 1)
      ANG_A(K) := (B - 1) * NRES + I - 1
      ANG_B(K) := (B - 1) * NRES + I
      ANG_C(K) := (B - 1) * NRES + I + 1
      ANGK_P(K) := RES_ANGK(I)
      ANGT0_P(K) := RES_ANGT0(I)
    ENDDO
    DO I = 2, NRES - 2
      K := (B - 1) * 20 + (I - 1)
      TORS_A(K) := (B - 1) * NRES + I - 1
      TORS_B(K) := (B - 1) * NRES + I
      TORS_C(K) := (B - 1) * NRES + I + 1
      TORS_D(K) := (B - 1) * NRES + I + 2
      TORSK_P(K) := RES_TORSK(I)
      TORSP0_P(K) := RES_TORSP0(I)
    ENDDO
  ENDDO
END

! ════════════════════════════════════════════════════════════
! UPDATE_THERMAL (block-independent; verbatim from source)
! ════════════════════════════════════════════════════════════

SUBROUTINE UPDATE_THERMAL(FRAME)
  INTEGER :: FRAME
  REAL :: FRAC

  THERMAL_CURRENT := HEAT_START

  IF FRAME < 300 THEN
    FRAC := REAL(FRAME) / 300.0
    THERMAL_CURRENT := HEAT_START + (HEAT_PEAK - HEAT_START) * FRAC
  ELSEIF FRAME < 600 THEN
    FRAC := REAL(FRAME - 300) / 300.0
    THERMAL_CURRENT := HEAT_PEAK - (HEAT_PEAK - HEAT_START) * FRAC
  ELSEIF FRAME < 900 THEN
    FRAC := REAL(FRAME - 600) / 300.0
    THERMAL_CURRENT := HEAT_START + (HEAT_PEAK - HEAT_START) * FRAC
  ELSEIF FRAME < 1200 THEN
    FRAC := REAL(FRAME - 900) / 300.0
    THERMAL_CURRENT := HEAT_PEAK - (HEAT_PEAK - HEAT_START) * FRAC
  ELSE
    THERMAL_CURRENT := HEAT_START
  ENDIF

  ! Quench tail: zero thermal noise after frame 12000
  IF FRAME > 12000 THEN
    THERMAL_CURRENT := 0.0
  ENDIF

  RETURN
END

! ════════════════════════════════════════════════════════════
! UPDATE_HBONDS (per block, OFFB-shifted; verbatim logic)
! ════════════════════════════════════════════════════════════

SUBROUTINE UPDATE_HBONDS(OFFB)
  INTEGER :: OFFB
  INTEGER :: I, J, DEG_I, DEG_J, NF, NB
  REAL :: DX, DY, DZ, D, ALIGN

  NF := 0
  NB := 0

  DO I = 1, NRES
    DEG_I := 0
    DO J = 1, NRES
      IF HBOND_MATRIX(OFFB + I, OFFB + J) = 1 THEN
        DEG_I := DEG_I + 1
      ENDIF
    ENDDO
  ENDDO

  ! Break weak H-bonds
  DO I = 1, NRES-3
    DO J = I+3, NRES
      IF HBOND_MATRIX(OFFB + I, OFFB + J) = 1 THEN
        DX := RES_X(OFFB + I) - RES_X(OFFB + J)
        DY := RES_Y(OFFB + I) - RES_Y(OFFB + J)
        DZ := RES_Z(OFFB + I) - RES_Z(OFFB + J)
        D := SQRT(DX*DX + DY*DY + DZ*DZ)
        ALIGN := COS(RES_THETA(OFFB + I) - RES_THETA(OFFB + J))
        IF ALIGN < HB_PHASE_STABLE .OR. D > HB_BREAK THEN
          HBOND_MATRIX(OFFB + I, OFFB + J) := 0
          HBOND_MATRIX(OFFB + J, OFFB + I) := 0
          NB := NB + 1
        ENDIF
      ENDIF
    ENDDO
  ENDDO

  ! Form new H-bonds
  DO I = 1, NRES-3
    DEG_I := 0
    DO J = 1, NRES
      IF HBOND_MATRIX(OFFB + I, OFFB + J) = 1 THEN
        DEG_I := DEG_I + 1
      ENDIF
    ENDDO
    IF DEG_I < HB_CAP THEN
      DO J = I+3, NRES
        IF HBOND_MATRIX(OFFB + I, OFFB + J) = 0 THEN
          DEG_J := 0
          DO K = 1, NRES
            IF HBOND_MATRIX(OFFB + J, OFFB + K) = 1 THEN
              DEG_J := DEG_J + 1
            ENDIF
          ENDDO
          IF DEG_J < HB_CAP THEN
            DX := RES_X(OFFB + I) - RES_X(OFFB + J)
            DY := RES_Y(OFFB + I) - RES_Y(OFFB + J)
            DZ := RES_Z(OFFB + I) - RES_Z(OFFB + J)
            D := SQRT(DX*DX + DY*DY + DZ*DZ)
            ALIGN := COS(RES_THETA(OFFB + I) - RES_THETA(OFFB + J))
            IF D < HB_FORM .AND. ALIGN > HB_PHASE_FORM THEN
              HBOND_MATRIX(OFFB + I, OFFB + J) := 1
              HBOND_MATRIX(OFFB + J, OFFB + I) := 1
              NF := NF + 1
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDIF
  ENDDO

  HB_FORMS := NF
  HB_BREAKS := NB

  RETURN
END

! ════════════════════════════════════════════════════════════
! COMPUTE_RMSD (per block, OFFB-shifted; Kabsch via quaternion
! power iteration — verbatim logic from source)
! ════════════════════════════════════════════════════════════

SUBROUTINE COMPUTE_RMSD(OFFB)
  INTEGER :: OFFB
  INTEGER :: I, ITER
  REAL :: XC, YC, ZC, XN, YN, ZN
  REAL :: SXX, SXY, SXZ, SYX, SYY, SYZ, SZX, SZY, SZZ
  REAL :: N44(4,4), VEC(4), NEWVEC(4), LAMBDA, NORM
  REAL :: RX, RY, RZ, NX, NY, NZ
  REAL :: Q0, Q1, Q2, Q3, QQ
  REAL :: R11, R12, R13, R21, R22, R23, R31, R32, R33
  REAL :: TX, TY, TZ, SUM_DIST_SQ

  XC := 0.0
  YC := 0.0
  ZC := 0.0
  DO I = 1, NRES
    XC := XC + RES_X(OFFB + I)
    YC := YC + RES_Y(OFFB + I)
    ZC := ZC + RES_Z(OFFB + I)
  ENDDO
  XC := XC / REAL(NRES)
  YC := YC / REAL(NRES)
  ZC := ZC / REAL(NRES)

  XN := 0.0
  YN := 0.0
  ZN := 0.0
  DO I = 1, NRES
    XN := XN + NATIVE_X(I)
    YN := YN + NATIVE_Y(I)
    ZN := ZN + NATIVE_Z(I)
  ENDDO
  XN := XN / REAL(NRES)
  YN := YN / REAL(NRES)
  ZN := ZN / REAL(NRES)

  SXX := 0.0
  SXY := 0.0
  SXZ := 0.0
  SYX := 0.0
  SYY := 0.0
  SYZ := 0.0
  SZX := 0.0
  SZY := 0.0
  SZZ := 0.0
  DO I = 1, NRES
    RX := RES_X(OFFB + I) - XC
    RY := RES_Y(OFFB + I) - YC
    RZ := RES_Z(OFFB + I) - ZC
    NX := NATIVE_X(I) - XN
    NY := NATIVE_Y(I) - YN
    NZ := NATIVE_Z(I) - ZN
    SXX := SXX + RX * NX
    SXY := SXY + RX * NY
    SXZ := SXZ + RX * NZ
    SYX := SYX + RY * NX
    SYY := SYY + RY * NY
    SYZ := SYZ + RY * NZ
    SZX := SZX + RZ * NX
    SZY := SZY + RZ * NY
    SZZ := SZZ + RZ * NZ
  ENDDO

  N44(1,1) := SXX + SYY + SZZ
  N44(1,2) := SYZ - SZY
  N44(1,3) := SZX - SXZ
  N44(1,4) := SXY - SYX
  N44(2,1) := SYZ - SZY
  N44(2,2) := SXX - SYY - SZZ
  N44(2,3) := SXY + SYX
  N44(2,4) := SXZ + SZX
  N44(3,1) := SZX - SXZ
  N44(3,2) := SXY + SYX
  N44(3,3) := -SXX + SYY - SZZ
  N44(3,4) := SYZ + SZY
  N44(4,1) := SXY - SYX
  N44(4,2) := SXZ + SZX
  N44(4,3) := SYZ + SZY
  N44(4,4) := -SXX - SYY + SZZ

  VEC(1) := 1.0
  VEC(2) := 0.0
  VEC(3) := 0.0
  VEC(4) := 0.0
  DO ITER = 1, 40
    NEWVEC(1) := N44(1,1)*VEC(1) + N44(1,2)*VEC(2) + N44(1,3)*VEC(3) + N44(1,4)*VEC(4)
    NEWVEC(2) := N44(2,1)*VEC(1) + N44(2,2)*VEC(2) + N44(2,3)*VEC(3) + N44(2,4)*VEC(4)
    NEWVEC(3) := N44(3,1)*VEC(1) + N44(3,2)*VEC(2) + N44(3,3)*VEC(3) + N44(3,4)*VEC(4)
    NEWVEC(4) := N44(4,1)*VEC(1) + N44(4,2)*VEC(2) + N44(4,3)*VEC(3) + N44(4,4)*VEC(4)
    NORM := SQRT(NEWVEC(1)*NEWVEC(1) + NEWVEC(2)*NEWVEC(2) + NEWVEC(3)*NEWVEC(3) + NEWVEC(4)*NEWVEC(4))
    IF NORM > 1.0E-12 THEN
      VEC(1) := NEWVEC(1) / NORM
      VEC(2) := NEWVEC(2) / NORM
      VEC(3) := NEWVEC(3) / NORM
      VEC(4) := NEWVEC(4) / NORM
    ENDIF
  ENDDO

  Q0 := VEC(1)
  Q1 := VEC(2)
  Q2 := VEC(3)
  Q3 := VEC(4)
  QQ := Q0*Q0 + Q1*Q1 + Q2*Q2 + Q3*Q3
  IF QQ > 1.0E-12 THEN
    QQ := SQRT(QQ)
    Q0 := Q0 / QQ
    Q1 := Q1 / QQ
    Q2 := Q2 / QQ
    Q3 := Q3 / QQ
  ENDIF
  R11 := Q0*Q0 + Q1*Q1 - Q2*Q2 - Q3*Q3
  R12 := 2.0*(Q1*Q2 - Q0*Q3)
  R13 := 2.0*(Q1*Q3 + Q0*Q2)
  R21 := 2.0*(Q1*Q2 + Q0*Q3)
  R22 := Q0*Q0 - Q1*Q1 + Q2*Q2 - Q3*Q3
  R23 := 2.0*(Q2*Q3 - Q0*Q1)
  R31 := 2.0*(Q1*Q3 - Q0*Q2)
  R32 := 2.0*(Q2*Q3 + Q0*Q1)
  R33 := Q0*Q0 - Q1*Q1 - Q2*Q2 + Q3*Q3

  SUM_DIST_SQ := 0.0
  DO I = 1, NRES
    RX := RES_X(OFFB + I) - XC
    RY := RES_Y(OFFB + I) - YC
    RZ := RES_Z(OFFB + I) - ZC
    TX := R11*RX + R12*RY + R13*RZ
    TY := R21*RX + R22*RY + R23*RZ
    TZ := R31*RX + R32*RY + R33*RZ
    NX := NATIVE_X(I) - XN
    NY := NATIVE_Y(I) - YN
    NZ := NATIVE_Z(I) - ZN
    SUM_DIST_SQ := SUM_DIST_SQ + (TX - NX)**2 + (TY - NY)**2 + (TZ - NZ)**2
  ENDDO
  RMSD_NATIVE := SQRT(SUM_DIST_SQ / REAL(NRES))

  RETURN
END
