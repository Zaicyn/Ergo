SUBROUTINE INIT_NATIVE()
  INTEGER :: I, J

  ! Native Cα coordinates, scaled by factor 0.399853

  NATIVE_X(1) := 3.996128
  NATIVE_Y(1) := 3.111654
  NATIVE_Z(1) := 3.120451
  NATIVE_X(2) := 3.890167
  NATIVE_Y(2) := 1.642595
  NATIVE_Z(2) := 2.748588
  NATIVE_X(3) := 4.947378
  NATIVE_Y(3) := 1.690977
  NATIVE_Z(3) := 1.645394
  NATIVE_X(4) := 6.014185
