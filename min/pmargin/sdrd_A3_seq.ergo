! WAVEFORM_SDRD_A3 - sdrd_A3 protein variant with native RMSD
! =====================================================================
! 168-residue protein variant
! Design: helix(1-9) - turn/cage(10-20)
! Includes hydrophobic attraction (L2,Y3,I4,W6,L7,P12,P17,P18,P19)
! Computes RMSD to native PDB 1L2Y coordinates at each frame.
!
! CSV: frame,rgyr,e2e,nhb,i3,i4,iL,bang_mean,bang_rms,tors_mean,alpha_frac,
!      e_morse,e_angle,e_torsion,e_hydro,thermal,rmsd_native

IMPLICIT NONE

! ── Chain / run ─────────────────────────────────────────────
PARAMETER INTEGER :: NRES = 168
PARAMETER INTEGER :: MAXHB = 256
PARAMETER INTEGER :: MAXFRAME = 48000

! ── Time stepping / coupling ──────────────────────────────────
PARAMETER REAL :: DT = 0.01
PARAMETER REAL :: FORCE_SCALE = 6.0
PARAMETER REAL :: VELOCITY_DAMP = 0.9
PARAMETER REAL :: BASE_OMEGA = 1.0
PARAMETER REAL :: COUPLING_K = 5.0
PARAMETER REAL :: PHASE_NOISE_SCALE = 10.0
PARAMETER REAL :: SEED = 0.0

! ── Thermal schedule ─────────────────────────────────────────
PARAMETER REAL :: HEAT_START = 0.001
PARAMETER REAL :: HEAT_PEAK = 1.0

! ── Backbone (permanent) ─────────────────────────────────────
PARAMETER REAL :: BACKBONE_R0 = 1.52
PARAMETER REAL :: BACKBONE_D = 1.4
PARAMETER REAL :: MORSE_A = 1.0

! ── H-bonds (dynamic contacts) ────────────────────────────────
PARAMETER REAL :: HB_R0 = 2.2
PARAMETER REAL :: HB_D = 0.30
PARAMETER REAL :: HB_FORM = 2.5
PARAMETER REAL :: HB_BREAK = 2.8
PARAMETER INTEGER :: HB_CAP = 0
PARAMETER REAL :: HB_PHASE_FORM = 0.80
PARAMETER REAL :: HB_PHASE_STABLE = 0.95

! ── Steric exclusion ─────────────────────────────────────────
PARAMETER REAL :: STERIC_SIG = 1.60
PARAMETER REAL :: STERIC_EPS = 0.1
PARAMETER REAL :: STERIC_CUT = 2.5

! ── Hydrophobic attraction ───────────────────────────────────
PARAMETER REAL :: HYDRO_STRENGTH = 0.0020
PARAMETER REAL :: HYDRO_R0 = 4.0
PARAMETER REAL :: HYDRO_CUTOFF = 8.0
PARAMETER REAL :: HYDRO_ALPHA = 1.0



! ── Native contact potential (Go-like) ─────────────────────────
PARAMETER REAL :: NATIVE_K = 1.00
PARAMETER REAL :: NATIVE_CUTOFF = 2.599043


! ── Cross-strand register torsion (β-sheet chirality) ─────────
PARAMETER INTEGER :: MAXREG = 576
PARAMETER INTEGER :: NREG = 576
PARAMETER INTEGER :: EXTRA_TORSIONS_FROM = 1200


! ── Residue state ─────────────────────────────────────────────
STATIC REAL :: RES_X(168)
STATIC REAL :: RES_Y(168)
STATIC REAL :: RES_Z(168)
STATIC REAL :: RES_VX(168)
STATIC REAL :: RES_VY(168)
STATIC REAL :: RES_VZ(168)
STATIC REAL :: RES_THETA(168)
STATIC REAL :: RES_OMEGA(168)

! ── Per-residue sequence parameters ──────────────────────────
STATIC REAL :: RES_ANGK(168)
STATIC REAL :: RES_ANGT0(168)
STATIC REAL :: RES_TORSK(168)
STATIC REAL :: RES_TORSP0(168)
STATIC REAL :: RES_HYDRO(168)



! ── Native coordinates (PDB 1L2Y, model 1, chain A) ─
! These are Cα positions from the NMR structure.
STATIC REAL :: NATIVE_X(168)
STATIC REAL :: NATIVE_Y(168)
STATIC REAL :: NATIVE_Z(168)

! ── Native contact state ─────────────────────────────────────
STATIC INTEGER :: NATIVE_CONTACT(168, 168)
STATIC REAL :: NATIVE_R0(168, 168)

! ── H-bond state ──────────────────────────────────────────────
STATIC INTEGER :: HBOND_MATRIX(168, 168)
STATIC INTEGER :: NHBOND
STATIC INTEGER :: HB_I(256)
STATIC INTEGER :: HB_J(256)

! ── Diagnostics ────────────────────────────────────────────────
STATIC REAL :: RGYR
STATIC REAL :: E2E
STATIC REAL :: BANG_MEAN
STATIC REAL :: BANG_RMS
STATIC REAL :: TORS_MEAN
STATIC REAL :: ALPHA_FRAC
STATIC REAL :: E_MORSE
STATIC REAL :: E_ANGLE
STATIC REAL :: E_TORSION
STATIC REAL :: E_HYDRO
STATIC REAL :: E_NATIVE
STATIC REAL :: THERMAL_CURRENT
STATIC REAL :: RMSD_NATIVE
STATIC INTEGER :: I3CNT
STATIC INTEGER :: I4CNT
STATIC INTEGER :: ILCNT
STATIC INTEGER :: HB_FORMS
STATIC INTEGER :: HB_BREAKS

! ── Working scalars ───────────────────────────────────────────
STATIC INTEGER :: I, J, K, FRAME, N, NC, NI3, NI4, NIL, DEG
STATIC REAL :: X, Y, Z, VX, VY, VZ, TH, OM, R, D, E, F
STATIC REAL :: DX, DY, DZ, CS, ALIGN, FM, TEMP_X, TEMP_Y, TEMP_Z
STATIC REAL :: SIN_AVG, COS_AVG, THETA_MEAN, PHASE_DEV
STATIC REAL :: SUM_RGYR, SUM_BANG, SUM_BANGSQ, SUM_TORS, CNT_TORS
STATIC REAL :: DIS, ANG, COSA, DEV, BX, CX, BY, CY, BZ, CZ
STATIC REAL :: UX, UY, UZ, WX, WY, WZ, UN, VN, B1X, B1Y, B1Z
STATIC REAL :: B2X, B2Y, B2Z, B3X, B3Y, B3Z, N1X, N1Y, N1Z
STATIC REAL :: N2X, N2Y, N2Z, B2MAG, PHI, DPHI_DR1X, DPHI_DR1Y, DPHI_DR1Z
STATIC REAL :: DPHI_DR4X, DPHI_DR4Y, DPHI_DR4Z, DPHI_DR2X, DPHI_DR2Y, DPHI_DR2Z
STATIC REAL :: DPHI_DR3X, DPHI_DR3Y, DPHI_DR3Z, N1MAG2, N2MAG2, N1MAG, N2MAG
STATIC REAL :: B1DOT, B3DOT, SCALE_B2, SCALE_B1, SCALE_B3, B2DOT
STATIC REAL :: SHIFT_SUM, SCALE_SHIFT, RMSD_SUM


STATIC INTEGER :: REG_A(MAXREG)
STATIC INTEGER :: REG_B(MAXREG)
STATIC INTEGER :: REG_C(MAXREG)
STATIC INTEGER :: REG_D(MAXREG)
STATIC REAL :: REG_K(MAXREG)
STATIC REAL :: REG_P0(MAXREG)
STATIC INTEGER :: IA, IB, IC, ID


! ── Initialize ─────────────────────────────────────────────
CALL INIT_CHAIN()
CALL INIT_NATIVE()

  ! Register torsions initialized in INIT_NATIVE


! CSV header
WRITE(*, "frame,rgyr,e2e,nhb,i3,i4,iL,bang_mean,bang_rms,tors_mean,alpha_frac,e_morse,e_angle,e_torsion,e_hydro,e_native,thermal,rmsd_native")

! ════════════════════════════════════════════════════════════
! MAIN LOOP
! ════════════════════════════════════════════════════════════
DO FRAME = 1, MAXFRAME

  ! Phase dynamics: intrinsic advance + Kuramoto coupling + noise
  DO I = 1, NRES
    RES_THETA(I) := RES_THETA(I) + RES_OMEGA(I) * DT
  ENDDO

  SIN_AVG := 0.0
  COS_AVG := 0.0
  DO I = 1, NRES
    SIN_AVG := SIN_AVG + SIN(RES_THETA(I))
    COS_AVG := COS_AVG + COS(RES_THETA(I))
  ENDDO
  THETA_MEAN := ATAN2(SIN_AVG, COS_AVG)
  DO I = 1, NRES
    RES_THETA(I) := RES_THETA(I) + COUPLING_K * SIN(THETA_MEAN - RES_THETA(I)) * DT
  ENDDO

  ! Phase noise
  TEMP_X := THERMAL_CURRENT * PHASE_NOISE_SCALE
  DO I = 1, NRES
    RES_THETA(I) := RES_THETA(I) + TEMP_X * SIN((I+1)*11.3 + REAL(FRAME)*0.23) * DT
  ENDDO

  ! Thermal impulses (velocity kicks)
  DO I = 1, NRES
    RES_VX(I) := RES_VX(I) + THERMAL_CURRENT * SIN((I+1)*7.3 + REAL(FRAME)*0.17)
    RES_VY(I) := RES_VY(I) + THERMAL_CURRENT * COS((I+1)*5.7 + REAL(FRAME)*0.31)
    RES_VZ(I) := RES_VZ(I) + THERMAL_CURRENT * SIN((I+1)*3.1 + REAL(FRAME)*0.09)
  ENDDO

  ! Steric repulsion (|i-j| >= 4, not H-bonded)
  DO I = 1, NRES-4
    DO J = I+4, NRES
      IF HBOND_MATRIX(I, J) = 0 THEN
        DX := RES_X(I) - RES_X(J)
        DY := RES_Y(I) - RES_Y(J)
        DZ := RES_Z(I) - RES_Z(J)
        D := SQRT(DX*DX + DY*DY + DZ*DZ)
        IF D > 0.0 .AND. D < STERIC_CUT THEN
          FM := STERIC_EPS * (STERIC_SIG / D) ** 6
          RES_VX(I) := RES_VX(I) + FM * DX / D * DT * FORCE_SCALE
          RES_VY(I) := RES_VY(I) + FM * DY / D * DT * FORCE_SCALE
          RES_VZ(I) := RES_VZ(I) + FM * DZ / D * DT * FORCE_SCALE
          RES_VX(J) := RES_VX(J) - FM * DX / D * DT * FORCE_SCALE
          RES_VY(J) := RES_VY(J) - FM * DY / D * DT * FORCE_SCALE
          RES_VZ(J) := RES_VZ(J) - FM * DZ / D * DT * FORCE_SCALE
        ENDIF
      ENDIF
    ENDDO
  ENDDO

  ! Hydrophobic attraction between Cα beads (coarse-grained core packing)
  DO I = 1, NRES-4
    DO J = I+4, NRES
      IF RES_HYDRO(I) > 0.0 .AND. RES_HYDRO(J) > 0.0 THEN
        DX := RES_X(I) - RES_X(J)
        DY := RES_Y(I) - RES_Y(J)
        DZ := RES_Z(I) - RES_Z(J)
        D := SQRT(DX*DX + DY*DY + DZ*DZ)
        IF D > 0.0 .AND. D < HYDRO_CUTOFF THEN
          FM := -HYDRO_STRENGTH * RES_HYDRO(I) * RES_HYDRO(J) * EXP(-HYDRO_ALPHA * (D - HYDRO_R0))
          RES_VX(I) := RES_VX(I) + FM * DX / D * DT * FORCE_SCALE
          RES_VY(I) := RES_VY(I) + FM * DY / D * DT * FORCE_SCALE
          RES_VZ(I) := RES_VZ(I) + FM * DZ / D * DT * FORCE_SCALE
          RES_VX(J) := RES_VX(J) - FM * DX / D * DT * FORCE_SCALE
          RES_VY(J) := RES_VY(J) - FM * DY / D * DT * FORCE_SCALE
          RES_VZ(J) := RES_VZ(J) - FM * DZ / D * DT * FORCE_SCALE
        ENDIF
      ENDIF
    ENDDO
  ENDDO

  

  ! Go-like native contact potential (harmonic, Cα-Cα < 6.5 Å in native)
  DO I = 1, NRES-3
    DO J = I+3, NRES
      IF NATIVE_CONTACT(I, J) = 1 THEN
        DX := RES_X(I) - RES_X(J)
        DY := RES_Y(I) - RES_Y(J)
        DZ := RES_Z(I) - RES_Z(J)
        D := SQRT(DX*DX + DY*DY + DZ*DZ)
        IF D > 0.0 THEN
          FM := -2.0 * NATIVE_K * (D - NATIVE_R0(I, J))
          RES_VX(I) := RES_VX(I) + FM * DX / D * DT * FORCE_SCALE
          RES_VY(I) := RES_VY(I) + FM * DY / D * DT * FORCE_SCALE
          RES_VZ(I) := RES_VZ(I) + FM * DZ / D * DT * FORCE_SCALE
          RES_VX(J) := RES_VX(J) - FM * DX / D * DT * FORCE_SCALE
          RES_VY(J) := RES_VY(J) - FM * DY / D * DT * FORCE_SCALE
          RES_VZ(J) := RES_VZ(J) - FM * DZ / D * DT * FORCE_SCALE
        ENDIF
      ENDIF
    ENDDO
  ENDDO

  ! Morse bonds (backbone)
  DO I = 1, NRES-1
    DX := RES_X(I) - RES_X(I+1)
    DY := RES_Y(I) - RES_Y(I+1)
    DZ := RES_Z(I) - RES_Z(I+1)
    D := SQRT(DX*DX + DY*DY + DZ*DZ)
    IF D > 0.0 THEN
      E := EXP(-MORSE_A * (D - BACKBONE_R0))
      FM := -2.0 * BACKBONE_D * MORSE_A * (1.0 - E) * E * FORCE_SCALE
      RES_VX(I) := RES_VX(I) + FM * DX / D * DT
      RES_VY(I) := RES_VY(I) + FM * DY / D * DT
      RES_VZ(I) := RES_VZ(I) + FM * DZ / D * DT
      RES_VX(I+1) := RES_VX(I+1) - FM * DX / D * DT
      RES_VY(I+1) := RES_VY(I+1) - FM * DY / D * DT
      RES_VZ(I+1) := RES_VZ(I+1) - FM * DZ / D * DT
    ENDIF
  ENDDO

  ! NOTE: dynamic H-bond force temporarily disabled for Trp-cage sweep

  ! Angle bending (backbone angles)
  DO I = 2, NRES-1
    BX := RES_X(I-1) - RES_X(I)
    BY := RES_Y(I-1) - RES_Y(I)
    BZ := RES_Z(I-1) - RES_Z(I)
    CX := RES_X(I+1) - RES_X(I)
    CY := RES_Y(I+1) - RES_Y(I)
    CZ := RES_Z(I+1) - RES_Z(I)
    UN := SQRT(BX*BX + BY*BY + BZ*BZ)
    VN := SQRT(CX*CX + CY*CY + CZ*CZ)
    IF UN > 1.0E-12 .AND. VN > 1.0E-12 THEN
      CS := MAX(-1.0, MIN(1.0, (BX*CX + BY*CY + BZ*CZ) / (UN * VN)))
      E := 2.0 * RES_ANGK(I) * (CS - COS(RES_ANGT0(I)))
      UX := (CX / (UN * VN) - CS * BX / UN / UN)
      UY := (CY / (UN * VN) - CS * BY / UN / UN)
      UZ := (CZ / (UN * VN) - CS * BZ / UN / UN)
      WX := (BX / (UN * VN) - CS * CX / VN / VN)
      WY := (BY / (UN * VN) - CS * CY / VN / VN)
      WZ := (BZ / (UN * VN) - CS * CZ / VN / VN)
      RES_VX(I-1) := RES_VX(I-1) - E * UX * DT * FORCE_SCALE
      RES_VY(I-1) := RES_VY(I-1) - E * UY * DT * FORCE_SCALE
      RES_VZ(I-1) := RES_VZ(I-1) - E * UZ * DT * FORCE_SCALE
      RES_VX(I+1) := RES_VX(I+1) - E * WX * DT * FORCE_SCALE
      RES_VY(I+1) := RES_VY(I+1) - E * WY * DT * FORCE_SCALE
      RES_VZ(I+1) := RES_VZ(I+1) - E * WZ * DT * FORCE_SCALE
      RES_VX(I) := RES_VX(I) + (E * UX + E * WX) * DT * FORCE_SCALE
      RES_VY(I) := RES_VY(I) + (E * UY + E * WY) * DT * FORCE_SCALE
      RES_VZ(I) := RES_VZ(I) + (E * UZ + E * WZ) * DT * FORCE_SCALE
    ENDIF
  ENDDO

  ! Torsion (dihedral) angles
  DO I = 2, NRES-2
    B1X := RES_X(I) - RES_X(I-1)
    B1Y := RES_Y(I) - RES_Y(I-1)
    B1Z := RES_Z(I) - RES_Z(I-1)
    B2X := RES_X(I+1) - RES_X(I)
    B2Y := RES_Y(I+1) - RES_Y(I)
    B2Z := RES_Z(I+1) - RES_Z(I)
    B3X := RES_X(I+2) - RES_X(I+1)
    B3Y := RES_Y(I+2) - RES_Y(I+1)
    B3Z := RES_Z(I+2) - RES_Z(I+1)

    N1X := B1Y*B2Z - B1Z*B2Y
    N1Y := B1Z*B2X - B1X*B2Z
    N1Z := B1X*B2Y - B1Y*B2X
    N2X := B2Y*B3Z - B2Z*B3Y
    N2Y := B2Z*B3X - B2X*B3Z
    N2Z := B2X*B3Y - B2Y*B3X

    N1MAG2 := N1X*N1X + N1Y*N1Y + N1Z*N1Z
    N2MAG2 := N2X*N2X + N2Y*N2Y + N2Z*N2Z
    B2MAG := SQRT(B2X*B2X + B2Y*B2Y + B2Z*B2Z)

    IF N1MAG2 > 1.0E-12 .AND. N2MAG2 > 1.0E-12 .AND. B2MAG > 1.0E-12 THEN
      N1MAG := SQRT(N1MAG2)
      N2MAG := SQRT(N2MAG2)
      PHI := ATAN2(B2MAG*(B1X*N2X + B1Y*N2Y + B1Z*N2Z), N1X*N2X + N1Y*N2Y + N1Z*N2Z)
      E := 2.0 * RES_TORSK(I) * (1.0 - COS(PHI - RES_TORSP0(I)))

      DPHI_DR1X := -B2MAG / N1MAG2 * N1X
      DPHI_DR1Y := -B2MAG / N1MAG2 * N1Y
      DPHI_DR1Z := -B2MAG / N1MAG2 * N1Z

      DPHI_DR4X := B2MAG / N2MAG2 * N2X
      DPHI_DR4Y := B2MAG / N2MAG2 * N2Y
      DPHI_DR4Z := B2MAG / N2MAG2 * N2Z

      B1DOT := B1X*B2X + B1Y*B2Y + B1Z*B2Z
      B3DOT := B3X*B2X + B3Y*B2Y + B3Z*B2Z
      SCALE_B2 := 1.0 / (B2MAG * B2MAG)
      SCALE_B1 := B1DOT * SCALE_B2
      SCALE_B3 := B3DOT * SCALE_B2

      DPHI_DR2X := -(1.0 + SCALE_B1) * DPHI_DR1X + SCALE_B3 * DPHI_DR4X
      DPHI_DR2Y := -(1.0 + SCALE_B1) * DPHI_DR1Y + SCALE_B3 * DPHI_DR4Y
      DPHI_DR2Z := -(1.0 + SCALE_B1) * DPHI_DR1Z + SCALE_B3 * DPHI_DR4Z

      DPHI_DR3X := -(DPHI_DR1X + DPHI_DR2X + DPHI_DR4X)
      DPHI_DR3Y := -(DPHI_DR1Y + DPHI_DR2Y + DPHI_DR4Y)
      DPHI_DR3Z := -(DPHI_DR1Z + DPHI_DR2Z + DPHI_DR4Z)

      F := -2.0 * RES_TORSK(I) * SIN(PHI - RES_TORSP0(I))

      RES_VX(I-1) := RES_VX(I-1) + F * DPHI_DR1X * DT * FORCE_SCALE
      RES_VY(I-1) := RES_VY(I-1) + F * DPHI_DR1Y * DT * FORCE_SCALE
      RES_VZ(I-1) := RES_VZ(I-1) + F * DPHI_DR1Z * DT * FORCE_SCALE

      RES_VX(I) := RES_VX(I) + F * DPHI_DR2X * DT * FORCE_SCALE
      RES_VY(I) := RES_VY(I) + F * DPHI_DR2Y * DT * FORCE_SCALE
      RES_VZ(I) := RES_VZ(I) + F * DPHI_DR2Z * DT * FORCE_SCALE

      RES_VX(I+1) := RES_VX(I+1) + F * DPHI_DR3X * DT * FORCE_SCALE
      RES_VY(I+1) := RES_VY(I+1) + F * DPHI_DR3Y * DT * FORCE_SCALE
      RES_VZ(I+1) := RES_VZ(I+1) + F * DPHI_DR3Z * DT * FORCE_SCALE

      RES_VX(I+2) := RES_VX(I+2) + F * DPHI_DR4X * DT * FORCE_SCALE
      RES_VY(I+2) := RES_VY(I+2) + F * DPHI_DR4Y * DT * FORCE_SCALE
      RES_VZ(I+2) := RES_VZ(I+2) + F * DPHI_DR4Z * DT * FORCE_SCALE
    ENDIF
  ENDDO

  
  ! Cross-strand register torsions (chirality of native sheet packing)
  IF FRAME > EXTRA_TORSIONS_FROM THEN
    DO K = 1, NREG
      IA := REG_A(K)
      IB := REG_B(K)
      IC := REG_C(K)
      ID := REG_D(K)

      B1X := RES_X(IB) - RES_X(IA)
      B1Y := RES_Y(IB) - RES_Y(IA)
      B1Z := RES_Z(IB) - RES_Z(IA)
      B2X := RES_X(IC) - RES_X(IB)
      B2Y := RES_Y(IC) - RES_Y(IB)
      B2Z := RES_Z(IC) - RES_Z(IB)
      B3X := RES_X(ID) - RES_X(IC)
      B3Y := RES_Y(ID) - RES_Y(IC)
      B3Z := RES_Z(ID) - RES_Z(IC)

      N1X := B1Y*B2Z - B1Z*B2Y
      N1Y := B1Z*B2X - B1X*B2Z
      N1Z := B1X*B2Y - B1Y*B2X
      N2X := B2Y*B3Z - B2Z*B3Y
      N2Y := B2Z*B3X - B2X*B3Z
      N2Z := B2X*B3Y - B2Y*B3X

      N1MAG2 := N1X*N1X + N1Y*N1Y + N1Z*N1Z
      N2MAG2 := N2X*N2X + N2Y*N2Y + N2Z*N2Z
      B2MAG := SQRT(B2X*B2X + B2Y*B2Y + B2Z*B2Z)

      IF N1MAG2 > 1.0E-12 .AND. N2MAG2 > 1.0E-12 .AND. B2MAG > 1.0E-12 THEN
        N1MAG := SQRT(N1MAG2)
        N2MAG := SQRT(N2MAG2)
        PHI := ATAN2(B2MAG*(B1X*N2X + B1Y*N2Y + B1Z*N2Z), N1X*N2X + N1Y*N2Y + N1Z*N2Z)
        F := -2.0 * REG_K(K) * SIN(PHI - REG_P0(K))

        DPHI_DR1X := -B2MAG / N1MAG2 * N1X
        DPHI_DR1Y := -B2MAG / N1MAG2 * N1Y
        DPHI_DR1Z := -B2MAG / N1MAG2 * N1Z

        DPHI_DR4X := B2MAG / N2MAG2 * N2X
        DPHI_DR4Y := B2MAG / N2MAG2 * N2Y
        DPHI_DR4Z := B2MAG / N2MAG2 * N2Z

        B1DOT := B1X*B2X + B1Y*B2Y + B1Z*B2Z
        B3DOT := B3X*B2X + B3Y*B2Y + B3Z*B2Z
        SCALE_B2 := 1.0 / (B2MAG * B2MAG)
        SCALE_B1 := B1DOT * SCALE_B2
        SCALE_B3 := B3DOT * SCALE_B2

        DPHI_DR2X := -(1.0 + SCALE_B1) * DPHI_DR1X + SCALE_B3 * DPHI_DR4X
        DPHI_DR2Y := -(1.0 + SCALE_B1) * DPHI_DR1Y + SCALE_B3 * DPHI_DR4Y
        DPHI_DR2Z := -(1.0 + SCALE_B1) * DPHI_DR1Z + SCALE_B3 * DPHI_DR4Z

        DPHI_DR3X := -(DPHI_DR1X + DPHI_DR2X + DPHI_DR4X)
        DPHI_DR3Y := -(DPHI_DR1Y + DPHI_DR2Y + DPHI_DR4Y)
        DPHI_DR3Z := -(DPHI_DR1Z + DPHI_DR2Z + DPHI_DR4Z)

        RES_VX(IA) := RES_VX(IA) + F * DPHI_DR1X * DT * FORCE_SCALE
        RES_VY(IA) := RES_VY(IA) + F * DPHI_DR1Y * DT * FORCE_SCALE
        RES_VZ(IA) := RES_VZ(IA) + F * DPHI_DR1Z * DT * FORCE_SCALE

        RES_VX(IB) := RES_VX(IB) + F * DPHI_DR2X * DT * FORCE_SCALE
        RES_VY(IB) := RES_VY(IB) + F * DPHI_DR2Y * DT * FORCE_SCALE
        RES_VZ(IB) := RES_VZ(IB) + F * DPHI_DR2Z * DT * FORCE_SCALE

        RES_VX(IC) := RES_VX(IC) + F * DPHI_DR3X * DT * FORCE_SCALE
        RES_VY(IC) := RES_VY(IC) + F * DPHI_DR3Y * DT * FORCE_SCALE
        RES_VZ(IC) := RES_VZ(IC) + F * DPHI_DR3Z * DT * FORCE_SCALE

        RES_VX(ID) := RES_VX(ID) + F * DPHI_DR4X * DT * FORCE_SCALE
        RES_VY(ID) := RES_VY(ID) + F * DPHI_DR4Y * DT * FORCE_SCALE
        RES_VZ(ID) := RES_VZ(ID) + F * DPHI_DR4Z * DT * FORCE_SCALE
      ENDIF
    ENDDO
  ENDIF


  ! Velocity damping
  DO I = 1, NRES
    RES_VX(I) := RES_VX(I) * VELOCITY_DAMP
    RES_VY(I) := RES_VY(I) * VELOCITY_DAMP
    RES_VZ(I) := RES_VZ(I) * VELOCITY_DAMP
  ENDDO

  ! Position update
  DO I = 1, NRES
    RES_X(I) := RES_X(I) + RES_VX(I) * DT
    RES_Y(I) := RES_Y(I) + RES_VY(I) * DT
    RES_Z(I) := RES_Z(I) + RES_VZ(I) * DT
  ENDDO

  ! H-bond update
  CALL UPDATE_HBONDS()

  ! Thermal schedule
  CALL UPDATE_THERMAL(FRAME)

  ! Output every 10 frames
  IF MOD(FRAME, 10) = 0 .OR. FRAME = MAXFRAME THEN
    CALL COMPUTE_DIAGNOSTICS()
    CALL COMPUTE_RMSD()
    WRITE(*, "%d,%.4f,%.4f,%d,%d,%d,%d,%.2f,%.2f,%.2f,%.3f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f") &
      FRAME, RGYR, E2E, NHBOND, I3CNT, I4CNT, ILCNT, BANG_MEAN, BANG_RMS, TORS_MEAN, &
      ALPHA_FRAC, E_MORSE, E_ANGLE, E_TORSION, E_HYDRO, E_NATIVE, THERMAL_CURRENT, RMSD_NATIVE
  ENDIF

ENDDO

! Final structure dump for gap analysis
WRITE(*, "FINAL_STRUCTURE")
DO I = 1, NRES
  WRITE(*, "%d,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f") &
    I, RES_X(I), RES_Y(I), RES_Z(I), NATIVE_X(I), NATIVE_Y(I), NATIVE_Z(I)
ENDDO
WRITE(*, "END_FINAL_STRUCTURE")

STOP

! ════════════════════════════════════════════════════════════
! SUBROUTINES
! ════════════════════════════════════════════════════════════

SUBROUTINE INIT_CHAIN()
  INTEGER :: I, ATT, J2, OK
  REAL :: TH0, OM0, R
  REAL :: U1, U2, COSTH, SINTH, PHI2, UX, UY, UZ, CANDX, CANDY, CANDZ, DD

  ! Self-avoiding random walk coil (denatured start)
  RES_X(1) := 10.0
  RES_Y(1) := 10.0
  RES_Z(1) := 10.0
  DO I = 2, NRES
    OK := 0
    ATT := 0
    DO WHILE ATT < 20
      ATT := ATT + 1
      U1 := MOD(ABS(SIN(REAL(I) * 12.9898 + REAL(ATT) * 3.7 + SEED) * 43758.5453), 1.0)
      U2 := MOD(ABS(SIN(REAL(I) * 78.2330 + REAL(ATT) * 1.3 + SEED) * 12543.1230), 1.0)
      COSTH := 2.0 * U1 - 1.0
      SINTH := SQRT(1.0 - COSTH * COSTH)
      PHI2 := 2.0 * 3.14159265 * U2
      UX := SINTH * COS(PHI2)
      UY := SINTH * SIN(PHI2)
      UZ := COSTH
      CANDX := RES_X(I - 1) + UX * BACKBONE_R0
      CANDY := RES_Y(I - 1) + UY * BACKBONE_R0
      CANDZ := RES_Z(I - 1) + UZ * BACKBONE_R0
      OK := 1
      IF I ≥ 5 THEN
        DO J2 = 1, I - 4
          DD := SQRT((CANDX - RES_X(J2))**2 + (CANDY - RES_Y(J2))**2 + (CANDZ - RES_Z(J2))**2)
          IF DD < 1.55 THEN
            OK := 0
          ENDIF
        ENDDO
      ENDIF
      IF OK = 1 THEN
        ATT := 20
      ENDIF
    ENDDO
    RES_X(I) := CANDX
    RES_Y(I) := CANDY
    RES_Z(I) := CANDZ
  ENDDO

  ! Phases from position hash; zero velocities
  DO I = 1, NRES
    RES_THETA(I) := 0.3 * RES_X(I) + 0.5 * RES_Y(I) + 0.7 * RES_Z(I) + SEED
    RES_OMEGA(I) := BASE_OMEGA + 0.5 * SIN(RES_THETA(I))
    RES_VX(I) := 0.0
    RES_VY(I) := 0.0
    RES_VZ(I) := 0.0
  ENDDO

  ! Sequence design: native angle targets and native torsion targets
  DO I = 1, NRES
    RES_ANGK(I) := 0.3000
    RES_TORSK(I) := 0.2000
  ENDDO

  ! Native Cα-Cα-Cα angle targets
  RES_ANGT0(1) := 0.000000
  RES_ANGT0(2) := 2.021159
  RES_ANGT0(3) := 1.959837
  RES_ANGT0(4) := 2.389121
