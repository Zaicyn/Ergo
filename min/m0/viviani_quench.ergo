! viviani_quench.ergo -- Stage D: quench dynamics of the exact-zero state
! Rename: viviani_quench.ergo.txt -> viviani_quench.ergo
! Run: python -m core min/<dir>/viviani_quench.ergo -o /tmp/vq && /tmp/vq
!      (expect ~1-3 min; 32000 RK4 steps x 5 Hamiltonian actions)
!
! PROTOCOL: psi(0) = ground state of the h=0 Hamiltonian (the certified
! exact zero, MB ~ 1e-18). At t=0 the h=1 dressed Hamiltonian is switched
! on; psi(t) evolves by fixed-step RK4 under H_shifted = H(h=1) - ESH*I,
! ESH = -764.0411454584249 (the h=1 ground energy; removes the fast global
! phase so RK4 is accurate at DT=1.25e-4; observable is shift-invariant).
! Observable M(t) = (1/N) sum_i <n_i.S_i> via the field-only action.
!
! MIRROR ORACLES (numpy RK4, converged: |M(dt)-M(dt/2)| = 3.1e-7 at
! DT=2.5e-4 vs 1.25e-4, this run at DT=1.25e-4; estimated error ~2e-8):
!   E0B  = -7.638857208193e+02   (h=0 ground energy, tol 1e-7)
!   M0   < 1e-12                 (the exact zero at t=0)
!   step  2000  M = +2.284007295593015e-03
!   step  4000  M = +5.827427280606545e-03
!   step  6000  M = +1.018264727817591e-02
!   step  8000  M = +1.685199447976861e-02
!   step 10000  M = +2.303641216565956e-02
!   step 12000  M = +2.935456324560755e-02
!   step 14000  M = +3.623053491193597e-02
!   step 16000  M = +4.201790924857322e-02
!   step 18000  M = +4.644699899698410e-02
!   step 20000  M = +4.852376450126309e-02
!   step 22000  M = +4.902835921057525e-02
!   step 24000  M = +4.810729382219326e-02
!   step 26000  M = +4.469116095069325e-02
!   step 28000  M = +4.046607169928726e-02
!   step 30000  M = +3.477382523834734e-02
!   step 32000  M = +2.686537360875078e-02
!   QMEAN = +2.576785852255086e-02   QMAX = +5.052690429593516e-02
!   QMIN  ~ 0 (the t=0 value)        QNORM = 9.999999999665381e-01
! Tolerances: M rows and stats to 1e-6 abs (RK4 convergence + accumulation
! order); QNORM to 1e-6.
!
! VERDICT KEY: M(t) rings up from the exact zero and oscillates around
! MA = +2.578664e-02 (the h=1 ground-state value) with dominant frequency
! omega ~ 26.7 ~ the gap -- M(t) ~ MA(1 - cos(gap t)), peak ~2*MA. The
! exact-zero state is NOT dynamically attractive; the quench populates the
! new equilibrium immediately and permanently (closed system, no damping).
! dm/dt = 0 holds for eigenstates only -- tautologically.

IMPLICIT NONE
INTEGER, PARAMETER :: N = 12, NIT = 150, DIM = 4096
INTEGER, PARAMETER :: NSTEPS = 32000
STATIC REAL :: NX(12), NY(12), NZ(12), CC(12), SS(12)
STATIC REAL :: QR(150,4096), QI(150,4096)
STATIC REAL :: AL(150), BE(150), A(150,150), V(150,150)
STATIC REAL :: WR(4096), WI(4096), RR(4096), RI(4096), YV(150)
STATIC REAL :: K1R(4096), K1I(4096), K2R(4096), K2I(4096)
STATIC REAL :: K3R(4096), K3I(4096), K4R(4096), K4I(4096)
STATIC REAL :: TMPR(4096), TMPI(4096), PQ(3), PO(3)
REAL :: PI, CA, SA, TH, CHI, DG, AR, AI, XR, XI
REAL :: Q0, Q1, Q2, Q3, R0, R1, R2, R3
REAL :: BETA, ALJ, CR, CI, NRM, JJ, HH, MVAL
REAL :: OFF, TAU, TT, C, SN, AKP, AKQ, APK, AQR, VKP, VKQ, EMN
REAL :: ESH, DT, DT2, DT6, MSUM, MMIN, MMAX, NRMF
INTEGER :: I, J, K, P, Q, S0, IT, S, T, BI, BJ, I0, NSW

PI := 3.14159265358979323846

! ---------------- geometry: (1,3) torus knot on S3, Hopf map + fiber twist
CA := COS(PI/4.0)
SA := SIN(PI/4.0)
DO I = 1, N
   TH := 2.0*PI*(I-1)/N
   Q0 := CA*COS(1.0*TH)
   Q1 := CA*SIN(1.0*TH)
   Q2 := SA*COS(3.0*TH)
   Q3 := SA*SIN(3.0*TH)
   ! n = q (i) conj(q), Hamilton product, scalar part discarded
   ! qmul(q, i): (-Q1, Q0, Q3, -Q2)
   R0 := -Q1
   R1 := Q0
   R2 := Q3
   R3 := -Q2
   ! qmul(R, conj(q)) = qmul(R, (Q0,-Q1,-Q2,-Q3))
   NX(I) := R0*(-Q1) + R1*Q0 + R2*(-Q3) - R3*(-Q2)
   NY(I) := R0*(-Q2) - R1*(-Q3) + R2*Q0 + R3*(-Q1)
   NZ(I) := R0*(-Q3) + R1*(-Q2) - R2*(-Q1) + R3*Q0
ENDDO
DO I = 1, N
   ! reconstruct q at i and i+1 for the fiber twist
   TH := 2.0*PI*(I-1)/N
   Q0 := CA*COS(1.0*TH)
   Q1 := CA*SIN(1.0*TH)
   Q2 := SA*COS(3.0*TH)
   Q3 := SA*SIN(3.0*TH)
   TH := 2.0*PI*I/N
   IF (I = N) THEN
      TH := 0.0
   ENDIF
   R0 := CA*COS(1.0*TH)
   R1 := CA*SIN(1.0*TH)
   R2 := SA*COS(3.0*TH)
   R3 := SA*SIN(3.0*TH)
   ! dq = qmul(q2, conj(q1))
   Q0 := R0*Q0 - R1*(-Q1) - R2*(-Q2) - R3*(-Q3)
   IF (Q0 > 1.0) THEN
      Q0 := 1.0
   ENDIF
   IF (Q0 < -1.0) THEN
      Q0 := -1.0
   ENDIF
   CHI := 2.0*ACOS(Q0)
   CC(I) := COS(CHI)
   SS(I) := SIN(CHI)
ENDDO

! ---------------- ground state of H(h=0): Lanczos, Neel start ----------------
! (e_0 is an exact eigenstate at h=0 -> start from s0=2730 = 101010101010)
HH := 0.0
JJ := 200.0
S0 := 2730
PQ(1) := HH
PQ(2) := JJ
PQ(3) := 0.0
DO S = 1, DIM
   QR(1,S) := 0.0
   QI(1,S) := 0.0
ENDDO
QR(1,S0+1) := 1.0
BETA := 0.0
DO IT = 1, NIT
   DO S = 1, DIM
      TMPR(S) := QR(IT,S)
      TMPI(S) := QI(IT,S)
      WR(S) := 0.0
      WI(S) := 0.0
   ENDDO
   CALL HACT(TMPR, TMPI, WR, WI, PQ)
   ALJ := 0.0
   DO S = 1, DIM
      ALJ := ALJ + QR(IT,S)*WR(S) + QI(IT,S)*WI(S)
   ENDDO
   AL(IT) := ALJ
   DO S = 1, DIM
      WR(S) := WR(S) - ALJ*QR(IT,S)
      WI(S) := WI(S) - ALJ*QI(IT,S)
   ENDDO
   IF (IT > 1) THEN
      DO S = 1, DIM
         WR(S) := WR(S) - BETA*QR(IT-1,S)
         WI(S) := WI(S) - BETA*QI(IT-1,S)
      ENDDO
   ENDIF
   DO K = 1, IT
      CR := 0.0
      CI := 0.0
      DO S = 1, DIM
         CR := CR + QR(K,S)*WR(S) + QI(K,S)*WI(S)
         CI := CI + QR(K,S)*WI(S) - QI(K,S)*WR(S)
      ENDDO
      DO S = 1, DIM
         WR(S) := WR(S) - CR*QR(K,S) + CI*QI(K,S)
         WI(S) := WI(S) - CR*QI(K,S) - CI*QR(K,S)
      ENDDO
   ENDDO
   NRM := 0.0
   DO S = 1, DIM
      NRM := NRM + WR(S)*WR(S) + WI(S)*WI(S)
   ENDDO
   BETA := SQRT(NRM)
   IF (IT < NIT) THEN
      BE(IT) := BETA
      DO S = 1, DIM
         QR(IT+1,S) := WR(S)/BETA
         QI(IT+1,S) := WI(S)/BETA
      ENDDO
   ENDIF
ENDDO

! ---------------- Jacobi solve of the tridiagonal ----------------
DO P = 1, NIT
   DO Q = 1, NIT
      A(P,Q) := 0.0
      V(P,Q) := 0.0
   ENDDO
   A(P,P) := AL(P)
   V(P,P) := 1.0
ENDDO
DO P = 1, NIT-1
   A(P,P+1) := BE(P)
   A(P+1,P) := BE(P)
ENDDO
DO NSW = 1, 200
   OFF := 0.0
   DO P = 1, NIT
      DO Q = 1, NIT
         OFF := OFF + A(P,Q)*A(P,Q)
      ENDDO
      OFF := OFF - A(P,P)*A(P,P)
   ENDDO
   OFF := SQRT(OFF)
   IF (OFF >= 1.0e-14) THEN
      DO P = 1, NIT-1
         DO Q = P+1, NIT
            IF (ABS(A(P,Q)) > 1.0e-16) THEN
               TAU := (A(Q,Q)-A(P,P))/(2.0*A(P,Q))
               IF (TAU /= 0.0) THEN
                  TT := SIGN(1.0,TAU)/(ABS(TAU)+SQRT(1.0+TAU*TAU))
               ELSE
                  TT := 1.0
               ENDIF
               C := 1.0/SQRT(1.0+TT*TT)
               SN := TT*C
               DO K = 1, NIT
                  AKP := A(K,P)
                  AKQ := A(K,Q)
                  A(K,P) := C*AKP - SN*AKQ
                  A(K,Q) := SN*AKP + C*AKQ
               ENDDO
               DO K = 1, NIT
                  APK := A(P,K)
                  AQR := A(Q,K)
                  A(P,K) := C*APK - SN*AQR
                  A(Q,K) := SN*APK + C*AQR
               ENDDO
               DO K = 1, NIT
                  VKP := V(K,P)
                  VKQ := V(K,Q)
                  V(K,P) := C*VKP - SN*VKQ
                  V(K,Q) := SN*VKP + C*VKQ
               ENDDO
            ENDIF
         ENDDO
      ENDDO
   ENDIF
ENDDO
EMN := A(1,1)
I0 := 1
DO P = 2, NIT
   IF (A(P,P) < EMN) THEN
      EMN := A(P,P)
      I0 := P
   ENDIF
ENDDO
DO K = 1, NIT
   YV(K) := V(K,I0)
ENDDO
DO S = 1, DIM
   RR(S) := 0.0
   RI(S) := 0.0
ENDDO
DO K = 1, NIT
   DO S = 1, DIM
      RR(S) := RR(S) + YV(K)*QR(K,S)
      RI(S) := RI(S) + YV(K)*QI(K,S)
   ENDDO
ENDDO
WRITE(*,"('E0B %.17e')") EMN

! ---------------- M at t=0 (the exact zero check) ----------------
PO(1) := 1.0/N
PO(2) := 0.0
PO(3) := 0.0
DO S = 1, DIM
   TMPR(S) := RR(S)
   TMPI(S) := RI(S)
   WR(S) := 0.0
   WI(S) := 0.0
ENDDO
CALL HACT(TMPR, TMPI, WR, WI, PO)
MVAL := 0.0
DO S = 1, DIM
   MVAL := MVAL + RR(S)*WR(S) + RI(S)*WI(S)
ENDDO
MVAL := -MVAL
WRITE(*,"('M0 %.17e')") MVAL

! ---------------- quench: RK4 under H(h=1) - ESH*I ----------------
ESH := -7.64041145458424900e+02
DT := 1.25e-4
DT2 := DT/2.0
DT6 := DT/6.0
PQ(1) := 1.0
PQ(2) := 200.0
PQ(3) := ESH
MSUM := MVAL
MMIN := MVAL
MMAX := MVAL

DO K = 1, NSTEPS
   ! K1 = -i H psi
   DO S = 1, DIM
      K1R(S) := 0.0
      K1I(S) := 0.0
   ENDDO
   CALL HACT(RR, RI, K1R, K1I, PQ)
   ! stage 2: psi + DT/2 * (-i K1)
   DO S = 1, DIM
      TMPR(S) := RR(S) + DT2*K1I(S)
      TMPI(S) := RI(S) - DT2*K1R(S)
      K2R(S) := 0.0
      K2I(S) := 0.0
   ENDDO
   CALL HACT(TMPR, TMPI, K2R, K2I, PQ)
   ! stage 3: psi + DT/2 * (-i K2)
   DO S = 1, DIM
      TMPR(S) := RR(S) + DT2*K2I(S)
      TMPI(S) := RI(S) - DT2*K2R(S)
      K3R(S) := 0.0
      K3I(S) := 0.0
   ENDDO
   CALL HACT(TMPR, TMPI, K3R, K3I, PQ)
   ! stage 4: psi + DT * (-i K3)
   DO S = 1, DIM
      TMPR(S) := RR(S) + DT*K3I(S)
      TMPI(S) := RI(S) - DT*K3R(S)
      K4R(S) := 0.0
      K4I(S) := 0.0
   ENDDO
   CALL HACT(TMPR, TMPI, K4R, K4I, PQ)
   ! psi += DT/6 * (-i)(K1 + 2K2 + 2K3 + K4)
   DO S = 1, DIM
      RR(S) := RR(S) + DT6*(K1I(S) + 2.0*K2I(S) + 2.0*K3I(S) + K4I(S))
      RI(S) := RI(S) - DT6*(K1R(S) + 2.0*K2R(S) + 2.0*K3R(S) + K4R(S))
   ENDDO
   ! observable M(t) = -(1/N) <psi| sum_i n_i.S_i |psi> (action has -h)
   DO S = 1, DIM
      WR(S) := 0.0
      WI(S) := 0.0
   ENDDO
   CALL HACT(RR, RI, WR, WI, PO)
   MVAL := 0.0
   DO S = 1, DIM
      MVAL := MVAL + RR(S)*WR(S) + RI(S)*WI(S)
   ENDDO
   MVAL := -MVAL
   MSUM := MSUM + MVAL
   IF (MVAL < MMIN) THEN
      MMIN := MVAL
   ENDIF
   IF (MVAL > MMAX) THEN
      MMAX := MVAL
   ENDIF
   IF (MOD(K,2000) = 0) THEN
      WRITE(*,"('Q %d %.17e')") K, MVAL
   ENDIF
ENDDO

MSUM := MSUM/(NSTEPS+1.0)
NRMF := 0.0
DO S = 1, DIM
   NRMF := NRMF + RR(S)*RR(S) + RI(S)*RI(S)
ENDDO
WRITE(*,"('QMEAN %.17e')") MSUM
WRITE(*,"('QMIN %.17e')") MMIN
WRITE(*,"('QMAX %.17e')") MMAX
WRITE(*,"('QNORM %.17e')") NRMF

! ---------------- Hamiltonian action: (UR,UI) = H (VR,VI) ----------------
! PP(1)=field h, PP(2)=bond J, PP(3)=diagonal shift ESH (0 for observable)
SUBROUTINE HACT(VR, VI, UR, UI, PP)
   IMPLICIT NONE
   INTEGER, PARAMETER :: NL = 12, DL = 4096
   REAL :: VR(DL), VI(DL), UR(DL), UI(DL), PP(3)
   REAL :: NX(12), NY(12), NZ(12), CC(12), SS(12)
   REAL :: PI, CA, SA, TH, CHI, DG, AR, AI, XR, XI
   REAL :: Q0, Q1, Q2, Q3, R0, R1, R2, R3
   INTEGER :: I, J, S, T, BI, BJ

   PI := 3.14159265358979323846
   CA := COS(PI/4.0)
   SA := SIN(PI/4.0)
   DO I = 1, NL
      TH := 2.0*PI*(I-1)/NL
      Q0 := CA*COS(1.0*TH)
      Q1 := CA*SIN(1.0*TH)
      Q2 := SA*COS(3.0*TH)
      Q3 := SA*SIN(3.0*TH)
      R0 := -Q1
      R1 := Q0
      R2 := Q3
      R3 := -Q2
      NX(I) := R0*(-Q1) + R1*Q0 + R2*(-Q3) - R3*(-Q2)
      NY(I) := R0*(-Q2) - R1*(-Q3) + R2*Q0 + R3*(-Q1)
      NZ(I) := R0*(-Q3) + R1*(-Q2) - R2*(-Q1) + R3*Q0
   ENDDO
   DO I = 1, NL
      TH := 2.0*PI*(I-1)/NL
      Q0 := CA*COS(1.0*TH)
      Q1 := CA*SIN(1.0*TH)
      Q2 := SA*COS(3.0*TH)
      Q3 := SA*SIN(3.0*TH)
      TH := 2.0*PI*I/NL
      IF (I = NL) THEN
         TH := 0.0
      ENDIF
      R0 := CA*COS(1.0*TH)
      R1 := CA*SIN(1.0*TH)
      R2 := SA*COS(3.0*TH)
      R3 := SA*SIN(3.0*TH)
      Q0 := R0*Q0 - R1*(-Q1) - R2*(-Q2) - R3*(-Q3)
      IF (Q0 > 1.0) THEN
         Q0 := 1.0
      ENDIF
      IF (Q0 < -1.0) THEN
         Q0 := -1.0
      ENDIF
      CHI := 2.0*ACOS(Q0)
      CC(I) := COS(CHI)
      SS(I) := SIN(CHI)
   ENDDO

   DO S = 1, DL
      XR := VR(S)
      XI := VI(S)
      DG := -PP(3)
      DO I = 1, NL
         IF (IAND(ISHFT(S-1,1-I),1) = 1) THEN
            DG := DG - PP(1)*NZ(I)*0.5
         ELSE
            DG := DG + PP(1)*NZ(I)*0.5
         ENDIF
      ENDDO
      UR(S) := UR(S) + DG*XR
      UI(S) := UI(S) + DG*XI
      DO I = 1, NL
         BI := IAND(ISHFT(S-1,1-I),1)
         T := IEOR(S-1, ISHFT(1,I-1)) + 1
         IF (BI = 1) THEN
            AR := -PP(1)*NX(I)/2.0
            AI := -PP(1)*NY(I)/2.0
         ELSE
            AR := -PP(1)*NX(I)/2.0
            AI := PP(1)*NY(I)/2.0
         ENDIF
         UR(T) := UR(T) + AR*XR - AI*XI
         UI(T) := UI(T) + AR*XI + AI*XR
         J := I+1
         IF (I = NL) THEN
            J := 1
         ENDIF
         BJ := IAND(ISHFT(S-1,1-J),1)
         IF (BI /= BJ) THEN
            T := IEOR(IEOR(S-1, ISHFT(1,I-1)), ISHFT(1,J-1)) + 1
            IF (BI = 1) THEN
               AR := -PP(2)*CC(I)/2.0
               AI := -PP(2)*SS(I)/2.0
            ELSE
               AR := -PP(2)*CC(I)/2.0
               AI := PP(2)*SS(I)/2.0
            ENDIF
            UR(T) := UR(T) + AR*XR - AI*XI
            UI(T) := UI(T) + AR*XI + AI*XR
         ENDIF
      ENDDO
   ENDDO
END
