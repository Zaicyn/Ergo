! ════════════════════════════════════════════════════════════════════
! FDTD_SLIT — 2D scalar wave equation, double-slit diffraction (pulsed)
! u_tt = c^2 laplacian(u), leapfrog, C2 = (c dt/dx)^2 = 0.25 (c = 0.5)
! Gaussian wave packet (T0=200, TW=60) from plane source ix=40,
! barrier ix=300 (two slits, sep d=64, width a=12, centered y=256),
! screen ix=560, intensity accumulated during packet transit (900..1800).
! Sponge: 40 cells per edge, cosine ramp to 0.5 (kills edge reflections).
! Scenes: lambda in {12, 16, 20}. dy = lambda*260/64 = 48.75/65/81.25.
! ════════════════════════════════════════════════════════════════════
IMPLICIT NONE

INTEGER, PARAMETER :: NX = 640, NY = 512
INTEGER, PARAMETER :: NSTEPS = 2000
INTEGER, PARAMETER :: NSP = 40
REAL, PARAMETER :: C2 = 0.25
REAL, PARAMETER :: AMP = 1.0
INTEGER, PARAMETER :: IX_SRC = 40, IX_BAR = 300, IX_SCR = 560

STATIC REAL :: U(NX, NY), U_OLD(NX, NY), UN(NX, NY)
STATIC REAL :: ABSORB(NX, NY), PASS(NX, NY), PROF(NY)
STATIC REAL :: LTAB(3)
DATA LTAB / 12.0, 16.0, 20.0 /

REAL :: OMEGA, ENV, SV
INTEGER :: I, J, T, SC, IXC

DO SC = 1, 3
  DO J = 1, NY
    DO I = 1, NX
      U(I, J) := 0.0
      U_OLD(I, J) := 0.0
      UN(I, J) := 0.0
      ABSORB(I, J) := 1.0
      PASS(I, J) := 1.0
    ENDDO
  ENDDO
  DO I = 1, NSP
    SV := 0.5 + 0.5 * 0.5 * (1.0 + COS(3.14159265358979 * REAL(NSP + 1 - I) / REAL(NSP + 1)))
    DO J = 1, NY
      ABSORB(I, J) := ABSORB(I, J) * SV
      ABSORB(NX - I + 1, J) := ABSORB(NX - I + 1, J) * SV
    ENDDO
  ENDDO
  DO J = 1, NSP
    SV := 0.5 + 0.5 * 0.5 * (1.0 + COS(3.14159265358979 * REAL(NSP + 1 - J) / REAL(NSP + 1)))
    DO I = 1, NX
      ABSORB(I, J) := ABSORB(I, J) * SV
      ABSORB(I, NY - J + 1) := ABSORB(I, NY - J + 1) * SV
    ENDDO
  ENDDO
  DO J = 1, NY
    PASS(IX_BAR, J) := 0.0
  ENDDO
  DO J = 219, 230
    PASS(IX_BAR, J) := 1.0
  ENDDO
  DO J = 283, 294
    PASS(IX_BAR, J) := 1.0
  ENDDO
  DO J = 1, NY
    PROF(J) := 0.0
  ENDDO
  OMEGA := 3.14159265358979 / LTAB(SC)

  DO T = 1, NSTEPS
    DO J = 2, NY - 1
      DO I = 2, NX - 1
        UN(I, J) := (2.0 * U(I, J) - U_OLD(I, J) &
          + C2 * (U(I + 1, J) + U(I - 1, J) + U(I, J + 1) + U(I, J - 1) &
          - 4.0 * U(I, J))) * ABSORB(I, J) * PASS(I, J)
      ENDDO
    ENDDO
    ! Gaussian wave packet: T0=200, TW=60
    ENV := EXP(0.0 - ((REAL(T) - 200.0) / 60.0) ** 2)
    SV := AMP * SIN(OMEGA * REAL(T)) * ENV
    DO J = 1, NY
      UN(IX_SRC, J) := UN(IX_SRC, J) + SV
    ENDDO
    IF (T >= 900) THEN
      IF (T <= 1800) THEN
        DO J = 1, NY
          PROF(J) := PROF(J) + UN(IX_SCR, J) * UN(IX_SCR, J)
        ENDDO
      ENDIF
    ENDIF
    DO J = 1, NY
      DO I = 1, NX
        U_OLD(I, J) := U(I, J)
        U(I, J) := UN(I, J)
      ENDDO
    ENDDO
  ENDDO

  DO J = 1, NY
    WRITE(*, "%d %d %.6f") SC, J, PROF(J)
  ENDDO
ENDDO

WRITE(*, "# DONE")
