IMPLICIT NONE
INTEGER, PARAMETER :: NX = 640, NY = 512
INTEGER, PARAMETER :: NPTS = 327680
INTEGER, PARAMETER :: NSP = 40
INTEGER, PARAMETER :: IX_BAR = 300
INTEGER, PARAMETER :: SL1A = 219, SL1B = 230, SL2A = 283, SL2B = 294
STATIC REAL :: ABSORB(NPTS), PASS(NPTS), BOUND(NPTS)
REAL :: FX, FY
INTEGER :: K, IK, JK, INI, INJ, DX, DY, BCOL, R1, R2
DO DMY = 1, 1
  DO K = 1, NPTS
    IK := MOD(K - 1, NX) + 1
    JK := INT(REAL(K - 1) / REAL(NX)) + 1
    INI := MIN(1, MAX(0, MIN(IK - 1, NX - IK)))
    INJ := MIN(1, MAX(0, MIN(JK - 1, NY - JK)))
    BOUND(K) := REAL(INI * INJ)
    DX := MIN(IK - 1, NX - IK)
    DY := MIN(JK - 1, NY - JK)
    FX := 0.5 + 0.25 * (1.0 + COS(3.14159265358979 * REAL(MAX(0, NSP - DX)) / REAL(NSP + 1)))
    FY := 0.5 + 0.25 * (1.0 + COS(3.14159265358979 * REAL(MAX(0, NSP - DY)) / REAL(NSP + 1)))
    ABSORB(K) := FX * FY
    BCOL := 1 - MIN(1, MAX(IK - IX_BAR, IX_BAR - IK))
    R1 := MIN(1, MAX(0, MIN(JK - SL1A, SL1B - JK) + 1))
    R2 := MIN(1, MAX(0, MIN(JK - SL2A, SL2B - JK) + 1))
    PASS(K) := REAL(1 - BCOL + BCOL * MIN(1, R1 + R2))
  ENDDO
ENDDO
WRITE(*, "B11=%.1f B22=%.1f B300x250=%.1f") BOUND(1), BOUND(642), BOUND(300 + 249 * NX)
WRITE(*, "Pslit=%.1f Pbar=%.1f Pother=%.1f") PASS(300 + 218 * NX), PASS(300 + 249 * NX), PASS(301 + 249 * NX)
WRITE(*, "A1=%.6f A40=%.6f A100=%.6f Acorn=%.6f") ABSORB(1 + 255 * NX), ABSORB(40 + 255 * NX), ABSORB(100 + 255 * NX), ABSORB(1)
