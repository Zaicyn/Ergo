  EX(88, 128) := EX(88, 128) - S * -0.05000 * RAMPV
  DO J = 1, NY - 1
    DO I = 1, NX - 1
      HZ(I, J) := (HZ(I, J) - S * (EY(I + 1, J) - EY(I, J) - EX(I, J + 1) + EX(I, J))) * ABSORB(I, J)
    ENDDO
  ENDDO
ENDDO

! ---- charge (discrete divergence) ----
DO J = 2, NY - 1
  DO I = 2, NX - 1
    RHO(I, J) := (EX(I, J) - EX(I - 1, J)) + (EY(I, J) - EY(I, J - 1))
  ENDDO
ENDDO

