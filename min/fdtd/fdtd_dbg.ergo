! ════════════════════════════════════════════════════════════════════
! FDTD_SLIT_1D — flattened-array double-slit FDTD for GPU extraction
! Physics identical to fdtd_slit_db.ergo (C2=0.25, pulse source, barrier
! ix=300 (slits [219,230],[283,294]), screen ix=560, PROF 900..1800).
! Arrays are 1D (NX*NY flat): the stencil is a SINGLE loop (no nesting,
! no shifted-index linearization needed) -> extracts as GPU kernel.
! Edge cells stay zero via a precomputed interior mask (BOUND).
! ════════════════════════════════════════════════════════════════════
IMPLICIT NONE

INTEGER, PARAMETER :: NX = 640, NY = 512
INTEGER, PARAMETER :: NPTS = 327680
INTEGER, PARAMETER :: NSTEPS = 2000
INTEGER, PARAMETER :: NSP = 40
REAL, PARAMETER :: C2 = 0.25
REAL, PARAMETER :: AMP = 1.0
INTEGER, PARAMETER :: IX_SRC = 40, IX_BAR = 300, IX_SCR = 560

STATIC REAL :: U(NPTS), UN(NPTS)
STATIC REAL :: ABSORB(NPTS), PASS(NPTS), BOUND(NPTS), PROF(NY)
STATIC REAL :: LTAB(3)
DATA LTAB / 12.0, 16.0, 20.0 /

REAL :: OMEGA, ENV, SV, SVX, SVY
INTEGER :: I, J, T, SC, K, NEND

DO SC = 1, 3
  DO DMY = 1, 1
    DO K = 1, NPTS
      U(K) := 0.0
      UN(K) := 0.0
      ABSORB(K) := 1.0
      PASS(K) := 1.0
      BOUND(K) := 0.0
    ENDDO
  ENDDO
  DO J = 2, NY - 1
    DO I = 2, NX - 1
      BOUND(I + (J - 1) * NX) := 1.0
    ENDDO
  ENDDO
  DO I = 1, NSP
    SVX := 0.5 + 0.5 * 0.5 * (1.0 + COS(3.14159265358979 * REAL(NSP + 1 - I) / REAL(NSP + 1)))
    DO J = 1, NY
      ABSORB(I + (J - 1) * NX) := ABSORB(I + (J - 1) * NX) * SVX
      ABSORB(NX - I + 1 + (J - 1) * NX) := ABSORB(NX - I + 1 + (J - 1) * NX) * SVX
    ENDDO
  ENDDO
  DO J = 1, NSP
    SVY := 0.5 + 0.5 * 0.5 * (1.0 + COS(3.14159265358979 * REAL(NSP + 1 - J) / REAL(NSP + 1)))
    DO I = 1, NX
      ABSORB(I + (J - 1) * NX) := ABSORB(I + (J - 1) * NX) * SVY
      ABSORB(I + (NY - J + 1 - 1) * NX) := ABSORB(I + (NY - J + 1 - 1) * NX) * SVY
    ENDDO
  ENDDO
  DO J = 1, NY
    PASS(IX_BAR + (J - 1) * NX) := 0.0
  ENDDO
  DO J = 219, 230
    PASS(IX_BAR + (J - 1) * NX) := 1.0
  ENDDO
  DO J = 283, 294
    PASS(IX_BAR + (J - 1) * NX) := 1.0
  ENDDO
  DO J = 1, NY
    PROF(J) := 0.0
  ENDDO
  NEND := NPTS - NX - 1
  OMEGA := 3.14159265358979 / LTAB(SC)
  DO T = 1, NSTEPS, 2
    ! ===== step A =====
    DO K = NX + 2, NEND
      UN(K) := ((2.0 * U(K) - UN(K) &
        + C2 * (U(K + 1) + U(K - 1) + U(K + NX) + U(K - NX) - 4.0 * U(K))) &
        * ABSORB(K) * PASS(K) * BOUND(K)) + UN(K) * (1.0 - BOUND(K))
    ENDDO
    SV := AMP * SIN(OMEGA * REAL(T)) * EXP(0.0 - ((REAL(T) - 200.0) / 60.0) ** 2)
    DO J = 1, NY
      UN(IX_SRC + (J - 1) * NX) := UN(IX_SRC + (J - 1) * NX) + SV
    ENDDO
    IF (T >= 900) THEN
      IF (T <= 1800) THEN
        DO J = 1, NY
          PROF(J) := PROF(J) + UN(IX_SCR + (J - 1) * NX) * UN(IX_SCR + (J - 1) * NX)
        ENDDO
      ENDIF
    ENDIF
    ! ===== step B =====
    DO K = NX + 2, NEND
      U(K) := ((2.0 * UN(K) - U(K) &
        + C2 * (UN(K + 1) + UN(K - 1) + UN(K + NX) + UN(K - NX) - 4.0 * UN(K))) &
        * ABSORB(K) * PASS(K) * BOUND(K)) + U(K) * (1.0 - BOUND(K))
    ENDDO
    SV := AMP * SIN(OMEGA * REAL(T + 1)) * EXP(0.0 - ((REAL(T + 1) - 200.0) / 60.0) ** 2)
    DO J = 1, NY
      U(IX_SRC + (J - 1) * NX) := U(IX_SRC + (J - 1) * NX) + SV
    ENDDO
    IF (T + 1 >= 900) THEN
      IF (T + 1 <= 1800) THEN
        DO J = 1, NY
          PROF(J) := PROF(J) + U(IX_SCR + (J - 1) * NX) * U(IX_SCR + (J - 1) * NX)
        ENDDO
      ENDIF
    ENDIF
  ENDDO

  WRITE(*, "DBG SC=%d U=%.6f UN=%.6f PROF=%.6f") SC, U(164000), UN(164000), PROF(256)
  DO J = 1, NY
    WRITE(*, "%d %d %.6f") SC, J, PROF(J)
  ENDDO
ENDDO

WRITE(*, "# DONE")
