! ---- charge (discrete divergence) ----
DO J = 2, NY - 1
  DO I = 2, NX - 1
    RHO(I, J) := (EX(I, J) - EX(I - 1, J)) + (EY(I, J) - EY(I, J - 1))
  ENDDO
ENDDO

