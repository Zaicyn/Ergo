IMPLICIT NONE
INTEGER, PARAMETER :: N = 327680, NX = 640
STATIC REAL :: A(N), B(N)
INTEGER :: K, T
DO K = 1, N
  A(K) := 0.001 * MOD(K, 97)
  B(K) := 0.0
ENDDO
DO T = 1, 3
  DO K = NX + 2, N - NX - 1
    B(K) := A(K - 1) + A(K + 1) + A(K - NX) + A(K + NX)
  ENDDO
  DO K = NX + 2, N - NX - 1
    A(K) := B(K)
  ENDDO
ENDDO
PRINT B(164000)
