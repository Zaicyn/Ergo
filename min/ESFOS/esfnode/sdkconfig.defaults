CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SIZE_8MB=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=4
# Data-bearer headroom: default MSYS_1 (12x256 B) ENOMEMs on back-to-back
# 512 B TX (TX_UNSTALLED status 6 -> partial SDU on air). 32 blocks.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=32
# CONFIG_ESP_COEX_SW_COEXIST_ENABLE is not set
# (kills libcoexist.a from the link; no WiFi to arbitrate. If a future
# feature needs coexistence back, this line is the switch.)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
