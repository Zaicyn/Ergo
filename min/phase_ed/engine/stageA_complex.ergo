! stageA_complex.ergo - GENERATED by gen_ergo_stageA.py (do not edit)
! Complex packed eigensolver (real/imag split), rotor chain N=12.
! Validation: 4 off-line points + on-line continuity point.
IMPLICIT NONE

INTEGER, PARAMETER :: N = 12
INTEGER, PARAMETER :: DIM = 531441
INTEGER, PARAMETER :: TT = 72
INTEGER, PARAMETER :: NB = 24
INTEGER, PARAMETER :: NPTS = 5
INTEGER, PARAMETER :: MAXIT = 20000
REAL, PARAMETER :: SHIFT = 4.0

STATIC INTEGER :: SRC(DIM, TT)
STATIC REAL :: CFAC(TT), SFAC(TT)
STATIC REAL :: DIAG(DIM)
STATIC REAL :: BTAB(NPTS), JTAB(NPTS)
STATIC REAL :: VR(DIM + 1), VI(DIM + 1), WR(DIM + 1), WI(DIM + 1)
STATIC REAL :: YR(DIM + 1), YI(DIM + 1), ZR(DIM + 1), ZI(DIM + 1)
STATIC REAL :: GSR(DIM + 1), GSI(DIM + 1)
STATIC REAL :: BJ2 = 0.0
STATIC REAL :: VV = 0.0

DATA BTAB / 0.1, 0.4, 0.1, 0.4, 0.25 /
DATA JTAB / 1.0, 1.0, 2.0, 2.0, 1.0 /

REAL :: RHO, RHO_OLD, NRM, E0, E1, GAPV, OVR, OVI, A0, A1
INTEGER :: I, X, T, Q, D, J, DI, DJ, PI, PJ, B, KB, K, NCONV, DG(12), P

! ============ table build (host, once) ============
DO X = 1, DIM
  Q := X - 1
  DIAG(X) := 0.0 - SHIFT
  DO I = 1, N
    D := MOD(Q, 3)
    Q := Q / 3
    DIAG(X) := DIAG(X) + REAL((D - 1) * (D - 1)) / 2.0
  ENDDO
ENDDO
DO X = 1, DIM
  DO T = 1, TT
    SRC(X, T) := DIM + 1
  ENDDO
ENDDO
! bonds: T = 1..2N  [(i, +1) then (i, -1) per site]
DO X = 1, DIM
  Q := X - 1
  DO I = 1, N
    DG(I) := MOD(Q, 3)
    Q := Q / 3
  ENDDO
  T := 1
  DO I = 1, N
    J := I + 1
    IF (J > 12) THEN
      J := 1
    ENDIF
    DI := DG(I)
    DJ := DG(J)
    PI := 3 ** (I - 1)
    PJ := 3 ** (J - 1)
    IF (DI >= 1) THEN
      IF (DJ <= 1) THEN
        SRC(X, T) := X - PI + PJ
        T := T + 1
      ENDIF
    ENDIF
    IF (DI <= 1) THEN
      IF (DJ >= 1) THEN
        SRC(X, T) := X + PI - PJ
        T := T + 1
      ENDIF
    ENDIF
  ENDDO
  ! cosphi terms: T = 2N+1..4N [(i, +1) then (i, -1)]
  T := 2 * 12 + 1
  DO I = 1, N
    DI := DG(I)
    PI := 3 ** (I - 1)
    IF (DI <= 1) THEN
      SRC(X, T) := X + PI
    ENDIF
    T := T + 1
    IF (DI >= 1) THEN
      SRC(X, T) := X - PI
    ENDIF
    T := T + 1
  ENDDO
  ! sinphi terms: T = 4N+1..6N [(i, +1) then (i, -1)]
  T := 4 * 12 + 1
  DO I = 1, N
    DI := DG(I)
    PI := 3 ** (I - 1)
    IF (DI <= 1) THEN
      SRC(X, T) := X + PI
    ENDIF
    T := T + 1
    IF (DI >= 1) THEN
      SRC(X, T) := X - PI
    ENDIF
    T := T + 1
  ENDDO
ENDDO
VR(DIM + 1) := 0.0
VI(DIM + 1) := 0.0
WR(DIM + 1) := 0.0
WI(DIM + 1) := 0.0
YR(DIM + 1) := 0.0
YI(DIM + 1) := 0.0
ZR(DIM + 1) := 0.0
ZI(DIM + 1) := 0.0

! ============ per-point loop ============
DO P = 1, NPTS
  BJ2 := JTAB(P) / 2.0
  VV := 0.5 - 2.0 * BTAB(P)
  DO T = 1, TT
    CFAC(T) := 0.0
    SFAC(T) := 0.0
  ENDDO
  DO I = 1, N
    CFAC(2 * 12 + 2 * I - 1) := 0.0 - VV * COS(6.283185307179586 * REAL(I - 1) / REAL(12)) / 2.0
    CFAC(2 * 12 + 2 * I) := CFAC(2 * 12 + 2 * I - 1)
    SFAC(4 * 12 + 2 * I - 1) := VV * SIN(6.283185307179586 * REAL(I - 1) / REAL(12)) / 2.0
    SFAC(4 * 12 + 2 * I) := 0.0 - SFAC(4 * 12 + 2 * I - 1)
  ENDDO

  ! ---- ground state (complex power iteration) ----
  DO I = 1, DIM
    VR(I) := MOD(37*I, 101) / 101.0 - 0.5
    VI(I) := MOD(53*I + 7, 101) / 101.0 - 0.5
  ENDDO
  NRM := SQRT(DOT_PRODUCT(VR, VR) + DOT_PRODUCT(VI, VI))
  DO I = 1, DIM
    VR(I) := VR(I) / NRM
    VI(I) := VI(I) / NRM
  ENDDO
  RHO_OLD := 0.0
  RHO := 0.0
  K := 1
  DO WHILE (K <= MAXIT)
    ! Y = H_R * V ; Z = H_I * V  (H_R on both parts via YR/YI roles)
    DO I = 1, DIM
      YR(I) := 0.0
      YI(I) := 0.0
    ENDDO
    DO I = 1, DIM
      A0 := DIAG(I) * VR(I)
      A1 := DIAG(I) * VI(I)
      DO T = 1, NB
        A0 := A0 - BJ2 * VR(SRC(I,T))
        A1 := A1 - BJ2 * VI(SRC(I,T))
      ENDDO
      DO T = NB + 1, 2 * NB
        A0 := A0 + CFAC(T) * VR(SRC(I,T))
        A1 := A1 + CFAC(T) * VI(SRC(I,T))
      ENDDO
      YR(I) := A0
      YI(I) := A1
    ENDDO
    DO I = 1, DIM
      ZR(I) := 0.0
      ZI(I) := 0.0
    ENDDO
    DO I = 1, DIM
      A0 := 0.0
      A1 := 0.0
      DO T = 2 * NB + 1, TT
        A0 := A0 + SFAC(T) * VR(SRC(I,T))
        A1 := A1 + SFAC(T) * VI(SRC(I,T))
      ENDDO
      ZR(I) := A0
      ZI(I) := A1
    ENDDO
    ! W = H V = (YR - ZI, YI + ZR)   [YR/YI = H_R V, ZR/ZI = H_I V]
    DO I = 1, DIM
      WR(I) := YR(I) - ZI(I)
      WI(I) := YI(I) + ZR(I)
    ENDDO
    RHO := DOT_PRODUCT(VR, WR) + DOT_PRODUCT(VI, WI) + SHIFT
    NRM := SQRT(DOT_PRODUCT(WR, WR) + DOT_PRODUCT(WI, WI))
    DO I = 1, DIM
      VR(I) := WR(I) / NRM
      VI(I) := WI(I) / NRM
    ENDDO
    IF (ABS(RHO - RHO_OLD) < 1E-12) THEN
      K := MAXIT + 1
    ENDIF
    RHO_OLD := RHO
    K := K + 1
  ENDDO
  E0 := RHO
  DO I = 1, DIM
    GSR(I) := VR(I)
    GSI(I) := VI(I)
  ENDDO

  ! ---- deflated run for E1 ----
  DO I = 1, DIM
    VR(I) := MOD(71*I + 3, 101) / 101.0 - 0.5
    VI(I) := MOD(17*I + 11, 101) / 101.0 - 0.5
  ENDDO
  NRM := SQRT(DOT_PRODUCT(VR, VR) + DOT_PRODUCT(VI, VI))
  DO I = 1, DIM
    VR(I) := VR(I) / NRM
    VI(I) := VI(I) / NRM
  ENDDO
  RHO_OLD := 0.0
  RHO := 0.0
  K := 1
  DO WHILE (K <= MAXIT)
    DO I = 1, DIM
      YR(I) := 0.0
      YI(I) := 0.0
    ENDDO
    DO I = 1, DIM
      A0 := DIAG(I) * VR(I)
      A1 := DIAG(I) * VI(I)
      DO T = 1, NB
        A0 := A0 - BJ2 * VR(SRC(I,T))
        A1 := A1 - BJ2 * VI(SRC(I,T))
      ENDDO
      DO T = NB + 1, 2 * NB
        A0 := A0 + CFAC(T) * VR(SRC(I,T))
        A1 := A1 + CFAC(T) * VI(SRC(I,T))
      ENDDO
      YR(I) := A0
      YI(I) := A1
    ENDDO
    DO I = 1, DIM
      ZR(I) := 0.0
      ZI(I) := 0.0
    ENDDO
    DO I = 1, DIM
      A0 := 0.0
      A1 := 0.0
      DO T = 2 * NB + 1, TT
        A0 := A0 + SFAC(T) * VR(SRC(I,T))
        A1 := A1 + SFAC(T) * VI(SRC(I,T))
      ENDDO
      ZR(I) := A0
      ZI(I) := A1
    ENDDO
    DO I = 1, DIM
      WR(I) := YR(I) - ZI(I)
      WI(I) := YI(I) + ZR(I)
    ENDDO
    ! complex overlap <GS|W> and deflation
    OVR := DOT_PRODUCT(GSR, WR) + DOT_PRODUCT(GSI, WI)
    OVI := DOT_PRODUCT(GSR, WI) - DOT_PRODUCT(GSI, WR)
    DO I = 1, DIM
      WR(I) := WR(I) - OVR * GSR(I) + OVI * GSI(I)
      WI(I) := WI(I) - OVR * GSI(I) - OVI * GSR(I)
    ENDDO
    RHO := DOT_PRODUCT(VR, WR) + DOT_PRODUCT(VI, WI) + SHIFT
    NRM := SQRT(DOT_PRODUCT(WR, WR) + DOT_PRODUCT(WI, WI))
    DO I = 1, DIM
      VR(I) := WR(I) / NRM
      VI(I) := WI(I) / NRM
    ENDDO
    IF (ABS(RHO - RHO_OLD) < 1E-12) THEN
      K := MAXIT + 1
    ENDIF
    RHO_OLD := RHO
    K := K + 1
  ENDDO
  E1 := RHO
  GAPV := E1 - E0
  WRITE(*, "%.2f %.2f %.10f %.6f") BTAB(P), JTAB(P), E0, GAPV
ENDDO
