! stageB_block.ergo - GENERATED by gen_ergo_stageB_block.py (do not edit)
! Complex-state entanglement via block [[G,-K],[K,G]] (spectrum = each
! eigenvalue of complex Hermitian rho = A A^H, doubled).
IMPLICIT NONE

INTEGER, PARAMETER :: N = 12
INTEGER, PARAMETER :: DIM = 531441
INTEGER, PARAMETER :: TT = 72
INTEGER, PARAMETER :: NB = 24
INTEGER, PARAMETER :: MAXIT = 20000
REAL, PARAMETER :: SHIFT = 4.0

STATIC INTEGER :: SRC(DIM, TT)
STATIC REAL :: CFAC(TT), SFAC(TT)
STATIC REAL :: DIAG(DIM)
STATIC REAL :: VR(DIM + 1), VI(DIM + 1), WR(DIM + 1), WI(DIM + 1)
STATIC REAL :: YR(DIM + 1), YI(DIM + 1), ZR(DIM + 1), ZI(DIM + 1)
STATIC REAL :: BMAT(54, 54), SS(3)
STATIC REAL :: BJ2 = 0.0
STATIC REAL :: VV = 0.0
STATIC REAL :: OFFA = 0.0, TAU = 0.0, A0 = 0.0, A1 = 0.0

REAL :: RHO, RHO_OLD, NRM, E0, CR, CI
REAL :: CSUM, SCALE, C, SN, APP, AQQ, APQ, TH, TMP
INTEGER :: I, X, T, Q, D, J, DI, DJ, PI, PJ, B, KB, K, NCONV, DG(12)
INTEGER :: R, L, RL, CL, R0, C0, P0, Q0, SWEEP, M, MP, S2, K2, M2, POS

! ============ table build ============
! ============ table build (host, once) ============
DO X = 1, DIM
  Q := X - 1
  DIAG(X) := 0.0 - SHIFT
  DO I = 1, N
    D := MOD(Q, 3)
    Q := Q / 3
    DIAG(X) := DIAG(X) + REAL((D - 1) * (D - 1)) / 2.0
  ENDDO
ENDDO
DO X = 1, DIM
  DO T = 1, TT
    SRC(X, T) := DIM + 1
  ENDDO
ENDDO
! bonds: T = 1..2N  [(i, +1) then (i, -1) per site]
DO X = 1, DIM
  Q := X - 1
  DO I = 1, N
    DG(I) := MOD(Q, 3)
    Q := Q / 3
  ENDDO
  T := 1
  DO I = 1, N
    J := I + 1
    IF (J > 12) THEN
      J := 1
    ENDIF
    DI := DG(I)
    DJ := DG(J)
    PI := 3 ** (I - 1)
    PJ := 3 ** (J - 1)
    IF (DI >= 1) THEN
      IF (DJ <= 1) THEN
        SRC(X, T) := X - PI + PJ
        T := T + 1
      ENDIF
    ENDIF
    IF (DI <= 1) THEN
      IF (DJ >= 1) THEN
        SRC(X, T) := X + PI - PJ
        T := T + 1
      ENDIF
    ENDIF
  ENDDO
  ! cosphi terms: T = 2N+1..4N [(i, +1) then (i, -1)]
  T := 2 * 12 + 1
  DO I = 1, N
    DI := DG(I)
    PI := 3 ** (I - 1)
    IF (DI <= 1) THEN
      SRC(X, T) := X + PI
    ENDIF
    T := T + 1
    IF (DI >= 1) THEN
      SRC(X, T) := X - PI
    ENDIF
    T := T + 1
  ENDDO
  ! sinphi terms: T = 4N+1..6N [(i, +1) then (i, -1)]
  T := 4 * 12 + 1
  DO I = 1, N
    DI := DG(I)
    PI := 3 ** (I - 1)
    IF (DI <= 1) THEN
      SRC(X, T) := X + PI
    ENDIF
    T := T + 1
    IF (DI >= 1) THEN
      SRC(X, T) := X - PI
    ENDIF
    T := T + 1
  ENDDO
ENDDO
VR(DIM + 1) := 0.0
VI(DIM + 1) := 0.0
WR(DIM + 1) := 0.0
WI(DIM + 1) := 0.0
YR(DIM + 1) := 0.0
YI(DIM + 1) := 0.0
ZR(DIM + 1) := 0.0
ZI(DIM + 1) := 0.0


VR(DIM + 1) := 0.0
VI(DIM + 1) := 0.0

! ============ production points ============
DO KB = 1, 2
  IF (KB == 1) THEN
    BJ2 := 0.5
    VV := 0.0
  ELSE
    BJ2 := 1.0
    VV := 0.3
  ENDIF
  DO T = 1, TT
    CFAC(T) := 0.0
    SFAC(T) := 0.0
  ENDDO
  DO I = 1, N
    CFAC(2 * 12 + 2 * I - 1) := 0.0 - VV * COS(6.283185307179586 * REAL(I - 1) / REAL(12)) / 2.0
    CFAC(2 * 12 + 2 * I) := CFAC(2 * 12 + 2 * I - 1)
    SFAC(4 * 12 + 2 * I - 1) := VV * SIN(6.283185307179586 * REAL(I - 1) / REAL(12)) / 2.0
    SFAC(4 * 12 + 2 * I) := 0.0 - SFAC(4 * 12 + 2 * I - 1)
  ENDDO

  ! ---- ground state (Stage A complex power iteration) ----
  DO I = 1, DIM
    VR(I) := MOD(37*I, 101) / 101.0 - 0.5
    VI(I) := MOD(53*I + 7, 101) / 101.0 - 0.5
  ENDDO
  NRM := SQRT(DOT_PRODUCT(VR, VR) + DOT_PRODUCT(VI, VI))
  DO I = 1, DIM
    VR(I) := VR(I) / NRM
    VI(I) := VI(I) / NRM
  ENDDO
  RHO_OLD := 0.0
  RHO := 0.0
  K := 1
  DO WHILE (K <= MAXIT)
    DO I = 1, DIM
      A0 := DIAG(I) * VR(I)
      A1 := DIAG(I) * VI(I)
      DO T = 1, NB
        A0 := A0 - BJ2 * VR(SRC(I,T))
        A1 := A1 - BJ2 * VI(SRC(I,T))
      ENDDO
      DO T = NB + 1, 2 * NB
        A0 := A0 + CFAC(T) * VR(SRC(I,T))
        A1 := A1 + CFAC(T) * VI(SRC(I,T))
      ENDDO
      YR(I) := A0
      YI(I) := A1
    ENDDO
    DO I = 1, DIM
      A0 := 0.0
      A1 := 0.0
      DO T = 2 * NB + 1, TT
        A0 := A0 + SFAC(T) * VR(SRC(I,T))
        A1 := A1 + SFAC(T) * VI(SRC(I,T))
      ENDDO
      ZR(I) := A0
      ZI(I) := A1
    ENDDO
    DO I = 1, DIM
      WR(I) := YR(I) - ZI(I)
      WI(I) := YI(I) + ZR(I)
    ENDDO
    RHO := DOT_PRODUCT(VR, WR) + DOT_PRODUCT(VI, WI) + SHIFT
    NRM := SQRT(DOT_PRODUCT(WR, WR) + DOT_PRODUCT(WI, WI))
    DO I = 1, DIM
      VR(I) := WR(I) / NRM
      VI(I) := WI(I) / NRM
    ENDDO
    IF (ABS(RHO - RHO_OLD) < 1E-12) THEN
      K := MAXIT + 1
    ENDIF
    RHO_OLD := RHO
    K := K + 1
  ENDDO
  E0 := RHO
  WRITE(*, "PT %d E0 %.10f K %d") KB, E0, K

  ! ---- cuts l = 1..3 with block-matrix entropy ----
  DO L = 1, 3
    RL := 3 ** L
    CL := 3 ** (12 - L)
    M := RL
    M2 := 2 * M
    ! build BMAT = [[G,-K],[K,G]] on the fly
    DO R0 = 1, M
      DO Q0 = 1, M
        A0 := 0.0
        A1 := 0.0
        DO C0 = 1, CL
          A0 := A0 + VR(R0 + (C0 - 1) * RL) * VR(Q0 + (C0 - 1) * RL) &
                  + VI(R0 + (C0 - 1) * RL) * VI(Q0 + (C0 - 1) * RL)
          A1 := A1 + VI(R0 + (C0 - 1) * RL) * VR(Q0 + (C0 - 1) * RL) &
                  - VR(R0 + (C0 - 1) * RL) * VI(Q0 + (C0 - 1) * RL)
        ENDDO
        BMAT(R0, Q0) := A0
        BMAT(M + R0, M + Q0) := A0
        BMAT(R0, M + Q0) := 0.0 - A1
        BMAT(M + R0, Q0) := A1
      ENDDO
    ENDDO
    ! cyclic round-robin Jacobi on BMAT (size M2, even -> no dummy)
    MP := M2
    OFFA := 1.0
    SWEEP := 0
    DO WHILE (SWEEP < 12)
      IF (OFFA < 1E-10 * SQRT(REAL(M2))) THEN
        SWEEP := 100
      ELSE
        DO R = 0, MP - 2
          DO K2 = 0, MP / 2 - 1
            IF (K2 == 0) THEN
              P0 := 1
            ELSE
              P0 := MOD(K2 - 1 + R, MP - 1) + 2
            ENDIF
            S2 := MP - 1 - K2
            IF (S2 == 0) THEN
              Q0 := 1
            ELSE
              Q0 := MOD(S2 - 1 + R, MP - 1) + 2
            ENDIF
            APQ := BMAT(P0, Q0)
            IF (ABS(APQ) > 1E-16) THEN
              APP := BMAT(P0, P0)
              AQQ := BMAT(Q0, Q0)
              TAU := (AQQ - APP) / (2.0 * APQ)
              IF (TAU >= 0.0) THEN
                TH := 1.0 / (ABS(TAU) + SQRT(1.0 + TAU * TAU))
              ELSE
                TH := 0.0 - 1.0 / (ABS(TAU) + SQRT(1.0 + TAU * TAU))
              ENDIF
              C := 1.0 / SQRT(1.0 + TH * TH)
              SN := TH * C
              DO C0 = 1, M2
                A0 := BMAT(C0, P0)
                A1 := BMAT(C0, Q0)
                BMAT(C0, P0) := C * A0 - SN * A1
                BMAT(C0, Q0) := SN * A0 + C * A1
              ENDDO
              DO C0 = 1, M2
                A0 := BMAT(P0, C0)
                A1 := BMAT(Q0, C0)
                BMAT(P0, C0) := C * A0 - SN * A1
                BMAT(Q0, C0) := SN * A0 + C * A1
              ENDDO
            ENDIF
          ENDDO
        ENDDO
        OFFA := 0.0
        DO P0 = 1, M2
          DO Q0 = P0 + 1, M2
            OFFA := OFFA + BMAT(P0, Q0) * BMAT(P0, Q0)
          ENDDO
        ENDDO
        OFFA := SQRT(2.0 * OFFA)
        SWEEP := SWEEP + 1
      ENDIF
    ENDDO
    IF (SWEEP >= 100) THEN
      SWEEP := SWEEP - 100
    ENDIF
    ! eigenvalues from the diagonal, insertion sort
    DO P0 = 2, M2
      TMP := BMAT(P0, P0)
      Q0 := P0 - 1
      POS := 1
      DO WHILE (Q0 >= 1)
        IF (BMAT(Q0, Q0) > TMP) THEN
          BMAT(Q0 + 1, Q0 + 1) := BMAT(Q0, Q0)
          Q0 := Q0 - 1
        ELSE
          POS := Q0 + 1
          Q0 := 0
        ENDIF
      ENDDO
      BMAT(POS, POS) := TMP
    ENDDO
    ! entropy with half weight (doubled spectrum)
    SS(L) := 0.0
    DO R0 = 1, M2
      IF (BMAT(R0, R0) > 1E-15) THEN
        SS(L) := SS(L) - 0.5 * BMAT(R0, R0) * LOG(BMAT(R0, R0))
      ENDIF
    ENDDO
    WRITE(*, "PT %d L %d S %.6f SWEEP %d") KB, L, SS(L), SWEEP
  ENDDO

  ! ---- CC fit over l = 1..3 ----
  CR := 0.0
  CI := 0.0
  A0 := 0.0
  A1 := 0.0
  DO L = 1, 3
    SCALE := LOG((REAL(12) / 3.14159265358979) * SIN(3.14159265358979 * REAL(L) / REAL(12)))
    CR := CR + SCALE * SCALE
    CI := CI + SCALE * SS(L)
    A0 := A0 + SCALE
    A1 := A1 + SS(L)
  ENDDO
  A0 := A0 / 3.0
  A1 := A1 / 3.0
  CSUM := (CI - 3.0 * A0 * A1) / (CR - 3.0 * A0 * A0)
  WRITE(*, "PT %d CC %.4f") KB, 3.0 * CSUM
ENDDO

WRITE(*, "# DONE")
