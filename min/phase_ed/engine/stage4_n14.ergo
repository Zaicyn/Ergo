    ENDDO
    DO I = 1, NP
      A := W(I) - DV(BLKOF(I)) * GS(I)
      W(I) := A
      V(I) := A * NRT(BLKOF(I))
    ENDDO
  ENDIF
ENDDO
DO B = 1, NB
  E1(B) := RH(B)
ENDDO

! ============ output ============
DO B = 1, NB
  GAPV := E1(B) - E0(B)
  WRITE(*, "%.2f %.10f %.6f %d %d") JTAB(B), E0(B), GAPV, CONV(B), CONV2(B)
ENDDO
