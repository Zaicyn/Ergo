IMPLICIT NONE
INTEGER, PARAMETER :: N = 100
STATIC REAL :: A(N), W(N), P2(N)
STATIC REAL :: S
INTEGER :: I, KB
DO I = 1, N
  A(I) := REAL(I)
ENDDO
DO KB = 1, 3
  IF (KB < 100) THEN
    DO I = 1, N
      W(I) := A(I) * 2.0
    ENDDO
    DO I = 1, N
      P2(I) := W(I) * W(I)
    ENDDO
  ENDIF
ENDDO
S := 0.0
DO I = 1, N
  S := S + P2(I)
ENDDO
PRINT S
