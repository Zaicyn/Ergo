IMPLICIT NONE
INTEGER, PARAMETER :: DIM = 100
INTEGER, PARAMETER :: NB = 3
INTEGER, PARAMETER :: NP = 300
STATIC REAL :: V(NP), W(NP), S1(NB)
STATIC REAL :: ACC
INTEGER :: I, B
DO I = 1, NP
  V(I) := 1.0
  W(I) := REAL(I)
ENDDO
DO B = 1, NB
  ACC := 0.0
  DO I = 1, DIM
    ACC := ACC + V(I + (B-1)*DIM) * W(I + (B-1)*DIM)
  ENDDO
  S1(B) := ACC
ENDDO
PRINT S1(1)
PRINT S1(2)
PRINT S1(3)
