! ============ table build ============
! ============ table build (host, once) ============
DO X = 1, DIM
  Q := X - 1
  DIAG(X) := 0.0 - SHIFT
  DO I = 1, N
    D := MOD(Q, 3)
    Q := Q / 3
    DIAG(X) := DIAG(X) + REAL((D - 1) * (D - 1)) / 2.0
  ENDDO
ENDDO
DO X = 1, DIM
  DO T = 1, TT
    SRC(X, T) := DIM + 1
  ENDDO
ENDDO
! bonds: T = 1..2N  [(i, +1) then (i, -1) per site]
DO X = 1, DIM
  Q := X - 1
  DO I = 1, N
    DG(I) := MOD(Q, 3)
    Q := Q / 3
  ENDDO
  T := 1
  DO I = 1, N
    J := I + 1
    IF (J > 12) THEN
      J := 1
    ENDIF
    DI := DG(I)
    DJ := DG(J)
    PI := 3 ** (I - 1)
    PJ := 3 ** (J - 1)
    IF (DI >= 1) THEN
      IF (DJ <= 1) THEN
        SRC(X, T) := X - PI + PJ
        T := T + 1
      ENDIF
    ENDIF
    IF (DI <= 1) THEN
      IF (DJ >= 1) THEN
        SRC(X, T) := X + PI - PJ
        T := T + 1
      ENDIF
    ENDIF
  ENDDO
  ! cosphi terms: T = 2N+1..4N [(i, +1) then (i, -1)]
  T := 2 * 12 + 1
  DO I = 1, N
    DI := DG(I)
    PI := 3 ** (I - 1)
    IF (DI <= 1) THEN
      SRC(X, T) := X + PI
    ENDIF
    T := T + 1
    IF (DI >= 1) THEN
      SRC(X, T) := X - PI
    ENDIF
    T := T + 1
  ENDDO
  ! sinphi terms: T = 4N+1..6N [(i, +1) then (i, -1)]
  T := 4 * 12 + 1
  DO I = 1, N
    DI := DG(I)
    PI := 3 ** (I - 1)
    IF (DI <= 1) THEN
      SRC(X, T) := X + PI
    ENDIF
    T := T + 1
    IF (DI >= 1) THEN
      SRC(X, T) := X - PI
    ENDIF
    T := T + 1
  ENDDO
ENDDO
VR(DIM + 1) := 0.0
VI(DIM + 1) := 0.0
WR(DIM + 1) := 0.0
WI(DIM + 1) := 0.0
YR(DIM + 1) := 0.0
YI(DIM + 1) := 0.0
ZR(DIM + 1) := 0.0
ZI(DIM + 1) := 0.0


VR(DIM + 1) := 0.0
VI(DIM + 1) := 0.0

! ================================================================
! SECTION 0: standalone eigensolver validation
! ================================================================

! --- (a) 5x5 known eigenvalues ---
WRITE(*, "TEST-A 5x5 known spectrum")
M := 5
CALL JACOBI5()
DO I = 1, 5
  WRITE(*, "EV5 %d %.10f") I, M5(I, I)
ENDDO

! --- (b) 81x81 random Gram ---
WRITE(*, "TEST-B 81x81 random Gram")
M := 81
CALL JACOBI81()
DO I = 1, 81
  WRITE(*, "EV81 %d %.10f") I, G81(I, I)
ENDDO

! ================================================================
! SECTION 1: production points
! ================================================================
DO KB = 1, 2
  IF (KB == 1) THEN
    BJ2 := 0.5
    VV := 0.0
  ELSE
    BJ2 := 1.0
    VV := 0.3
  ENDIF
  DO T = 1, TT
    CFAC(T) := 0.0
    SFAC(T) := 0.0
  ENDDO
  DO I = 1, N
    CFAC(2 * 12 + 2 * I - 1) := 0.0 - VV * COS(6.283185307179586 * REAL(I - 1) / REAL(12)) / 2.0
    CFAC(2 * 12 + 2 * I) := CFAC(2 * 12 + 2 * I - 1)
    SFAC(4 * 12 + 2 * I - 1) := VV * SIN(6.283185307179586 * REAL(I - 1) / REAL(12)) / 2.0
    SFAC(4 * 12 + 2 * I) := 0.0 - SFAC(4 * 12 + 2 * I - 1)
  ENDDO

  ! ---- ground state (Stage A complex power iteration) ----
  DO I = 1, DIM
    VR(I) := MOD(37*I, 101) / 101.0 - 0.5
    VI(I) := MOD(53*I + 7, 101) / 101.0 - 0.5
  ENDDO
  NRM := SQRT(DOT_PRODUCT(VR, VR) + DOT_PRODUCT(VI, VI))
  DO I = 1, DIM
    VR(I) := VR(I) / NRM
    VI(I) := VI(I) / NRM
  ENDDO
  RHO_OLD := 0.0
  RHO := 0.0
  K := 1
  DO WHILE (K <= MAXIT)
    DO I = 1, DIM
      A0 := DIAG(I) * VR(I)
      A1 := DIAG(I) * VI(I)
      DO T = 1, NB
        A0 := A0 - BJ2 * VR(SRC(I,T))
        A1 := A1 - BJ2 * VI(SRC(I,T))
      ENDDO
      DO T = NB + 1, 2 * NB
        A0 := A0 + CFAC(T) * VR(SRC(I,T))
        A1 := A1 + CFAC(T) * VI(SRC(I,T))
      ENDDO
      YR(I) := A0
      YI(I) := A1
    ENDDO
    DO I = 1, DIM
      A0 := 0.0
      A1 := 0.0
      DO T = 2 * NB + 1, TT
        A0 := A0 + SFAC(T) * VR(SRC(I,T))
        A1 := A1 + SFAC(T) * VI(SRC(I,T))
      ENDDO
      ZR(I) := A0
      ZI(I) := A1
    ENDDO
    DO I = 1, DIM
      WR(I) := YR(I) - ZI(I)
      WI(I) := YI(I) + ZR(I)
    ENDDO
    RHO := DOT_PRODUCT(VR, WR) + DOT_PRODUCT(VI, WI) + SHIFT
    NRM := SQRT(DOT_PRODUCT(WR, WR) + DOT_PRODUCT(WI, WI))
    DO I = 1, DIM
      VR(I) := WR(I) / NRM
      VI(I) := WI(I) / NRM
    ENDDO
    IF (ABS(RHO - RHO_OLD) < 1E-12) THEN
      K := MAXIT + 1
    ENDIF
    RHO_OLD := RHO
    K := K + 1
  ENDDO
  E0 := RHO
  WRITE(*, "PT %d E0 %.10f K %d") KB, E0, K

  ! ---- cuts l = 1..6 ----
  DO L = 1, 6
    RL := 3 ** L
    CL := 3 ** (12 - L)
    ! Gram on the fly: G(r,q) = sum_c V(r+(c-1)*RL) . V(q+(c-1)*RL)
    DO R0 = 1, RL
      DO Q0 = R0, RL
        A0 := 0.0
        DO C0 = 1, CL
          A0 := A0 + VR(C0 + (R0 - 1) * CL) * VR(C0 + (Q0 - 1) * CL) &
                  + VI(C0 + (R0 - 1) * CL) * VI(C0 + (Q0 - 1) * CL)
        ENDDO
        G(R0, Q0) := A0
        G(Q0, R0) := A0
      ENDDO
    ENDDO
    ! cyclic round-robin Jacobi (inline schedule, eigenvalue-only)
    M := RL
    IF (MOD(M, 2) == 0) THEN
      MP := M
    ELSE
      MP := M + 1
    ENDIF
    OFFA := 1.0
    SWEEP := 0
    DO WHILE (SWEEP < 12)
      IF (OFFA < 1E-10 * SQRT(REAL(M))) THEN
        SWEEP := 100
      ELSE
        DO R = 0, MP - 2
          DO K2 = 0, MP / 2 - 1
            IF (K2 == 0) THEN
              P0 := 1
            ELSE
              P0 := MOD(K2 - 1 + R, MP - 1) + 2
            ENDIF
            S2 := MP - 1 - K2
            IF (S2 == 0) THEN
              Q0 := 1
            ELSE
              Q0 := MOD(S2 - 1 + R, MP - 1) + 2
            ENDIF
            ! skip dummy pair for odd M (dummy index = M+1)
            IF (P0 <= M) THEN
              IF (Q0 <= M) THEN
                APQ := G(P0, Q0)
                IF (ABS(APQ) > 1E-16) THEN
                  APP := G(P0, P0)
                  AQQ := G(Q0, Q0)
                  TAU := (AQQ - APP) / (2.0 * APQ)
                  IF (TAU >= 0.0) THEN
                    TH := 1.0 / (ABS(TAU) + SQRT(1.0 + TAU * TAU))
                  ELSE
                    TH := 0.0 - 1.0 / (ABS(TAU) + SQRT(1.0 + TAU * TAU))
                  ENDIF
                  C := 1.0 / SQRT(1.0 + TH * TH)
                  SN := TH * C
                  DO C0 = 1, M
                    A0 := G(C0, P0)
                    A1 := G(C0, Q0)
                    G(C0, P0) := C * A0 - SN * A1
                    G(C0, Q0) := SN * A0 + C * A1
                  ENDDO
                  DO C0 = 1, M
                    A0 := G(P0, C0)
                    A1 := G(Q0, C0)
                    G(P0, C0) := C * A0 - SN * A1
                    G(Q0, C0) := SN * A0 + C * A1
                  ENDDO
                ENDIF
              ENDIF
            ENDIF
          ENDDO
        ENDDO
        OFFA := 0.0
        DO P0 = 1, M
          DO Q0 = P0 + 1, M
            OFFA := OFFA + G(P0, Q0) * G(P0, Q0)
          ENDDO
        ENDDO
        OFFA := SQRT(2.0 * OFFA)
        SWEEP := SWEEP + 1
      ENDIF
    ENDDO
    IF (SWEEP >= 100) THEN
      SWEEP := SWEEP - 100
    ENDIF
    SS(L) := 0.0
    DO R0 = 1, M
      IF (G(R0, R0) > 1E-15) THEN
        SS(L) := SS(L) - G(R0, R0) * LOG(G(R0, R0))
      ENDIF
    ENDDO
    WRITE(*, "PT %d L %d S %.6f SWEEP %d") KB, L, SS(L), SWEEP
  ENDDO

  ! ---- CC fit over l = 1..6 ----
  CR := 0.0
  CI := 0.0
  A0 := 0.0
  A1 := 0.0
  DO L = 1, 6
    SCALE := LOG((REAL(12) / 3.14159265358979) * SIN(3.14159265358979 * REAL(L) / REAL(12)))
    CR := CR + SCALE * SCALE
    CI := CI + SCALE * SS(L)
    A0 := A0 + SCALE
    A1 := A1 + SS(L)
  ENDDO
  A0 := A0 / 6.0
  A1 := A1 / 6.0
  CSUM := (CI - 6.0 * A0 * A1) / (CR - 6.0 * A0 * A0)
  WRITE(*, "PT %d CC %.4f") KB, 3.0 * CSUM
ENDDO

WRITE(*, "# DONE")
STOP

! ============ JACOBI5: cyclic Jacobi on the 5x5 test matrix ============
SUBROUTINE JACOBI5()
  INTEGER :: MM, RR, KK, SS2, PP, QQ, SW, C0
  REAL :: AA, BB, CC2, TT2, CC, SS2R
  MM := 6
  OFFA := 1.0
  SW := 0
  DO WHILE (SW < 12)
    IF (OFFA < 1E-10 * SQRT(5.0)) THEN
      SW := 100
    ELSE
      DO RR = 0, MM - 2
        DO KK = 0, MM / 2 - 1
          IF (KK == 0) THEN
            PP := 1
          ELSE
            PP := MOD(KK - 1 + RR, MM - 1) + 2
          ENDIF
          SS2 := MM - 1 - KK
          IF (SS2 == 0) THEN
            QQ := 1
          ELSE
            QQ := MOD(SS2 - 1 + RR, MM - 1) + 2
          ENDIF
          IF (PP <= 5) THEN
            IF (QQ <= 5) THEN
              AA := M5(PP, QQ)
              IF (ABS(AA) > 1E-16) THEN
                TAU := (M5(QQ, QQ) - M5(PP, PP)) / (2.0 * AA)
                IF (TAU >= 0.0) THEN
                  TT2 := 1.0 / (ABS(TAU) + SQRT(1.0 + TAU * TAU))
                ELSE
                  TT2 := 0.0 - 1.0 / (ABS(TAU) + SQRT(1.0 + TAU * TAU))
                ENDIF
                CC := 1.0 / SQRT(1.0 + TT2 * TT2)
                SS2R := TT2 * CC
                DO C0 = 1, 5
                  A0 := M5(C0, PP)
                  A1 := M5(C0, QQ)
                  M5(C0, PP) := CC * A0 - SS2R * A1
                  M5(C0, QQ) := SS2R * A0 + CC * A1
                ENDDO
                DO C0 = 1, 5
                  A0 := M5(PP, C0)
                  A1 := M5(QQ, C0)
                  M5(PP, C0) := CC * A0 - SS2R * A1
                  M5(QQ, C0) := SS2R * A0 + CC * A1
                ENDDO
              ENDIF
            ENDIF
          ENDIF
        ENDDO
      ENDDO
      OFFA := 0.0
      DO PP = 1, 5
        DO QQ = PP + 1, 5
          OFFA := OFFA + M5(PP, QQ) * M5(PP, QQ)
        ENDDO
      ENDDO
      OFFA := SQRT(2.0 * OFFA)
      SW := SW + 1
    ENDIF
  ENDDO
  RETURN
END

! ============ JACOBI81: cyclic Jacobi on the 81x81 test Gram ============
SUBROUTINE JACOBI81()
  INTEGER :: MM, RR, KK, SS2, PP, QQ, SW, C0
  REAL :: AA, BB, CC2, TT2, CC, SS2R
  MM := 82
  OFFA := 1.0
  SW := 0
  DO WHILE (SW < 12)
    IF (OFFA < 1E-10 * SQRT(81.0)) THEN
      SW := 100
    ELSE
      DO RR = 0, MM - 2
        DO KK = 0, MM / 2 - 1
          IF (KK == 0) THEN
            PP := 1
          ELSE
            PP := MOD(KK - 1 + RR, MM - 1) + 2
          ENDIF
          SS2 := MM - 1 - KK
          IF (SS2 == 0) THEN
            QQ := 1
          ELSE
            QQ := MOD(SS2 - 1 + RR, MM - 1) + 2
          ENDIF
          IF (PP <= 81) THEN
            IF (QQ <= 81) THEN
              AA := G81(PP, QQ)
              IF (ABS(AA) > 1E-16) THEN
                TAU := (G81(QQ, QQ) - G81(PP, PP)) / (2.0 * AA)
                IF (TAU >= 0.0) THEN
                  TT2 := 1.0 / (ABS(TAU) + SQRT(1.0 + TAU * TAU))
                ELSE
                  TT2 := 0.0 - 1.0 / (ABS(TAU) + SQRT(1.0 + TAU * TAU))
                ENDIF
                CC := 1.0 / SQRT(1.0 + TT2 * TT2)
                SS2R := TT2 * CC
                DO C0 = 1, 81
                  A0 := G81(C0, PP)
                  A1 := G81(C0, QQ)
                  G81(C0, PP) := CC * A0 - SS2R * A1
                  G81(C0, QQ) := SS2R * A0 + CC * A1
                ENDDO
                DO C0 = 1, 81
                  A0 := G81(PP, C0)
                  A1 := G81(QQ, C0)
                  G81(PP, C0) := CC * A0 - SS2R * A1
                  G81(QQ, C0) := SS2R * A0 + CC * A1
                ENDDO
              ENDIF
            ENDIF
          ENDIF
        ENDDO
      ENDDO
      OFFA := 0.0
      DO PP = 1, 81
        DO QQ = PP + 1, 81
          OFFA := OFFA + G81(PP, QQ) * G81(PP, QQ)
        ENDDO
      ENDDO
      OFFA := SQRT(2.0 * OFFA)
      SW := SW + 1
    ENDIF
  ENDDO
  RETURN
END
