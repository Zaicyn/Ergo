IMPLICIT NONE
INTEGER, PARAMETER :: M2 = 6
STATIC REAL :: BMAT(M2, M2), TMP
INTEGER :: P0, Q0, POS
BMAT(1,1) := 0.1715063034
BMAT(2,2) := 0.6569873933
BMAT(3,3) := 0.1715063034
BMAT(4,4) := 0.1715063034
BMAT(5,5) := 0.6569873933
BMAT(6,6) := 0.1715063034
DO P0 = 2, M2
  TMP := BMAT(P0, P0)
  Q0 := P0 - 1
  POS := 1
  DO WHILE (Q0 >= 1)
    IF (BMAT(Q0, Q0) > TMP) THEN
      BMAT(Q0 + 1, Q0 + 1) := BMAT(Q0, Q0)
      Q0 := Q0 - 1
    ELSE
      POS := Q0 + 1
      Q0 := 0
    ENDIF
  ENDDO
  BMAT(POS, POS) := TMP
ENDDO
DO P0 = 1, M2
  WRITE(*, "SRT %d %.10f") P0, BMAT(P0, P0)
ENDDO
