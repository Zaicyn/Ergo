  -0.772875,  0.585344, -0.245021, &
  -0.944624,  0.319859, -0.073314, &
  -1.000000,  0.000000, -0.000000, &
  -0.944624, -0.319859, -0.073314, &
  -0.772875, -0.585344, -0.245021, &
  -0.528346, -0.752980, -0.392265, &
  -0.288675, -0.866025, -0.408248, &
  -0.068948, -0.982752, -0.171595, &
   0.096980, -0.896348,  0.432615, &
   0.083063, -0.567568,  0.819126 /
! ════════════════════════════════════════════════════════════════
! LAYER 3: FLUID — Particle dynamics (GPU-exclusive)
! ════════════════════════════════════════════════════════════════
!
! The fluid is the particle state — positions, velocities, omega, flags.
! GPU owns exclusively. Each particle is a signed accumulator.
! Positive = source/gain. Negative = drain/loss. Zero = off/skip.
!
! The CPU never sees individual particles — only waveguide summaries.

! ── Fluid state (SoA) ────────────────────────────────────
STATIC REAL :: POS_X(MAXPART), POS_Y(MAXPART), POS_Z(MAXPART)
STATIC REAL :: VEL_X(MAXPART), VEL_Y(MAXPART), VEL_Z(MAXPART)
STATIC REAL :: OMEGA_NAT(MAXPART)
STATIC INTEGER :: FLAGS(MAXPART)

! ── Population state ──────────────────────────────────────
STATIC INTEGER :: NPART = 0
STATIC INTEGER :: CAPACITY = 0
STATIC INTEGER :: RNG_STATE = 42

! ── Spawn control (GPU-side, continuous) ──────────────────
! SPAWN_RATE: probability of spawning per active particle per frame.
! CPU sets the target rate. GPU applies it continuously.
! At rate 0.01, each particle has 1% chance per frame → ~1 spawn
! per 100 frames per particle. Smooth, no bursts.
! SPAWN_COUNTER: atomic slot allocator for new particles.
PARAMETER REAL :: SPAWN_RATE_DEFAULT = 0.01
STATIC REAL :: SPAWN_RATE = 0.01
STATIC INTEGER :: SPAWN_COUNTER(1)

! ── Oracle control (CPU instructions, applied as amplitudes) ──
STATIC INTEGER :: NET_SPAWN_ACTIVE = 0
STATIC REAL :: NET_SPAWN_RATE = 0.0
STATIC INTEGER :: NET_SPAWN_PAUSE = 0
STATIC INTEGER :: NET_CENSUS_OVERRIDE = 0
STATIC INTEGER :: NET_SPAWN_COUNT = 0

! ════════════════════════════════════════════════════════════════
! PRNG (deterministic, reproducible)
! ════════════════════════════════════════════════════════════════
! ════════════════════════════════════════════════════════════════
! LAYER 2: WAVEGUIDE — Field structure (density + gradients)
! ════════════════════════════════════════════════════════════════
!
! The waveguide is the structure that guides the fluid.
! Updated every frame by scatter (fluid → field) and stencil (field → field).
! Corrected at census intervals by oracle blend (external → field).
!
! The CPU oracle sees ONLY this layer — the 128KB density grid.
! The GPU fluid reads this layer but never owns it.

! ── Waveguide state ───────────────────────────────────────
STATIC INTEGER :: GRID_DENSITY(GRID_SIZE, GRID_SIZE, GRID_SIZE)
STATIC REAL :: GRID_GRAD_X(GRID_SIZE, GRID_SIZE, GRID_SIZE)
STATIC REAL :: GRID_GRAD_Y(GRID_SIZE, GRID_SIZE, GRID_SIZE)
STATIC REAL :: GRID_GRAD_Z(GRID_SIZE, GRID_SIZE, GRID_SIZE)
STATIC REAL :: GRID_MET_GATE(GRID_SIZE, GRID_SIZE, GRID_SIZE)
STATIC INTEGER :: BIN_PRESENCE(GRID_SIZE, GRID_SIZE, GRID_SIZE)

! ── Crystal density (permanent — never cleared) ───────────
! When a particle crystallizes, its grid cell gets +1 here.
! Blended into GRID_DENSITY at stencil time so frozen suns
! still exert field influence without per-particle compute.
STATIC INTEGER :: GRID_CRYSTAL(GRID_SIZE, GRID_SIZE, GRID_SIZE)

! ── Oracle consensus (external correction) ────────────────
STATIC REAL :: GRID_DENSITY_GLOBAL(GRID_SIZE, GRID_SIZE, GRID_SIZE)

! ── Census persistent state (CPU-side sampling history) ───
STATIC REAL :: CENSUS_PREV_OMEGA_MAX = 0.0
STATIC REAL :: CENSUS_PREV_OMEGA_MEAN = 0.0
STATIC INTEGER :: CENSUS_PREV_CRYSTAL = 0
STATIC INTEGER :: CENSUS_PREV_NOVA = 0
STATIC REAL :: CENSUS_PREV_SPREAD = 0.0
STATIC INTEGER :: CENSUS_PREV_FRAME = 0
STATIC INTEGER :: CENSUS_INITIALIZED = 0

! ════════════════════════════════════════════════════════════════
! WAVEGUIDE SUBROUTINES
! ════════════════════════════════════════════════════════════════

! ── CLEAR: zero accumulators ──────────────────────────────
! Zeros density, gradients, presence, met_gate for fresh scatter pass.
! On GPU this becomes vkCmdFillBuffer (no CPU memset).
! ════════════════════════════════════════════════════════════════
! LAYER 3: FLUID SUBROUTINES
! ════════════════════════════════════════════════════════════════
!
! Everything is a signed accumulator. Decay always runs.
! Accumulation is the variable. Zero input = pure decay.
! One path through the kernel. Mode modulates amplitude, not flow.

! ════════════════════════════════════════════════════════════════
! PRNG (deterministic, reproducible)
! ════════════════════════════════════════════════════════════════

REAL FUNCTION RNGF()
  RNG_STATE := IAND(RNG_STATE * 1103515245 + 12345, 2147483647)
  RNGF := REAL(IAND(ISHFT(RNG_STATE, -16), 32767)) / 32767.0
  RETURN RNGF
END

INTEGER FUNCTION BITCOUNT(N)
  INTEGER :: N, CNT, B
  CNT := 0
  DO B = 0, 7
    IF IAND(N, ISHFT(1, B)) ≠ 0 THEN
      CNT := CNT + 1
    ENDIF
  ENDDO
  BITCOUNT := CNT
  RETURN BITCOUNT
END

! ════════════════════════════════════════════════════════════════
! INIT (CPU-only, runs once)
! ════════════════════════════════════════════════════════════════

SUBROUTINE SIM_INIT(N, CAP, SEED)
  INTEGER :: N, CAP, SEED
  INTEGER :: I, GEN, PH
  REAL :: X, Y, Z, R, S
  REAL :: THETA_I, R_XZ, V_CIRC, R_CLAMP

  NPART := N
  IF CAP < N THEN
    CAPACITY := N
  ELSE
    CAPACITY := CAP
  ENDIF
  RNG_STATE := SEED

  DO I = 1, CAPACITY
    POS_X(I) := 0.0
    POS_Y(I) := 0.0
    POS_Z(I) := 0.0
    VEL_X(I) := 0.0
    VEL_Y(I) := 0.0
    VEL_Z(I) := 0.0
    OMEGA_NAT(I) := 0.0
    FLAGS(I) := 0
  ENDDO

  DO I = 1, N
    X := (RNGF() * 2.0 - 1.0) * DISK_OUTER_R
    Y := (RNGF() * 2.0 - 1.0) * DISK_OUTER_R * 0.3
    Z := (RNGF() * 2.0 - 1.0) * DISK_OUTER_R

    R := SQRT(X * X + Y * Y + Z * Z)
    IF R < 1.0 THEN
      S := 1.0 / R
      X := X * S
      Y := Y * S
      Z := Z * S
    ENDIF

    POS_X(I) := X
    POS_Y(I) := Y
    POS_Z(I) := Z

    THETA_I := ATAN2(Z, X) + SEAM_STEP
    IF THETA_I ≥ TWO_PI THEN
      THETA_I := THETA_I - TWO_PI
    ENDIF
    IF THETA_I < 0.0 THEN
      THETA_I := THETA_I + TWO_PI
    ENDIF

    PH := IAND(INT(THETA_I * REAL(PHASE_MASK) / TWO_PI), PHASE_MASK)
    GEN := IAND(ISHFT(PH, -10), GEN_MASK) + 1

    R_XZ := SQRT(X * X + Z * Z)
    V_CIRC := SQRT(BH_MASS / MAX(R_XZ, 1.0))
    VEL_X(I) := TANGENT(1, GEN) * V_CIRC
    VEL_Y(I) := TANGENT(2, GEN) * V_CIRC
    VEL_Z(I) := TANGENT(3, GEN) * V_CIRC

    R_CLAMP := MAX(R_XZ, 1.0)
    OMEGA_NAT(I) := 0.1 * (50.0 / R_CLAMP) ** 1.5

    FLAGS(I) := IOR(IOR(PFLAG_ACTIVE, ISHFT(IAND(GEN - 1, GEN_MASK), &
      GEN_SHIFT)), ISHFT(PH, PHASE_SHIFT))
  ENDDO

  RETURN
END

! ════════════════════════════════════════════════════════════════
! SEED SHELL (CPU-only, runs once)
! ════════════════════════════════════════════════════════════════

SUBROUTINE SIM_SEED_SHELL()
  INTEGER :: I, N_SHELL, GEN, PH
  REAL :: PX, PY, PZ, SHELL_R, THETA_I, R_XZ, V_CIRC

  SHELL_R := 50.0
  IF NPART < 12 THEN
    N_SHELL := NPART
  ELSE
    N_SHELL := 12
  ENDIF

  DO I = 1, N_SHELL
    PX := CUBOCT(1, I) * SHELL_R
    PY := CUBOCT(2, I) * SHELL_R
    PZ := CUBOCT(3, I) * SHELL_R
    POS_X(I) := PX
    POS_Y(I) := PY
    POS_Z(I) := PZ

    THETA_I := REAL(I - 1) * (TWO_PI / 12.0)
    PH := IAND(INT(THETA_I * REAL(PHASE_MASK) / TWO_PI), PHASE_MASK)
    GEN := IAND(ISHFT(PH, -10), GEN_MASK) + 1

    R_XZ := SQRT(PX * PX + PZ * PZ)
    V_CIRC := SQRT(BH_MASS / MAX(R_XZ, 1.0))
    VEL_X(I) := TANGENT(1, GEN) * V_CIRC
    VEL_Y(I) := TANGENT(2, GEN) * V_CIRC
    VEL_Z(I) := TANGENT(3, GEN) * V_CIRC

    OMEGA_NAT(I) := 0.1
    FLAGS(I) := IOR(IOR(PFLAG_ACTIVE, ISHFT(IAND(GEN - 1, GEN_MASK), &
      GEN_SHIFT)), ISHFT(PH, PHASE_SHIFT))
  ENDDO

  RETURN
END

! ════════════════════════════════════════════════════════════════
! PHYSICS + SPAWN — One path. Decay always. Spawn is accumulation.
! ════════════════════════════════════════════════════════════════
!
! Spawn is integrated into the physics pass. Each active particle
! can produce one child per spawn interval. The child slot comes
! from an atomic counter (SPAWN_COUNTER(1)). The child's position
! offset is derived from the parent's state (deterministic hash,
! no sequential RNG needed).
!
! SPAWN_COUNTER(1) is reset to NPART at the start of each spawn frame.
! Each spawning particle does: SLOT = atomicAdd(SPAWN_COUNTER(1), 1).
! After the physics pass, NPART = SPAWN_COUNTER(1).

SUBROUTINE SIM_PHYSICS_STEP(DT)
  REAL :: DT
  INTEGER :: I, GEN, FMODE, CI, CJ, CK
  REAL :: PX, PY, PZ, VX, VY, VZ
  REAL :: R3D_SQ, R3D, INV_R3D, R_SAFE, INV_R
  REAL :: RX, RY, RZ, GRAVITY
  REAL :: AX, AY, AZ
  REAL :: V_SQ, OMEGA
  REAL :: ENV, RHO, MET_GATE, COUPLING
  REAL :: DECAY, SPD_SQ
  REAL :: TANG_X, TANG_Y, TANG_Z, Z_C, FLOW_WG
  REAL :: CP_X, CP_Y, CP_Z, DX_N, DY_N, DZ_N, D_NODE_SQ
  REAL :: INV_RXZ, PGX, PGZ
  REAL :: F_DOT_R, FPX, FPY, FPZ, VIV_MOD
  REAL :: TX, TY, TZ, BASE_RATE, STEER_R
  REAL :: INV_SPD_B, INV_T_MAG, TNX, TNY, TNZ
  REAL :: V_DOT_T, INV_SPD_A, RESCALE
  REAL :: STRONG
  REAL :: DRIVE, TARGET, INSTABILITY
  REAL :: WEAK_DOT_R, WEAK_STR
  REAL :: GDX, GDY, GDZ, GD_R, GTX, GTY, GTZ
  ! Spawn vars
  INTEGER :: SLOT, PH_CHILD, GEN_CHILD
  REAL :: HASH, SPX, SPY, SPZ, SR_XZ, SV_CIRC

  DO I = 1, NPART
    ! ── Skip crystallized (off) and ejected (gone) ────────
    IF IAND(FLAGS(I), IOR(PFLAG_CRYSTAL, PFLAG_EJECTED)) ≠ 0 THEN
      CYCLE
    ENDIF

    ! ── Load state ────────────────────────────────────────
    PX := POS_X(I)
    PY := POS_Y(I)
    PZ := POS_Z(I)
    VX := VEL_X(I)
    VY := VEL_Y(I)
    VZ := VEL_Z(I)
    OMEGA := OMEGA_NAT(I)

    ! ── GEN + mode ────────────────────────────────────────
    GEN := IAND(ISHFT(FLAGS(I), -GEN_SHIFT), GEN_MASK) + 1
    FMODE := FLOW_MODE(GEN)

    ! ── 1. GRAVITY (always — the universal downhill) ──────
    R3D_SQ := PX * PX + PY * PY + PZ * PZ
    INV_R3D := 1.0 / SQRT(R3D_SQ + 1.0E-8)
    R3D := R3D_SQ * INV_R3D
    R_SAFE := MAX(R3D, 1.0)
    INV_R := MIN(INV_R3D, 1.0)

    RX := PX * INV_R
    RY := PY * INV_R
    RZ := PZ * INV_R
    GRAVITY := BH_MASS * INV_R * INV_R

    AX := -RX * GRAVITY
    AY := -RY * GRAVITY
    AZ := -RZ * GRAVITY

    ! ── 2. OMEGA DECAY (always) ───────────────────────────
    DECAY := 1.0 - OMEGA_DECAY * DT
    DECAY := DECAY * DECAY * DECAY * DECAY
    OMEGA := OMEGA * DECAY

    ! ── 3. MODE COUPLING ─────────────────────────────────
    IF FMODE = 0 THEN
      COUPLING := 0.0
    ELSE
      COUPLING := 1.0
    ENDIF

    ! ── 4. WAVEGUIDE READ ────────────────────────────────
    CI := CLAMP(INT(PX / CELL_SIZE) + GRID_HALF, 1, GRID_SIZE)
    CJ := CLAMP(INT(PY / CELL_SIZE) + GRID_HALF, 1, GRID_SIZE)
    CK := CLAMP(INT(PZ / CELL_SIZE) + GRID_HALF, 1, GRID_SIZE)
    RHO := REAL(GRID_DENSITY(CI, CJ, CK)) * COUPLING

    ! ── 5. ENVELOPE ──────────────────────────────────────
    CP_X := CURVE_PT(1, GEN) * R_SAFE
    CP_Y := CURVE_PT(2, GEN) * R_SAFE
    CP_Z := CURVE_PT(3, GEN) * R_SAFE
    DX_N := PX - CP_X
    DY_N := PY - CP_Y
    DZ_N := PZ - CP_Z
    D_NODE_SQ := DX_N * DX_N + DY_N * DY_N + DZ_N * DZ_N
    ENV := 1.0 / SQRT(1.0 + D_NODE_SQ * INV_R_SCALE_SQ) * COUPLING

    ! ── 6. METABOLIC GATE ────────────────────────────────
    MET_GATE := GRID_MET_GATE(CI, CJ, CK) * COUPLING

    ! ── 7. LUT GEOMETRY ──────────────────────────────────
    TANG_X := TANGENT(1, GEN)
    TANG_Y := TANGENT(2, GEN)
    TANG_Z := TANGENT(3, GEN)
    Z_C := Z_COUPLING(GEN)
    FLOW_WG := FLOW_W(GEN)

    ! ── 8. PROGRADE TANGENT ──────────────────────────────
    INV_RXZ := 1.0 / SQRT(PX * PX + PZ * PZ + 1.0E-8)
    PGX := -PZ * INV_RXZ
    PGZ :=  PX * INV_RXZ

    ! ── 9. VIVIANI MODULATION ────────────────────────────
    F_DOT_R := TANG_X * RX + TANG_Y * RY + TANG_Z * RZ
    FPX := TANG_X - F_DOT_R * RX
    FPY := TANG_Y - F_DOT_R * RY
    FPZ := TANG_Z - F_DOT_R * RZ
    VIV_MOD := FPX * PGX + FPZ * PGZ

    TX := PGX * ABS(VIV_MOD) + FPX * 0.1
    TY := FPY * 0.1
    TZ := PGZ * ABS(VIV_MOD) + FPZ * 0.1

    ! ── 10. EM STEERING ──────────────────────────────────
    IF FMODE = 2 THEN
      BASE_RATE := 0.02
    ELSE
      BASE_RATE := 0.002
    ENDIF
    STEER_R := BASE_RATE * ENV

    SPD_SQ := VX * VX + VY * VY + VZ * VZ
    INV_SPD_B := 1.0 / SQRT(SPD_SQ + 1.0E-8)

    INV_T_MAG := 1.0 / SQRT(TX * TX + TY * TY + TZ * TZ + 1.0E-8)
    TNX := TX * INV_T_MAG
    TNY := TY * INV_T_MAG
    TNZ := TZ * INV_T_MAG

    V_DOT_T := VX * TNX + VY * TNY + VZ * TNZ
    VX := VX - (VX - V_DOT_T * TNX) * STEER_R
    VY := VY - (VY - V_DOT_T * TNY) * STEER_R
    VZ := VZ - (VZ - V_DOT_T * TNZ) * STEER_R

    INV_SPD_A := 1.0 / SQRT(VX * VX + VY * VY + VZ * VZ + 1.0E-8)
    RESCALE := INV_SPD_A / INV_SPD_B
    VX := VX * RESCALE
    VY := VY * RESCALE
    VZ := VZ * RESCALE

    ! ── 11. STRONG CHANNEL ───────────────────────────────
    STRONG := Z_C * GRAVITY * 0.1 * COUPLING
    AX := AX + RX * STRONG
    AY := AY + RY * STRONG
    AZ := AZ + RZ * STRONG

    ! ── 12. WEAK CHANNEL ─────────────────────────────────
    IF FMODE = 2 THEN
      WEAK_DOT_R := CURVE_PT(1, GEN) * RX + &
        CURVE_PT(2, GEN) * RY + CURVE_PT(3, GEN) * RZ
      WEAK_STR := ABS(FLOW_WG) * GRAVITY * 0.05
      AX := AX + (CURVE_PT(1, GEN) - WEAK_DOT_R * RX) * WEAK_STR
      AY := AY + (CURVE_PT(2, GEN) - WEAK_DOT_R * RY) * WEAK_STR
      AZ := AZ + (CURVE_PT(3, GEN) - WEAK_DOT_R * RZ) * WEAK_STR
    ENDIF

    ! ── 13. DENSITY SIPHON ───────────────────────────────
    GDX := GRID_GRAD_X(CI, CJ, CK)
    GDY := GRID_GRAD_Y(CI, CJ, CK)
    GDZ := GRID_GRAD_Z(CI, CJ, CK)
    GD_R := GDX * RX + GDY * RY + GDZ * RZ
    GTX := GDX - GD_R * RX
    GTY := GDY - GD_R * RY
    GTZ := GDZ - GD_R * RZ
    AX := AX + GTX * RHO * ENV * DENSITY_FORCE_SCALE
    AY := AY + GTY * RHO * ENV * DENSITY_FORCE_SCALE
    AZ := AZ + GTZ * RHO * ENV * DENSITY_FORCE_SCALE

    ! ── 14. VELOCITY ACCUMULATION ────────────────────────
    VX := VX + AX * DT
    VY := VY + AY * DT
    VZ := VZ + AZ * DT

    V_SQ := VX * VX + VY * VY + VZ * VZ
    IF V_SQ ≥ 1.0E24 THEN
      CYCLE
    ENDIF

    ! ── 15. OMEGA ACCUMULATION ───────────────────────────
    ! OMEGA_BASE is always present — the background metabolic rate.
    ! DRIVE (field coupling) is zero for COAST (RHO already zero).
    ! The base prevents total omega collapse — particles maintain
    ! enough energy to orbit. Without it, everything crystallizes.
    DRIVE := RHO * ENV * MET_GATE
    TARGET := OMEGA_BASE + DRIVE * OMEGA_GAIN
    OMEGA := OMEGA + (TARGET - OMEGA) * OMEGA_RESPONSE * DT
    INSTABILITY := MAX(OMEGA - 0.4, 0.0)
    OMEGA := OMEGA + INSTABILITY * INSTABILITY * 0.5 * DT
    IF OMEGA > OMEGA_MAX THEN
      OMEGA := OMEGA_MAX
    ENDIF
    IF OMEGA < 0.0 THEN
      OMEGA := 0.0
    ENDIF

    ! ── 16. POSITION ACCUMULATION ────────────────────────
    POS_X(I) := PX + VX * DT
    POS_Y(I) := PY + VY * DT
    POS_Z(I) := PZ + VZ * DT
    VEL_X(I) := VX
    VEL_Y(I) := VY
    VEL_Z(I) := VZ
    OMEGA_NAT(I) := OMEGA

    ! ── 17. THRESHOLD OBSERVATIONS ───────────────────────

    ! Nova
    IF OMEGA > OMEGA_NOVA_THRESH .AND. RHO > RHO_NOVA_THRESH THEN
      FLAGS(I) := IOR(FLAGS(I), PFLAG_NOVA)
      FLAGS(I) := IAND(FLAGS(I), NOT(PFLAG_ACTIVE))
      VEL_X(I) := VX + TANGENT(1, GEN) * BLAST_MULT
      VEL_Y(I) := VY + TANGENT(2, GEN) * BLAST_MULT
      VEL_Z(I) := VZ + TANGENT(3, GEN) * BLAST_MULT
    ENDIF

    ! Crystal
    SPD_SQ := VX * VX + VY * VY + VZ * VZ
    IF OMEGA < OMEGA_CRYSTAL_THRESH .AND. SPD_SQ < 0.01 THEN
      FLAGS(I) := IOR(FLAGS(I), PFLAG_CRYSTAL)
    ENDIF

    ! ── 18. SPAWN (continuous, rate-based) ──────────────
    ! SPAWN_RATE is a probability per particle per frame.
    ! Deterministic: hash of (index × phase) changes each frame
    ! because phase advances. At rate=0.01, ~1% of active particles
    ! spawn per frame. Smooth growth, no bursts. Zero = natural skip.
    HASH := REAL(IAND((I * 1103515245 + GEN * 2654435) + 12345, &
      65535)) / 65536.0
    IF HASH < SPAWN_RATE .AND. IAND(FLAGS(I), PFLAG_ACTIVE) ≠ 0 THEN
      IF SPAWN_COUNTER(1) < CAPACITY THEN
        SLOT := SPAWN_COUNTER(1) + 1
        SPAWN_COUNTER(1) := SPAWN_COUNTER(1) + 1

        ! Child phase = parent + seam step
        PH_CHILD := IAND(IAND(ISHFT(FLAGS(I), -PHASE_SHIFT), &
          PHASE_MASK) + SEAM_STEP_PH, PHASE_MASK)
        GEN_CHILD := IAND(ISHFT(PH_CHILD, -10), GEN_MASK) + 1

        ! Deterministic offset from parent index (replaces RNG)
        ! Hash: scramble index with large prime (fits signed int32)
        HASH := REAL(IAND(I * 1103515245 + 12345, 65535)) / 65536.0
        SPX := PX + (HASH - 0.5) * 2.0
        SPY := PY + (HASH * 0.7 - 0.35) * 0.5
        SPZ := PZ + (HASH * 1.3 - 0.65) * 2.0

        SR_XZ := SQRT(SPX * SPX + SPZ * SPZ)
        SV_CIRC := SQRT(BH_MASS / MAX(SR_XZ, 1.0))

        POS_X(SLOT) := SPX
        POS_Y(SLOT) := SPY
        POS_Z(SLOT) := SPZ
        VEL_X(SLOT) := TANGENT(1, GEN_CHILD) * SV_CIRC
        VEL_Y(SLOT) := TANGENT(2, GEN_CHILD) * SV_CIRC
        VEL_Z(SLOT) := TANGENT(3, GEN_CHILD) * SV_CIRC
        OMEGA_NAT(SLOT) := 0.1 * (50.0 / MAX(SR_XZ, 1.0)) ** 1.5
        FLAGS(SLOT) := IOR(IOR(PFLAG_ACTIVE, &
          ISHFT(IAND(GEN_CHILD - 1, GEN_MASK), GEN_SHIFT)), &
          ISHFT(PH_CHILD, PHASE_SHIFT))
      ENDIF
    ENDIF
  ENDDO

  RETURN
END

! ── DOWNLOAD_WAVEGUIDE: GPU → CPU readback ────────────────
! The ONLY place GPU sends data to CPU. 128KB per grid array.
! Called at census intervals only (every 50-2000 frames).
! Must be called AFTER frame_end + frame_wait (GPU idle).
!
! This is a no-op subroutine that the codegen recognizes as
! a signal to insert grid array downloads. The subroutine body
! copies from the GPU arrays to their CPU-side counterparts.
! On CPU-only mode, this is a no-op (arrays are already in sync).

SUBROUTINE DOWNLOAD_WAVEGUIDE()
  ! Forces GPU → CPU sync of waveguide grid arrays.
  ! Total: ~768KB (6 arrays × 32³ × 4 bytes).
  ! Touch each grid array to trigger codegen download.
  REAL :: DW
  DW := REAL(GRID_DENSITY(1, 1, 1))
  DW := GRID_GRAD_X(1, 1, 1)
  DW := GRID_GRAD_Y(1, 1, 1)
  DW := GRID_GRAD_Z(1, 1, 1)
  DW := GRID_MET_GATE(1, 1, 1)
  DW := REAL(BIN_PRESENCE(1, 1, 1))
  RETURN
END

SUBROUTINE CLEAR_GRID()
  CALL ZERO(GRID_DENSITY)
  CALL ZERO(GRID_GRAD_X)
  CALL ZERO(GRID_GRAD_Y)
  CALL ZERO(GRID_GRAD_Z)
  CALL ZERO(GRID_MET_GATE)
  CALL ZERO(BIN_PRESENCE)
  RETURN
END

! ── SCATTER: fluid → waveguide ────────────────────────────
! Each particle deposits its presence into the field.
! Phase advance + GEN packing + density + bin presence.
! Ejected: skip. Crystal: bank into GRID_CRYSTAL once, then skip.
!
! This is the generational handoff — the particle declares
! its lifecycle state into the field.

SUBROUTINE SCATTER_GRID()
  INTEGER :: I, CI, CJ, CK, GEN, BIN, PH

  DO I = 1, NPART
    ! Ejected: gone, skip entirely
    IF IAND(FLAGS(I), PFLAG_EJECTED) ≠ 0 THEN
      CYCLE
    ENDIF

    ! Crystal: deposit into permanent grid once, then skip
    IF IAND(FLAGS(I), PFLAG_CRYSTAL) ≠ 0 THEN
      IF IAND(FLAGS(I), PFLAG_BANKED) = 0 THEN
        CI := CLAMP(INT(POS_X(I) / CELL_SIZE) + GRID_HALF, 1, GRID_SIZE)
        CJ := CLAMP(INT(POS_Y(I) / CELL_SIZE) + GRID_HALF, 1, GRID_SIZE)
        CK := CLAMP(INT(POS_Z(I) / CELL_SIZE) + GRID_HALF, 1, GRID_SIZE)
        GRID_CRYSTAL(CI, CJ, CK) := GRID_CRYSTAL(CI, CJ, CK) + 1
        FLAGS(I) := IOR(FLAGS(I), PFLAG_BANKED)
      ENDIF
      CYCLE
    ENDIF

    IF IAND(FLAGS(I), IOR(PFLAG_ACTIVE, PFLAG_NOVA)) = 0 THEN
      CYCLE
    ENDIF

    ! Phase accumulator: advance, wrap (all integer)
    PH := IAND(ISHFT(FLAGS(I), -PHASE_SHIFT), PHASE_MASK)
    PH := IAND(PH + INT(OMEGA_NAT(I) * PHASE_INC_SCALE), PHASE_MASK)

    ! GEN from top 5 bits of 15-bit phase
    GEN := IAND(ISHFT(PH, -10), GEN_MASK)

    ! Write back FLAGS: low byte (status) + GEN + PHASE
    FLAGS(I) := IOR(IOR(IAND(FLAGS(I), 255), ISHFT(GEN, GEN_SHIFT)), ISHFT(PH, PHASE_SHIFT))

    ! Density: +1 into cell (positive accumulator)
    CI := CLAMP(INT(POS_X(I) / CELL_SIZE) + GRID_HALF, 1, GRID_SIZE)
    CJ := CLAMP(INT(POS_Y(I) / CELL_SIZE) + GRID_HALF, 1, GRID_SIZE)
    CK := CLAMP(INT(POS_Z(I) / CELL_SIZE) + GRID_HALF, 1, GRID_SIZE)
    GRID_DENSITY(CI, CJ, CK) := GRID_DENSITY(CI, CJ, CK) + 1

    ! Generation bin presence
    BIN := IAND(GEN, 7) + 1
    BIN_PRESENCE(CI, CJ, CK) := IOR(BIN_PRESENCE(CI, CJ, CK), ISHFT(1, BIN - 1))
  ENDDO
  RETURN
END

! ── STENCIL: waveguide → waveguide ───────────────────────
! Computes gradients from density, metabolic gate from presence.
! Blends oracle consensus into local field before differentiation.
! Cells with zero density: gradients are zero. Natural skip.

SUBROUTINE STENCIL_GRID()
  INTEGER :: I, J, K, IM, IP, JM, JP, KM, KP
  INTEGER :: BP
  REAL :: COV

  DO K = 1, GRID_SIZE
    KM := MOD(K - 2 + GRID_SIZE, GRID_SIZE) + 1
    KP := MOD(K, GRID_SIZE) + 1
    DO J = 1, GRID_SIZE
      JM := MOD(J - 2 + GRID_SIZE, GRID_SIZE) + 1
      JP := MOD(J, GRID_SIZE) + 1
      DO I = 1, GRID_SIZE
        IM := MOD(I - 2 + GRID_SIZE, GRID_SIZE) + 1
        IP := MOD(I, GRID_SIZE) + 1

        ! Crystal field: permanent density from frozen suns
        GRID_DENSITY(I, J, K) := GRID_DENSITY(I, J, K) + GRID_CRYSTAL(I, J, K)

        ! Oracle blend: local + alpha * (global - local)
        GRID_DENSITY(I, J, K) := INT(REAL(GRID_DENSITY(I, J, K)) + FIELD_BLEND * (GRID_DENSITY_GLOBAL(I, J, K) - REAL(GRID_DENSITY(I, J, K))))

        ! Gradients (cast INTEGER → REAL for arithmetic)
        GRID_GRAD_X(I, J, K) := REAL(GRID_DENSITY(IP, J, K) - GRID_DENSITY(IM, J, K)) * 0.5
        GRID_GRAD_Y(I, J, K) := REAL(GRID_DENSITY(I, JP, K) - GRID_DENSITY(I, JM, K)) * 0.5
        GRID_GRAD_Z(I, J, K) := REAL(GRID_DENSITY(I, J, KP) - GRID_DENSITY(I, J, KM)) * 0.5

        ! Metabolic gate: popcount → coverage → gate
        BP := BIN_PRESENCE(I, J, K)
        COV := 0.0
        IF IAND(BP, 1) ≠ 0 THEN
          COV := COV + 1.0
        ENDIF
        IF IAND(BP, 2) ≠ 0 THEN
          COV := COV + 1.0
        ENDIF
        IF IAND(BP, 4) ≠ 0 THEN
          COV := COV + 1.0
        ENDIF
        IF IAND(BP, 8) ≠ 0 THEN
          COV := COV + 1.0
        ENDIF
        IF IAND(BP, 16) ≠ 0 THEN
          COV := COV + 1.0
        ENDIF
        IF IAND(BP, 32) ≠ 0 THEN
          COV := COV + 1.0
        ENDIF
        IF IAND(BP, 64) ≠ 0 THEN
          COV := COV + 1.0
        ENDIF
        IF IAND(BP, 128) ≠ 0 THEN
          COV := COV + 1.0
        ENDIF
        GRID_MET_GATE(I, J, K) := 0.2 + 1.3 * COV / 8.0
      ENDDO
    ENDDO
  ENDDO
  RETURN
END
! ════════════════════════════════════════════════════════════════
! CENSUS — CPU observation (minimal: population + frame only)
! ════════════════════════════════════════════════════════════════
!
! For now, census reports NPART and FRAME only.
! Grid-level statistics (density distribution, gradient magnitude)
! will be added when proper census-time grid downloads are implemented.
!
! NPART is a CPU scalar — no GPU download needed.
! Census persistent state is declared in waveguide_state.mcl.

SUBROUTINE SIM_CENSUS_ADAPTIVE(COUNT, FRAME, NEXT_INTERVAL)
  INTEGER :: COUNT, FRAME, NEXT_INTERVAL
  INTEGER :: INTERVAL

  PRINT FRAME
  PRINT COUNT

  ! Adaptive interval: simple population-based for now
  INTERVAL := CENSUS_INTERVAL_DEFAULT
  IF COUNT > 50000 THEN
    INTERVAL := CENSUS_INTERVAL_MIN
  ELSEIF COUNT > 10000 THEN
    INTERVAL := CENSUS_INTERVAL_DEFAULT / 2
  ELSEIF COUNT < 100 THEN
    INTERVAL := CENSUS_INTERVAL_MAX
  ENDIF

  IF INTERVAL < CENSUS_INTERVAL_MIN THEN
    INTERVAL := CENSUS_INTERVAL_MIN
  ENDIF
  IF INTERVAL > CENSUS_INTERVAL_MAX THEN
    INTERVAL := CENSUS_INTERVAL_MAX
  ENDIF

  CENSUS_PREV_FRAME := FRAME
  CENSUS_INITIALIZED := 1
  NEXT_INTERVAL := INTERVAL
  RETURN
END
! ════════════════════════════════════════════════════════════════
! MAIN — Pipeline orchestration
! ════════════════════════════════════════════════════════════════
!
! Two waves, one cycle:
!
! Wave 1 — Instruction (Oracle → CPU → GPU):
!   Oracle sends consensus field → CPU sets waveguide corrections →
!   GPU reads them at next frame start.
!
! Wave 2 — Observation (GPU → CPU → Oracle):
!   GPU accumulates density → CPU lazy-grabs grid at census →
!   CPU sends density + stats to oracle → Oracle sums, trust-weights,
!   broadcasts consensus back.
!
! Zero particle downloads. Ever. The waveguide is the interface.

IMPLICIT NONE

INTEGER :: FRAME, SPAWNED, SAMPLE
INTEGER :: CENSUS_INTERVAL, NEXT_CENSUS

CENSUS_INTERVAL := CENSUS_INTERVAL_DEFAULT
NEXT_CENSUS := CENSUS_INTERVAL

! ── CPU INIT: set constants, seed initial fluid state ─────
CALL SIM_INIT(DEFAULT_N, MAXPART, 42)
CALL SIM_SEED_SHELL()

PRINT NPART

! GPU spawn counter starts at NPART — set once, GPU manages from here
SPAWN_COUNTER(1) := NPART

! ── VERIFY: oracle probe + NET for field exchange ─────────
! This line activates the two-wave cycle:
!   - Sends 12 probe particles to oracle every 100 frames (Wave 2)
!   - Receives spawn commands from oracle (Wave 1)
!   - NET enables density grid send/recv at census intervals
VERIFY POS_X, POS_Y, POS_Z, VEL_X, VEL_Y, VEL_Z, OMEGA_NAT &
  ORACLE 12 EVERY 100 TOL 1.0E-4 NET "127.0.0.1:4250"

! ── FRAME LOOP: GPU executes, CPU observes at intervals ───
DO FRAME = 1, DEFAULT_FRAMES

  ! ── GPU EXECUTION (every frame) ─────────────────────────
  ! Forward pipeline: waveguide rebuild → fluid update (+ spawn)
  ! All GPU. No CPU. No downloads.
  ! SPAWN_RATE is continuous — GPU applies it every frame as probability.
  ! SPAWN_COUNTER is GPU-managed via atomic increment.
  CALL CLEAR_GRID()
  CALL SCATTER_GRID()
  CALL STENCIL_GRID()
  CALL SIM_PHYSICS_STEP(DEFAULT_DT)

  ! ── CPU OBSERVATION (lazy readback at census intervals) ──
  ! Wave 2: CPU grabs density grid, computes stats, sends to oracle.
  ! GPU doesn't wait. CPU gets to it when it gets to it.
  IF NET_SPAWN_ACTIVE ≠ 0 .AND. NET_CENSUS_OVERRIDE > 0 THEN
    CENSUS_INTERVAL := NET_CENSUS_OVERRIDE
  ENDIF
  IF FRAME ≥ NEXT_CENSUS THEN
    ! Census reads NPART only — grid download causes per-frame
    ! rubber-banding because codegen inserts unconditional downloads.
    ! TODO: fix codegen to only download inside conditional blocks.
    CALL SIM_CENSUS_ADAPTIVE(NPART, FRAME, CENSUS_INTERVAL)
    NEXT_CENSUS := FRAME + CENSUS_INTERVAL
  ENDIF

  IF FRAME > 1 .AND. MOD(FRAME, 1000) = 0 THEN
    PRINT FRAME
    PRINT NPART
  ENDIF

ENDDO

PRINT NPART
