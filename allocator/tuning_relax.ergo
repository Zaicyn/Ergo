! tuning_relax.ergo — GENERATED by gen_tuning_relax.py (do not edit)
! Level 2 geodesy: SCATLT visitation walk on the 8x32 torus.
! Metric: ring step WR(r)=1+(|FLOWW[r]|+|FLOWW[r+1]|)/2, bin step WB=SCLRAT=27/16.
! Action E = sum 1/(1+DD(n_i,n_i+1)) (collision energy; spread sequences minimize).
IMPLICIT NONE
INTEGER, PARAMETER :: NB = 8, NR = 32, NP = 256, NW = 32
INTEGER, PARAMETER :: NSWEEP = 200
REAL, PARAMETER :: WB = 1.6875
STATIC REAL :: FLOWW(NR), WR(NR), DIST(NP), DD(NP, NP)
STATIC INTEGER :: SCAT(NW), SEQ(NW), NODE(NW), CNT(NB)
STATIC INTEGER :: PREV(NP), VIS(NP)
DATA FLOWW / 0.000000, 0.263371, 0.231222, 0.227317, 0.340459, 0.163085, -0.216041, -0.319410, -0.259259, -0.319410, -0.216041, 0.163086, 0.340459, 0.227318, 0.231222, 0.263371, -0.000000, -0.263371, -0.231222, -0.227317, -0.340459, -0.163085, 0.216041, 0.319410, 0.259259, 0.319410, 0.216041, -0.163086, -0.340459, -0.227317, -0.231222, -0.263371 /
DATA SCAT / 6, 4, 6, 2, 7, 4, 3, 0, 2, 0, 3, 4, 7, 2, 6, 4, 6, 4, 6, 2, 7, 4, 3, 0, 2, 0, 3, 4, 7, 2, 6, 4 /
REAL :: C1, DB, EB, E2, DSUM
INTEGER :: I, J, K, S, T, U, V, CHANGED, B, R, RP, RM
INTEGER :: BP, BM, N1, N2, TMP, CONV

DO I = 1, NR
  RP := MOD(I, NR) + 1
  WR(I) := 1.0 + 0.5 * (ABS(FLOWW(I)) + ABS(FLOWW(RP)))
ENDDO

DO S = 1, NP
  DO I = 1, NP
    DIST(I) := 1.0e30
    VIS(I) := 0
  ENDDO
  DIST(S) := 0.0
  DO T = 1, NP
    U := 0
    DB := 1.0e29
    DO I = 1, NP
      IF (VIS(I) == 0) THEN
        IF (DIST(I) < DB) THEN
          DB := DIST(I)
          U := I
        ENDIF
      ENDIF
    ENDDO
    IF (U > 0) THEN
      VIS(U) := 1
      B := (U - 1) / NR
      R := MOD(U - 1, NR)
      RP := MOD(R + 1, NR)
      RM := MOD(R + NR - 1, NR)
      BP := MOD(B + 1, NB)
      BM := MOD(B + NB - 1, NB)
      V := B * NR + RP + 1
      C1 := DIST(U) + WR(R + 1)
      IF (C1 < DIST(V)) THEN
        DIST(V) := C1
      ENDIF
      V := B * NR + RM + 1
      C1 := DIST(U) + WR(RM + 1)
      IF (C1 < DIST(V)) THEN
        DIST(V) := C1
      ENDIF
      V := BP * NR + R + 1
      C1 := DIST(U) + WB
      IF (C1 < DIST(V)) THEN
        DIST(V) := C1
      ENDIF
      V := BM * NR + R + 1
      C1 := DIST(U) + WB
      IF (C1 < DIST(V)) THEN
        DIST(V) := C1
      ENDIF
    ENDIF
  ENDDO
  DO I = 1, NP
    DD(S, I) := DIST(I)
  ENDDO
ENDDO
WRITE(*, "dd done")
DO I = 1, NP
  DO J = 1, NP
    WRITE(*, "DD %d %d %.12e") I, J, DD(I, J)
  ENDDO
ENDDO

DO I = 1, NW
  SEQ(I) := SCAT(I)
ENDDO
DO K = 1, NB
  CNT(K) := 0
ENDDO
DO K = 1, NW
  B := SEQ(K) + 1
  R := CNT(B)
  CNT(B) := R + 1
  NODE(K) := (B - 1) * NR + R + 1
ENDDO
EB := 0.0
DSUM := 0.0
DO K = 1, NW - 1
  N1 := NODE(K)
  N2 := NODE(K + 1)
  EB := EB + 1.0 / (1.0 + DD(N1, N2))
  DSUM := DSUM + DD(N1, N2)
ENDDO
WRITE(*, "EDESIGN %.12e") EB
WRITE(*, "DSUM %.12e") DSUM

CONV := 0
DO T = 1, NSWEEP
  CHANGED := 0
  DO I = 1, NW - 1
    DO J = I + 1, NW
      TMP := SEQ(I)
      SEQ(I) := SEQ(J)
      SEQ(J) := TMP
      DO K = 1, NB
        CNT(K) := 0
      ENDDO
      DO K = 1, NW
        B := SEQ(K) + 1
        R := CNT(B)
        CNT(B) := R + 1
        NODE(K) := (B - 1) * NR + R + 1
      ENDDO
      E2 := 0.0
      DO K = 1, NW - 1
        N1 := NODE(K)
        N2 := NODE(K + 1)
        E2 := E2 + 1.0 / (1.0 + DD(N1, N2))
      ENDDO
      IF (E2 < EB - 1.0e-12) THEN
        EB := E2
        CHANGED := 1
      ELSE
        TMP := SEQ(I)
        SEQ(I) := SEQ(J)
        SEQ(J) := TMP
      ENDIF
    ENDDO
  ENDDO
  IF (CHANGED == 0) THEN
    CONV := T
    T := NSWEEP
  ENDIF
ENDDO
WRITE(*, "converged at sweep %d") CONV
WRITE(*, "ERELAXED %.12e") EB
DO I = 1, NW
  WRITE(*, "RSEQ %d %d") I, SEQ(I)
ENDDO
