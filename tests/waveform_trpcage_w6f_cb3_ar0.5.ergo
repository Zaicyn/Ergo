  CB_OFF_Z(19) := -0.344178
  CB_OFF_X(20) := 0.440045
  CB_OFF_Y(20) := 0.410185
  CB_OFF_Z(20) := -0.000393

  ! Aromatic side-chain multipliers (Phe=0.5, Tyr=0.7, Trp=1.0)
  AROMATIC_MULT(1) := 0.00
  AROMATIC_MULT(2) := 0.00
  AROMATIC_MULT(3) := 0.60
  AROMATIC_MULT(4) := 0.00
  AROMATIC_MULT(5) := 0.00
