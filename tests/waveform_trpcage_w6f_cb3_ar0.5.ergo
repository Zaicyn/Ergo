  RES_HYDRO(11) := 0.0   ! G
  RES_HYDRO(12) := 0.6   ! P
  RES_HYDRO(13) := 0.0   ! S
  RES_HYDRO(14) := 0.0   ! S
  RES_HYDRO(15) := 0.0   ! G
  RES_HYDRO(16) := 0.0   ! R
  RES_HYDRO(17) := 0.6   ! P
  RES_HYDRO(18) := 0.6   ! P
  RES_HYDRO(19) := 0.6   ! P
  RES_HYDRO(20) := 0.0   ! S

  ! Cβ offsets relative to Cα (from native structure)
  CB_OFF_X(1) := -0.325712
  CB_OFF_Y(1) := 0.102546
  CB_OFF_Z(1) := -0.499372
  CB_OFF_X(2) := 0.201163
  CB_OFF_Y(2) := 0.568915
  CB_OFF_Z(2) := -0.065614
  CB_OFF_X(3) := -0.107654
  CB_OFF_Y(3) := 0.288387
  CB_OFF_Z(3) := 0.519017
  CB_OFF_X(4) := -0.600740
  CB_OFF_Y(4) := -0.006679
  CB_OFF_Z(4) := -0.106082
  CB_OFF_X(5) := -0.066793
  CB_OFF_Y(5) := 0.335534
  CB_OFF_Z(5) := -0.498979
  CB_OFF_X(6) := 0.194484
  CB_OFF_Y(6) := 0.524125
  CB_OFF_Z(6) := 0.226309
  CB_OFF_X(7) := -0.420007
  CB_OFF_Y(7) := 0.112762
  CB_OFF_Z(7) := 0.420400
  CB_OFF_X(8) := -0.471477
  CB_OFF_Y(8) := 0.036932
  CB_OFF_Z(8) := -0.378360
  CB_OFF_X(9) := 0.222773
  CB_OFF_Y(9) := 0.462440
  CB_OFF_Z(9) := -0.321783
  CB_OFF_X(10) := 0.000000
  CB_OFF_Y(10) := 0.000000
  CB_OFF_Z(10) := 0.000000
  CB_OFF_X(11) := 0.000000
  CB_OFF_Y(11) := 0.000000
  CB_OFF_Z(11) := 0.000000
  CB_OFF_X(12) := 0.159909
  CB_OFF_Y(12) := 0.057363
  CB_OFF_Z(12) := 0.578738
  CB_OFF_X(13) := -0.232202
  CB_OFF_Y(13) := -0.468334
  CB_OFF_Z(13) := 0.301745
  CB_OFF_X(14) := -0.579523
  CB_OFF_Y(14) := 0.126513
  CB_OFF_Z(14) := -0.098224
  CB_OFF_X(15) := 0.000000
  CB_OFF_Y(15) := 0.000000
  CB_OFF_Z(15) := 0.000000
  CB_OFF_X(16) := -0.463226
  CB_OFF_Y(16) := -0.128477
