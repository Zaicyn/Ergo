! RENDER_ONLY_PARTICLES — B2 regression (2026-09-04): --render without
! --target must compile a POS_X/POS_Y/PZ particle program (CPU physics +
! GPU display). Pre-fix the particle epilogue referenced _color_buf and
! the FDTD grid buffers unconditionally — C codegen failed. Gate: the
! RENDER COMPILE CHECK in tests/golden/run_golden.py compiles this with
! --render (compile only; running opens a window).
IMPLICIT NONE
PARAMETER INTEGER :: NPART = 100
PARAMETER INTEGER :: NSTEPS = 200
PARAMETER REAL :: BOX_SIZE = 10.0
STATIC REAL :: POS_X(NPART), POS_Y(NPART), POS_Z(NPART)
STATIC REAL :: VEL_X(NPART)
STATIC INTEGER :: I, STEP
DO I = 1, NPART
  POS_X(I) := RAND(1000 + I) * 10.0
  POS_Y(I) := RAND(2000 + I) * 10.0
  POS_Z(I) := RAND(3000 + I) * 10.0
  VEL_X(I) := 0.0
ENDDO
DO STEP = 1, NSTEPS
  DO I = 1, NPART
    POS_X(I) := POS_X(I) + 0.001
  ENDDO
ENDDO
WRITE(*, "done %f") POS_X(1)
STOP
