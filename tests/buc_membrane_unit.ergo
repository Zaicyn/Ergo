! BUC_MEMBRANE_UNIT - Single cell membrane potential model (MCL port)
! ====================================================================
! Nernst-Planck membrane model with active transport.
! Tests pump-leak equilibrium and depolarization cliff.
! Produces CSV to stdout, summaries to stderr.

IMPLICIT NONE

! ── Simulation parameters ───────────────────────────────────
INTEGER :: NTICK = 10000
INTEGER :: NRUNS = 5

! ── Cell state ──────────────────────────────────────────────
REAL :: PSI, HIN, KIN, ATP, MSHINT

! ── Environment (fixed external concentrations) ─────────────
REAL :: HOUT = 1.0E-4
REAL :: KOUT = 5.0

! ── Membrane parameters ────────────────────────────────────
REAL :: CM = 0.02
REAL :: GK0 = 0.008
REAL :: GH0 = 0.002

! ── Pump parameters ─────────────────────────────────────────
REAL :: PMAX = 0.05
REAL :: PHALF = 0.3
REAL :: PCOST = 0.008
REAL :: PCURR = 2.0

! ── ATP synthase parameters ─────────────────────────────────
REAL :: SMAX = 0.08
REAL :: SHALF = 80.0
REAL :: SYIELD = 0.005
REAL :: SFLUX = 0.00002

! ── Metabolism ──────────────────────────────────────────────
REAL :: ADECAY = 0.00005

! ── Nernst constant (RT/F at 37C) ──────────────────────────
REAL :: NERNST = 61.5

! ── Working variables ───────────────────────────────────────
REAL :: EK, EH, GK, GH, IK, IH, ILEAK
REAL :: PRATE, IPUMP, DELTAP, SRATE
REAL :: ITOTAL, DPSIDT, EXCESS, VPNLTY
INTEGER :: IRUN, IT

! ── CSV header ──────────────────────────────────────────────
WRITE(*, "run,tick,psi,h_in,k_in,atp,mesh,delta_p,pump_rate,synth_rate,i_leak,i_pump,e_k,e_h")

! ── RUN LOOP ────────────────────────────────────────────────
DO IRUN = 1, 5

  ! Initialize cell to healthy steady state
  PSI := -150.0
  HIN := 3.16E-5
  KIN := 200.0
  ATP := 0.8
  MSHINT := 1.0

  ! ── TICK LOOP ───────────────────────────────────────────
  DO IT = 1, 10000

    ! ── Update mesh based on run ─────────────────────────
    IF IRUN = 1 THEN
      MSHINT := 1.0
    ELSEIF IRUN = 2 THEN
      MSHINT := MAX(0.0, 1.0 - REAL(IT) / 5000.0)
    ELSEIF IRUN = 3 THEN
      IF IT ≥ 2000 THEN
        MSHINT := 0.2
      ELSE
        MSHINT := 1.0
      ENDIF
    ELSEIF IRUN = 4 THEN
      IF IT ≥ 2000 THEN
        MSHINT := 0.2
      ELSE
        MSHINT := 1.0
      ENDIF
      IF IT = 4000 THEN
        ATP := 0.9
      ENDIF
    ELSEIF IRUN = 5 THEN
      MSHINT := 0.5 + 0.4 * SIN(REAL(IT) / 300.0)
      IF MSHINT < 0.0 THEN
        MSHINT := 0.0
      ENDIF
      IF MSHINT > 1.0 THEN
        MSHINT := 1.0
      ENDIF
    ENDIF

    ! ── 1. SENSE — Nernst equilibrium potentials ─────────
    IF KIN > 1.0E-10 .AND. KOUT > 1.0E-10 THEN
      EK := NERNST * LOG10(KOUT / KIN)
    ELSE
      EK := 0.0
    ENDIF
    IF HIN > 1.0E-15 .AND. HOUT > 1.0E-15 THEN
      EH := NERNST * LOG10(HOUT / HIN)
    ELSE
      EH := 0.0
    ENDIF

    ! ── 2. LEAK — passive ion conductance ────────────────
    GK := GK0 * (1.0 - 0.95 * MSHINT)
    GH := GH0 * (1.0 - 0.95 * MSHINT)
    IK := GK * (PSI - EK)
    IH := GH * (PSI - EH)
    ILEAK := IK + IH

    ! ── 3. PUMP — active proton export ───────────────────
    IF ATP > 0.001 THEN
      PRATE := PMAX * ATP / (ATP + PHALF)
    ELSE
      PRATE := 0.0
    ENDIF
    IPUMP := PCURR * PRATE
    HIN := HIN - PRATE * 2.0E-5
    IF HIN < 1.0E-8 THEN
      HIN := 1.0E-8
    ENDIF
    ATP := ATP - PCOST * PRATE
    IF ATP < 0.0 THEN
      ATP := 0.0
    ENDIF

    ! ── 4. HARVEST — ATP synthase ────────────────────────
    IF HIN > 1.0E-15 .AND. HOUT > 1.0E-15 THEN
      DELTAP := PSI - 60.0 * LOG10(HIN / HOUT)
    ELSE
      DELTAP := PSI
    ENDIF

    IF DELTAP < -80.0 .AND. PSI < -100.0 THEN
      EXCESS := ABS(DELTAP) - 80.0
      VPNLTY := MIN(1.0, (ABS(PSI) - 100.0) / 50.0)
      SRATE := SMAX * (EXCESS ** 2) / (EXCESS ** 2 + SHALF ** 2) * VPNLTY
      ATP := ATP + SYIELD * SRATE
      IF ATP > 1.0 THEN
        ATP := 1.0
      ENDIF
      HIN := HIN + 5.0E-7 * SRATE
    ELSE
      SRATE := 0.0
    ENDIF

    ! ── 5. DECAY — baseline ATP drain ────────────────────
    ATP := ATP - ADECAY
    IF ATP < 0.0 THEN
      ATP := 0.0
    ENDIF

    ! ── 6. UPDATE — membrane potential ───────────────────
    ITOTAL := ILEAK + IPUMP
    DPSIDT := -ITOTAL / CM
    PSI := PSI + DPSIDT
    IF PSI < -300.0 THEN
      PSI := -300.0
    ENDIF
    IF PSI > 50.0 THEN
      PSI := 50.0
    ENDIF

    ! ── 7. ION UPDATE — concentrations track current ─────
    KIN := KIN - IK * 0.05
    HIN := HIN - IH * 5.0E-5
    IF KIN < 0.1 THEN
      KIN := 0.1
    ENDIF
    IF KIN > 500.0 THEN
      KIN := 500.0
    ENDIF
    IF HIN < 1.0E-8 THEN
      HIN := 1.0E-8
    ENDIF
    IF HIN > 1.0E-2 THEN
      HIN := 1.0E-2
    ENDIF

    ! ── Output every 10 ticks ────────────────────────────
    IF MOD(IT, 10) = 0 THEN
      WRITE(*, "%d,%d,%.2f,%.3e,%.3f,%.4f,%.3f,%.2f,%.4f,%.4f,%.3f,%.3f,%.2f,%.2f") IRUN, IT, PSI, HIN, KIN, ATP, MSHINT, DELTAP, PRATE, SRATE, ILEAK, IPUMP, EK, EH
    ENDIF

  ENDDO

  ! ── Run summary to stderr ────────────────────────────
  WRITE(0, "  Run %d: final psi=%.2f  atp=%.4f  delta_p=%.2f") IRUN, PSI, ATP, DELTAP

ENDDO

WRITE(0, " ")
WRITE(0, "MEMBRANE UNIT TEST COMPLETE")
WRITE(0, "===========================")
WRITE(0, "Run 1: Healthy (mesh=1.0)")
WRITE(0, "Run 2: Degradation ramp (1.0->0.0)")
WRITE(0, "Run 3: Sudden loss (1.0->0.2 at t=2000)")
WRITE(0, "Run 4: Sudden loss + ATP rescue at t=4000")
WRITE(0, "Run 5: Oscillating mesh (edge stress)")
STOP
