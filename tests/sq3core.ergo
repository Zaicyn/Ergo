! SQUARAGON V3 CORE - MCL PORT
! ==============================
! Torus allocator: 2 shells x 8 bins x 32 ring = 512 slots
! All state in STATIC declarations. Zero dynamic allocation.
! Direct addressing guaranteed.
!
! v3 differences from v2:
!   - Seam rotation encoded in integer bits of RINV, not float perturbation.
!   - MOD by power-of-two written as IAND for explicit bit-twiddle intent.
!   - No floating-point operations in SQ3FAL fast path.
!   - RINV is now exactly recoverable bit-for-bit; no 0.01 representation drift.

! ── Constants ────────────────────────────────────────────────

STATIC INTEGER :: NBINS = 8
STATIC INTEGER :: NSHEL = 2
STATIC INTEGER :: NRING = 32
STATIC INTEGER :: NSLOT = 512
STATIC INTEGER :: THBIAS = 384
STATIC INTEGER :: THWORK = 432
STATIC INTEGER :: THMAX = 496

! ── Precomputed LUTs ────────────────────────────────────────
! SCATLT: Viviani scatter — maps (ID & 31) to bin index 0-7
! BINGEO: Viviani geo encoding per bin

STATIC INTEGER :: SCATLT(32)
DATA SCATLT / 6, 4, 6, 2, 7, 4, 3, 0, 2, 0, 3, 4, 7, 2, 6, 4, 6, 4, 6, 2, 7, 4, 3, 0, 2, 0, 3, 4, 7, 2, 6, 4 /

STATIC INTEGER :: BINGEO(8)
DATA BINGEO / 228, 104, 0, 104, 228, 104, 0, 104 /

! ── Torus State ─────────────────────────────────────────────
! Direct static addressing. No pointer chasing. No indirection.
! Access to STATIC storage compiles to direct address computation.

STATIC INTEGER :: TINVAR(32, 8, 2)
STATIC INTEGER :: TOCC(32, 8, 2)
STATIC INTEGER :: TFROZ(32, 8, 2)
STATIC INTEGER :: TWHEAD(8, 2)
STATIC INTEGER :: TLEN(8, 2)
STATIC INTEGER :: TALLOC(8, 2)
STATIC INTEGER :: TTOTAL = 0
STATIC INTEGER :: TPHASE = 0
STATIC INTEGER :: TGEN = 0

! ── SQ3SCT: Viviani scatter (LUT, O(1)) ────────────────────
! Returns bin index 1-8 for a given ID

INTEGER FUNCTION SQ3SCT(ID)
  INTEGER :: ID
  SQ3SCT := SCATLT(MOD(ID - 1, 32) + 1) + 1
  RETURN SQ3SCT
END

! ── SQ3FAL: FAST allocate (LUT-only, no gate write) ────────
! Pure integer hot path: scatter + LUT invariant + rotate.
! No vertex init, no gate fold. Just index math.
!
! ID    = allocation ID (1-based)
! IERR  = 0 on success, -1 on full

SUBROUTINE SQ3FAL(ID, IERR)
  INTEGER :: ID, IERR
  INTEGER :: BIN, GEN, SHELL, POS
  INTEGER :: IGEO, IBIN, ISHEL
  INTEGER :: TBITS
  INTEGER :: RINV

  IERR := 0
  SHELL := 1
  BIN := SQ3SCT(ID)
  GEN := TWHEAD(BIN, SHELL)

  IF GEN > 32 THEN
    IERR := -1
    RETURN
  ENDIF

  ! Fast invariant: LUT geo + bin + shell encoding
  ! Pack: geo<<24 | bin<<16 | seam<<9 | shell<<8 | gen
  ! Bit layout:
  !   bits  0-4 : gen   (0-31)
  !   bits  5-7 : unused
  !   bit    8  : shell (0-1)
  !   bits  9-13: seam  (TBITS, even values 0-30 → 4 useful bits)
  !   bits 14-15: unused
  !   bits 16-18: bin   (0-7)
  !   bits 19-23: unused
  !   bits 24-31: geo   (BINGEO 0-228)
  POS := IAND(GEN - 1, 31) + 1
  IGEO := BINGEO(BIN)
  IBIN := BIN - 1
  ISHEL := SHELL - 1

  ! Seam rotation: (gen-1) * 2 bits, integer-twiddled, packed at bit 9.
  ! IAND(..., 31) replaces MOD(..., 32) — explicit bit-twiddle intent,
  ! no dependence on optimizer recognizing the power-of-two fold.
  TBITS := IAND(ISHFT(GEN - 1, 1), 31)

  RINV := ISHFT(IGEO, 24) + ISHFT(IBIN, 16) + ISHFT(TBITS, 9) + &
          ISHFT(ISHEL, 8) + (GEN - 1)

  TINVAR(GEN, BIN, SHELL) := RINV

  ! Mark occupied, period-4
  TOCC(GEN, BIN, SHELL) := 1
  TALLOC(BIN, SHELL) := TALLOC(BIN, SHELL) + 1
  IF MOD(TALLOC(BIN, SHELL), 4) = 0 THEN
    TFROZ(GEN, BIN, SHELL) := 1
  ELSE
    TFROZ(GEN, BIN, SHELL) := 0
  ENDIF

  TWHEAD(BIN, SHELL) := GEN + 1
  TLEN(BIN, SHELL) := TLEN(BIN, SHELL) + 1
  TTOTAL := TTOTAL + 1

  RETURN
END

! ── SQ3TIN: Initialize torus (all slots empty) ──────────────

SUBROUTINE SQ3TIN
  INTEGER :: I, J, K

  DO K = 1, 2
    DO J = 1, 8
      TWHEAD(J, K) := 1
      TLEN(J, K) := 0
      TALLOC(J, K) := 0
      DO I = 1, 32
        TOCC(I, J, K) := 0
        TFROZ(I, J, K) := 0
        TINVAR(I, J, K) := 0
      ENDDO
    ENDDO
  ENDDO
  TTOTAL := 0
  TPHASE := 0
  TGEN := 0
  RETURN
END

! ── SQ3ZON: Zone for occupancy ──────────────────────────────
! Returns: 1=COASTING, 2=ACTIVE, 3=OVERDRIVE, 4=DIVIDE

INTEGER FUNCTION SQ3ZON(NOCC)
  INTEGER :: NOCC
  IF NOCC < 384 THEN
    SQ3ZON := 1
  ELSEIF NOCC < 432 THEN
    SQ3ZON := 2
  ELSEIF NOCC < 496 THEN
    SQ3ZON := 3
  ELSE
    SQ3ZON := 4
  ENDIF
  RETURN SQ3ZON
END

! ── SQ3VAL: Validate TINVAR contents ───────────────────────
! Walks every (GEN, BIN, SHELL) slot. For occupied slots
! (TOCC == 1), recomputes the expected bit-pack and compares
! against the stored TINVAR entry. Returns count of mismatches
! (zero = all entries valid). For unoccupied slots, expects
! TINVAR == 0 (the SQ3TIN init value).
!
! This routine exists to make v3's "RINV is exactly recoverable
! bit-for-bit" claim falsifiable. Without it, the bit-pack
! discipline is asserted but never verified. With it, any
! corruption of the encoding (wrong shift, wrong mask, drift)
! produces a non-zero mismatch count.
!
! TODO (future implementer): when Invariant_Language_Feature
! Version 1 lands, the per-entry check below becomes the body
! of an INVARIANT GEO_PACKING declaration, and SQ3VAL becomes
! the compiler-generated verifier rather than hand-written.
! Other invariants worth adding at that time (per Grok's sketch):
!   - INVARIANT TORUS_CONSERVATION:
!       TTOTAL = SUM(TALLOC) OVER BINS,SHELLS = SUM(TOCC)
!   - INVARIANT RING_INTEGRITY:
!       FOR EACH BIN,SHELL: TLEN = COUNT(TOCC == 1)
!   - INVARIANT PERIOD4_FREEZE:
!       TFROZ == 1 IFF MOD(TALLOC, 4) == 0 AT ALLOCATION TIME
!   - INVARIANT HEAD_PROGRESSION:
!       TWHEAD = 1 + TLEN
! Keep this comment in sync with the V1 implementation if it lands.

SUBROUTINE SQ3VAL(NMISMATCH)
  INTEGER :: NMISMATCH
  INTEGER :: VI, VJ, VK
  INTEGER :: VBIN, VSHELL, VGEO, VTBITS, EXPECTED, ACTUAL

  NMISMATCH := 0
  DO VK = 1, 2
    DO VJ = 1, 8
      DO VI = 1, 32
        ACTUAL := TINVAR(VI, VJ, VK)
        IF TOCC(VI, VJ, VK) = 1 THEN
          ! Reproduce SQ3FAL's bit-pack from (BIN=VJ, SHELL=VK, GEN=VI).
          VBIN := VJ - 1
          VSHELL := VK - 1
          VGEO := BINGEO(VJ)
          VTBITS := IAND(ISHFT(VI - 1, 1), 31)
          EXPECTED := ISHFT(VGEO, 24) + ISHFT(VBIN, 16) + &
                      ISHFT(VTBITS, 9) + ISHFT(VSHELL, 8) + (VI - 1)
          IF ACTUAL ≠ EXPECTED THEN
            NMISMATCH := NMISMATCH + 1
          ENDIF
        ELSE
          IF ACTUAL ≠ 0 THEN
            NMISMATCH := NMISMATCH + 1
          ENDIF
        ENDIF
      ENDDO
    ENDDO
  ENDDO
  RETURN
END

! ── Test harness ─────────────────────────────────────────────

IMPLICIT NONE
INTEGER :: I, ERR, ZONE
INTEGER :: HASH, HI, HJ, HK
INTEGER :: NBAD

CALL SQ3TIN

! Allocate 400 items via fast path
DO I = 1, 400
  CALL SQ3FAL(I, ERR)
ENDDO

PRINT TTOTAL
ZONE := SQ3ZON(TTOTAL)
PRINT ZONE

! Validate TINVAR encoding. Expected: 0 mismatches.
CALL SQ3VAL(NBAD)
PRINT NBAD

! ── ERGO_HASH_FINAL-style integer state hash ─────────────────
! Ad-hoc XOR-of-shifts mix over TOCC, TFROZ, TWHEAD, TLEN, TALLOC,
! TTOTAL in fixed iteration order. Per-step mix is
!   HASH := IEOR(ISHFT(HASH, 13), ISHFT(HASH, -19))
! This is the single-step form (h replaced by (h<<13) ^ (h>>19)),
! NOT the canonical Marsaglia xorshift32 (which uses three shifts in
! sequence and preserves more bits). Adequate for state fingerprinting
! at this scale (collisions are rare for small integer state) but
! NOT cryptographic and NOT proven full-period.
!
! Seed: 166136261. Looks like FNV-1a 32-bit offset basis (2166136261)
! with the leading 2 dropped — either deliberate truncation to fit
! signed int32 or a transcription artifact. Not actually FNV-1a;
! treat as an arbitrary 32-bit constant in the FNV family.
!
! Uses only IEOR/ISHFT so the hash itself is bit-exact under any
! GCC optimization level — the algorithm's adequacy is about
! collision resistance, not determinism. Determinism is solid.
!
! Skips TINVAR — its contents are verified directly by SQ3VAL
! (called below), which checks every entry against its derived
! bit-pack; the hash's role is regression coverage of integer state,
! not redundant TINVAR validation.
!
! See Spec/Hash_Strengthening_Proposal.md for the upgrade path
! (FNV-1a 64-bit or canonical xorshift32) when stronger guarantees
! are needed.

HASH := 166136261
DO HK = 1, 2
  DO HJ = 1, 8
    HASH := IEOR(HASH, TWHEAD(HJ, HK))
    HASH := IEOR(ISHFT(HASH, 13), ISHFT(HASH, -19))
    HASH := IEOR(HASH, TLEN(HJ, HK))
    HASH := IEOR(ISHFT(HASH, 13), ISHFT(HASH, -19))
    HASH := IEOR(HASH, TALLOC(HJ, HK))
    HASH := IEOR(ISHFT(HASH, 13), ISHFT(HASH, -19))
    DO HI = 1, 32
      HASH := IEOR(HASH, TOCC(HI, HJ, HK))
      HASH := IEOR(ISHFT(HASH, 13), ISHFT(HASH, -19))
      HASH := IEOR(HASH, TFROZ(HI, HJ, HK))
      HASH := IEOR(ISHFT(HASH, 13), ISHFT(HASH, -19))
    ENDDO
  ENDDO
ENDDO
HASH := IEOR(HASH, TTOTAL)
HASH := IEOR(ISHFT(HASH, 13), ISHFT(HASH, -19))

PRINT HASH
