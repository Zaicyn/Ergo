SUBROUTINE UPDATE_THERMAL(FRAME)
  INTEGER :: FRAME
  INTEGER :: HS, HE, CE
  REAL :: FRAC

  THERMAL_CURRENT := HEAT_START

  ! Five heat/cool cycles
  IF FRAME < 300 THEN
    FRAC := REAL(FRAME) / 300.0
    THERMAL_CURRENT := HEAT_START + (HEAT_PEAK - HEAT_START) * FRAC
  ELSEIF FRAME < 600 THEN
    FRAC := REAL(FRAME - 300) / 300.0
    THERMAL_CURRENT := HEAT_PEAK - (HEAT_PEAK - HEAT_START) * FRAC
  ELSEIF FRAME < 900 THEN
    FRAC := REAL(FRAME - 600) / 300.0
    THERMAL_CURRENT := HEAT_START + (HEAT_PEAK - HEAT_START) * FRAC
  ELSEIF FRAME < 1200 THEN
    FRAC := REAL(FRAME - 900) / 300.0
    THERMAL_CURRENT := HEAT_PEAK - (HEAT_PEAK - HEAT_START) * FRAC
  ELSE
    THERMAL_CURRENT := HEAT_START
  ENDIF

  
  ! Quench tail: zero thermal noise after frame 153600
  IF FRAME > 153600 THEN
    THERMAL_CURRENT := 0.0
  ENDIF


  RETURN
END

SUBROUTINE UPDATE_HBONDS()
  INTEGER :: I, J, DEG_I, DEG_J, NF, NB
  REAL :: DX, DY, DZ, D, ALIGN

  NF := 0
  NB := 0

  ! Count current degrees
  DO I = 1, NRES
    DEG_I := 0
    DO J = 1, NRES
      IF HBOND_MATRIX(I, J) = 1 THEN
        DEG_I := DEG_I + 1
      ENDIF
    ENDDO
  ENDDO

  ! Break weak H-bonds
  DO I = 1, NRES-3
    DO J = I+3, NRES
      IF HBOND_MATRIX(I, J) = 1 THEN
        DX := RES_X(I) - RES_X(J)
        DY := RES_Y(I) - RES_Y(J)
        DZ := RES_Z(I) - RES_Z(J)
        D := SQRT(DX*DX + DY*DY + DZ*DZ)
        ALIGN := COS(RES_THETA(I) - RES_THETA(J))
        IF ALIGN < HB_PHASE_STABLE .OR. D > HB_BREAK THEN
          HBOND_MATRIX(I, J) := 0
          HBOND_MATRIX(J, I) := 0
          NB := NB + 1
        ENDIF
      ENDIF
    ENDDO
  ENDDO

  ! Form new H-bonds
  DO I = 1, NRES-3
    DEG_I := 0
    DO J = 1, NRES
      IF HBOND_MATRIX(I, J) = 1 THEN
        DEG_I := DEG_I + 1
      ENDIF
    ENDDO
    IF DEG_I < HB_CAP THEN
      DO J = I+3, NRES
        IF HBOND_MATRIX(I, J) = 0 THEN
          DEG_J := 0
          DO K = 1, NRES
            IF HBOND_MATRIX(J, K) = 1 THEN
              DEG_J := DEG_J + 1
            ENDIF
          ENDDO
          IF DEG_J < HB_CAP THEN
            DX := RES_X(I) - RES_X(J)
            DY := RES_Y(I) - RES_Y(J)
            DZ := RES_Z(I) - RES_Z(J)
            D := SQRT(DX*DX + DY*DY + DZ*DZ)
            ALIGN := COS(RES_THETA(I) - RES_THETA(J))
            IF D < HB_FORM .AND. ALIGN > HB_PHASE_FORM THEN
              HBOND_MATRIX(I, J) := 1
              HBOND_MATRIX(J, I) := 1
              NF := NF + 1
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDIF
  ENDDO

  HB_FORMS := NF
  HB_BREAKS := NB

  RETURN
END

SUBROUTINE COMPUTE_DIAGNOSTICS()
  INTEGER :: I, J, N_ACTIVE
  REAL :: CX, CY, CZ, SUM_ANG, SUM_ANGSQ
  REAL :: U_X, U_Y, U_Z, V_X, V_Y, V_Z, U_MAG, V_MAG, COS_ANG
  REAL :: B1X, B1Y, B1Z, B2X, B2Y, B2Z, B3X, B3Y, B3Z
  REAL :: N1X, N1Y, N1Z, N2X, N2Y, N2Z, N1MAG2, N2MAG2, B2MAG
  REAL :: N1MAG, N2MAG, PHI_ACTUAL
  REAL :: DX, DY, DZ, D, E, G
  REAL :: SUM_PHI2, COS_DIFF

  ! Radius of gyration
  CX := 0.0
  CY := 0.0
  CZ := 0.0
  DO I = 1, NRES
    CX := CX + RES_X(I)
    CY := CY + RES_Y(I)
    CZ := CZ + RES_Z(I)
  ENDDO
  CX := CX / REAL(NRES)
  CY := CY / REAL(NRES)
  CZ := CZ / REAL(NRES)
  RGYR := 0.0
  DO I = 1, NRES
    RGYR := RGYR + (RES_X(I) - CX)**2 + (RES_Y(I) - CY)**2 + (RES_Z(I) - CZ)**2
  ENDDO
  RGYR := SQRT(RGYR / REAL(NRES))

  ! End-to-end distance
  E2E := SQRT((RES_X(NRES) - RES_X(164))**2 + (RES_Y(NRES) - RES_Y(164))**2 + (RES_Z(NRES) - RES_Z(164))**2)

  ! Backbone angles
  SUM_ANG := 0.0
  SUM_ANGSQ := 0.0
  N_ACTIVE := 0
  DO I = 2, NRES-1
    U_X := RES_X(I-1) - RES_X(I)
    U_Y := RES_Y(I-1) - RES_Y(I)
    U_Z := RES_Z(I-1) - RES_Z(I)
    V_X := RES_X(I+1) - RES_X(I)
    V_Y := RES_Y(I+1) - RES_Y(I)
    V_Z := RES_Z(I+1) - RES_Z(I)
    U_MAG := SQRT(U_X*U_X + U_Y*U_Y + U_Z*U_Z)
    V_MAG := SQRT(V_X*V_X + V_Y*V_Y + V_Z*V_Z)
    IF U_MAG > 1.0E-12 .AND. V_MAG > 1.0E-12 THEN
      COS_ANG := MAX(-1.0, MIN(1.0, (U_X*V_X + U_Y*V_Y + U_Z*V_Z) / (U_MAG * V_MAG)))
      SUM_ANG := SUM_ANG + ACOS(COS_ANG) * 180.0 / 3.14159265
      SUM_ANGSQ := SUM_ANGSQ + (ACOS(COS_ANG) * 180.0 / 3.14159265) ** 2
      N_ACTIVE := N_ACTIVE + 1
    ENDIF
  ENDDO
  IF N_ACTIVE > 0 THEN
    BANG_MEAN := SUM_ANG / REAL(N_ACTIVE)
    BANG_RMS := SQRT(MAX(0.0, SUM_ANGSQ / REAL(N_ACTIVE) - BANG_MEAN**2))
  ELSE
    BANG_MEAN := 0.0
    BANG_RMS := 0.0
  ENDIF

  ! Actual torsion angles from current geometry
  SUM_TORS := 0.0
  CNT_TORS := 0.0
  ALPHA_FRAC := 0.0
  DO I = 2, NRES-2
    B1X := RES_X(I) - RES_X(I-1)
    B1Y := RES_Y(I) - RES_Y(I-1)
    B1Z := RES_Z(I) - RES_Z(I-1)
    B2X := RES_X(I+1) - RES_X(I)
    B2Y := RES_Y(I+1) - RES_Y(I)
    B2Z := RES_Z(I+1) - RES_Z(I)
    B3X := RES_X(I+2) - RES_X(I+1)
    B3Y := RES_Y(I+2) - RES_Y(I+1)
    B3Z := RES_Z(I+2) - RES_Z(I+1)

    N1X := B1Y*B2Z - B1Z*B2Y
    N1Y := B1Z*B2X - B1X*B2Z
    N1Z := B1X*B2Y - B1Y*B2X
    N2X := B2Y*B3Z - B2Z*B3Y
    N2Y := B2Z*B3X - B2X*B3Z
    N2Z := B2X*B3Y - B2Y*B3X

    N1MAG2 := N1X*N1X + N1Y*N1Y + N1Z*N1Z
    N2MAG2 := N2X*N2X + N2Y*N2Y + N2Z*N2Z
    B2MAG := SQRT(B2X*B2X + B2Y*B2Y + B2Z*B2Z)

    IF N1MAG2 > 1.0E-12 .AND. N2MAG2 > 1.0E-12 .AND. B2MAG > 1.0E-12 THEN
      N1MAG := SQRT(N1MAG2)
      N2MAG := SQRT(N2MAG2)
      PHI_ACTUAL := ATAN2(B2MAG*(B1X*N2X + B1Y*N2Y + B1Z*N2Z), N1X*N2X + N1Y*N2Y + N1Z*N2Z)
      ! Wrap to (-pi, pi] and report in degrees
      IF PHI_ACTUAL > 3.14159265 THEN
        PHI_ACTUAL := PHI_ACTUAL - 2.0 * 3.14159265
      ENDIF
      IF PHI_ACTUAL ≤ -3.14159265 THEN
        PHI_ACTUAL := PHI_ACTUAL + 2.0 * 3.14159265
      ENDIF
      SUM_TORS := SUM_TORS + PHI_ACTUAL * 180.0 / 3.14159265
      CNT_TORS := CNT_TORS + 1.0
      ! Alpha helix: within ±25 degrees of 50 degrees
      IF ABS(PHI_ACTUAL * 180.0 / 3.14159265 - 50.0) < 25.0 THEN
        ALPHA_FRAC := ALPHA_FRAC + 1.0
      ENDIF
    ENDIF
  ENDDO
  IF CNT_TORS > 0.0 THEN
    TORS_MEAN := SUM_TORS / CNT_TORS
    ALPHA_FRAC := ALPHA_FRAC / CNT_TORS
  ELSE
    TORS_MEAN := 0.0
    ALPHA_FRAC := 0.0
  ENDIF

  ! Count H-bonds by type
  I3CNT := 0
  I4CNT := 0
  ILCNT := 0
  NHBOND := 0
  DO I = 1, NRES
    DO J = I+3, NRES
      IF HBOND_MATRIX(I, J) = 1 THEN
        NHBOND := NHBOND + 1
        IF J - I = 3 THEN
          I3CNT := I3CNT + 1
        ELSEIF J - I = 4 THEN
          I4CNT := I4CNT + 1
        ELSE
          ILCNT := ILCNT + 1
        ENDIF
      ENDIF
    ENDDO
  ENDDO

  ! Energy accounting from current geometry
  E_MORSE := 0.0
  E_ANGLE := 0.0
  E_TORSION := 0.0
  E_HYDRO := 0.0

  ! Morse bond energy (backbone)
  DO I = 1, NRES-1
    DX := RES_X(I) - RES_X(I+1)
    DY := RES_Y(I) - RES_Y(I+1)
    DZ := RES_Z(I) - RES_Z(I+1)
    D := SQRT(DX*DX + DY*DY + DZ*DZ)
    G := EXP(-MORSE_A * (D - BACKBONE_R0))
    E_MORSE := E_MORSE + BACKBONE_D * (1.0 - G) * (1.0 - G)
  ENDDO

  ! Angle bending energy
  DO I = 2, NRES-1
    BX := RES_X(I-1) - RES_X(I)
    BY := RES_Y(I-1) - RES_Y(I)
    BZ := RES_Z(I-1) - RES_Z(I)
    CX := RES_X(I+1) - RES_X(I)
    CY := RES_Y(I+1) - RES_Y(I)
    CZ := RES_Z(I+1) - RES_Z(I)
    U_MAG := SQRT(BX*BX + BY*BY + BZ*BZ)
    V_MAG := SQRT(CX*CX + CY*CY + CZ*CZ)
    IF U_MAG > 1.0E-12 .AND. V_MAG > 1.0E-12 THEN
      COS_ANG := MAX(-1.0, MIN(1.0, (BX*CX + BY*CY + BZ*CZ) / (U_MAG * V_MAG)))
      E_ANGLE := E_ANGLE + RES_ANGK(I) * (COS_ANG - COS(RES_ANGT0(I)))**2
    ENDIF
  ENDDO

  ! Torsion energy from current geometry (matches 2*k*(1-cos(dphi)) force)
  DO I = 2, NRES-2
    B1X := RES_X(I) - RES_X(I-1)
    B1Y := RES_Y(I) - RES_Y(I-1)
    B1Z := RES_Z(I) - RES_Z(I-1)
    B2X := RES_X(I+1) - RES_X(I)
    B2Y := RES_Y(I+1) - RES_Y(I)
    B2Z := RES_Z(I+1) - RES_Z(I)
    B3X := RES_X(I+2) - RES_X(I+1)
    B3Y := RES_Y(I+2) - RES_Y(I+1)
    B3Z := RES_Z(I+2) - RES_Z(I+1)

    N1X := B1Y*B2Z - B1Z*B2Y
    N1Y := B1Z*B2X - B1X*B2Z
    N1Z := B1X*B2Y - B1Y*B2X
    N2X := B2Y*B3Z - B2Z*B3Y
    N2Y := B2Z*B3X - B2X*B3Z
    N2Z := B2X*B3Y - B2Y*B3X

    N1MAG2 := N1X*N1X + N1Y*N1Y + N1Z*N1Z
    N2MAG2 := N2X*N2X + N2Y*N2Y + N2Z*N2Z
    B2MAG := SQRT(B2X*B2X + B2Y*B2Y + B2Z*B2Z)

    IF N1MAG2 > 1.0E-12 .AND. N2MAG2 > 1.0E-12 .AND. B2MAG > 1.0E-12 THEN
      N1MAG := SQRT(N1MAG2)
      N2MAG := SQRT(N2MAG2)
      PHI_ACTUAL := ATAN2(B2MAG*(N1X*N2X + N1Y*N2Y + N1Z*N2Z), N1MAG*N2MAG)
      COS_DIFF := COS(PHI_ACTUAL - RES_TORSP0(I))
      E_TORSION := E_TORSION + 2.0 * RES_TORSK(I) * (1.0 - COS_DIFF)
    ENDIF
  ENDDO

  ! Hydrophobic energy corresponding to the attractive force (Cα-Cα)
  DO I = 1, NRES-4
    DO J = I+4, NRES
      IF RES_HYDRO(I) > 0.0 .AND. RES_HYDRO(J) > 0.0 THEN
        DX := RES_X(I) - RES_X(J)
        DY := RES_Y(I) - RES_Y(J)
        DZ := RES_Z(I) - RES_Z(J)
        D := SQRT(DX*DX + DY*DY + DZ*DZ)
        IF D < HYDRO_CUTOFF .AND. D > 0.0 THEN
          E_HYDRO := E_HYDRO - (HYDRO_STRENGTH / HYDRO_ALPHA) * RES_HYDRO(I) * RES_HYDRO(J) * &
                     EXP(-HYDRO_ALPHA * (D - HYDRO_R0))
        ENDIF
      ENDIF
    ENDDO
  ENDDO

  ! Go-like native contact energy (harmonic)
  E_NATIVE := 0.0
  DO I = 1, NRES-3
    DO J = I+3, NRES
      IF NATIVE_CONTACT(I, J) = 1 THEN
        DX := RES_X(I) - RES_X(J)
        DY := RES_Y(I) - RES_Y(J)
        DZ := RES_Z(I) - RES_Z(J)
        D := SQRT(DX*DX + DY*DY + DZ*DZ)
        IF D > 0.0 THEN
          E_NATIVE := E_NATIVE + NATIVE_K * (D - NATIVE_R0(I, J))**2
        ENDIF
      ENDIF
    ENDDO
  ENDDO

  RETURN
END

SUBROUTINE COMPUTE_RMSD()
  INTEGER :: I, J, ITER
  REAL :: XC, YC, ZC, XN, YN, ZN
  REAL :: SXX, SXY, SXZ, SYX, SYY, SYZ, SZX, SZY, SZZ
  REAL :: N44(4,4), VEC(4), NEWVEC(4), LAMBDA, NORM
  REAL :: G_CUR, G_NAT, SUM_DIST_SQ
  REAL :: RX, RY, RZ, NX, NY, NZ
  REAL :: Q0, Q1, Q2, Q3, QQ
  REAL :: R11, R12, R13, R21, R22, R23, R31, R32, R33
  REAL :: TX, TY, TZ

  ! Center current structure
  XC := 0.0
  YC := 0.0
  ZC := 0.0
  DO I = 1, NRES
    XC := XC + RES_X(I)
    YC := YC + RES_Y(I)
    ZC := ZC + RES_Z(I)
  ENDDO
  XC := XC / REAL(NRES)
  YC := YC / REAL(NRES)
  ZC := ZC / REAL(NRES)

  ! Center native structure
  XN := 0.0
  YN := 0.0
  ZN := 0.0
  DO I = 1, NRES
    XN := XN + NATIVE_X(I)
    YN := YN + NATIVE_Y(I)
    ZN := ZN + NATIVE_Z(I)
  ENDDO
  XN := XN / REAL(NRES)
  YN := YN / REAL(NRES)
  ZN := ZN / REAL(NRES)

  ! Compute covariance matrix S = sum(cur_i * nat_i^T)
  SXX := 0.0
  SXY := 0.0
  SXZ := 0.0
  SYX := 0.0
  SYY := 0.0
  SYZ := 0.0
  SZX := 0.0
  SZY := 0.0
  SZZ := 0.0
  G_CUR := 0.0
  G_NAT := 0.0
  DO I = 1, NRES
    RX := RES_X(I) - XC
    RY := RES_Y(I) - YC
    RZ := RES_Z(I) - ZC
    NX := NATIVE_X(I) - XN
    NY := NATIVE_Y(I) - YN
    NZ := NATIVE_Z(I) - ZN
    SXX := SXX + RX * NX
    SXY := SXY + RX * NY
    SXZ := SXZ + RX * NZ
    SYX := SYX + RY * NX
    SYY := SYY + RY * NY
    SYZ := SYZ + RY * NZ
    SZX := SZX + RZ * NX
    SZY := SZY + RZ * NY
    SZZ := SZZ + RZ * NZ
    G_CUR := G_CUR + RX*RX + RY*RY + RZ*RZ
    G_NAT := G_NAT + NX*NX + NY*NY + NZ*NZ
  ENDDO

  ! Build quaternion matrix N for Kabsch optimal rotation
  N44(1,1) := SXX + SYY + SZZ
  N44(1,2) := SYZ - SZY
  N44(1,3) := SZX - SXZ
  N44(1,4) := SXY - SYX
  N44(2,1) := SYZ - SZY
  N44(2,2) := SXX - SYY - SZZ
  N44(2,3) := SXY + SYX
  N44(2,4) := SXZ + SZX
  N44(3,1) := SZX - SXZ
  N44(3,2) := SXY + SYX
  N44(3,3) := -SXX + SYY - SZZ
  N44(3,4) := SYZ + SZY
  N44(4,1) := SXY - SYX
  N44(4,2) := SXZ + SZX
  N44(4,3) := SYZ + SZY
  N44(4,4) := -SXX - SYY + SZZ

  ! Power iteration for largest eigenvalue/eigenvector
  VEC(1) := 1.0
  VEC(2) := 0.0
  VEC(3) := 0.0
  VEC(4) := 0.0
  DO ITER = 1, 40
    NEWVEC(1) := N44(1,1)*VEC(1) + N44(1,2)*VEC(2) + N44(1,3)*VEC(3) + N44(1,4)*VEC(4)
    NEWVEC(2) := N44(2,1)*VEC(1) + N44(2,2)*VEC(2) + N44(2,3)*VEC(3) + N44(2,4)*VEC(4)
    NEWVEC(3) := N44(3,1)*VEC(1) + N44(3,2)*VEC(2) + N44(3,3)*VEC(3) + N44(3,4)*VEC(4)
    NEWVEC(4) := N44(4,1)*VEC(1) + N44(4,2)*VEC(2) + N44(4,3)*VEC(3) + N44(4,4)*VEC(4)
    NORM := SQRT(NEWVEC(1)*NEWVEC(1) + NEWVEC(2)*NEWVEC(2) + NEWVEC(3)*NEWVEC(3) + NEWVEC(4)*NEWVEC(4))
    IF NORM > 1.0E-12 THEN
      VEC(1) := NEWVEC(1) / NORM
      VEC(2) := NEWVEC(2) / NORM
      VEC(3) := NEWVEC(3) / NORM
      VEC(4) := NEWVEC(4) / NORM
    ENDIF
  ENDDO

  ! Rayleigh quotient for largest eigenvalue
  LAMBDA := VEC(1)*(N44(1,1)*VEC(1) + N44(1,2)*VEC(2) + N44(1,3)*VEC(3) + N44(1,4)*VEC(4)) + &
            VEC(2)*(N44(2,1)*VEC(1) + N44(2,2)*VEC(2) + N44(2,3)*VEC(3) + N44(2,4)*VEC(4)) + &
            VEC(3)*(N44(3,1)*VEC(1) + N44(3,2)*VEC(2) + N44(3,3)*VEC(3) + N44(3,4)*VEC(4)) + &
            VEC(4)*(N44(4,1)*VEC(1) + N44(4,2)*VEC(2) + N44(4,3)*VEC(3) + N44(4,4)*VEC(4))

  ! Build rotation matrix from unit quaternion eigenvector
  Q0 := VEC(1)
  Q1 := VEC(2)
  Q2 := VEC(3)
  Q3 := VEC(4)
  QQ := Q0*Q0 + Q1*Q1 + Q2*Q2 + Q3*Q3
  IF QQ > 1.0E-12 THEN
    QQ := SQRT(QQ)
    Q0 := Q0 / QQ
    Q1 := Q1 / QQ
    Q2 := Q2 / QQ
    Q3 := Q3 / QQ
  ENDIF
  R11 := Q0*Q0 + Q1*Q1 - Q2*Q2 - Q3*Q3
  R12 := 2.0*(Q1*Q2 - Q0*Q3)
  R13 := 2.0*(Q1*Q3 + Q0*Q2)
  R21 := 2.0*(Q1*Q2 + Q0*Q3)
  R22 := Q0*Q0 - Q1*Q1 + Q2*Q2 - Q3*Q3
  R23 := 2.0*(Q2*Q3 - Q0*Q1)
  R31 := 2.0*(Q1*Q3 - Q0*Q2)
  R32 := 2.0*(Q2*Q3 + Q0*Q1)
  R33 := Q0*Q0 - Q1*Q1 - Q2*Q2 + Q3*Q3

  ! RMSD after optimal rotation
  SUM_DIST_SQ := 0.0
  DO I = 1, NRES
    RX := RES_X(I) - XC
    RY := RES_Y(I) - YC
    RZ := RES_Z(I) - ZC
    TX := R11*RX + R12*RY + R13*RZ
    TY := R21*RX + R22*RY + R23*RZ
    TZ := R31*RX + R32*RY + R33*RZ
    NX := NATIVE_X(I) - XN
    NY := NATIVE_Y(I) - YN
    NZ := NATIVE_Z(I) - ZN
    SUM_DIST_SQ := SUM_DIST_SQ + (TX - NX)**2 + (TY - NY)**2 + (TZ - NZ)**2
  ENDDO
  RMSD_NATIVE := SQRT(SUM_DIST_SQ / REAL(NRES))

  RETURN
END
