// glsl_dump.comp — trig_identity harness: evaluate the shared GLSL f32
// sin/cos core (core/runtime/ergo_trig32.glsl) over the harness domain.
//
// Build: glslc -fshader-stage=comp -I core/runtime glsl_dump.comp -o glsl_dump.spv
// Run:   run_glsl glsl_dump.spv /tmp/trig32_domain.bin /tmp/trig32_glsl.bin <M>
#version 460
#extension GL_GOOGLE_include_directive : require
#include "ergo_trig32.glsl"

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer Dom { float d[]; };
layout(set = 0, binding = 1) writeonly buffer So { uint s[]; };
layout(set = 0, binding = 2) writeonly buffer Co { uint c[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= d.length()) return;
    vec2 sc = ergo_sincosf32(d[i]);
    s[i] = floatBitsToUint(sc.x);
    c[i] = floatBitsToUint(sc.y);
}
