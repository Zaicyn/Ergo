! gpu_particle_render.mcl - Particle sim with rendering
! Particles start at 0, velocities are a sine wave.
! Each frame: px(i) += vx(i) * DT
IMPLICIT NONE

INTEGER, PARAMETER :: N = 1024
REAL, PARAMETER :: DT = 0.001

REAL :: px(N), vx(N)
INTEGER :: i, FRAME

! Initialize
DO i = 1, N, 1
  px(i) := 0.0
  vx(i) := 1.0
ENDDO

! Time loop — 10000 frames
DO FRAME = 1, 10000, 1
  DO i = 1, N, 1
    px(i) := px(i) + vx(i) * DT
  ENDDO
ENDDO

PRINT px(1)
