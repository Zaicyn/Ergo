! WAVEFORM_BILAYER - Two-sheet amphiphilic bilayer simulation
! ===================================================================
! Two fixed populations of 128 atoms each, forming sheets at z = 0.5
! (layer 1) and z = 2.5 (layer 3). The 3D wavefield has a gap layer
! (layer 2). Intra-sheet Kuramoto coupling dominates; inter-sheet
! coupling weakly synchronizes the two sheets. Cross-link bonds only
! form between TAIL atoms across sheets. The field deposits amplitude
! and diffuses on a 6-connected 3D grid.

IMPLICIT NONE

! ── Grid dimensions ─────────────────────────────────────────
PARAMETER INTEGER :: NX = 32
PARAMETER INTEGER :: NY = 32
PARAMETER INTEGER :: NZ = 3

! ── Population ───────────────────────────────────────────────
PARAMETER INTEGER :: NATOM = 256
PARAMETER INTEGER :: NATOM_PER_SHEET = 128
PARAMETER INTEGER :: MAXFRAME = 1000

! ── Time stepping ────────────────────────────────────────────
PARAMETER REAL :: DT = 0.01
PARAMETER REAL :: BASE_OMEGA = 1.0
PARAMETER REAL :: K_INTRA = 5.0
PARAMETER REAL :: K_INTER = 1.0
PARAMETER REAL :: DAMPING = 0.01
PARAMETER REAL :: DIFFUSION = 0.1

! ── Curvature / orientation dynamics ─────────────────────────
PARAMETER REAL :: CURVATURE_STRENGTH = 0.05
PARAMETER REAL :: THERMAL_NOISE = 0.001
PARAMETER REAL :: VELOCITY_DAMP = 0.90

! ── Perturbation experiment flags ───────────────────────────
! 0 = none, 1 = remove central block in Sheet 1, 2 = flip types in Sheet 1,
! 3 = decouple sheets, 4 = partial flip (HEAD->TAIL only) in Sheet 1
PARAMETER INTEGER :: PERTURB_TYPE = 0
PARAMETER INTEGER :: PERTURB_FRAME = 300
PARAMETER INTEGER :: PERTURB_UNFLIP_FRAME = 0
PARAMETER REAL :: PERTURB_RADIUS = 5.0

! ── Bond detection ───────────────────────────────────────────
PARAMETER INTEGER :: MAXBOND = 2048
PARAMETER REAL :: BOND_DIST = 2.5
PARAMETER REAL :: CROSS_BOND_DIST = 3.5
PARAMETER REAL :: BOND_PHASE_THRESH = 0.95
PARAMETER REAL :: CROSS_PHASE_THRESH = 0.90
PARAMETER INTEGER :: MAX_BACKBONE = 2
PARAMETER INTEGER :: MAX_CROSS = 1

! ── Membrane type constants ──────────────────────────────────
PARAMETER INTEGER :: TYPE_HEAD = 1
PARAMETER INTEGER :: TYPE_TAIL = -1

! ── Wavefield grid ───────────────────────────────────────────
STATIC REAL :: FIELD_AMP(32, 32, 3)
STATIC REAL :: FIELD_PHI(32, 32, 3)
STATIC REAL :: FIELD_AMP_NEXT(32, 32, 3)

! ── Atom state ───────────────────────────────────────────────
STATIC REAL :: ATOM_X(256)
STATIC REAL :: ATOM_Y(256)
STATIC REAL :: ATOM_Z(256)
STATIC REAL :: ATOM_THETA(256)
STATIC REAL :: ATOM_OMEGA(256)
STATIC REAL :: ATOM_NX(256)
STATIC REAL :: ATOM_NY(256)
STATIC REAL :: ATOM_NZ(256)
STATIC REAL :: ATOM_NW(256)
STATIC INTEGER :: ATOM_TYPE(256)
STATIC INTEGER :: ATOM_SHEET(256)
STATIC INTEGER :: ATOM_ACTIVE(256)
STATIC INTEGER :: ATOM_FLIPPED(256)
STATIC REAL :: ATOM_VX(256)
STATIC REAL :: ATOM_VY(256)

! ── Diagnostics ────────────────────────────────────────────
STATIC INTEGER :: N_SHEET1
STATIC INTEGER :: N_SHEET2
STATIC REAL :: COHERENCE
STATIC REAL :: MEAN_GAP_AMP
STATIC INTEGER :: BILAYER_INTACT
STATIC INTEGER :: DECOUPLE_CROSS
STATIC INTEGER :: NBOND_BB
STATIC INTEGER :: NBOND_CROSS
STATIC INTEGER :: BB_BOND_I(2048)
STATIC INTEGER :: BB_BOND_J(2048)
STATIC INTEGER :: CROSS_BOND_I(2048)
STATIC INTEGER :: CROSS_BOND_J(2048)
STATIC INTEGER :: ATOM_DEGREE_BB(256)
STATIC INTEGER :: ATOM_DEGREE_CROSS(256)
STATIC INTEGER :: ATOM_PARENT_BOND(256)
STATIC INTEGER :: COMPONENT_SIZE(256)
STATIC INTEGER :: MAX_COMPONENT

! ── 6-connected neighbor offsets in 3D ─────────────────────
STATIC INTEGER :: DXI(6)
STATIC INTEGER :: DYJ(6)
STATIC INTEGER :: DZK(6)
DATA DXI / 1, -1, 0, 0, 0, 0 /
DATA DYJ / 0, 0, 1, -1, 0, 0 /
DATA DZK / 0, 0, 0, 0, 1, -1 /

! ── Working scalars ──────────────────────────────────────────
STATIC INTEGER :: I, J, K, IP, IM, JP, JM, DIR, NI, NJ, NK, AT, AT2, FRAME, N
STATIC INTEGER :: IX, IY, SHEET
STATIC REAL :: X, Y, Z, W, S, R, TH, D, WEIGHT, DIFF, AVG, RR
STATIC REAL :: SIN_AVG1, COS_AVG1, THETA_MEAN1, COHERENCE1
STATIC REAL :: SIN_AVG2, COS_AVG2, THETA_MEAN2, COHERENCE2
STATIC REAL :: SIN_AVG, COS_AVG, THETA_MEAN
STATIC REAL :: MEAN_W, FLOW_FRAC
STATIC REAL :: DXB, DYB, DZB, DISTB, DTHB
STATIC REAL :: CX, CY

! ── Initialize ───────────────────────────────────────────────
DECOUPLE_CROSS := 1
CALL INIT_OFFSETS()
CALL INIT_WAVEFIELD()
CALL INIT_ATOMS()

! CSV header
WRITE(*, "frame,n_sheet1,n_sheet2,coherence,nbond_bb,nbond_cross,max_component,mean_gap_amp,bilayer_intact")

! ════════════════════════════════════════════════════════════
! MAIN LOOP
! ════════════════════════════════════════════════════════════
DO FRAME = 1, MAXFRAME

  ! Compute Viviani normals from current atom phases
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      CALL SET_ATOM_NORMAL(AT)
    ENDIF
  ENDDO

  ! Atom phase advance + Kuramoto synchronization
  CALL ATOM_PHASE_STEP()

  ! Apply perturbation experiment to Sheet 1
  IF FRAME = PERTURB_FRAME THEN
    IF PERTURB_TYPE = 1 THEN
      CALL REMOVE_CENTRAL_BLOCK_SHEET1()
    ELSEIF PERTURB_TYPE = 2 THEN
      CALL FLIP_CENTRAL_TYPES_SHEET1()
    ELSEIF PERTURB_TYPE = 3 THEN
      DECOUPLE_CROSS := 0
    ELSEIF PERTURB_TYPE = 4 THEN
      CALL PARTIAL_FLIP_CENTRAL_TYPES_SHEET1()
    ENDIF
  ENDIF

  IF PERTURB_UNFLIP_FRAME > 0 .AND. FRAME = PERTURB_UNFLIP_FRAME THEN
    CALL UNFLIP_CENTRAL_TYPES_SHEET1()
  ENDIF

  ! Field deposition and diffusion
  CALL FIELD_STEP()

  ! Move atoms in-plane; z is fixed to the sheet plane
  CALL MOVE_ATOMS()

  ! Update both bond types and connected components
  CALL BOND_UPDATE()
  CALL COMPUTE_BOND_STATS()

  ! Output every 10 frames
  IF MOD(FRAME, 10) = 0 THEN
    CALL COUNT_SHEET_ATOMS()

    WRITE(*, "%d,%d,%d,%.6f,%d,%d,%d,%.6f,%d") &
      FRAME, N_SHEET1, N_SHEET2, COHERENCE, NBOND_BB, NBOND_CROSS, MAX_COMPONENT, &
      MEAN_GAP_AMP, BILAYER_INTACT
  ENDIF

ENDDO

STOP

! ════════════════════════════════════════════════════════════
! SUBROUTINES
! ════════════════════════════════════════════════════════════

SUBROUTINE INIT_OFFSETS()
  ! 6-connected neighbor offsets already set via DATA
  RETURN
END

SUBROUTINE INIT_WAVEFIELD()
  DO K = 1, NZ
    DO J = 1, NY
      DO I = 1, NX
        FIELD_AMP(I, J, K) := 0.0
        FIELD_PHI(I, J, K) := 0.0
        FIELD_AMP_NEXT(I, J, K) := 0.0
      ENDDO
    ENDDO
  ENDDO
  RETURN
END

SUBROUTINE INIT_ATOMS()
  INTEGER :: IX, IY, AT
  REAL :: STEP, OFFSET, TH0, WW

  STEP := 2.0
  OFFSET := 0.5

  ! Sheet 1: 16 x 8 lattice at z = 0.5 (deposits into field layer 1)
  DO AT = 1, NATOM_PER_SHEET
    ATOM_ACTIVE(AT) := 1
    ATOM_SHEET(AT) := 1
    ATOM_Z(AT) := 0.5
    ATOM_VX(AT) := 0.0
    ATOM_VY(AT) := 0.0
    ATOM_FLIPPED(AT) := 0

    IX := (AT - 1) / 8
    IY := MOD(AT - 1, 8)

    ATOM_X(AT) := OFFSET + REAL(IX) * STEP + 0.15 * SIN(REAL(AT) * 0.7)
    ATOM_Y(AT) := OFFSET + REAL(IY) * STEP + 0.15 * COS(REAL(AT) * 0.9)

    TH0 := 0.5 * ATOM_X(AT) + 0.7 * ATOM_Y(AT)
    ATOM_THETA(AT) := TH0
    ATOM_OMEGA(AT) := BASE_OMEGA + 0.5 * SIN(TH0)

    WW := (1.0 / 3.0) * SIN(5.0 * TH0)
    IF WW ≥ 0.0 THEN
      ATOM_TYPE(AT) := TYPE_HEAD
    ELSE
      ATOM_TYPE(AT) := TYPE_TAIL
    ENDIF
  ENDDO

  ! Sheet 2: 16 x 8 lattice at z = 2.5 (deposits into field layer 3), offset in x-y
  DO AT = NATOM_PER_SHEET + 1, NATOM
    ATOM_ACTIVE(AT) := 1
    ATOM_SHEET(AT) := 2
    ATOM_Z(AT) := 2.5
    ATOM_VX(AT) := 0.0
    ATOM_VY(AT) := 0.0
    ATOM_FLIPPED(AT) := 0

    IX := (AT - NATOM_PER_SHEET - 1) / 8
    IY := MOD(AT - NATOM_PER_SHEET - 1, 8)

    ATOM_X(AT) := OFFSET + 1.0 + REAL(IX) * STEP + 0.15 * SIN(REAL(AT) * 0.6)
    ATOM_Y(AT) := OFFSET + 1.0 + REAL(IY) * STEP + 0.15 * COS(REAL(AT) * 0.8)

    TH0 := 0.5 * ATOM_X(AT) + 0.7 * ATOM_Y(AT) + 1.0
    ATOM_THETA(AT) := TH0
    ATOM_OMEGA(AT) := BASE_OMEGA + 0.5 * SIN(TH0)

    WW := (1.0 / 3.0) * SIN(5.0 * TH0)
    IF WW ≥ 0.0 THEN
      ATOM_TYPE(AT) := TYPE_HEAD
    ELSE
      ATOM_TYPE(AT) := TYPE_TAIL
    ENDIF
  ENDDO

  RETURN
END

SUBROUTINE SET_ATOM_NORMAL(AT)
  INTEGER :: AT
  REAL :: TH, WW, SS, RR

  TH := ATOM_THETA(AT)
  WW := (1.0 / 3.0) * SIN(5.0 * TH)
  SS := SQRT(1.0 - WW * WW)

  ATOM_NX(AT) := SS * (SIN(TH) - 0.5 * SIN(3.0 * TH))
  ATOM_NY(AT) := SS * (-COS(TH) + 0.5 * COS(3.0 * TH))
  ATOM_NZ(AT) := SS * COS(TH) * COS(3.0 * TH)
  ATOM_NW(AT) := WW

  RR := SQRT(ATOM_NX(AT)*ATOM_NX(AT) + ATOM_NY(AT)*ATOM_NY(AT) + &
            ATOM_NZ(AT)*ATOM_NZ(AT) + ATOM_NW(AT)*ATOM_NW(AT))
  IF RR > 1.0E-12 THEN
    ATOM_NX(AT) := ATOM_NX(AT) / RR
    ATOM_NY(AT) := ATOM_NY(AT) / RR
    ATOM_NZ(AT) := ATOM_NZ(AT) / RR
    ATOM_NW(AT) := ATOM_NW(AT) / RR
  ENDIF
  RETURN
END

REAL FUNCTION DOT4(AX, AY, AZ, AW, BX, BY, BZ, BW)
  REAL :: AX, AY, AZ, AW, BX, BY, BZ, BW
  DOT4 := AX*BX + AY*BY + AZ*BZ + AW*BW
  RETURN DOT4
END

REAL FUNCTION ARCTAN_NORM(XX)
  REAL :: XX
  ARCTAN_NORM := (2.0 / 3.141592653589793) * ATAN(XX)
  RETURN ARCTAN_NORM
END

SUBROUTINE ATOM_PHASE_STEP()
  ! 1. Intrinsic phase advance
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      ATOM_THETA(AT) := ATOM_THETA(AT) + ATOM_OMEGA(AT) * DT
    ENDIF
  ENDDO

  ! 2. Compute per-sheet mean phases and coherence
  SIN_AVG1 := 0.0
  COS_AVG1 := 0.0
  SIN_AVG2 := 0.0
  COS_AVG2 := 0.0
  N_SHEET1 := 0
  N_SHEET2 := 0

  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      IF ATOM_SHEET(AT) = 1 THEN
        SIN_AVG1 := SIN_AVG1 + SIN(ATOM_THETA(AT))
        COS_AVG1 := COS_AVG1 + COS(ATOM_THETA(AT))
        N_SHEET1 := N_SHEET1 + 1
      ELSEIF ATOM_SHEET(AT) = 2 THEN
        SIN_AVG2 := SIN_AVG2 + SIN(ATOM_THETA(AT))
        COS_AVG2 := COS_AVG2 + COS(ATOM_THETA(AT))
        N_SHEET2 := N_SHEET2 + 1
      ENDIF
    ENDIF
  ENDDO

  IF N_SHEET1 > 0 THEN
    COHERENCE1 := SQRT(SIN_AVG1*SIN_AVG1 + COS_AVG1*COS_AVG1) / REAL(N_SHEET1)
    THETA_MEAN1 := ATAN2(SIN_AVG1, COS_AVG1)
  ELSE
    COHERENCE1 := 0.0
    THETA_MEAN1 := 0.0
  ENDIF

  IF N_SHEET2 > 0 THEN
    COHERENCE2 := SQRT(SIN_AVG2*SIN_AVG2 + COS_AVG2*COS_AVG2) / REAL(N_SHEET2)
    THETA_MEAN2 := ATAN2(SIN_AVG2, COS_AVG2)
  ELSE
    COHERENCE2 := 0.0
    THETA_MEAN2 := 0.0
  ENDIF

  ! Global coherence for diagnostics
  SIN_AVG := SIN_AVG1 + SIN_AVG2
  COS_AVG := COS_AVG1 + COS_AVG2
  N := N_SHEET1 + N_SHEET2
  IF N > 0 THEN
    COHERENCE := SQRT(SIN_AVG*SIN_AVG + COS_AVG*COS_AVG) / REAL(N)
  ELSE
    COHERENCE := 0.0
  ENDIF

  ! 3. Kuramoto coupling: intra-sheet strong, inter-sheet weak
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      IF ATOM_SHEET(AT) = 1 THEN
        ATOM_THETA(AT) := ATOM_THETA(AT) + &
          K_INTRA * SIN(THETA_MEAN1 - ATOM_THETA(AT)) * DT + &
          K_INTER * SIN(THETA_MEAN2 - ATOM_THETA(AT)) * DT
      ELSEIF ATOM_SHEET(AT) = 2 THEN
        ATOM_THETA(AT) := ATOM_THETA(AT) + &
          K_INTRA * SIN(THETA_MEAN2 - ATOM_THETA(AT)) * DT + &
          K_INTER * SIN(THETA_MEAN1 - ATOM_THETA(AT)) * DT
      ENDIF
    ENDIF
  ENDDO

  RETURN
END

SUBROUTINE FIELD_STEP()
  ! 1. Start from the current field amplitude
  DO K = 1, NZ
    DO J = 1, NY
      DO I = 1, NX
        FIELD_AMP_NEXT(I, J, K) := FIELD_AMP(I, J, K)
      ENDDO
    ENDDO
  ENDDO

  ! 2. Deposit atom amplitude and phase into the nearest grid cell
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      I := INT(ATOM_X(AT)) + 1
      J := INT(ATOM_Y(AT)) + 1
      K := INT(ATOM_Z(AT)) + 1
      IF I ≥ 1 .AND. I ≤ NX .AND. J ≥ 1 .AND. J ≤ NY .AND. K ≥ 1 .AND. K ≤ NZ THEN
        FIELD_AMP_NEXT(I, J, K) := FIELD_AMP_NEXT(I, J, K) + 1.0
        FIELD_PHI(I, J, K) := ATOM_THETA(AT)
      ENDIF
    ENDIF
  ENDDO

  ! 3. Diffuse amplitude through 6-connected neighbors
  DO K = 1, NZ
    DO J = 1, NY
      DO I = 1, NX
        AVG := 0.0
        DO DIR = 1, 6
          NI := I + DXI(DIR)
          NJ := J + DYJ(DIR)
          NK := K + DZK(DIR)

          ! Periodic in x and y
          IF NI < 1 THEN
            NI := NX
          ENDIF
          IF NI > NX THEN
            NI := 1
          ENDIF
          IF NJ < 1 THEN
            NJ := NY
          ENDIF
          IF NJ > NY THEN
            NJ := 1
          ENDIF

          ! Reflective in z: out-of-bound neighbor uses the current cell
          IF NK < 1 .OR. NK > NZ THEN
            NK := K
          ENDIF

          AVG := AVG + FIELD_AMP(NI, NJ, NK)
        ENDDO
        AVG := AVG / 6.0
        FIELD_AMP_NEXT(I, J, K) := FIELD_AMP_NEXT(I, J, K) + DIFFUSION * (AVG - FIELD_AMP(I, J, K))
      ENDDO
    ENDDO
  ENDDO

  ! 4. Apply uniform damping and commit
  DO K = 1, NZ
    DO J = 1, NY
      DO I = 1, NX
        FIELD_AMP(I, J, K) := FIELD_AMP_NEXT(I, J, K) * (1.0 - DAMPING)
      ENDDO
    ENDDO
  ENDDO

  RETURN
END

SUBROUTINE BOND_UPDATE()
  INTEGER :: I, J

  NBOND_BB := 0
  NBOND_CROSS := 0
  DO I = 1, NATOM
    ATOM_DEGREE_BB(I) := 0
    ATOM_DEGREE_CROSS(I) := 0
  ENDDO

  DO I = 1, NATOM - 1
    IF ATOM_ACTIVE(I) = 1 THEN
      DO J = I + 1, NATOM
        IF ATOM_ACTIVE(J) = 1 THEN
          DXB := ATOM_X(I) - ATOM_X(J)
          DYB := ATOM_Y(I) - ATOM_Y(J)
          DZB := ATOM_Z(I) - ATOM_Z(J)
          DISTB := SQRT(DXB*DXB + DYB*DYB + DZB*DZB)
          DTHB := ATOM_THETA(I) - ATOM_THETA(J)

          IF ATOM_SHEET(I) = ATOM_SHEET(J) THEN
            ! Backbone bond: same sheet, same type, distance and phase criteria
            IF ATOM_TYPE(I) = ATOM_TYPE(J) THEN
              IF DISTB < BOND_DIST .AND. COS(DTHB) > BOND_PHASE_THRESH .AND. &
                 ATOM_DEGREE_BB(I) < MAX_BACKBONE .AND. ATOM_DEGREE_BB(J) < MAX_BACKBONE THEN
                NBOND_BB := NBOND_BB + 1
                IF NBOND_BB > MAXBOND THEN
                  NBOND_BB := MAXBOND
                  RETURN
                ENDIF
                BB_BOND_I(NBOND_BB) := I
                BB_BOND_J(NBOND_BB) := J
                ATOM_DEGREE_BB(I) := ATOM_DEGREE_BB(I) + 1
                ATOM_DEGREE_BB(J) := ATOM_DEGREE_BB(J) + 1
              ENDIF
            ENDIF
          ELSE
            ! Cross-link bond: different sheets, both TAIL, distance and phase criteria
            IF DECOUPLE_CROSS = 1 THEN
              IF ATOM_TYPE(I) = TYPE_TAIL .AND. ATOM_TYPE(J) = TYPE_TAIL THEN
                IF DISTB < CROSS_BOND_DIST .AND. COS(DTHB) > CROSS_PHASE_THRESH .AND. &
                   ATOM_DEGREE_CROSS(I) < MAX_CROSS .AND. ATOM_DEGREE_CROSS(J) < MAX_CROSS THEN
                  NBOND_CROSS := NBOND_CROSS + 1
                  IF NBOND_CROSS > MAXBOND THEN
                    NBOND_CROSS := MAXBOND
                    RETURN
                  ENDIF
                  CROSS_BOND_I(NBOND_CROSS) := I
                  CROSS_BOND_J(NBOND_CROSS) := J
                  ATOM_DEGREE_CROSS(I) := ATOM_DEGREE_CROSS(I) + 1
                  ATOM_DEGREE_CROSS(J) := ATOM_DEGREE_CROSS(J) + 1
                ENDIF
              ENDIF
            ENDIF
          ENDIF

        ENDIF
      ENDDO
    ENDIF
  ENDDO
  RETURN
END

SUBROUTINE COMPUTE_BOND_STATS()
  INTEGER :: I, J, R, RI, RJ, IT, IT2, TOTAL_BONDS

  ! Union-find over all bonds (backbone + cross-link)
  DO IT = 1, NATOM
    ATOM_PARENT_BOND(IT) := IT
  ENDDO

  DO IT = 1, NBOND_BB
    I := BB_BOND_I(IT)
    J := BB_BOND_J(IT)

    R := I
    DO IT2 = 1, NATOM
      IF ATOM_PARENT_BOND(R) > R .OR. ATOM_PARENT_BOND(R) < R THEN
        R := ATOM_PARENT_BOND(R)
      ENDIF
    ENDDO
    RI := R

    R := J
    DO IT2 = 1, NATOM
      IF ATOM_PARENT_BOND(R) > R .OR. ATOM_PARENT_BOND(R) < R THEN
        R := ATOM_PARENT_BOND(R)
      ENDIF
    ENDDO
    RJ := R

    IF RI > RJ .OR. RI < RJ THEN
      ATOM_PARENT_BOND(RI) := RJ
    ENDIF
  ENDDO

  DO IT = 1, NBOND_CROSS
    I := CROSS_BOND_I(IT)
    J := CROSS_BOND_J(IT)

    R := I
    DO IT2 = 1, NATOM
      IF ATOM_PARENT_BOND(R) > R .OR. ATOM_PARENT_BOND(R) < R THEN
        R := ATOM_PARENT_BOND(R)
      ENDIF
    ENDDO
    RI := R

    R := J
    DO IT2 = 1, NATOM
      IF ATOM_PARENT_BOND(R) > R .OR. ATOM_PARENT_BOND(R) < R THEN
        R := ATOM_PARENT_BOND(R)
      ENDIF
    ENDDO
    RJ := R

    IF RI > RJ .OR. RI < RJ THEN
      ATOM_PARENT_BOND(RI) := RJ
    ENDIF
  ENDDO

  ! Count component sizes
  DO IT = 1, NATOM
    COMPONENT_SIZE(IT) := 0
  ENDDO
  DO IT = 1, NATOM
    IF ATOM_ACTIVE(IT) = 1 THEN
      R := IT
      DO IT2 = 1, NATOM
        IF ATOM_PARENT_BOND(R) > R .OR. ATOM_PARENT_BOND(R) < R THEN
          R := ATOM_PARENT_BOND(R)
        ENDIF
      ENDDO
      COMPONENT_SIZE(R) := COMPONENT_SIZE(R) + 1
    ENDIF
  ENDDO

  MAX_COMPONENT := 0
  DO IT = 1, NATOM
    IF COMPONENT_SIZE(IT) > MAX_COMPONENT THEN
      MAX_COMPONENT := COMPONENT_SIZE(IT)
    ENDIF
  ENDDO

  ! Mean gap amplitude (layer 2)
  MEAN_GAP_AMP := 0.0
  DO J = 1, NY
    DO I = 1, NX
      MEAN_GAP_AMP := MEAN_GAP_AMP + FIELD_AMP(I, J, 2)
    ENDDO
  ENDDO
  MEAN_GAP_AMP := MEAN_GAP_AMP / REAL(NX * NY)

  ! Bilayer integrity flag
  IF N_SHEET1 > 100 .AND. N_SHEET2 > 100 .AND. NBOND_CROSS > 50 THEN
    BILAYER_INTACT := 1
  ELSE
    BILAYER_INTACT := 0
  ENDIF

  RETURN
END

SUBROUTINE COUNT_SHEET_ATOMS()
  INTEGER :: AT
  N_SHEET1 := 0
  N_SHEET2 := 0
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      IF ATOM_SHEET(AT) = 1 THEN
        N_SHEET1 := N_SHEET1 + 1
      ELSEIF ATOM_SHEET(AT) = 2 THEN
        N_SHEET2 := N_SHEET2 + 1
      ENDIF
    ENDIF
  ENDDO
  RETURN
END

SUBROUTINE REMOVE_CENTRAL_BLOCK_SHEET1()
  ! Deactivate Sheet 1 atoms inside a circular hole at the center of the plane.
  INTEGER :: AT, COUNT
  REAL :: CX, CY, DXB, DYB, DISTB

  CX := REAL(NX) / 2.0
  CY := REAL(NY) / 2.0
  COUNT := 0

  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 .AND. ATOM_SHEET(AT) = 1 THEN
      DXB := ATOM_X(AT) - CX
      DYB := ATOM_Y(AT) - CY
      DISTB := SQRT(DXB*DXB + DYB*DYB)
      IF DISTB < PERTURB_RADIUS THEN
        ATOM_ACTIVE(AT) := 0
        COUNT := COUNT + 1
      ENDIF
    ENDIF
  ENDDO

  RETURN
END

SUBROUTINE FLIP_CENTRAL_TYPES_SHEET1()
  ! Invert amphiphilic type for Sheet 1 atoms inside a circular central region.
  INTEGER :: AT, COUNT
  REAL :: CX, CY, DXB, DYB, DISTB

  CX := REAL(NX) / 2.0
  CY := REAL(NY) / 2.0
  COUNT := 0

  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 .AND. ATOM_SHEET(AT) = 1 THEN
      DXB := ATOM_X(AT) - CX
      DYB := ATOM_Y(AT) - CY
      DISTB := SQRT(DXB*DXB + DYB*DYB)
      IF DISTB < PERTURB_RADIUS THEN
        ATOM_TYPE(AT) := -ATOM_TYPE(AT)
        ATOM_FLIPPED(AT) := 1
        COUNT := COUNT + 1
      ENDIF
    ENDIF
  ENDDO

  RETURN
END

SUBROUTINE PARTIAL_FLIP_CENTRAL_TYPES_SHEET1()
  ! Flip only HEAD -> TAIL in Sheet 1 atoms inside a circular central region.
  INTEGER :: AT, COUNT
  REAL :: CX, CY, DXB, DYB, DISTB

  CX := REAL(NX) / 2.0
  CY := REAL(NY) / 2.0
  COUNT := 0

  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 .AND. ATOM_SHEET(AT) = 1 THEN
      DXB := ATOM_X(AT) - CX
      DYB := ATOM_Y(AT) - CY
      DISTB := SQRT(DXB*DXB + DYB*DYB)
      IF DISTB < PERTURB_RADIUS THEN
        IF ATOM_TYPE(AT) = TYPE_HEAD THEN
          ATOM_TYPE(AT) := TYPE_TAIL
          ATOM_FLIPPED(AT) := 1
          COUNT := COUNT + 1
        ENDIF
      ENDIF
    ENDIF
  ENDDO

  RETURN
END

SUBROUTINE UNFLIP_CENTRAL_TYPES_SHEET1()
  ! Restore any Sheet 1 atoms that were previously flipped.
  INTEGER :: AT, COUNT

  COUNT := 0
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 .AND. ATOM_SHEET(AT) = 1 THEN
      IF ATOM_FLIPPED(AT) = 1 THEN
        ATOM_TYPE(AT) := -ATOM_TYPE(AT)
        ATOM_FLIPPED(AT) := 0
        COUNT := COUNT + 1
      ENDIF
    ENDIF
  ENDDO

  RETURN
END

SUBROUTINE MOVE_ATOMS()
  ! In-plane motion driven by amphiphilic curvature preference + thermal noise.
  ! z remains fixed at the sheet plane.
  INTEGER :: AT, COUNT
  REAL :: DX, DY, R, FORCE, RANDX, RANDY

  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      DX := ATOM_X(AT) - REAL(NX) / 2.0
      DY := ATOM_Y(AT) - REAL(NY) / 2.0
      R := SQRT(DX*DX + DY*DY)
      IF R > 1.0E-12 THEN
        ! HEAD (+1) driven outward, TAIL (-1) inward
        FORCE := CURVATURE_STRENGTH * ATOM_TYPE(AT)
        ATOM_VX(AT) := ATOM_VX(AT) + FORCE * (DX / R) * DT
        ATOM_VY(AT) := ATOM_VY(AT) + FORCE * (DY / R) * DT
      ENDIF

      ! Deterministic thermal noise
      RANDX := SIN(REAL(AT) * 7.3 + REAL(FRAME) * 0.17)
      RANDY := COS(REAL(AT) * 5.7 + REAL(FRAME) * 0.31)
      ATOM_VX(AT) := ATOM_VX(AT) + THERMAL_NOISE * RANDX * DT
      ATOM_VY(AT) := ATOM_VY(AT) + THERMAL_NOISE * RANDY * DT

      ! Velocity damping
      ATOM_VX(AT) := ATOM_VX(AT) * VELOCITY_DAMP
      ATOM_VY(AT) := ATOM_VY(AT) * VELOCITY_DAMP

      ! Update position
      ATOM_X(AT) := ATOM_X(AT) + ATOM_VX(AT) * DT
      ATOM_Y(AT) := ATOM_Y(AT) + ATOM_VY(AT) * DT

      ! Hard-wall boundaries in x and y
      IF ATOM_X(AT) < 0.0 THEN
        ATOM_X(AT) := 0.0
        ATOM_VX(AT) := -ATOM_VX(AT)
      ENDIF
      IF ATOM_X(AT) > REAL(NX) THEN
        ATOM_X(AT) := REAL(NX)
        ATOM_VX(AT) := -ATOM_VX(AT)
      ENDIF
      IF ATOM_Y(AT) < 0.0 THEN
        ATOM_Y(AT) := 0.0
        ATOM_VY(AT) := -ATOM_VY(AT)
      ENDIF
      IF ATOM_Y(AT) > REAL(NY) THEN
        ATOM_Y(AT) := REAL(NY)
        ATOM_VY(AT) := -ATOM_VY(AT)
      ENDIF
    ENDIF
  ENDDO

  RETURN
END
