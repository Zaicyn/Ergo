! WAVEFORM_MOLECULE_DYNAMICS_GEOMETRIC - pure geometric force field
! =====================================================================
! 32 atoms in a 4x4x2 lattice. Each atom carries a phase and an element
! type (C/H/O/N) derived from its initial Viviani w-component. Bonds form,
! break, and reform based on distance, phase alignment, and local stress.
! Element-specific valence limits prevent overbonding.
!
! GEOMETRIC VARIANT: all interactions are classical geometry.
!   1. Morse potential sign FIXED: energy now has its minimum (-D) at the
!      equilibrium distance (previous version was inverted - a maximum at
!      r0, so "annealing" was really bond stretching toward the cutoff).
!   2. Spectral Zeff/electronegativity/period factors REMOVED. Bond wells
!      come from pure geometric combining rules:
!        r0(A,B,BO) = (rA + rB) * (1 - BO_SHORTEN*(BO-1))
!        D(A,B,BO)  = sqrt(D_AA * D_BB) * (1 + 0.8*(BO-1))
!      with homonuclear single-bond depths D_AA scaled to C-C ~ 1.0.
!   3. Three-body angle bending added: E = k*(cos(t) - cos(t0))^2 with
!      hybridization targets (C tetrahedral 109.47, N pyramidal 107.3,
!      O bent 104.45). This is what makes the chemistry *geometric*:
!      local shape is now part of the energy, not just pairwise distance.
!   4. Non-bonded steric repulsion uses per-pair sigma from covalent radii.
!   5. FORCE_SCALE multiplies Morse+angle impulses: the integrator was too
!      sluggish to relax within a 100-frame cool window; 6.0 lets bonds
!      reach equilibrium (mean |r-r0| ~ 0.06) without destabilizing.
!
! CSV output: frame,nbond,total_energy,mean_energy,max_energy,n_breaks, &
!             n_reforms,fingerprint,total_strength,coherence,mean_w,rgyr, &
!             thermal,e_angle,ang_rmse, &
!             deg0,deg1,deg2,deg3,deg4,max_component,n_fragments

IMPLICIT NONE

! ── Grid / population ───────────────────────────────────────
PARAMETER INTEGER :: NATOM = 32
PARAMETER INTEGER :: MAXBOND = 256
PARAMETER INTEGER :: MAXFRAME = 1500
PARAMETER INTEGER :: NX = 8
PARAMETER INTEGER :: NY = 8
PARAMETER INTEGER :: NZ = 4

! ── Time stepping / coupling ──────────────────────────────────
PARAMETER REAL :: DT = 0.01
PARAMETER REAL :: BASE_OMEGA = 1.0
PARAMETER REAL :: COUPLING_K = 5.0
PARAMETER REAL :: PHASE_NOISE_SCALE = 10.0
PARAMETER REAL :: VELOCITY_DAMP = 0.9
PARAMETER REAL :: FORCE_SCALE = 6.0

! ── Initial-condition seed ──────────────────────────────────
PARAMETER REAL :: SEED = 0.0

! ── Five repeated heat/cool cycles + final anneal ─────────────
PARAMETER REAL :: HEAT_START = 0.001
PARAMETER REAL :: HEAT_PEAK = 1.0
PARAMETER INTEGER :: CYCLE1_HEAT_START = 200
PARAMETER INTEGER :: CYCLE1_HEAT_END = 300
PARAMETER INTEGER :: CYCLE1_COOL_END = 400
PARAMETER INTEGER :: CYCLE2_HEAT_END = 500
PARAMETER INTEGER :: CYCLE2_COOL_END = 600
PARAMETER INTEGER :: CYCLE3_HEAT_END = 700
PARAMETER INTEGER :: CYCLE3_COOL_END = 800
PARAMETER INTEGER :: CYCLE4_HEAT_END = 900
PARAMETER INTEGER :: CYCLE4_COOL_END = 1000
PARAMETER INTEGER :: CYCLE5_HEAT_END = 1100
PARAMETER INTEGER :: CYCLE5_COOL_END = 1200

! ── Element type indices and valence ───────────────────────────
PARAMETER INTEGER :: ELEM_C = 1
PARAMETER INTEGER :: ELEM_H = 2
PARAMETER INTEGER :: ELEM_O = 3
PARAMETER INTEGER :: ELEM_N = 4
PARAMETER INTEGER :: NELEM = 4

! ── Bond criteria ──────────────────────────────────────────────
PARAMETER REAL :: BOND_DIST = 2.5
PARAMETER REAL :: BOND_ORDER_HIGH = 1.5
PARAMETER REAL :: BOND_ORDER_SINGLE = 1.0
PARAMETER REAL :: PHASE_HIGH = 0.95
PARAMETER REAL :: PHASE_SINGLE = 0.80
PARAMETER REAL :: STRESS_BREAK = 0.05
PARAMETER REAL :: STRESS_REFORM = 0.18

! ── Morse potential ───────────────────────────────────────────
PARAMETER REAL :: MORSE_A = 1.0
! Higher bond order pulls the equilibrium distance shorter
PARAMETER REAL :: BO_SHORTEN = 0.12

! ── Steric repulsion (non-bonded pairs only) ───────────────────
PARAMETER REAL :: REPULSION_EPSILON = 0.1
PARAMETER REAL :: STERIC_SCALE = 0.9
PARAMETER REAL :: REPULSION_CUTOFF = 2.5

! ── Element properties (pure geometry) ─────────────────────────
STATIC INTEGER :: ELEM_MAX_DEGREE(4)
STATIC REAL :: ELEM_RADIUS(4)
STATIC REAL :: ELEM_DHOMO(4)
STATIC REAL :: ELEM_ANGK(4)
STATIC REAL :: ELEM_COS0(4)

! ── Atom state ────────────────────────────────────────────────
STATIC REAL :: ATOM_X(32)
STATIC REAL :: ATOM_Y(32)
STATIC REAL :: ATOM_Z(32)
STATIC REAL :: ATOM_VX(32)
STATIC REAL :: ATOM_VY(32)
STATIC REAL :: ATOM_VZ(32)
STATIC REAL :: ATOM_THETA(32)
STATIC REAL :: ATOM_OMEGA(32)
STATIC REAL :: ATOM_NW(32)
STATIC INTEGER :: ATOM_ELEMENT(32)
STATIC INTEGER :: ATOM_ACTIVE(32)
STATIC INTEGER :: ATOM_DEGREE(32)

! ── Dynamic bond state ─────────────────────────────────────────
STATIC INTEGER :: BOND_MATRIX(32, 32)
STATIC REAL :: ALIGN_PREV(32, 32)
STATIC REAL :: ALIGN_CURR(32, 32)

! ── Bond list (snapshot of active bonds each frame) ───────────
STATIC INTEGER :: NBOND
STATIC INTEGER :: BOND_I(256)
STATIC INTEGER :: BOND_J(256)
STATIC REAL :: BOND_ORDER(256)
STATIC REAL :: BOND_ENERGY(256)
STATIC REAL :: BOND_STRENGTH(256)
STATIC REAL :: BOND_EQDIST(256)

! ── Diagnostics ────────────────────────────────────────────────
STATIC REAL :: TOTAL_POTENTIAL_ENERGY
STATIC REAL :: MEAN_POTENTIAL_ENERGY
STATIC REAL :: MAX_POTENTIAL_ENERGY
STATIC REAL :: TOTAL_BOND_STRENGTH
STATIC REAL :: COHERENCE
STATIC REAL :: MEAN_W
STATIC REAL :: RGYR
STATIC REAL :: THERMAL_CURRENT
STATIC REAL :: E_ANGLE
STATIC REAL :: ANG_DEV_SQ
STATIC REAL :: ANG_RMSE
STATIC INTEGER :: N_ANGLE
STATIC INTEGER :: N_BOND_BREAKS
STATIC INTEGER :: N_BOND_REFORM
STATIC INTEGER :: FINGERPRINT
STATIC INTEGER :: DEG0
STATIC INTEGER :: DEG1
STATIC INTEGER :: DEG2
STATIC INTEGER :: DEG3
STATIC INTEGER :: DEG4
STATIC INTEGER :: MAX_COMPONENT
STATIC INTEGER :: N_FRAGMENTS

! ── Working scalars ───────────────────────────────────────────
STATIC INTEGER :: I, J, K, AT, FRAME, N
STATIC REAL :: X, Y, Z, W, TH, DTH, DX, DY, DZ, DIST, WEIGHT
STATIC REAL :: SIN_AVG, COS_AVG, THETA_MEAN

! ── Initialize ─────────────────────────────────────────────────
CALL INIT_ELEMENTS()
CALL INIT_ATOMS()
CALL INIT_BONDS()

! CSV header
WRITE(*, "frame,nbond,total_energy,mean_energy,max_energy,n_breaks, &
            n_reforms,fingerprint,total_strength,coherence,mean_w,rgyr, &
            thermal,e_angle,ang_rmse, &
            deg0,deg1,deg2,deg3,deg4,max_component,n_fragments")

! ════════════════════════════════════════════════════════════
! MAIN LOOP
! ════════════════════════════════════════════════════════════
FRAME := 1
DO WHILE FRAME ≤ MAXFRAME

  CALL COMPUTE_THERMAL()
  CALL ATOM_PHASE_STEP()
  CALL MOVE_ATOMS()
  CALL BOND_UPDATE()
  CALL COMPUTE_BOND_STATS()
  CALL COMPUTE_RGYR()

  ! Mean |w| over active atoms
  MEAN_W := 0.0
  N := 0
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      MEAN_W := MEAN_W + ABS(ATOM_NW(AT))
      N := N + 1
    ENDIF
  ENDDO
  IF N > 0 THEN
    MEAN_W := MEAN_W / REAL(N)
  ENDIF

  IF MOD(FRAME, 10) = 0 THEN
    WRITE(*, "%d,%d,%.6f,%.6f,%.6f,%d,%d,%d,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%d,%d,%d,%d,%d,%d,%d") &
      FRAME, NBOND, TOTAL_POTENTIAL_ENERGY, MEAN_POTENTIAL_ENERGY, &
      MAX_POTENTIAL_ENERGY, N_BOND_BREAKS, N_BOND_REFORM, FINGERPRINT, &
      TOTAL_BOND_STRENGTH, COHERENCE, MEAN_W, RGYR, THERMAL_CURRENT, &
      E_ANGLE, ANG_RMSE, &
      DEG0, DEG1, DEG2, DEG3, DEG4, MAX_COMPONENT, N_FRAGMENTS
  ENDIF

  FRAME := FRAME + 1
ENDDO

STOP

! ════════════════════════════════════════════════════════════
! SUBROUTINES
! ════════════════════════════════════════════════════════════

SUBROUTINE INIT_ELEMENTS()
  ! C: valence 4, tetrahedral target
  ELEM_MAX_DEGREE(1) := 4
  ELEM_RADIUS(1) := 0.76
  ELEM_DHOMO(1) := 1.00
  ELEM_ANGK(1) := 0.35
  ELEM_COS0(1) := -0.3333333
  ! H: valence 1, no angle term possible
  ELEM_MAX_DEGREE(2) := 1
  ELEM_RADIUS(2) := 0.31
  ELEM_DHOMO(2) := 1.25
  ELEM_ANGK(2) := 0.00
  ELEM_COS0(2) := 0.0
  ! O: valence 2, bent target (104.45 deg)
  ELEM_MAX_DEGREE(3) := 2
  ELEM_RADIUS(3) := 0.66
  ELEM_DHOMO(3) := 0.42
  ELEM_ANGK(3) := 0.25
  ELEM_COS0(3) := -0.2499
  ! N: valence 3, pyramidal target (107.3 deg)
  ELEM_MAX_DEGREE(4) := 3
  ELEM_RADIUS(4) := 0.71
  ELEM_DHOMO(4) := 0.46
  ELEM_ANGK(4) := 0.30
  ELEM_COS0(4) := -0.2987
  RETURN
END

SUBROUTINE INIT_ATOMS()
  INTEGER :: IX, IY, IZ, AT
  REAL :: STEP, OFFSET, TH0, WW

  STEP := 2.0
  OFFSET := 0.5

  AT := 0
  DO IZ = 1, 2
    DO IY = 1, 4
      DO IX = 1, 4
        AT := AT + 1
        ATOM_ACTIVE(AT) := 1
        ATOM_DEGREE(AT) := 0
        ATOM_VX(AT) := 0.0
        ATOM_VY(AT) := 0.0
        ATOM_VZ(AT) := 0.0

        ATOM_X(AT) := OFFSET + REAL(IX - 1) * STEP
        ATOM_Y(AT) := OFFSET + REAL(IY - 1) * STEP
        ATOM_Z(AT) := OFFSET + REAL(IZ - 1) * STEP

        ! Spatially varying initial phase, shifted by seed
        TH0 := 0.3 * ATOM_X(AT) + 0.5 * ATOM_Y(AT) + 0.7 * ATOM_Z(AT) + SEED
        ATOM_THETA(AT) := TH0
        ATOM_OMEGA(AT) := BASE_OMEGA + 0.5 * SIN(TH0)

        ! Viviani w-component determines element type
        WW := (1.0 / 3.0) * SIN(5.0 * TH0)
        ATOM_NW(AT) := WW
        IF WW ≥ 0.15 THEN
          ATOM_ELEMENT(AT) := ELEM_C
        ELSEIF WW ≥ 0.0 THEN
          ATOM_ELEMENT(AT) := ELEM_H
        ELSEIF WW ≥ -0.15 THEN
          ATOM_ELEMENT(AT) := ELEM_O
        ELSE
          ATOM_ELEMENT(AT) := ELEM_N
        ENDIF
      ENDDO
    ENDDO
  ENDDO
  RETURN
END

SUBROUTINE INIT_BONDS()
  INTEGER :: EI, EJ
  REAL :: TH0, WW, DTH0, ALIGN0

  DO I = 1, NATOM
    ATOM_DEGREE(I) := 0
    DO J = 1, NATOM
      BOND_MATRIX(I, J) := 0
      ALIGN_PREV(I, J) := 0.0
      ALIGN_CURR(I, J) := 0.0
    ENDDO
  ENDDO

  ! Seed previous alignment from initial phases so first-frame stress is real
  DO I = 1, NATOM - 1
    DO J = I + 1, NATOM
      DTH0 := ATOM_THETA(I) - ATOM_THETA(J)
      ALIGN_PREV(I, J) := COS(DTH0)
    ENDDO
  ENDDO
  RETURN
END

SUBROUTINE COMPUTE_THERMAL()
  IF FRAME < CYCLE1_HEAT_START THEN
    THERMAL_CURRENT := HEAT_START
  ELSEIF FRAME < CYCLE1_HEAT_END THEN
    THERMAL_CURRENT := HEAT_START + (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE1_HEAT_START) / REAL(CYCLE1_HEAT_END - CYCLE1_HEAT_START)
  ELSEIF FRAME < CYCLE1_COOL_END THEN
    THERMAL_CURRENT := HEAT_PEAK - (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE1_HEAT_END) / REAL(CYCLE1_COOL_END - CYCLE1_HEAT_END)
  ELSEIF FRAME < CYCLE2_HEAT_END THEN
    THERMAL_CURRENT := HEAT_START + (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE1_COOL_END) / REAL(CYCLE2_HEAT_END - CYCLE1_COOL_END)
  ELSEIF FRAME < CYCLE2_COOL_END THEN
    THERMAL_CURRENT := HEAT_PEAK - (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE2_HEAT_END) / REAL(CYCLE2_COOL_END - CYCLE2_HEAT_END)
  ELSEIF FRAME < CYCLE3_HEAT_END THEN
    THERMAL_CURRENT := HEAT_START + (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE2_COOL_END) / REAL(CYCLE3_HEAT_END - CYCLE2_COOL_END)
  ELSEIF FRAME < CYCLE3_COOL_END THEN
    THERMAL_CURRENT := HEAT_PEAK - (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE3_HEAT_END) / REAL(CYCLE3_COOL_END - CYCLE3_HEAT_END)
  ELSEIF FRAME < CYCLE4_HEAT_END THEN
    THERMAL_CURRENT := HEAT_START + (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE3_COOL_END) / REAL(CYCLE4_HEAT_END - CYCLE3_COOL_END)
  ELSEIF FRAME < CYCLE4_COOL_END THEN
    THERMAL_CURRENT := HEAT_PEAK - (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE4_HEAT_END) / REAL(CYCLE4_COOL_END - CYCLE4_HEAT_END)
  ELSEIF FRAME < CYCLE5_HEAT_END THEN
    THERMAL_CURRENT := HEAT_START + (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE4_COOL_END) / REAL(CYCLE5_HEAT_END - CYCLE4_COOL_END)
  ELSEIF FRAME < CYCLE5_COOL_END THEN
    THERMAL_CURRENT := HEAT_PEAK - (HEAT_PEAK - HEAT_START) * &
      REAL(FRAME - CYCLE5_HEAT_END) / REAL(CYCLE5_COOL_END - CYCLE5_HEAT_END)
  ELSE
    THERMAL_CURRENT := HEAT_START
  ENDIF
  RETURN
END

SUBROUTINE ATOM_PHASE_STEP()
  ! Intrinsic phase advance
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      ATOM_THETA(AT) := ATOM_THETA(AT) + ATOM_OMEGA(AT) * DT
    ENDIF
  ENDDO

  ! Global Kuramoto synchronization toward mean phase
  SIN_AVG := 0.0
  COS_AVG := 0.0
  N := 0
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      SIN_AVG := SIN_AVG + SIN(ATOM_THETA(AT))
      COS_AVG := COS_AVG + COS(ATOM_THETA(AT))
      N := N + 1
    ENDIF
  ENDDO

  IF N > 0 THEN
    COHERENCE := SQRT(SIN_AVG*SIN_AVG + COS_AVG*COS_AVG) / REAL(N)
    THETA_MEAN := ATAN2(SIN_AVG, COS_AVG)
    DO AT = 1, NATOM
      IF ATOM_ACTIVE(AT) = 1 THEN
        ATOM_THETA(AT) := ATOM_THETA(AT) + COUPLING_K * SIN(THETA_MEAN - ATOM_THETA(AT)) * DT
      ENDIF
    ENDDO
  ELSE
    COHERENCE := 0.0
  ENDIF

  ! Phase thermal noise: strong during heating, weak during cooling
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      ATOM_THETA(AT) := ATOM_THETA(AT) + &
        PHASE_NOISE_SCALE * THERMAL_CURRENT * SIN(REAL(AT) * 11.3 + REAL(FRAME) * 0.23) * DT
    ENDIF
  ENDDO
  RETURN
END

SUBROUTINE MOVE_ATOMS()
  ! Thermal jitter, non-bonded steric repulsion, Morse bond forces,
  ! and three-body angle forces all act as velocity impulses
  ! before damping and position update.
  REAL :: SR, SR2, SR6, FM, FX, FY, FZ, SIG_PAIR
  REAL :: RDIFF, EXP_TERM, MORSE_FORCE
  INTEGER :: II, JJ, KK

  ! Thermal noise impulse on velocities
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      ATOM_VX(AT) := ATOM_VX(AT) + THERMAL_CURRENT * SIN(REAL(AT) * 7.3 + REAL(FRAME) * 0.17)
      ATOM_VY(AT) := ATOM_VY(AT) + THERMAL_CURRENT * COS(REAL(AT) * 5.7 + REAL(FRAME) * 0.31)
      ATOM_VZ(AT) := ATOM_VZ(AT) + THERMAL_CURRENT * SIN(REAL(AT) * 3.1 + REAL(FRAME) * 0.09)
    ENDIF
  ENDDO

  ! Steric repulsion between non-bonded active atom pairs within cutoff.
  ! Sigma is per-pair from covalent radii (excluded volume is geometric).
  DO II = 1, NATOM - 1
    IF ATOM_ACTIVE(II) = 1 THEN
      DO JJ = II + 1, NATOM
        IF ATOM_ACTIVE(JJ) = 1 THEN
          ! Skip bonded pairs: the Morse core wall handles their repulsion
          IF BOND_MATRIX(II, JJ) = 0 .AND. BOND_MATRIX(JJ, II) = 0 THEN
            DX := ATOM_X(II) - ATOM_X(JJ)
            DY := ATOM_Y(II) - ATOM_Y(JJ)
            DZ := ATOM_Z(II) - ATOM_Z(JJ)
            DIST := SQRT(DX*DX + DY*DY + DZ*DZ)
            IF DIST > 0.0 .AND. DIST < REPULSION_CUTOFF THEN
              SIG_PAIR := STERIC_SCALE * (ELEM_RADIUS(ATOM_ELEMENT(II)) + &
                ELEM_RADIUS(ATOM_ELEMENT(JJ)))
              SR := SIG_PAIR / DIST
              SR2 := SR * SR
              SR6 := SR2 * SR2 * SR2
              FM := REPULSION_EPSILON * SR6
              FX := FM * DX / DIST
              FY := FM * DY / DIST
              FZ := FM * DZ / DIST
              ATOM_VX(II) := ATOM_VX(II) + FX
              ATOM_VY(II) := ATOM_VY(II) + FY
              ATOM_VZ(II) := ATOM_VZ(II) + FZ
              ATOM_VX(JJ) := ATOM_VX(JJ) - FX
              ATOM_VY(JJ) := ATOM_VY(JJ) - FY
              ATOM_VZ(JJ) := ATOM_VZ(JJ) - FZ
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDIF
  ENDDO

  ! Morse bond forces for bonds recorded in the previous frame.
  ! E = D*(g^2 - 2g) with g = exp(-a*(r-r0)): minimum -D at r0, zero at
  ! infinity, hard core wall as r -> 0. Force sign is negative of the old
  ! (inverted) version: it now restores r toward r0.
  DO KK = 1, NBOND
    II := BOND_I(KK)
    JJ := BOND_J(KK)
    IF ATOM_ACTIVE(II) = 1 .AND. ATOM_ACTIVE(JJ) = 1 THEN
      DX := ATOM_X(II) - ATOM_X(JJ)
      DY := ATOM_Y(II) - ATOM_Y(JJ)
      DZ := ATOM_Z(II) - ATOM_Z(JJ)
      DIST := SQRT(DX*DX + DY*DY + DZ*DZ)
      IF DIST > 0.0 THEN
        RDIFF := DIST - BOND_EQDIST(KK)
        EXP_TERM := EXP(-MORSE_A * RDIFF)
        MORSE_FORCE := -2.0 * BOND_STRENGTH(KK) * MORSE_A * &
          (1.0 - EXP_TERM) * EXP_TERM
        FX := MORSE_FORCE * DX / DIST
        FY := MORSE_FORCE * DY / DIST
        FZ := MORSE_FORCE * DZ / DIST
        ATOM_VX(II) := ATOM_VX(II) + FX * DT * FORCE_SCALE
        ATOM_VY(II) := ATOM_VY(II) + FY * DT * FORCE_SCALE
        ATOM_VZ(II) := ATOM_VZ(II) + FZ * DT * FORCE_SCALE
        ATOM_VX(JJ) := ATOM_VX(JJ) - FX * DT * FORCE_SCALE
        ATOM_VY(JJ) := ATOM_VY(JJ) - FY * DT * FORCE_SCALE
        ATOM_VZ(JJ) := ATOM_VZ(JJ) - FZ * DT * FORCE_SCALE
      ENDIF
    ENDIF
  ENDDO

  ! Three-body angle bending from the same previous-frame bond list
  CALL ANGLE_FORCES()

  ! Damping and position update with hard-wall boundaries
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      ATOM_VX(AT) := ATOM_VX(AT) * VELOCITY_DAMP
      ATOM_VY(AT) := ATOM_VY(AT) * VELOCITY_DAMP
      ATOM_VZ(AT) := ATOM_VZ(AT) * VELOCITY_DAMP

      ATOM_X(AT) := ATOM_X(AT) + ATOM_VX(AT) * DT
      ATOM_Y(AT) := ATOM_Y(AT) + ATOM_VY(AT) * DT
      ATOM_Z(AT) := ATOM_Z(AT) + ATOM_VZ(AT) * DT

      IF ATOM_X(AT) < 0.0 THEN
        ATOM_X(AT) := 0.0
        ATOM_VX(AT) := -ATOM_VX(AT)
      ENDIF
      IF ATOM_X(AT) > REAL(NX) THEN
        ATOM_X(AT) := REAL(NX)
        ATOM_VX(AT) := -ATOM_VX(AT)
      ENDIF
      IF ATOM_Y(AT) < 0.0 THEN
        ATOM_Y(AT) := 0.0
        ATOM_VY(AT) := -ATOM_VY(AT)
      ENDIF
      IF ATOM_Y(AT) > REAL(NY) THEN
        ATOM_Y(AT) := REAL(NY)
        ATOM_VY(AT) := -ATOM_VY(AT)
      ENDIF
      IF ATOM_Z(AT) < 0.0 THEN
        ATOM_Z(AT) := 0.0
        ATOM_VZ(AT) := -ATOM_VZ(AT)
      ENDIF
      IF ATOM_Z(AT) > REAL(NZ) THEN
        ATOM_Z(AT) := REAL(NZ)
        ATOM_VZ(AT) := -ATOM_VZ(AT)
      ENDIF
    ENDIF
  ENDDO
  RETURN
END

SUBROUTINE ANGLE_FORCES()
  ! E_ang = k * (cos(theta) - cos(theta0))^2 for every pair of bonds
  ! sharing a central atom. Uses the previous frame's bond list (same
  ! snapshot as the Morse pass). Accumulates E_ANGLE and ANG_RMSE.
  INTEGER :: KK, CEN, A1, A2, NA, NB2, NNB
  INTEGER :: NBRC(8)
  REAL :: UX, UY, UZ, WX, WY, WZ, UN, VN, CS, C0, KANG, S, DEDC
  REAL :: DCUX, DCUY, DCUZ, DCWX, DCWY, DCWZ
  REAL :: FAX, FAY, FAZ, FCX, FCY, FCZ
  REAL :: DEV, THETA0

  E_ANGLE := 0.0
  ANG_DEV_SQ := 0.0
  N_ANGLE := 0

  DO CEN = 1, NATOM
    IF ATOM_ACTIVE(CEN) = 1 THEN
      KANG := ELEM_ANGK(ATOM_ELEMENT(CEN))
      IF KANG > 0.0 THEN
        ! Gather bonded neighbors of CEN
        NNB := 0
        DO KK = 1, NBOND
          IF BOND_I(KK) = CEN .AND. NNB < 8 THEN
            NNB := NNB + 1
            NBRC(NNB) := BOND_J(KK)
          ENDIF
          IF BOND_J(KK) = CEN .AND. NNB < 8 THEN
            NNB := NNB + 1
            NBRC(NNB) := BOND_I(KK)
          ENDIF
        ENDDO

        IF NNB ≥ 2 THEN
          C0 := ELEM_COS0(ATOM_ELEMENT(CEN))
          ! acos(x) = atan2(sqrt(1-x^2), x)
          THETA0 := ATAN2(SQRT(1.0 - C0*C0), C0)
          DO A1 = 1, NNB - 1
            DO A2 = A1 + 1, NNB
              NA := NBRC(A1)
              NB2 := NBRC(A2)
              UX := ATOM_X(NA) - ATOM_X(CEN)
              UY := ATOM_Y(NA) - ATOM_Y(CEN)
              UZ := ATOM_Z(NA) - ATOM_Z(CEN)
              WX := ATOM_X(NB2) - ATOM_X(CEN)
              WY := ATOM_Y(NB2) - ATOM_Y(CEN)
              WZ := ATOM_Z(NB2) - ATOM_Z(CEN)
              UN := SQRT(UX*UX + UY*UY + UZ*UZ)
              VN := SQRT(WX*WX + WY*WY + WZ*WZ)
              IF UN > 0.0 .AND. VN > 0.0 THEN
                CS := (UX*WX + UY*WY + UZ*WZ) / (UN * VN)
                IF CS > 1.0 THEN
                  CS := 1.0
                ENDIF
                IF CS < -1.0 THEN
                  CS := -1.0
                ENDIF

                E_ANGLE := E_ANGLE + KANG * (CS - C0) * (CS - C0)
                N_ANGLE := N_ANGLE + 1
                DEV := ATAN2(SQRT(1.0 - CS*CS), CS) - THETA0
                ANG_DEV_SQ := ANG_DEV_SQ + DEV * DEV

                DEDC := 2.0 * KANG * (CS - C0)
                S := 1.0 / (UN * VN)
                DCUX := S * WX - CS * UX / (UN * UN)
                DCUY := S * WY - CS * UY / (UN * UN)
                DCUZ := S * WZ - CS * UZ / (UN * UN)
                DCWX := S * UX - CS * WX / (VN * VN)
                DCWY := S * UY - CS * WY / (VN * VN)
                DCWZ := S * UZ - CS * WZ / (VN * VN)

                FAX := -DEDC * DCUX
                FAY := -DEDC * DCUY
                FAZ := -DEDC * DCUZ
                FCX := -DEDC * DCWX
                FCY := -DEDC * DCWY
                FCZ := -DEDC * DCWZ

                ATOM_VX(NA) := ATOM_VX(NA) + FAX * DT * FORCE_SCALE
                ATOM_VY(NA) := ATOM_VY(NA) + FAY * DT * FORCE_SCALE
                ATOM_VZ(NA) := ATOM_VZ(NA) + FAZ * DT * FORCE_SCALE
                ATOM_VX(NB2) := ATOM_VX(NB2) + FCX * DT * FORCE_SCALE
                ATOM_VY(NB2) := ATOM_VY(NB2) + FCY * DT * FORCE_SCALE
                ATOM_VZ(NB2) := ATOM_VZ(NB2) + FCZ * DT * FORCE_SCALE
                ATOM_VX(CEN) := ATOM_VX(CEN) - (FAX + FCX) * DT * FORCE_SCALE
                ATOM_VY(CEN) := ATOM_VY(CEN) - (FAY + FCY) * DT * FORCE_SCALE
                ATOM_VZ(CEN) := ATOM_VZ(CEN) - (FAZ + FCZ) * DT * FORCE_SCALE
              ENDIF
            ENDDO
          ENDDO
        ENDIF
      ENDIF
    ENDIF
  ENDDO

  IF N_ANGLE > 0 THEN
    ANG_RMSE := SQRT(ANG_DEV_SQ / REAL(N_ANGLE)) * 57.29578
  ELSE
    ANG_RMSE := 0.0
  ENDIF
  RETURN
END

SUBROUTINE BOND_UPDATE()
  ! Detect bonds, compute stress, break/reform, and accumulate energies.
  ! Bond parameters are pure geometry: covalent radii set lengths,
  ! homonuclear well depths combine by geometric mean, bond order scales
  ! depth up and equilibrium distance down.
  INTEGER :: EI, EJ
  REAL :: RI, RJ
  REAL :: BO, BOND_SCALE
  REAL :: DISS, EQDIST, ALIGN, STRESS
  REAL :: RDIFF, EXP_TERM, MORSE_ENERGY

  NBOND := 0
  N_BOND_BREAKS := 0
  N_BOND_REFORM := 0
  TOTAL_POTENTIAL_ENERGY := 0.0
  TOTAL_BOND_STRENGTH := 0.0
  MAX_POTENTIAL_ENERGY := -1.0E30
  FINGERPRINT := 0

  DO I = 1, NATOM - 1
    IF ATOM_ACTIVE(I) = 1 THEN
      DO J = I + 1, NATOM
        IF ATOM_ACTIVE(J) = 1 THEN
          DX := ATOM_X(I) - ATOM_X(J)
          DY := ATOM_Y(I) - ATOM_Y(J)
          DZ := ATOM_Z(I) - ATOM_Z(J)
          DIST := SQRT(DX*DX + DY*DY + DZ*DZ)

          IF DIST < BOND_DIST THEN
            DTH := ATOM_THETA(I) - ATOM_THETA(J)
            ALIGN := COS(DTH)
            ALIGN_CURR(I, J) := ALIGN

            ! Bond order from alignment
            IF ALIGN > PHASE_HIGH THEN
              BO := BOND_ORDER_HIGH
            ELSEIF ALIGN > PHASE_SINGLE THEN
              BO := BOND_ORDER_SINGLE
            ELSE
              BO := 0.0
            ENDIF

            ! Geometric combining rules
            EI := ATOM_ELEMENT(I)
            EJ := ATOM_ELEMENT(J)
            RI := ELEM_RADIUS(EI)
            RJ := ELEM_RADIUS(EJ)

            BOND_SCALE := 1.0 + 0.8 * (BO - 1.0)
            DISS := SQRT(ELEM_DHOMO(EI) * ELEM_DHOMO(EJ)) * BOND_SCALE
            EQDIST := (RI + RJ) * (1.0 - BO_SHORTEN * (BO - 1.0))

            ! Stress = 1 - alignment (high stress = misaligned)
            STRESS := 1.0 - ALIGN

            ! Break if currently bonded and too stressed or too far
            IF BOND_MATRIX(I, J) = 1 THEN
              IF STRESS > STRESS_BREAK .OR. BO = 0.0 THEN
                BOND_MATRIX(I, J) := 0
                ATOM_DEGREE(I) := ATOM_DEGREE(I) - 1
                ATOM_DEGREE(J) := ATOM_DEGREE(J) - 1
                N_BOND_BREAKS := N_BOND_BREAKS + 1
              ELSE
                ! Active bond: record and accumulate energy
                NBOND := NBOND + 1
                IF NBOND ≤ MAXBOND THEN
                  BOND_I(NBOND) := I
                  BOND_J(NBOND) := J
                  BOND_ORDER(NBOND) := BO
                  BOND_STRENGTH(NBOND) := DISS
                  BOND_EQDIST(NBOND) := EQDIST

                  RDIFF := DIST - EQDIST
                  EXP_TERM := EXP(-MORSE_A * RDIFF)
                  MORSE_ENERGY := DISS * (EXP_TERM * EXP_TERM - 2.0 * EXP_TERM)
                  BOND_ENERGY(NBOND) := MORSE_ENERGY

                  TOTAL_POTENTIAL_ENERGY := TOTAL_POTENTIAL_ENERGY + MORSE_ENERGY
                  TOTAL_BOND_STRENGTH := TOTAL_BOND_STRENGTH + DISS
                  IF MORSE_ENERGY > MAX_POTENTIAL_ENERGY THEN
                    MAX_POTENTIAL_ENERGY := MORSE_ENERGY
                  ENDIF
                ENDIF
                FINGERPRINT := FINGERPRINT + I * J
              ENDIF
            ELSE
              ! Form new bond if aligned, low stress, and valence permits
              IF BO > 0.0 .AND. STRESS < STRESS_REFORM .AND. &
                 ATOM_DEGREE(I) < ELEM_MAX_DEGREE(EI) .AND. &
                 ATOM_DEGREE(J) < ELEM_MAX_DEGREE(EJ) THEN
                BOND_MATRIX(I, J) := 1
                ATOM_DEGREE(I) := ATOM_DEGREE(I) + 1
                ATOM_DEGREE(J) := ATOM_DEGREE(J) + 1
                N_BOND_REFORM := N_BOND_REFORM + 1
                NBOND := NBOND + 1
                IF NBOND ≤ MAXBOND THEN
                  BOND_I(NBOND) := I
                  BOND_J(NBOND) := J
                  BOND_ORDER(NBOND) := BO
                  BOND_STRENGTH(NBOND) := DISS
                  BOND_EQDIST(NBOND) := EQDIST

                  RDIFF := DIST - EQDIST
                  EXP_TERM := EXP(-MORSE_A * RDIFF)
                  MORSE_ENERGY := DISS * (EXP_TERM * EXP_TERM - 2.0 * EXP_TERM)
                  BOND_ENERGY(NBOND) := MORSE_ENERGY

                  TOTAL_POTENTIAL_ENERGY := TOTAL_POTENTIAL_ENERGY + MORSE_ENERGY
                  TOTAL_BOND_STRENGTH := TOTAL_BOND_STRENGTH + DISS
                  IF MORSE_ENERGY > MAX_POTENTIAL_ENERGY THEN
                    MAX_POTENTIAL_ENERGY := MORSE_ENERGY
                  ENDIF
                ENDIF
                FINGERPRINT := FINGERPRINT + I * J
              ENDIF
            ENDIF
          ELSE
            ! Out of range: zero alignment and break any existing bond
            ALIGN_CURR(I, J) := 0.0
            IF BOND_MATRIX(I, J) = 1 THEN
              BOND_MATRIX(I, J) := 0
              ATOM_DEGREE(I) := ATOM_DEGREE(I) - 1
              ATOM_DEGREE(J) := ATOM_DEGREE(J) - 1
              N_BOND_BREAKS := N_BOND_BREAKS + 1
            ENDIF
          ENDIF
        ENDIF
      ENDDO
    ENDIF
  ENDDO

  ! Fold the angle-bending energy (computed in MOVE_ATOMS from the
  ! previous frame's bond list) into the reported total
  TOTAL_POTENTIAL_ENERGY := TOTAL_POTENTIAL_ENERGY + E_ANGLE

  IF NBOND > 0 THEN
    MEAN_POTENTIAL_ENERGY := TOTAL_POTENTIAL_ENERGY / REAL(NBOND)
  ELSE
    MEAN_POTENTIAL_ENERGY := 0.0
  ENDIF

  ! Copy current alignments to previous for next frame stress estimate
  DO I = 1, NATOM - 1
    DO J = I + 1, NATOM
      ALIGN_PREV(I, J) := ALIGN_CURR(I, J)
    ENDDO
  ENDDO

  RETURN
END

SUBROUTINE COMPUTE_BOND_STATS()
  ! Degree distribution and connected components via BFS.
  INTEGER :: VISITED(32), QUEUE(32), QHEAD, QTAIL, CUR, NB, COMP_SIZE

  DEG0 := 0
  DEG1 := 0
  DEG2 := 0
  DEG3 := 0
  DEG4 := 0

  DO AT = 1, NATOM
    IF ATOM_DEGREE(AT) = 0 THEN
      DEG0 := DEG0 + 1
    ELSEIF ATOM_DEGREE(AT) = 1 THEN
      DEG1 := DEG1 + 1
    ELSEIF ATOM_DEGREE(AT) = 2 THEN
      DEG2 := DEG2 + 1
    ELSEIF ATOM_DEGREE(AT) = 3 THEN
      DEG3 := DEG3 + 1
    ELSEIF ATOM_DEGREE(AT) = 4 THEN
      DEG4 := DEG4 + 1
    ENDIF
    VISITED(AT) := 0
  ENDDO

  MAX_COMPONENT := 0
  N_FRAGMENTS := 0

  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 .AND. VISITED(AT) = 0 THEN
      QHEAD := 1
      QTAIL := 1
      QUEUE(1) := AT
      VISITED(AT) := 1
      COMP_SIZE := 0
      DO WHILE QHEAD ≤ QTAIL
        CUR := QUEUE(QHEAD)
        QHEAD := QHEAD + 1
        COMP_SIZE := COMP_SIZE + 1
        DO NB = 1, NATOM
          IF BOND_MATRIX(CUR, NB) = 1 .OR. BOND_MATRIX(NB, CUR) = 1 THEN
            IF VISITED(NB) = 0 THEN
              QTAIL := QTAIL + 1
              QUEUE(QTAIL) := NB
              VISITED(NB) := 1
            ENDIF
          ENDIF
        ENDDO
      ENDDO
      IF COMP_SIZE > MAX_COMPONENT THEN
        MAX_COMPONENT := COMP_SIZE
      ENDIF
      N_FRAGMENTS := N_FRAGMENTS + 1
    ENDIF
  ENDDO

  RETURN
END

SUBROUTINE COMPUTE_RGYR()
  REAL :: CX, CY, CZ

  CX := 0.0
  CY := 0.0
  CZ := 0.0
  N := 0
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      CX := CX + ATOM_X(AT)
      CY := CY + ATOM_Y(AT)
      CZ := CZ + ATOM_Z(AT)
      N := N + 1
    ENDIF
  ENDDO
  IF N > 0 THEN
    CX := CX / REAL(N)
    CY := CY / REAL(N)
    CZ := CZ / REAL(N)
  ENDIF

  RGYR := 0.0
  DO AT = 1, NATOM
    IF ATOM_ACTIVE(AT) = 1 THEN
      RGYR := RGYR + (ATOM_X(AT) - CX)**2 + (ATOM_Y(AT) - CY)**2 + (ATOM_Z(AT) - CZ)**2
    ENDIF
  ENDDO
  IF N > 0 THEN
    RGYR := SQRT(RGYR / REAL(N))
  ENDIF
  RETURN
END
