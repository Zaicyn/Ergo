#version 450
#extension GL_GOOGLE_include_directive : require
// shared f32 sin/cos core — bit-identical to CPU/SPIR-V (op map §3)
#include "ergo_trig32.glsl"

/*
 * Atlas generation compute shader — wave field splatting.
 *
 * Each particle splats a gaussian kernel into its cell's atlas tile.
 * Overlapping contributions create constructive interference where
 * particles cluster. The atlas stores the accumulated wave field.
 *
 * Uses Petroff equal-area projection for direction -> UV.
 */

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer BufX { float px[]; };
layout(set = 0, binding = 1) readonly buffer BufY { float py[]; };
layout(set = 0, binding = 2) readonly buffer BufZ { float pz[]; };
layout(set = 0, binding = 3) readonly buffer BufC { float cv[]; };
layout(set = 0, binding = 4) buffer AtlasBuf { uint atlas_pixels[]; };

layout(push_constant) uniform PC {
    int   n_points;
    int   grid_size;
    float cell_size;
    float val_min;
    float val_max;
    float pad1, pad2, pad3;
};

#define PI      3.14159265359
#define SQRT2   1.41421356237
#define SQRT3   1.73205080757
#define PHI_0   1.17809724510

vec2 petroff_uv(vec3 dir) {
    dir = normalize(dir);
    float phi = asin(clamp(dir.y, -1.0, 1.0));
    float lambda_ = atan(dir.x, dir.z) + PI;
    float cos_phi0 = ergo_cosf32(PHI_0); float sin_phi0 = ergo_sinf32(PHI_0);
    float psi0 = asin(1.0 / sqrt(2.0 - cos_phi0 * cos_phi0));
    float rho_v = asin(2.0 * sin_phi0 / sqrt(3.0 - ergo_cosf32(2.0 * PHI_0)));
    float hprime = (12.0 / PI) * (psi0 + rho_v - PI / 2.0);
    float xiprime = atan((PI * (hprime - 3.0) * (hprime - 3.0)) /
        (SQRT3 * (PI * (hprime * hprime - 2.0 * hprime + 45.0) - 96.0 * psi0 - 48.0 * rho_v)));
    float phi_c = abs(phi); float lambda_c = lambda_ - PI / 4.0;
    float quadrant = floor(2.0 * lambda_ / PI);
    float lambda0 = quadrant * PI / 2.0;
    float theta = abs(atan(ergo_cosf32(phi_c) * ergo_sinf32(lambda_c - lambda0),
        sin_phi0 * ergo_cosf32(phi_c) * ergo_cosf32(lambda_c - lambda0) - cos_phi0 * ergo_sinf32(phi_c)));
    float r = acos(clamp(sin_phi0 * ergo_sinf32(phi_c) + cos_phi0 * ergo_cosf32(phi_c) * ergo_cosf32(lambda_c - lambda0), -1.0, 1.0));
    float psi1 = PI - 2.0 * psi0;
    float beta; if (theta <= psi0) beta = psi0 - theta; else if (theta <= psi0 + psi1) beta = theta - psi0; else beta = PI - theta;
    float c; if (theta <= psi0 + psi1) c = acos(cos_phi0 / SQRT2); else c = PI / 2.0 - PHI_0;
    float G; if (theta <= psi0) G = psi0; else if (theta <= psi0 + psi1) G = psi1; else G = psi0;
    float psi0prime = atan(SQRT3 / hprime);
    float psi1prime = 7.0 * PI / 6.0 - psi0prime - xiprime;
    float psi2prime = xiprime - PI / 6.0;
    float Gprime; if (theta <= psi0) Gprime = psi0prime; else if (theta <= psi0 + psi1) Gprime = psi1prime; else Gprime = psi2prime;
    float F; if (theta <= psi0) F = rho_v; else if (theta <= psi0 + psi1) F = PI / 2.0 - rho_v; else F = PI / 4.0;
    float aprime; if (theta <= psi0) aprime = hprime; else aprime = sqrt(hprime * hprime + 3.0) * ergo_sinf32(PI / 3.0 - atan(hprime / SQRT3)) / ergo_sinf32(xiprime);
    float cprime; if (theta <= psi0 + psi1) cprime = sqrt(hprime * hprime + 3.0); else cprime = 3.0 - hprime;
    float x = acos(clamp(ergo_cosf32(r) * ergo_cosf32(c) + ergo_sinf32(r) * ergo_sinf32(c) * ergo_cosf32(beta), -1.0, 1.0));
    float gamma_v = 0.0; if (x > 1e-10) gamma_v = asin(clamp(ergo_sinf32(beta) * ergo_sinf32(r) / ergo_sinf32(x), -1.0, 1.0));
    float epsilon = acos(clamp(ergo_sinf32(G) * ergo_sinf32(gamma_v) * ergo_cosf32(c) - ergo_cosf32(G) * ergo_cosf32(gamma_v), -1.0, 1.0));
    float upupvp = (gamma_v + G + epsilon - PI) / (F + G - PI / 2.0);
    float s_e = max(ergo_sinf32(epsilon), 1e-10);
    float cos_xy = sqrt(max(1.0 - (ergo_sinf32(G) * ergo_sinf32(c) / s_e) * (ergo_sinf32(G) * ergo_sinf32(c) / s_e), 0.0));
    float xpxpyp = sqrt(max((1.0 - ergo_cosf32(x)) / max(1.0 - cos_xy, 1e-10), 0.0));
    float uprime = aprime * upupvp;
    float xpyp = sqrt(max(uprime * uprime + cprime * cprime - 2.0 * uprime * cprime * ergo_cosf32(Gprime), 0.0));
    float uGp = uprime * ergo_sinf32(Gprime) / max(xpyp, 1e-10);
    float cos_gp = sqrt(max(1.0 - uGp * uGp, 0.0));
    float xprime = xpyp * xpxpyp; float yprime = xpyp - xprime;
    float rprime = sqrt(max(xprime * xprime + cprime * cprime - 2.0 * xprime * cprime * cos_gp, 0.0));
    float alphaprime;
    if (uprime * rprime <= 1e-10) alphaprime = psi2prime;
    else { float ca = (yprime * yprime - uprime * uprime - rprime * rprime) / (-2.0 * uprime * rprime); alphaprime = acos(clamp(ca, -1.0, 1.0)); }
    float thetaprime;
    if (theta <= psi0) thetaprime = alphaprime;
    else if (theta <= psi0 + psi1) thetaprime = PI - psi2prime - alphaprime;
    else thetaprime = PI - psi2prime + alphaprime;
    float sign_lc = (lambda_c - lambda0 >= 0.0) ? 1.0 : -1.0;
    float x_c = sign_lc * rprime * ergo_sinf32(thetaprime);
    float y_c = hprime - rprime * ergo_cosf32(thetaprime);
    float y_h = y_c * sign(phi) - 3.0;
    float zeta = PI / 4.0 + quadrant * PI / 2.0;
    float scale = SQRT3 / (3.0 * SQRT2);
    float x_m = (x_c * ergo_cosf32(zeta) - y_h * ergo_sinf32(zeta) / SQRT3) * scale;
    float y_m = (x_c * ergo_sinf32(zeta) + y_h * ergo_cosf32(zeta) / SQRT3) * scale;
    return clamp(vec2(x_m, y_m) * 0.5 + 0.5, vec2(0.0), vec2(1.0));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= n_points) return;

    vec3 pos = vec3(px[idx], py[idx], pz[idx]);

    int gs = grid_size;
    float half_extent = float(gs) * 0.5 * cell_size;

    int ci = clamp(int(floor((pos.x + half_extent) / cell_size)), 0, gs - 1);
    int cj = clamp(int(floor((pos.y + half_extent) / cell_size)), 0, gs - 1);
    int ck = clamp(int(floor((pos.z + half_extent) / cell_size)), 0, gs - 1);

    int cell_idx = ck * gs * gs + cj * gs + ci;

    vec3 cell_center = vec3(
        (float(ci) - float(gs) * 0.5 + 0.5) * cell_size,
        (float(cj) - float(gs) * 0.5 + 0.5) * cell_size,
        (float(ck) - float(gs) * 0.5 + 0.5) * cell_size);

    vec3 dir = pos - cell_center;
    if (length(dir) < 1e-8) return;

    vec2 center_uv = petroff_uv(dir);
    ivec2 center_px = ivec2(center_uv * 64.0);

    int tile_x = cell_idx % 128;
    int tile_y = cell_idx / 128;
    ivec2 tile_origin = ivec2(tile_x * 64, tile_y * 64);

    /* Heat palette color for this particle */
    float t = clamp((cv[idx] - val_min) / (val_max - val_min + 1e-10), 0.0, 1.0);
    float r_c = clamp(t * 4.0 - 2.0, 0.0, 1.0);
    float g_c = clamp(1.0 - abs(t * 4.0 - 2.0), 0.0, 1.0) +
                clamp(t * 4.0 - 2.0, 0.0, 1.0) * step(0.5, t);
    float b_c = clamp(1.0 - t * 4.0, 0.0, 1.0);

    /* Splat a gaussian kernel: 5x5 pixels around center.
     * Weight falls off with distance from center pixel.
     * Use atomicMax to keep the brightest contribution per pixel. */
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            ivec2 px = center_px + ivec2(dx, dy);
            if (px.x < 0 || px.x >= 64 || px.y < 0 || px.y >= 64) continue;

            /* Gaussian weight: exp(-d²/2σ²), σ = 1.0 pixel */
            float d2 = float(dx * dx + dy * dy);
            float w = exp(-d2 * 0.5);

            /* Scale color by weight */
            uint rr = uint(r_c * w * 255.0) & 0xFFu;
            uint gg = uint(clamp(g_c, 0.0, 1.0) * w * 255.0) & 0xFFu;
            uint bb = uint(b_c * w * 255.0) & 0xFFu;
            uint packed = rr | (gg << 8u) | (bb << 16u) | (0xFFu << 24u);

            ivec2 atlas_px = tile_origin + px;
            uint pixel_idx = uint(atlas_px.y) * 8192u + uint(atlas_px.x);

            /* atomicMax: brightest contribution wins per pixel */
            atomicMax(atlas_pixels[pixel_idx], packed);
        }
    }
}
