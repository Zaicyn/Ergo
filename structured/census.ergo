! ════════════════════════════════════════════════════════════════
! CENSUS — CPU-only observation (runs at census intervals)
! ════════════════════════════════════════════════════════════════
!
! Reads particle arrays directly on CPU at census intervals.
! Cost: ~25ms at 25M (one linear pass). Runs every 1000 frames
! = 0.025ms amortized per frame. Zero GPU overhead.

SUBROUTINE SIM_CENSUS_REPORT(COUNT, FRAME)
  INTEGER :: COUNT, FRAME
  INTEGER :: I, B, BIN
  REAL :: OMEGA_SUM, OMEGA_MEAN, OMEGA_PEAK
  INTEGER :: PEAK_BIN, TOTAL

  PRINT FRAME
  PRINT COUNT

  ! Zero local histogram + state counts
  DO B = 1, 20
    CENSUS_OMEGA_HIST(B) := 0
  ENDDO
  CENSUS_STATE_COUNT(1) := 0
  CENSUS_STATE_COUNT(2) := 0
  CENSUS_STATE_COUNT(3) := 0
  CENSUS_STATE_COUNT(4) := 0

  ! Single pass over particles: bin OMEGA + count states
  DO I = 1, COUNT
    BIN := CLAMP(INT(OMEGA_NAT(I) * 10.0), 0, 19) + 1
    CENSUS_OMEGA_HIST(BIN) := CENSUS_OMEGA_HIST(BIN) + 1

    IF IAND(FLAGS(I), PFLAG_CRYSTAL) ≠ 0 THEN
      CENSUS_STATE_COUNT(2) := CENSUS_STATE_COUNT(2) + 1
    ELSEIF IAND(FLAGS(I), IOR(PFLAG_NOVA, PFLAG_EJECTED)) ≠ 0 THEN
      CENSUS_STATE_COUNT(4) := CENSUS_STATE_COUNT(4) + 1
    ELSEIF IAND(FLAGS(I), PFLAG_ACTIVE) ≠ 0 THEN
      CENSUS_STATE_COUNT(1) := CENSUS_STATE_COUNT(1) + 1
    ELSE
      CENSUS_STATE_COUNT(3) := CENSUS_STATE_COUNT(3) + 1
    ENDIF
  ENDDO

  ! State counts
  PRINT CENSUS_STATE_COUNT(1)
  PRINT CENSUS_STATE_COUNT(2)
  PRINT CENSUS_STATE_COUNT(3)
  PRINT CENSUS_STATE_COUNT(4)

  ! OMEGA stats from histogram
  OMEGA_SUM := 0.0
  TOTAL := 0
  OMEGA_PEAK := 0.0
  PEAK_BIN := 1
  DO B = 1, 20
    OMEGA_SUM := OMEGA_SUM + REAL(CENSUS_OMEGA_HIST(B)) * (REAL(B - 1) * 0.1 + 0.05)
    TOTAL := TOTAL + CENSUS_OMEGA_HIST(B)
    IF CENSUS_OMEGA_HIST(B) > INT(OMEGA_PEAK) THEN
      OMEGA_PEAK := REAL(CENSUS_OMEGA_HIST(B))
      PEAK_BIN := B
    ENDIF
  ENDDO
  IF TOTAL > 0 THEN
    OMEGA_MEAN := OMEGA_SUM / REAL(TOTAL)
  ELSE
    OMEGA_MEAN := 0.0
  ENDIF

  PRINT OMEGA_MEAN
  PRINT PEAK_BIN

  ! Full histogram
  DO B = 1, 20
    PRINT CENSUS_OMEGA_HIST(B)
  ENDDO

  ! Resonance signatures collected since last census
  IF SIG_COUNT(1) > 0 THEN
    PRINT SIG_COUNT(1)
    DO I = 1, SIG_COUNT(1)
      IF I ≤ SIG_MAX THEN
        ! Print 8 signature values per crystallization event
        PRINT SIG_BUF(1, I)
        PRINT SIG_BUF(2, I)
        PRINT SIG_BUF(3, I)
        PRINT SIG_BUF(4, I)
        PRINT SIG_BUF(5, I)
        PRINT SIG_BUF(6, I)
        PRINT SIG_BUF(7, I)
        PRINT SIG_BUF(8, I)
      ENDIF
    ENDDO
    ! Reset counter for next census interval
    SIG_COUNT(1) := 0
  ENDIF

  RETURN
END
