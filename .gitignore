# Whitelist mode: ignore everything, then allow specific dirs
*
!.gitignore
!structured/
!structured/**
!galaxy_structured.ergo
!core/
!core/**
# min/ — campaign work (sources only: .ergo/.py/.md; binaries and
# .out dumps stay ignored, same convention as tests/).
!min/
!min/**/
!min/*.ergo
!min/*.py
!min/*.md
!min/**/*.ergo
!min/**/*.py
!min/**/*.md
!min/**/*.sh
# min/ribosome certified reference CSVs — regression diff targets cited
# by the md docs and core/test_stag5_hang_regression.py. The other ~143
# trajectory-dump CSVs stay ignored (campaign outputs, regenerable).
!min/ribosome/ul18_stag5.csv
!min/ribosome/ul18_dom5.csv
!min/ribosome/ul18_full_slot.csv
# rail-map rotation series — small evidence data cited by RAIL_MAP.md
!min/ribosome/rail_series/
!min/ribosome/rail_series/*.csv
!Spec/
!Spec/**
!tools/
!tools/**
!README.md
!NEXT_SESSION.md

# Testing/ — sources only, not build products.
# Whitelist directories first so git considers them, then whitelist
# source extensions by directory. asm/ and asm/keep_*/ stay ignored
# because they're not in this whitelist — that's intentional, they
# are regenerable from `make`.
!Testing/
!Testing/**/
!Testing/*.md
!Testing/**/*.md
!Testing/Makefile
!Testing/**/Makefile
!Testing/*.c
!Testing/*.cu
!Testing/V8/*.cu
!Testing/V8/*.cuh
!Testing/V8/*.h
!Testing/V8_bounded/*.cu
!Testing/V22/*.c
!Testing/V22/*.h
!Testing/V9/*.cu
!Testing/V9/*.cuh
!Testing/V16/*.cu
!Testing/V16/*.cuh
!Testing/GEO/*.cu
!Testing/GEO/*.cuh

# allocator/ — F77 reference core + tuning audit (sources only).
!allocator/
!allocator/*.f
!allocator/*.py
!allocator/*.md
!allocator/*.ergo

# tests/ — Ergo programs and C harnesses. Same pattern as Testing/:
# track sources, leave build products and stale regenerable dumps
# (compiled binaries, .spvasm snapshots) ignored.
!tests/
!tests/*.ergo
!tests/*.c
!tests/*.h
# A2 golden harness (runner + burn-down doc)
!tests/golden/
!tests/golden/*.py
!tests/golden/*.md
# corpus audit + regression manifest (sha256 oracle, tracked); the
# full .out baselines stay local-only (regenerable: run_corpus.py
# --record) — 50 MB of dumps don't belong in the repo
!tests/golden/*.json
# D3 stream suite (file I/O + .esf) — sources tracked, out/ artifacts
# stay ignored (regenerable: run_stream.py rebuilds them)
!tests/stream/
!tests/stream/*.py
!tests/stream/*.ergo
!tests/stream/*.md
# nodegraph golden tests (graph JSON + runner)
!tests/nodegraph/
!tests/nodegraph/*.py
!tests/nodegraph/*.json
!tests/nodegraph/*.md
# math-kernel verification harness (coefficient generator, bit-plumbing
# dump, ulp checker, recorded results) — the audit trail for the owned
# transcendentals, so it must live in git, not /tmp
!tests/math_kernels/
!tests/math_kernels/*.py
!tests/math_kernels/*.c
!tests/math_kernels/*.md
# contraction-policy survey probes + runner (the evidence base for the
# NoContraction policy and the rejected plan-A rationale)
!tests/contraction/
!tests/contraction/*.py
!tests/contraction/*.c
!tests/contraction/*.md
# trig_identity three-path f32 sin/cos bit-identity harness (domain
# generator, GLSL compute runner, orchestrator) — the audit trail for
# the shared trig32 core, so it must live in git, not /tmp
!tests/trig_identity/
!tests/trig_identity/*.ergo
!tests/trig_identity/*.py
!tests/trig_identity/*.c
!tests/trig_identity/*.comp
!tests/trig_identity/*.md

# Always ignore build artifacts
__pycache__/
*.pyc
*.spvasm
*.spv
*.o
*.so
*.zip
*.png

# Hard ban, kept last so no whitelist rule above can override it:
# reference PDFs live in the tree for reading but never enter git.
*.pdf


reference/
